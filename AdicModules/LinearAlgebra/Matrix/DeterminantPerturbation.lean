/-!
# Matrix unit factors under determinant-scaled perturbations

Let `I` be an ideal contained in the Jacobson radical of the zero ideal. If each
entry of `A - B` lies in `(Ideal.span {B.det}) * I`, then the determinants of `A`
and `B` are associated. The scale is fixed by `B`; neither determinant needs to
be regular or invertible.

If the entries of `B - A` lie in `(Ideal.span {A.det}) * I`, then
`B = V * A = A * U` for matrix-ring units `U` and `V`, both congruent to the
identity entrywise modulo the original ideal `I`. Left multiplication by `V`
preserves the kernel of `mulVecLin`, and right multiplication by `U` preserves
its range, as submodules of the same coordinate module. These statements require
neither determinant to be regular or invertible.

Reduction modulo the scaled ideal makes the matrices, hence their determinants,
equal. Polynomial evaluation at `X` then gives association. As a consequence,
cancellation-regularity of the determinant is preserved by these perturbations.
-/

@[expose] public section

universe u v

namespace Matrix

variable {R : Type u} [CommRing R]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]

/-- Entry perturbations in the ideal generated by `B.det` times a Jacobson-radical
ideal preserve the determinant up to association. -/
theorem associated_det_of_sub_mem_span_mul
    (A B : Matrix ι ι R) (I : Ideal R)
    (hI : I ≤ (⊥ : Ideal R).jacobson)
    (hAB : ∀ i j, A i j - B i j ∈ Ideal.span {B.det} * I) :
    Associated A.det B.det := by
  classical
  let J : Ideal R := Ideal.span {B.det} * I
  let q : R →+* R ⧸ J := Ideal.Quotient.mk J
  have hmap : q.mapMatrix A = q.mapMatrix B := by
    ext i j
    change q (A i j) = q (B i j)
    rw [← sub_eq_zero, ← map_sub]
    change Ideal.Quotient.mk J (A i j - B i j) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hAB i j
  have hdet : A.det - B.det ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change q (A.det - B.det) = 0
    rw [map_sub, q.map_det, q.map_det, hmap, sub_self]
  simpa only [Polynomial.eval_X] using
    Polynomial.associated_eval_of_sub_mem_span_mul I hI (Polynomial.X : Polynomial R)
      B.det A.det (by simpa only [Polynomial.eval_X] using hdet)

/-- Cancellation-regularity of the determinant is invariant under entry
perturbations in the fixed determinant-scaled Jacobson-radical ideal. -/
theorem isRegular_det_iff_of_sub_mem_span_mul
    (A B : Matrix ι ι R) (I : Ideal R)
    (hI : I ≤ (⊥ : Ideal R).jacobson)
    (hAB : ∀ i j, A i j - B i j ∈ Ideal.span {B.det} * I) :
    IsRegular A.det ↔ IsRegular B.det := by
  obtain ⟨u, hu⟩ := associated_det_of_sub_mem_span_mul A B I hI hAB
  rw [← hu]
  constructor
  · intro hA
    constructor
    · intro x y hxy
      have hux : (u : R) * x = (u : R) * y :=
        hA.1 (by simpa [mul_assoc] using hxy)
      have h := congrArg (fun z : R => (↑(u⁻¹) : R) * z) hux
      simpa [← mul_assoc] using h
    · intro x y hxy
      apply hA.2
      have h := congrArg (fun z : R => z * (↑(u⁻¹) : R)) hxy
      simpa [mul_assoc] using h
  · intro hB
    constructor
    · intro x y hxy
      apply hB.1
      have h := congrArg (fun z : R => (u : R) * z) hxy
      simpa [mul_assoc, mul_left_comm] using h
    · intro x y hxy
      apply hB.2
      simpa [mul_assoc] using congrArg (fun z : R => z * (u : R)) hxy

/-- Determinant-scaled entry perturbations admit unit factors on both sides.
Both factors are congruent to the identity modulo the original ideal `I`.
The two units need not be equal, and no distinctness is asserted. -/
theorem exists_units_eq_mul_and_eq_mul_of_sub_mem_span_mul
    (A B : Matrix ι ι R) (I : Ideal R)
    (hI : I ≤ (⊥ : Ideal R).jacobson)
    (hAB : ∀ i j, B i j - A i j ∈ Ideal.span {A.det} * I) :
    ∃ U V : (Matrix ι ι R)ˣ,
      B = (V : Matrix ι ι R) * A ∧ B = A * (U : Matrix ι ι R) ∧
      (∀ i j, ((U : Matrix ι ι R) - 1) i j ∈ I) ∧
      (∀ i j, ((V : Matrix ι ι R) - 1) i j ∈ I) := by
  classical
  have hentries : ∀ i j, ∃ e ∈ I, A.det * e = B i j - A i j :=
    fun i j => Ideal.mem_span_singleton_mul.mp (hAB i j)
  choose e hEI hE using hentries
  let E : Matrix ι ι R := Matrix.of e
  have hB : B = A + A.det • E := by
    apply Matrix.ext
    intro i j
    have hij : B i j = A i j + A.det * e i j := by
      rw [hE i j]
      exact (sub_add_cancel (B i j) (A i j)).symm.trans (add_comm _ _)
    simpa only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, E, Matrix.of_apply] using hij
  have hUmem : ∀ i j, ((1 + A.adjugate * E : Matrix ι ι R) - 1) i j ∈ I := by
    intro i j
    rw [add_sub_cancel_left, Matrix.mul_apply]
    exact I.sum_mem fun k _ => I.mul_mem_left _ (hEI k j)
  have hVmem : ∀ i j, ((1 + E * A.adjugate : Matrix ι ι R) - 1) i j ∈ I := by
    intro i j
    rw [add_sub_cancel_left, Matrix.mul_apply]
    apply I.sum_mem
    intro k _
    rw [mul_comm]
    exact I.mul_mem_left _ (hEI i k)
  have hunit : ∀ M : Matrix ι ι R, (∀ i j, (M - 1) i j ∈ I) → IsUnit M := by
    intro M hM
    let q : R →+* R ⧸ I := Ideal.Quotient.mk I
    have hmap : q.mapMatrix M = q.mapMatrix (1 : Matrix ι ι R) := by
      ext i j
      change q (M i j) = q ((1 : Matrix ι ι R) i j)
      rw [← sub_eq_zero, ← map_sub]
      change Ideal.Quotient.mk I ((M - 1) i j) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hM i j)
    have hdet : M.det - 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q (M.det - 1) = 0
      rw [map_sub, q.map_det, hmap, ← q.map_det, Matrix.det_one, map_one, sub_self]
    exact (Matrix.isUnit_iff_isUnit_det M).mpr
      (Ideal.isUnit_of_sub_one_mem_jacobson_bot M.det (hI hdet))
  have hAU : A * (1 + A.adjugate * E) = B := by
    calc
      A * (1 + A.adjugate * E) = A + (A * A.adjugate) * E := by
        rw [mul_add, mul_one, ← mul_assoc]
      _ = A + A.det • E := by rw [mul_adjugate, smul_mul_assoc, one_mul]
      _ = B := hB.symm
  have hVA : (1 + E * A.adjugate) * A = B := by
    calc
      (1 + E * A.adjugate) * A = A + E * (A.adjugate * A) := by
        rw [add_mul, one_mul, mul_assoc]
      _ = A + A.det • E := by rw [adjugate_mul, mul_smul_comm, mul_one]
      _ = B := hB.symm
  obtain ⟨U, hU⟩ := hunit (1 + A.adjugate * E) hUmem
  obtain ⟨V, hV⟩ := hunit (1 + E * A.adjugate) hVmem
  refine ⟨U, V, ?_, ?_, ?_, ?_⟩
  · simpa only [hV] using hVA.symm
  · simpa only [hU] using hAU.symm
  · simpa only [hU] using hUmem
  · simpa only [hV] using hVmem

/-- Determinant-scaled Jacobson perturbations have the same kernel on the
coordinate module. The left unit factor preserves this kernel. -/
theorem ker_mulVecLin_eq_of_sub_mem_span_mul
    (A B : Matrix ι ι R) (I : Ideal R)
    (hI : I ≤ (⊥ : Ideal R).jacobson)
    (hAB : ∀ i j, B i j - A i j ∈ Ideal.span {A.det} * I) :
    LinearMap.ker B.mulVecLin = LinearMap.ker A.mulVecLin := by
  obtain ⟨_, V, hVA, _, _, _⟩ :=
    exists_units_eq_mul_and_eq_mul_of_sub_mem_span_mul A B I hI hAB
  rw [hVA, Matrix.mulVecLin_mul]
  apply LinearMap.ker_comp_of_ker_eq_bot
  apply LinearMap.ker_eq_bot_of_inverse
    (g := (↑(V⁻¹) : Matrix ι ι R).mulVecLin)
  rw [← Matrix.mulVecLin_mul]
  simp

/-- Determinant-scaled Jacobson perturbations have the same range in the
coordinate module. The right unit factor preserves this range. -/
theorem range_mulVecLin_eq_of_sub_mem_span_mul
    (A B : Matrix ι ι R) (I : Ideal R)
    (hI : I ≤ (⊥ : Ideal R).jacobson)
    (hAB : ∀ i j, B i j - A i j ∈ Ideal.span {A.det} * I) :
    LinearMap.range B.mulVecLin = LinearMap.range A.mulVecLin := by
  obtain ⟨U, _, _, hAU, _, _⟩ :=
    exists_units_eq_mul_and_eq_mul_of_sub_mem_span_mul A B I hI hAB
  rw [hAU, Matrix.mulVecLin_mul]
  apply LinearMap.range_comp_of_range_eq_top
  apply LinearMap.range_eq_top_of_surjective
  intro x
  refine ⟨(↑(U⁻¹) : Matrix ι ι R).mulVecLin x, ?_⟩
  have hcomp : (U : Matrix ι ι R).mulVecLin.comp
      (↑(U⁻¹) : Matrix ι ι R).mulVecLin = LinearMap.id := by
    rw [← Matrix.mulVecLin_mul]
    simp
  exact LinearMap.congr_fun hcomp x

end Matrix

namespace Matrix

universe uR uι

open scoped Pointwise

/-- For a square matrix, the preimage of a determinant-scaled set is the sum of
its scaled adjugate image and the kernel of the matrix. -/
theorem mulVec_preimage_smul_image_add_ker
    {R : Type uR} {ι : Type uι}
    [CommRing R] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R) (c : R) (S : Set (ι → R)) :
    A.mulVec ⁻¹' ((fun z => (A.det * c) • z) '' S) =
      ((fun z => c • A.adjugate.mulVec z) '' S) +
        {κ : ι → R | A.mulVec κ = 0} := by
  have hmul (z : ι → R) :
      A.mulVec (c • A.adjugate.mulVec z) = (A.det * c) • z := by
    calc
      A.mulVec (c • A.adjugate.mulVec z) =
          c • A.mulVec (A.adjugate.mulVec z) := by rw [mulVec_smul]
      _ = c • (A * A.adjugate).mulVec z := by simp only [mulVec_mulVec]
      _ = c • (A.det • z) := by rw [mul_adjugate, smul_mulVec, one_mulVec]
      _ = (A.det * c) • z := by rw [smul_smul, mul_comm]
  ext y
  constructor
  · rintro ⟨x, hx, hxy⟩
    change (A.det * c) • x = A.mulVec y at hxy
    refine ⟨c • A.adjugate.mulVec x, ⟨x, hx, rfl⟩,
      y - c • A.adjugate.mulVec x, ?_, ?_⟩
    · change A.mulVec (y - c • A.adjugate.mulVec x) = 0
      rw [mulVec_sub, hmul, hxy, sub_self]
    · change c • A.adjugate.mulVec x + (y - c • A.adjugate.mulVec x) = y
      rw [add_comm, sub_add_cancel]
  · rintro ⟨p, ⟨x, hx, rfl⟩, κ, hκ, rfl⟩
    refine ⟨x, hx, ?_⟩
    symm
    rw [mulVec_add, hmul, hκ, add_zero]

/-- For a square matrix with non-zero-divisor determinant, the preimage of a
scaled image of any set is its image under the scaled adjugate. -/
theorem mulVec_preimage_smul_image
    {R : Type uR} {ι : Type uι}
    [CommRing R] [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R) (c : R) (S : Set (ι → R))
    (hd : A.det ∈ nonZeroDivisors R) :
    A.mulVec ⁻¹' ((fun z => (A.det * c) • z) '' S) =
      (fun z => c • A.adjugate.mulVec z) '' S := by
  rw [mulVec_preimage_smul_image_add_ker]
  ext y
  constructor
  · rintro ⟨p, hp, κ, hκ, rfl⟩
    have hκzero : κ = 0 := by
      have hcancel : A.det • κ = A.det • (0 : ι → R) := by
        calc
          A.det • κ = (A.adjugate * A).mulVec κ := by
            rw [adjugate_mul, smul_mulVec, one_mulVec]
          _ = A.adjugate.mulVec (A.mulVec κ) := by simp only [mulVec_mulVec]
          _ = A.det • (0 : ι → R) := by rw [hκ, mulVec_zero, smul_zero]
      funext i
      apply (mul_cancel_left_mem_nonZeroDivisors hd).mp
      simpa only [Pi.smul_apply, smul_eq_mul] using congrFun hcancel i
    simpa only [hκzero, add_zero] using hp
  · intro hy
    refine ⟨y, hy, 0, ?_, add_zero y⟩
    change A.mulVec 0 = 0
    rw [mulVec_zero]

end Matrix
