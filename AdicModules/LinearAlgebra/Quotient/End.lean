/-!
# Endomorphisms on ideal-smul quotients

Reduction modulo an ideal acts on endomorphisms of the original module, with
scalars unchanged. The quotient and its induced maps are Mathlib's constructions.
For nested left ideals, endomorphisms descend canonically between the two quotient
modules, over the original ring. These reductions intertwine the quotient maps,
are uniquely characterized by this square, and satisfy identity and composition.
They are surjective when the original module is projective.

Reduction is injective when the ideal annihilates the module, over any ring.
When scalar multiplications commute on the module, this condition also
characterizes injectivity, with no finiteness or projectivity assumption.
In particular, the criterion applies over every commutative ring.
Already over a semiring with commuting scalar multiplications, the left ideal
of endomorphisms generated by `r • 1` for `r ∈ I` has the same members as
`I • ⊤` in the R-module of endomorphisms. This endomorphism ideal is two-sided
even if `I` is only a left ideal. This coefficient bridge needs no additive
inverses. In the ring case, for projective modules with commuting scalar
multiplications, the kernel of reduction is this scalar-generated ideal if
either the ideal or the module is finitely generated. For projective modules,
every endomorphism of the quotient lifts to an endomorphism of the original module.
Thus Mathlib's first isomorphism theorem identifies the endomorphism ring of the
quotient with the quotient of the original endomorphism ring by this ideal.
The equivalences send endomorphism classes to their reductions and agree when
both finiteness conditions hold.
For finite projective modules over a
commutative ring, every quotient automorphism lifts when the ideal is contained
in the Jacobson radical of the module annihilator.
For commutative scalars, restriction of scalars identifies this construction with
Mathlib's `LinearMap.reduceModIdeal`. The finite-module unit-reflection statement
combines Nakayama's lemma with
Orzech's theorem, as supplied by Mathlib.

## References

* Mathlib's quotient, Nakayama and Orzech formalizations, including
  `Submodule.mapQ`, `LinearMap.reduceModIdeal`, `CommRing.orzechProperty` and
  `Module.End.isUnit_iff`.
* [The Stacks Project, Nakayama's lemma, Tag 00DV](https://stacks.math.columbia.edu/tag/00DV).
* M. Orzech, *Onto endomorphisms are isomorphisms*, American Mathematical
  Monthly 78 (1971), 357–362.
-/

@[expose] public section

universe u v

namespace Module.End

section Semiring

variable {R : Type u} {M : Type v} [Semiring R] [AddCommMonoid M]
variable [Module R M] [SMulCommClass R R M]

/-- The endomorphism ideal generated by scalar multiples of the identity has the
same members as the ideal-smul submodule of endomorphisms. -/
theorem mem_span_smul_one (I : Ideal R) (f : Module.End R M) :
    f ∈ Ideal.span ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R)) ↔
      f ∈ I • (⊤ : Submodule R (Module.End R M)) := by
  constructor
  · intro hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨r, hr, rfl⟩ := hx
      exact Submodule.smul_mem_smul hr (by trivial)
    | zero => exact Submodule.zero_mem _
    | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
    | smul g x hx ih =>
      refine Submodule.smul_induction_on ih ?_ ?_
      · intro r hr y hy
        simpa only [smul_eq_mul, mul_smul_comm] using
          (Submodule.smul_mem_smul hr
            (show g * y ∈ (⊤ : Submodule R (Module.End R M)) by trivial))
      · intro y z ihy ihz
        simpa only [smul_eq_mul, mul_add] using Submodule.add_mem _ ihy ihz
  · intro hf
    refine Submodule.smul_induction_on hf ?_ ?_
    · intro r hr g hg
      simpa only [mul_smul_comm, mul_one] using
        (Ideal.span ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R))).mul_mem_left g
          (Ideal.subset_span ⟨r, hr, rfl⟩)
    · intro x y ihx ihy
      exact Submodule.add_mem _ ihx ihy

/-- Scalar multiples of the identity generate a two-sided endomorphism ideal,
even when the original ideal is only a left ideal. -/
instance isTwoSided_span_smul_one (I : Ideal R) :
    Ideal.IsTwoSided (Ideal.span
      ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R))) := by
  constructor
  intro f g hf
  rw [mem_span_smul_one] at hf ⊢
  refine Submodule.smul_induction_on hf ?_ ?_
  · intro r hr h hh
    simpa only [smul_mul_assoc] using
      (Submodule.smul_mem_smul hr
        (show h * g ∈ (⊤ : Submodule R (Module.End R M)) by trivial))
  · intro x y ihx ihy
    simpa only [add_mul] using Submodule.add_mem _ ihx ihy

end Semiring

section Ring

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- A linear map between ideal-smul quotients that sends each representative to
its class in the target has kernel equal to the target ideal acting on the source. -/
private theorem ker_quotientMap_eq_smul_top (I J : Ideal R)
    (q : (M ⧸ (I • (⊤ : Submodule R M))) →ₗ[R]
      (M ⧸ (J • (⊤ : Submodule R M))))
    (hq : ∀ m : M, q ((I • (⊤ : Submodule R M)).mkQ m) =
      (J • (⊤ : Submodule R M)).mkQ m) :
    LinearMap.ker q = J • (⊤ : Submodule R (M ⧸ (I • (⊤ : Submodule R M)))) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I • (⊤ : Submodule R M)) x
    change q ((I • (⊤ : Submodule R M)).mkQ m) = 0 at hx
    have heq : (J • (⊤ : Submodule R M)).mkQ m =
        (J • (⊤ : Submodule R M)).mkQ (0 : M) := by
      rw [map_zero]
      exact (hq m).symm.trans hx
    have hm : m ∈ J • (⊤ : Submodule R M) := by
      simpa only [sub_zero] using
        (Submodule.Quotient.eq (J • (⊤ : Submodule R M))).mp heq
    exact (Submodule.smul_top_le_comap_smul_top J
      (I • (⊤ : Submodule R M)).mkQ) hm
  · apply Submodule.smul_le.mpr
    intro a ha x _
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I • (⊤ : Submodule R M)) x
    change q ((I • (⊤ : Submodule R M)).mkQ (a • m)) = 0
    rw [hq]
    have hm : a • m - 0 ∈ J • (⊤ : Submodule R M) := by
      simpa only [sub_zero] using
        (Submodule.smul_mem_smul ha (show m ∈ (⊤ : Submodule R M) by trivial))
    have heq : (J • (⊤ : Submodule R M)).mkQ (a • m) =
        (J • (⊤ : Submodule R M)).mkQ (0 : M) :=
      (Submodule.Quotient.eq (J • (⊤ : Submodule R M))).mpr hm
    simpa only [map_zero] using heq

private theorem smul_top_mono {J I : Ideal R} (hJI : J ≤ I) :
    J • (⊤ : Submodule R M) ≤ I • (⊤ : Submodule R M) := by
  apply Submodule.smul_le.mpr
  intro a ha m _
  exact Submodule.smul_mem_smul (hJI ha) (by trivial)

private def quotientMapOfLE (I J : Ideal R) (hIJ : I ≤ J) :
    (M ⧸ (I • (⊤ : Submodule R M))) →ₗ[R]
      M ⧸ (J • (⊤ : Submodule R M)) :=
  (I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
    (smul_top_mono hIJ)

private theorem quotientMapOfLE_refl (I : Ideal R) :
    quotientMapOfLE (M := M) I I le_rfl = LinearMap.id :=
  Submodule.quot_hom_ext _ _ _ (fun _ => rfl)

private theorem quotientMapOfLE_comp (I J K : Ideal R) (hIJ : I ≤ J) (hJK : J ≤ K) :
    (quotientMapOfLE (M := M) J K hJK).comp (quotientMapOfLE I J hIJ) =
      quotientMapOfLE I K (hIJ.trans hJK) :=
  Submodule.quot_hom_ext _ _ _ (fun _ => rfl)

/-- The endomorphism ring homomorphism induced on the quotient by `I • ⊤`. -/
def reduceModIdeal (I : Ideal R) :
    Module.End R M →+* Module.End R (M ⧸ (I • (⊤ : Submodule R M))) where
  toFun f := (I • (⊤ : Submodule R M)).mapQ (I • (⊤ : Submodule R M)) f
    (Submodule.smul_top_le_comap_smul_top I f)
  map_zero' := Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _ (fun _ => rfl)
  map_one' := Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _ (fun _ => rfl)
  map_add' _ _ := Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _ (fun _ => rfl)
  map_mul' _ _ := Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _ (fun _ => rfl)

/-- Reduction sends the class of an element to the class of its image. -/
@[simp]
theorem reduceModIdeal_apply_mk (I : Ideal R) (f : Module.End R M) (m : M) :
    reduceModIdeal I f (Submodule.Quotient.mk m) = Submodule.Quotient.mk (f m) := rfl

/-- Reduction evaluated through the quotient linear map. -/
theorem reduceModIdeal_apply_mkQ (I : Ideal R) (f : Module.End R M) (m : M) :
    reduceModIdeal I f ((I • (⊤ : Submodule R M)).mkQ m) =
      (I • (⊤ : Submodule R M)).mkQ (f m) := rfl

/-- Reduction intertwines the original endomorphism with the quotient map. -/
theorem reduceModIdeal_comp_mkQ (I : Ideal R) (f : Module.End R M) :
    (reduceModIdeal I f).comp (I • (⊤ : Submodule R M)).mkQ =
      (I • (⊤ : Submodule R M)).mkQ.comp f :=
  Submodule.mapQ_mkQ _ _ _ (h := Submodule.smul_top_le_comap_smul_top I f)

/-- Two endomorphisms have equal reductions exactly when their values differ in
`I • ⊤` at every element of the original module. -/
theorem reduceModIdeal_eq_iff (I : Ideal R) (f g : Module.End R M) :
    reduceModIdeal I f = reduceModIdeal I g ↔
      ∀ m, f m - g m ∈ I • (⊤ : Submodule R M) := by
  constructor
  · intro h m
    apply (Submodule.Quotient.eq (I • (⊤ : Submodule R M))).mp
    exact congrArg (fun a : Module.End R (M ⧸ (I • (⊤ : Submodule R M))) =>
      a ((I • (⊤ : Submodule R M)).mkQ m)) h
  · intro h
    apply Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _
    intro m
    exact (Submodule.Quotient.eq (I • (⊤ : Submodule R M))).mpr (h m)

/-- Reduction is injective if the ideal annihilates the original module. -/
theorem reduceModIdeal_injective_of_le_annihilator (I : Ideal R)
    (hI : I ≤ Module.annihilator R M) :
    Function.Injective (reduceModIdeal (R := R) (M := M) I) := by
  have hzero : I • (⊤ : Submodule R M) ≤ ⊥ := by
    apply Submodule.smul_le.mpr
    intro a ha m _
    simpa only [Submodule.mem_bot] using Module.mem_annihilator.mp (hI ha) m
  intro f g h
  apply LinearMap.ext
  intro m
  have hm := hzero ((reduceModIdeal_eq_iff I f g).mp h m)
  simpa only [Submodule.mem_bot, sub_eq_zero] using hm

/-- Every endomorphism of an ideal-smul quotient of a projective module lifts to
an endomorphism of the original module. -/
theorem reduceModIdeal_surjective [Module.Projective R M] (I : Ideal R) :
    Function.Surjective (reduceModIdeal (R := R) (M := M) I) := by
  intro g
  obtain ⟨f, hf⟩ := Module.projective_lifting_property
    (I • (⊤ : Submodule R M)).mkQ (g.comp (I • (⊤ : Submodule R M)).mkQ)
    (Submodule.mkQ_surjective _)
  refine ⟨f, ?_⟩
  apply Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _
  intro m
  exact DFunLike.congr_fun ((reduceModIdeal_comp_mkQ I f).trans hf) m

/-- The canonical reduction between endomorphism rings of nested ideal-smul quotients.
The scalar ring is unchanged; no projectivity or commutation of scalars is required. -/
def reduceModIdealOfLE (I J : Ideal R) (hIJ : I ≤ J) :
    Module.End R (M ⧸ (I • (⊤ : Submodule R M))) →+*
      Module.End R (M ⧸ (J • (⊤ : Submodule R M))) := by
  let q : (M ⧸ (I • (⊤ : Submodule R M))) →ₗ[R]
      M ⧸ (J • (⊤ : Submodule R M)) :=
    (I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
      (by exact smul_top_mono hIJ)
  let F (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) :
      Module.End R (M ⧸ (J • (⊤ : Submodule R M))) :=
    (J • (⊤ : Submodule R M)).liftQ
      (q.comp (f.comp (I • (⊤ : Submodule R M)).mkQ)) (by
        intro m hm
        have hmI : (I • (⊤ : Submodule R M)).mkQ m ∈
            J • (⊤ : Submodule R (M ⧸ (I • (⊤ : Submodule R M)))) :=
          Submodule.smul_top_le_comap_smul_top J (I • (⊤ : Submodule R M)).mkQ hm
        have hfm : f ((I • (⊤ : Submodule R M)).mkQ m) ∈
            J • (⊤ : Submodule R (M ⧸ (I • (⊤ : Submodule R M)))) :=
          Submodule.smul_top_le_comap_smul_top J f hmI
        have hker := ker_quotientMap_eq_smul_top I J q (fun _ => rfl)
        exact (show f ((I • (⊤ : Submodule R M)).mkQ m) ∈ q.ker from hker.symm ▸ hfm))
  have hF (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) (m : M) :
      F f ((J • (⊤ : Submodule R M)).mkQ m) =
        q (f ((I • (⊤ : Submodule R M)).mkQ m)) := rfl
  have hFq (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M))))
      (x : M ⧸ (I • (⊤ : Submodule R M))) : F f (q x) = q (f x) := by
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I • (⊤ : Submodule R M)) x
    rfl
  exact
    { toFun := F
      map_zero' := by
        apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
        intro m
        exact (hF 0 m).trans q.map_zero
      map_one' := by
        apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
        intro m
        rfl
      map_add' := by
        intro f g
        apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
        intro m
        change F (f + g) ((J • (⊤ : Submodule R M)).mkQ m) =
          F f ((J • (⊤ : Submodule R M)).mkQ m) +
            F g ((J • (⊤ : Submodule R M)).mkQ m)
        rw [hF, hF, hF]
        exact q.map_add _ _
      map_mul' := by
        intro f g
        apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
        intro m
        change F (f * g) ((J • (⊤ : Submodule R M)).mkQ m) =
          F f (F g ((J • (⊤ : Submodule R M)).mkQ m))
        rw [hF, hF, hFq]
        rfl }

/-- Nested reduction sends a quotient class to the image of its value under the
canonical map between the two quotients. -/
@[simp]
theorem reduceModIdealOfLE_apply_mk (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) (m : M) :
    reduceModIdealOfLE I J hIJ f (Submodule.Quotient.mk m) =
      (I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
        (by exact smul_top_mono hIJ) (f (Submodule.Quotient.mk m)) := rfl

/-- Nested reduction evaluated through the quotient linear map. -/
theorem reduceModIdealOfLE_apply_mkQ (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) (m : M) :
    reduceModIdealOfLE I J hIJ f ((J • (⊤ : Submodule R M)).mkQ m) =
      (I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
        (by exact smul_top_mono hIJ) (f ((I • (⊤ : Submodule R M)).mkQ m)) := rfl

/-- Nested reduction intertwines evaluation with the map between the quotients. -/
@[simp]
theorem reduceModIdealOfLE_apply_mapQ (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M))))
    (x : M ⧸ (I • (⊤ : Submodule R M))) :
    reduceModIdealOfLE I J hIJ f
        ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
          (by exact smul_top_mono hIJ) x) =
      (I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
        (by exact smul_top_mono hIJ) (f x) := by
  obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I • (⊤ : Submodule R M)) x
  rfl

/-- The linear-map form of the canonical intertwining square. -/
theorem reduceModIdealOfLE_comp_mapQ (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) :
    (reduceModIdealOfLE I J hIJ f).comp
        ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
          (by exact smul_top_mono hIJ)) =
      ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
        (by exact smul_top_mono hIJ)).comp f := by
  apply LinearMap.ext
  intro x
  exact reduceModIdealOfLE_apply_mapQ I J hIJ f x

/-- An endomorphism is the nested reduction precisely when it intertwines with
the canonical map between the two quotients. -/
theorem reduceModIdealOfLE_eq_iff (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R (M ⧸ (I • (⊤ : Submodule R M))))
    (g : Module.End R (M ⧸ (J • (⊤ : Submodule R M)))) :
    g = reduceModIdealOfLE I J hIJ f ↔
      g.comp ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
          (by exact smul_top_mono hIJ)) =
        ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
          (by exact smul_top_mono hIJ)).comp f := by
  constructor
  · rintro rfl
    exact reduceModIdealOfLE_comp_mapQ I J hIJ f
  · intro h
    apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
    intro m
    rw [reduceModIdealOfLE_apply_mk]
    exact DFunLike.congr_fun h ((I • (⊤ : Submodule R M)).mkQ m)

/-- The intertwining square determines nested reduction as a ring homomorphism. -/
theorem reduceModIdealOfLE_unique (I J : Ideal R) (hIJ : I ≤ J)
    (φ : Module.End R (M ⧸ (I • (⊤ : Submodule R M))) →+*
      Module.End R (M ⧸ (J • (⊤ : Submodule R M))))
    (hφ : ∀ f, (φ f).comp
        ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
          (by exact smul_top_mono hIJ)) =
      ((I • (⊤ : Submodule R M)).mapQ (J • (⊤ : Submodule R M)) LinearMap.id
        (by exact smul_top_mono hIJ)).comp f) :
    φ = reduceModIdealOfLE I J hIJ := by
  apply RingHom.ext
  intro f
  exact (reduceModIdealOfLE_eq_iff I J hIJ f (φ f)).mpr (hφ f)

/-- Reduction between equal ideals is the identity on the endomorphism ring. -/
@[simp]
theorem reduceModIdealOfLE_refl (I : Ideal R) :
    reduceModIdealOfLE (M := M) I I le_rfl =
      RingHom.id (Module.End R (M ⧸ (I • (⊤ : Submodule R M)))) := by
  apply RingHom.ext
  intro f
  apply Submodule.quot_hom_ext (I • (⊤ : Submodule R M)) _ _
  intro m
  rw [reduceModIdealOfLE_apply_mk]
  exact DFunLike.congr_fun (quotientMapOfLE_refl (M := M) I)
    (f ((I • (⊤ : Submodule R M)).mkQ m))

/-- Canonical nested reductions compose along inclusions of left ideals. -/
theorem reduceModIdealOfLE_comp (I J K : Ideal R) (hIJ : I ≤ J) (hJK : J ≤ K) :
    (reduceModIdealOfLE (M := M) J K hJK).comp (reduceModIdealOfLE I J hIJ) =
      reduceModIdealOfLE I K (hIJ.trans hJK) := by
  apply RingHom.ext
  intro f
  apply Submodule.quot_hom_ext (K • (⊤ : Submodule R M)) _ _
  intro m
  simp only [RingHom.comp_apply]
  rw [reduceModIdealOfLE_apply_mk, reduceModIdealOfLE_apply_mk,
    reduceModIdealOfLE_apply_mk]
  exact DFunLike.congr_fun (quotientMapOfLE_comp (M := M) I J K hIJ hJK)
    (f ((I • (⊤ : Submodule R M)).mkQ m))

/-- Nested reduction is compatible with reduction from the original module. -/
theorem reduceModIdealOfLE_comp_reduceModIdeal (I J : Ideal R) (hIJ : I ≤ J) :
    (reduceModIdealOfLE (M := M) I J hIJ).comp (reduceModIdeal I) =
      reduceModIdeal J := by
  apply RingHom.ext
  intro f
  apply Submodule.quot_hom_ext (J • (⊤ : Submodule R M)) _ _
  intro m
  simp only [RingHom.comp_apply]
  rw [reduceModIdealOfLE_apply_mk, reduceModIdeal_apply_mk,
    reduceModIdeal_apply_mk]
  rfl

/-- Reducing an original endomorphism in two stages equals its direct reduction. -/
@[simp]
theorem reduceModIdealOfLE_apply_reduceModIdeal (I J : Ideal R) (hIJ : I ≤ J)
    (f : Module.End R M) :
    reduceModIdealOfLE I J hIJ (reduceModIdeal I f) = reduceModIdeal J f :=
  DFunLike.congr_fun (reduceModIdealOfLE_comp_reduceModIdeal I J hIJ) f

/-- Nested reduction is surjective when the same original module is projective. -/
theorem reduceModIdealOfLE_surjective [Module.Projective R M]
    (I J : Ideal R) (hIJ : I ≤ J) :
    Function.Surjective (reduceModIdealOfLE (M := M) I J hIJ) := by
  have h : Function.Surjective
      ((reduceModIdealOfLE (M := M) I J hIJ).comp (reduceModIdeal I)) := by
    rw [reduceModIdealOfLE_comp_reduceModIdeal]
    exact reduceModIdeal_surjective J
  exact Function.Surjective.of_comp h

/-- For nested left ideals, reducing from `M ⧸ (I • ⊤)` to `M ⧸ (J • ⊤)`
has the same kernel as reducing endomorphisms of `M ⧸ (I • ⊤)` modulo `J`. -/
theorem ker_reduceModIdealOfLE_eq_ker_reduceModIdeal
    (I J : Ideal R) (hIJ : I ≤ J) :
    RingHom.ker (reduceModIdealOfLE (M := M) I J hIJ) =
      RingHom.ker (reduceModIdeal (R := R)
        (M := M ⧸ (I • (⊤ : Submodule R M))) J) := by
  let q := quotientMapOfLE (M := M) I J hIJ
  have hq := ker_quotientMap_eq_smul_top I J q (fun _ => rfl)
  apply Ideal.ext
  intro f
  change reduceModIdealOfLE I J hIJ f = 0 ↔
    reduceModIdeal (M := M ⧸ (I • (⊤ : Submodule R M))) J f = 0
  have hzero :
      reduceModIdeal (M := M ⧸ (I • (⊤ : Submodule R M))) J f = 0 ↔
        ∀ x, f x ∈ J • (⊤ : Submodule R (M ⧸ (I • (⊤ : Submodule R M)))) := by
    simpa only [map_zero, LinearMap.zero_apply, sub_zero] using
      (reduceModIdeal_eq_iff J f 0)
  rw [hzero]
  constructor
  · intro hf x
    have hsquare := (reduceModIdealOfLE_eq_iff I J hIJ f 0).mp hf.symm
    rw [← hq]
    change q (f x) = 0
    exact (DFunLike.congr_fun hsquare x).symm
  · intro hf
    apply Eq.symm
    apply (reduceModIdealOfLE_eq_iff I J hIJ f 0).mpr
    apply LinearMap.ext
    intro x
    change 0 = q (f x)
    have hx : f x ∈ LinearMap.ker q := hq.symm ▸ hf x
    exact (show q (f x) = 0 from hx).symm

/-- Reduction modulo the zero ideal loses no endomorphisms. -/
theorem reduceModIdeal_injective_bot :
    Function.Injective (reduceModIdeal (M := M) (⊥ : Ideal R)) :=
  reduceModIdeal_injective_of_le_annihilator ⊥ bot_le

/-- When scalar multiplications commute on the module, reduction is injective
exactly when the ideal annihilates the original module. No finiteness or
projectivity is required. In particular, this applies over a commutative ring. -/
theorem reduceModIdeal_injective_iff [SMulCommClass R R M] (I : Ideal R) :
    Function.Injective (reduceModIdeal (R := R) (M := M) I) ↔
      I ≤ Module.annihilator R M := by
  constructor
  · intro hinj a ha
    apply Module.mem_annihilator.mpr
    intro m
    have hred : reduceModIdeal I (a • (1 : Module.End R M)) = reduceModIdeal I 0 := by
      apply (reduceModIdeal_eq_iff I _ _).mpr
      intro x
      simpa using (Submodule.smul_mem_smul ha (show x ∈ (⊤ : Submodule R M) by trivial))
    have hscalar := hinj hred
    simpa using DFunLike.congr_fun hscalar m
  · exact reduceModIdeal_injective_of_le_annihilator I

private theorem exists_fg_le_of_mem_smul_top (I : Ideal R) {m : M}
    (hm : m ∈ I • (⊤ : Submodule R M)) :
    ∃ J : Ideal R, J.FG ∧ J ≤ I ∧ m ∈ J • (⊤ : Submodule R M) := by
  let K : Submodule R M :=
    { carrier := {m | ∃ J : Ideal R, J.FG ∧ J ≤ I ∧ m ∈ J • (⊤ : Submodule R M)}
      zero_mem' := ⟨⊥, ⟨∅, by simp⟩, bot_le, Submodule.zero_mem _⟩
      add_mem' := by
        rintro x y ⟨J, hJ, hJI, hx⟩ ⟨L, hL, hLI, hy⟩
        exact ⟨J ⊔ L, Submodule.FG.sup hJ hL, sup_le hJI hLI,
          Submodule.add_mem _ (smul_top_mono le_sup_left hx) (smul_top_mono le_sup_right hy)⟩
      smul_mem' := by
        rintro a x ⟨J, hJ, hJI, hx⟩
        exact ⟨J, hJ, hJI, Submodule.smul_mem _ a hx⟩ }
  have hle : I • (⊤ : Submodule R M) ≤ K := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    refine ⟨Ideal.span ({a} : Set R), ⟨{a}, by simp⟩, ?_, ?_⟩
    · exact Ideal.span_le.mpr (by simpa using ha)
    · exact Submodule.smul_mem_smul (Ideal.subset_span (by simp)) (by trivial)
  exact hle hm

private theorem reduceModIdeal_eq_zero_of_mem_smul_top [SMulCommClass R R M]
    (I : Ideal R) (f : Module.End R M)
    (hf : f ∈ I • (⊤ : Submodule R (Module.End R M))) : reduceModIdeal I f = 0 := by
  rw [← (reduceModIdeal (M := M) I).map_zero]
  apply (reduceModIdeal_eq_iff I f 0).mpr
  intro m
  let ev : Module.End R M →ₗ[R] M :=
    { toFun := fun g => g m
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hle : I • (⊤ : Submodule R (Module.End R M)) ≤
      (I • (⊤ : Submodule R M)).comap ev := by
    apply Submodule.smul_le.mpr
    intro a ha g _
    exact Submodule.smul_mem_smul ha (by trivial)
  have hm : f m ∈ I • (⊤ : Submodule R M) := hle hf
  simpa only [LinearMap.zero_apply, sub_zero] using hm

private theorem mem_smul_top_of_image_of_fg [SMulCommClass R R M]
    [Module.Projective R M] (I : Ideal R) (hI : I.FG) (f : Module.End R M)
    (hf : ∀ m, f m ∈ I • (⊤ : Submodule R M)) :
    f ∈ I • (⊤ : Submodule R (Module.End R M)) := by
  classical
  obtain ⟨s, hs⟩ := hI
  let θ : (s → M) →ₗ[R] M := ∑ i : s, (i : R) • LinearMap.proj i
  have hgen (i : s) (m : M) : (i : R) • m ∈ θ.range := by
    refine ⟨Pi.single i m, ?_⟩
    simp only [θ, LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.proj_apply]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      simp [hji]
    · simp
  let K : Submodule R R :=
    { carrier := {a | ∀ m : M, a • m ∈ θ.range}
      zero_mem' := by
        intro m
        simpa only [zero_smul] using θ.range.zero_mem
      add_mem' := by
        intro a b ha hb m
        simpa only [add_smul] using θ.range.add_mem (ha m) (hb m)
      smul_mem' := by
        intro r a ha m
        simpa only [smul_eq_mul, mul_smul] using θ.range.smul_mem r (ha m) }
  have hIK : I ≤ K := by
    rw [← hs]
    apply Submodule.span_le.mpr
    intro a ha
    exact hgen ⟨a, ha⟩
  have himage : ∀ m, f m ∈ θ.range := by
    have hle : I • (⊤ : Submodule R M) ≤ θ.range := by
      apply Submodule.smul_le.mpr
      intro a ha m _
      exact hIK ha m
    exact fun m => hle (hf m)
  have hsurj : Function.Surjective θ.rangeRestrict := by
    rintro ⟨m, hm⟩
    obtain ⟨x, hx⟩ := hm
    exact ⟨x, Subtype.ext hx⟩
  obtain ⟨g, hg⟩ := Module.projective_lifting_property θ.rangeRestrict
    (f.codRestrict θ.range himage) hsurj
  have hexpr : f = ∑ i : s, (i : R) • (LinearMap.proj i).comp g := by
    apply LinearMap.ext
    intro m
    have hm := congrArg Subtype.val (DFunLike.congr_fun hg m)
    change θ (g m) = f m at hm
    simpa only [θ, LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.comp_apply,
      LinearMap.proj_apply] using hm.symm
  rw [hexpr]
  apply Submodule.sum_mem
  intro i _
  exact Submodule.smul_mem_smul (hs ▸ Submodule.subset_span i.property) (by trivial)

/-- For a finitely generated ideal and a projective module with commuting scalar
multiplications, the kernel of reduction consists of ideal-smul endomorphisms.
The module need not be finitely generated. -/
theorem reduceModIdeal_eq_zero_iff_mem_smul_top_of_fg [SMulCommClass R R M]
    [Module.Projective R M] (I : Ideal R) (hI : I.FG) (f : Module.End R M) :
    reduceModIdeal I f = 0 ↔ f ∈ I • (⊤ : Submodule R (Module.End R M)) := by
  constructor
  · intro hf
    apply mem_smul_top_of_image_of_fg I hI f
    have h := (reduceModIdeal_eq_iff I f 0).mp (by simpa using hf)
    simpa using h
  · exact reduceModIdeal_eq_zero_of_mem_smul_top I f

/-- For a finite projective module with commuting scalar multiplications, the
kernel of reduction modulo any ideal consists of ideal-smul endomorphisms. -/
theorem reduceModIdeal_eq_zero_iff_mem_smul_top [SMulCommClass R R M]
    [Module.Projective R M] [Module.Finite R M] (I : Ideal R) (f : Module.End R M) :
    reduceModIdeal I f = 0 ↔ f ∈ I • (⊤ : Submodule R (Module.End R M)) := by
  classical
  constructor
  · intro hf
    have himage : ∀ m, f m ∈ I • (⊤ : Submodule R M) := by
      simpa using (reduceModIdeal_eq_iff I f 0).mp (by simpa using hf)
    have gather (t : Finset M) : ∃ J : Ideal R, J.FG ∧ J ≤ I ∧
        ∀ m ∈ t, f m ∈ J • (⊤ : Submodule R M) := by
      induction t using Finset.induction_on with
      | empty => exact ⟨⊥, ⟨∅, by simp⟩, bot_le, by simp⟩
      | @insert m t _ ih =>
        obtain ⟨J, hJ, hJI, ht⟩ := ih
        obtain ⟨L, hL, hLI, hm⟩ := exists_fg_le_of_mem_smul_top I (himage m)
        refine ⟨J ⊔ L, Submodule.FG.sup hJ hL, sup_le hJI hLI, ?_⟩
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx
        · exact smul_top_mono le_sup_right hm
        · exact smul_top_mono le_sup_left (ht x hx)
    obtain ⟨s, hs⟩ := Module.finite_def.mp ‹Module.Finite R M›
    obtain ⟨J, hJ, hJI, hgen⟩ := gather s
    have hspan : Submodule.span R (s : Set M) ≤ (J • (⊤ : Submodule R M)).comap f :=
      Submodule.span_le.mpr hgen
    have htop : (⊤ : Submodule R M) ≤ (J • (⊤ : Submodule R M)).comap f := hs ▸ hspan
    exact smul_top_mono hJI (mem_smul_top_of_image_of_fg J hJ f (fun m => htop (by trivial)))
  · exact reduceModIdeal_eq_zero_of_mem_smul_top I f

/-- For a projective module and a finitely generated left ideal, the reduction
kernel is the endomorphism ideal generated by scalar multiples of the identity.
No finiteness assumption on the module is required. -/
theorem ker_reduceModIdeal_eq_span_smul_one_of_fg [SMulCommClass R R M]
    [Module.Projective R M] (I : Ideal R) (hI : I.FG) :
    RingHom.ker (reduceModIdeal (M := M) I) =
      Ideal.span ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R)) := by
  apply Ideal.ext
  intro f
  exact (reduceModIdeal_eq_zero_iff_mem_smul_top_of_fg I hI f).trans
    (mem_span_smul_one I f).symm

/-- For a finite projective module, the reduction kernel for any left ideal is
the endomorphism ideal generated by scalar multiples of the identity. -/
theorem ker_reduceModIdeal_eq_span_smul_one [SMulCommClass R R M]
    [Module.Projective R M] [Module.Finite R M] (I : Ideal R) :
    RingHom.ker (reduceModIdeal (M := M) I) =
      Ideal.span ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R)) := by
  apply Ideal.ext
  intro f
  exact (reduceModIdeal_eq_zero_iff_mem_smul_top I f).trans (mem_span_smul_one I f).symm

/-- For a projective module and a finitely generated left ideal, reduction
identifies the quotient by the scalar-generated endomorphism ideal with the
endomorphism ring of the ideal-smul quotient. The module need not be finite. -/
noncomputable def reduceModIdealQuotientEquivOfFG [SMulCommClass R R M]
    [Module.Projective R M] (I : Ideal R) (hI : I.FG) :
    (Module.End R M ⧸ Ideal.span
      ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R))) ≃+*
      Module.End R (M ⧸ (I • (⊤ : Submodule R M))) := by
  exact (Ideal.quotEquivOfEq (ker_reduceModIdeal_eq_span_smul_one_of_fg I hI).symm).trans
    ((reduceModIdeal (M := M) I).quotientKerEquivOfSurjective (reduceModIdeal_surjective I))

/-- For a finite projective module, reduction identifies the quotient by the
scalar-generated endomorphism ideal with the endomorphism ring of the
ideal-smul quotient, for every left ideal. -/
noncomputable def reduceModIdealQuotientEquiv [SMulCommClass R R M]
    [Module.Projective R M] [Module.Finite R M] (I : Ideal R) :
    (Module.End R M ⧸ Ideal.span
      ((fun r : R => r • (1 : Module.End R M)) '' (I : Set R))) ≃+*
      Module.End R (M ⧸ (I • (⊤ : Submodule R M))) := by
  exact (Ideal.quotEquivOfEq (ker_reduceModIdeal_eq_span_smul_one I).symm).trans
    ((reduceModIdeal (M := M) I).quotientKerEquivOfSurjective (reduceModIdeal_surjective I))

/-- The quotient equivalence for a finitely generated ideal sends the class of an
endomorphism to its reduction. -/
@[simp]
theorem reduceModIdealQuotientEquivOfFG_apply_mk [SMulCommClass R R M]
    [Module.Projective R M] (I : Ideal R) (hI : I.FG) (f : Module.End R M) :
    reduceModIdealQuotientEquivOfFG (M := M) I hI (Ideal.Quotient.mk _ f) =
      reduceModIdeal I f := by
  simp [reduceModIdealQuotientEquivOfFG]

/-- The quotient equivalence for a finite projective module sends the class of an
endomorphism to its reduction. -/
@[simp]
theorem reduceModIdealQuotientEquiv_apply_mk [SMulCommClass R R M]
    [Module.Projective R M] [Module.Finite R M] (I : Ideal R) (f : Module.End R M) :
    reduceModIdealQuotientEquiv (M := M) I (Ideal.Quotient.mk _ f) =
      reduceModIdeal I f := by
  simp [reduceModIdealQuotientEquiv]

/-- The two quotient equivalences agree whenever both finiteness conditions hold. -/
theorem reduceModIdealQuotientEquivOfFG_eq [SMulCommClass R R M]
    [Module.Projective R M] [Module.Finite R M] (I : Ideal R) (hI : I.FG) :
    reduceModIdealQuotientEquivOfFG (M := M) I hI = reduceModIdealQuotientEquiv I := by
  apply RingEquiv.ext
  intro x
  induction x using Quotient.inductionOn with
  | h f =>
      exact (reduceModIdealQuotientEquivOfFG_apply_mk I hI f).trans
        (reduceModIdealQuotientEquiv_apply_mk I f).symm

end Ring

section CommRing

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- For commutative scalars, endomorphism reduction agrees with Mathlib's quotient
linear map after restriction from `R ⧸ I` to the original scalars. -/
theorem reduceModIdeal_eq_restrictScalars (I : Ideal R) (f : Module.End R M) :
    reduceModIdeal I f = (LinearMap.reduceModIdeal I f).restrictScalars R := by
  apply Submodule.quot_hom_ext
  intro m
  rfl

variable [Module.Finite R M]

/-- Reduction of a finite-module endomorphism modulo an ideal contained in the
Jacobson radical of the module annihilator reflects units.

The proof combines Nakayama's lemma (Stacks Project, Tag 00DV) and Orzech's
theorem on surjective endomorphisms (1971), through their Mathlib formalizations;
see the module references. -/
theorem isLocalHom_reduceModIdeal (I : Ideal R)
    (hI : I ≤ Ideal.jacobson (Module.annihilator R M)) :
    IsLocalHom (reduceModIdeal (M := M) I) := by
  refine ⟨fun f hf => ?_⟩
  have hsurj : Function.Surjective (reduceModIdeal I f) :=
    ((Module.End.isUnit_iff _).mp hf).surjective
  have hcomp : Function.Surjective ((I • (⊤ : Submodule R M)).mkQ.comp f) := by
    rw [← reduceModIdeal_comp_mkQ I f]
    exact hsurj.comp (Submodule.mkQ_surjective _)
  have hrange : f.range ⊔ I • (⊤ : Submodule R M) = ⊤ := by
    have hmap : Submodule.map (I • (⊤ : Submodule R M)).mkQ f.range = ⊤ := by
      rw [← LinearMap.range_comp]
      exact LinearMap.range_eq_top_of_surjective _ hcomp
    simpa only [sup_comm] using
      (Submodule.map_mkQ_eq_top (I • (⊤ : Submodule R M)) f.range).mp hmap
  have hnak := Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson
    (N := f.range) (N' := (⊤ : Submodule R M))
    (Module.finite_def.mp ‹Module.Finite R M›) hI (le_of_eq hrange.symm)
  have hzero : Module.annihilator R M • (⊤ : Submodule R M) = ⊥ := by
    simpa only [Submodule.annihilator_top] using
      (Submodule.annihilator_smul (⊤ : Submodule R M))
  have htop : f.range = ⊤ := by
    simpa only [sup_top_eq, hzero, sup_bot_eq] using hnak.symm
  exact (Module.End.isUnit_iff f).mpr
    (OrzechProperty.bijective_of_surjective_endomorphism f
      (LinearMap.range_eq_top.mp htop))

/-- Every automorphism of an ideal-smul quotient of a finite projective module
over a commutative ring lifts to an automorphism of the original module when the
ideal lies in the Jacobson radical of the module annihilator.

Projectivity lifts the underlying endomorphism; finite-module unit reflection,
using Nakayama's lemma and Orzech's theorem as above, makes this lift a unit. -/
theorem unitsMap_reduceModIdeal_surjective [Module.Projective R M] (I : Ideal R)
    (hI : I ≤ Ideal.jacobson (Module.annihilator R M)) :
    Function.Surjective (Units.map (reduceModIdeal (M := M) I).toMonoidHom) := by
  let : IsLocalHom (reduceModIdeal (M := M) I) := isLocalHom_reduceModIdeal I hI
  intro g
  obtain ⟨f, hf⟩ := reduceModIdeal_surjective (M := M) I ↑g
  have hfunit : IsUnit (reduceModIdeal I f) := hf.symm ▸ g.isUnit
  obtain ⟨u, rfl⟩ := IsLocalHom.map_nonunit f hfunit
  exact ⟨u, Units.ext hf⟩

end CommRing

end Module.End
