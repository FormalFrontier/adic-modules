module

public import Mathlib

/-!
# Coefficients of endomorphisms of a quotient

For a left ideal `I`, `Ideal.moduleSpan I M` is the submodule of finite sums
of elements `i • m`. No commutativity of the ring or of its action on `M`
is required. For the quotient by this submodule, commuting scalar actions
on the quotient suffice for a finite coefficient decomposition of its
endomorphisms. The projectivity hypothesis is on `M`, not on the quotient.
-/

@[expose] public section

universe u v

namespace Ideal

variable {R : Type u} [Semiring R]

/-- The submodule generated by products of elements of a left ideal with
module elements. This definition does not require commuting scalar actions. -/
def moduleSpan (I : Ideal R) (N : Type v) [AddCommMonoid N] [Module R N] :
    Submodule R N :=
  Submodule.span R {x | ∃ a ∈ I, ∃ n : N, a • n = x}

variable {N : Type v} [AddCommMonoid N] [Module R N]

theorem smul_mem_moduleSpan (I : Ideal R) {a : R} (ha : a ∈ I) (n : N) :
    a • n ∈ I.moduleSpan N :=
  Submodule.subset_span ⟨a, ha, n, rfl⟩

theorem moduleSpan_le {I : Ideal R} {P : Submodule R N} :
    I.moduleSpan N ≤ P ↔ ∀ a ∈ I, ∀ n : N, a • n ∈ P := by
  constructor
  · intro h a ha n
    exact h (I.smul_mem_moduleSpan ha n)
  · intro h
    apply Submodule.span_le.2
    rintro _ ⟨a, ha, n, rfl⟩
    exact h a ha n

theorem moduleSpan_mono {I J : Ideal R} (h : I ≤ J) :
    I.moduleSpan N ≤ J.moduleSpan N :=
  moduleSpan_le.2 fun _ ha n => J.smul_mem_moduleSpan (h ha) n

/-- Every element of an ideal-generated submodule uses only a finitely
generated left subideal of the coefficient ideal. -/
theorem exists_fg_subideal_of_mem_moduleSpan {J : Ideal R} {x : N}
    (hx : x ∈ J.moduleSpan N) :
    ∃ J₀ : Ideal R, J₀.FG ∧ J₀ ≤ J ∧ x ∈ J₀.moduleSpan N := by
  classical
  induction hx using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨a, ha, n, rfl⟩
      refine ⟨Submodule.span R ({a} : Set R), ?_, ?_, ?_⟩
      · exact ⟨{a}, by simp⟩
      · exact Submodule.span_le.2 (by simpa using ha)
      · exact smul_mem_moduleSpan _ (Submodule.subset_span (by simp)) n
  | zero =>
      exact ⟨⊥, ⟨∅, by simp⟩, bot_le, (moduleSpan (⊥ : Ideal R) N).zero_mem⟩
  | add x y _ _ ihx ihy =>
      rcases ihx with ⟨J₁, hfg₁, hle₁, hx⟩
      rcases ihy with ⟨J₂, hfg₂, hle₂, hy⟩
      refine ⟨J₁ ⊔ J₂, ?_, sup_le hle₁ hle₂, ?_⟩
      · obtain ⟨s, hs⟩ := hfg₁
        obtain ⟨t, ht⟩ := hfg₂
        refine ⟨s ∪ t, ?_⟩
        change Submodule.span R (↑(s ∪ t) : Set R) = _
        change Submodule.span R (↑s : Set R) = J₁ at hs
        change Submodule.span R (↑t : Set R) = J₂ at ht
        rw [Finset.coe_union, Submodule.span_union, hs, ht]
      · exact (moduleSpan (J₁ ⊔ J₂) N).add_mem
          (moduleSpan_mono le_sup_left hx) (moduleSpan_mono le_sup_right hy)
  | smul a x _ ihx =>
      rcases ihx with ⟨J₀, hfg, hle, hx⟩
      exact ⟨J₀, hfg, hle, (moduleSpan J₀ N).smul_mem a hx⟩

/-- A finitely generated submodule contained in `J N` is contained in `J₀ N`
for some finitely generated left ideal `J₀ ≤ J`. -/
theorem exists_fg_subideal_cover {J : Ideal R} {P : Submodule R N}
    (hP : P.FG) (hPJ : P ≤ J.moduleSpan N) :
    ∃ J₀ : Ideal R, J₀.FG ∧ J₀ ≤ J ∧ P ≤ J₀.moduleSpan N := by
  classical
  have finite_cover (s : Finset N) (hs : ∀ x ∈ s, x ∈ J.moduleSpan N) :
      ∃ J₀ : Ideal R, J₀.FG ∧ J₀ ≤ J ∧ ∀ x ∈ s, x ∈ J₀.moduleSpan N := by
    induction s using Finset.induction_on with
    | empty =>
        exact ⟨⊥, ⟨∅, by simp⟩, bot_le, by simp⟩
    | @insert x s hxs ih =>
        obtain ⟨J₁, hfg₁, hle₁, hx⟩ :=
          exists_fg_subideal_of_mem_moduleSpan (hs x (Finset.mem_insert_self x s))
        obtain ⟨J₂, hfg₂, hle₂, hcover⟩ :=
          ih (fun y hy => hs y (Finset.mem_insert_of_mem hy))
        refine ⟨J₁ ⊔ J₂, ?_, sup_le hle₁ hle₂, ?_⟩
        · obtain ⟨t₁, ht₁⟩ := hfg₁
          obtain ⟨t₂, ht₂⟩ := hfg₂
          refine ⟨t₁ ∪ t₂, ?_⟩
          change Submodule.span R (↑(t₁ ∪ t₂) : Set R) = _
          change Submodule.span R (↑t₁ : Set R) = J₁ at ht₁
          change Submodule.span R (↑t₂ : Set R) = J₂ at ht₂
          rw [Finset.coe_union, Submodule.span_union, ht₁, ht₂]
        · intro y hy
          rcases Finset.mem_insert.1 hy with rfl | hy
          · exact moduleSpan_mono le_sup_left hx
          · exact moduleSpan_mono le_sup_right (hcover y hy)
  obtain ⟨s, hs⟩ := hP
  obtain ⟨J₀, hfg, hle, hcover⟩ := finite_cover s (by
    intro x hx
    apply hPJ
    rw [← hs]
    exact Submodule.subset_span hx)
  refine ⟨J₀, hfg, hle, ?_⟩
  rw [← hs]
  exact Submodule.span_le.2 hcover

end Ideal

namespace Ideal

variable {R : Type u} [Ring R]

/-- The canonical quotient by the submodule of finite sums `i • m`. -/
abbrev ModuleQuotient (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M] :=
  M ⧸ I.moduleSpan M

variable (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]

/-- The canonical projection onto the module quotient. -/
def moduleQuotientMk : M →ₗ[R] I.ModuleQuotient M :=
  (I.moduleSpan M).mkQ

theorem moduleQuotientMk_surjective : Function.Surjective (I.moduleQuotientMk M) :=
  (I.moduleSpan M).mkQ_surjective

/-- The coefficient ideal annihilates its canonical module quotient. -/
theorem smul_moduleQuotient_eq_zero {a : R} (ha : a ∈ I)
    (q : I.ModuleQuotient M) : a • q = 0 := by
  obtain ⟨m, rfl⟩ := I.moduleQuotientMk_surjective M q
  change (I.moduleSpan M).mkQ (a • m) = 0
  change a • m ∈ LinearMap.ker (I.moduleSpan M).mkQ
  simpa only [Submodule.ker_mkQ] using I.smul_mem_moduleSpan ha m

/-- Every linear map into this quotient kills `I M`, independently of any
other coefficient ideal. -/
theorem moduleSpan_le_ker (f : M →ₗ[R] I.ModuleQuotient M) :
    I.moduleSpan M ≤ LinearMap.ker f := by
  apply moduleSpan_le.2
  intro a ha m
  change f (a • m) = 0
  rw [map_smul]
  exact I.smul_moduleQuotient_eq_zero M ha (f m)

/-- Descend a linear map to the canonical quotient using its annihilation
by `I`. -/
def descendModuleQuotient (f : M →ₗ[R] I.ModuleQuotient M) :
    I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M :=
  (I.moduleSpan M).liftQ f (I.moduleSpan_le_ker M f)

@[simp]
theorem descendModuleQuotient_mk (f : M →ₗ[R] I.ModuleQuotient M) (m : M) :
    I.descendModuleQuotient M f (I.moduleQuotientMk M m) = f m := rfl

end Ideal

namespace LinearMap

variable {R : Type u} [Semiring R]
variable {N : Type v} [AddCommMonoid N] [Module R N] [SMulCommClass R R N]

/-- The finite coefficient map. Its linearity uses commuting scalar actions
only on its target. -/
def coefficientMap (s : Finset R) : (s → N) →ₗ[R] N where
  toFun v := ∑ a : s, (a : R) • v a
  map_add' x y := by simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
  map_smul' r v := by
    change (∑ a : s, (a : R) • (r • v a)) = r • ∑ a : s, (a : R) • v a
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro a _
    exact smul_comm (a : R) r (v a)

@[simp]
theorem coefficientMap_apply (s : Finset R) (v : s → N) :
    coefficientMap s v = ∑ a : s, (a : R) • v a := rfl

/-- Left generators of the coefficient ideal suffice for the coefficient
map to cover its ideal-generated submodule. -/
theorem moduleSpan_le_range_coefficientMap (s : Finset R) :
    Ideal.moduleSpan (Submodule.span R (↑s : Set R) : Ideal R) N ≤
      LinearMap.range (coefficientMap (N := N) s) := by
  classical
  apply Ideal.moduleSpan_le.2
  intro a ha n
  have h : ∀ n : N, a • n ∈ LinearMap.range (coefficientMap (N := N) s) := by
    induction ha using Submodule.span_induction with
    | mem a ha =>
        intro n
        refine ⟨fun b => if b = (⟨a, ha⟩ : s) then n else 0, ?_⟩
        simp
    | zero =>
        intro n
        simp
    | add a b _ _ iha ihb =>
        intro n
        simpa only [add_smul] using
          (LinearMap.range (coefficientMap (N := N) s)).add_mem (iha n) (ihb n)
    | smul r a _ iha =>
        intro n
        simpa only [smul_eq_mul, mul_smul, smul_comm r a n] using iha (r • n)
  exact h n

end LinearMap

namespace Ideal

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable (I J : Ideal R)
variable [Module.Projective R M]
variable [SMulCommClass R R (I.ModuleQuotient M)]

/-- Finite generators of `J` give one global finite list of endomorphism
coefficients. The lift has source the original projective module `M`. -/
theorem exists_endomorphism_coefficients_of_fg (hJ : J.FG)
    (u : I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)
    (hu : LinearMap.range u ≤ J.moduleSpan (I.ModuleQuotient M)) :
    ∃ (s : Finset R) (v : s → (I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)),
      (∀ a : s, (a : R) ∈ J) ∧ u = ∑ a : s, (a : R) • v a := by
  classical
  obtain ⟨s, hs⟩ := hJ
  let c := LinearMap.coefficientMap (N := I.ModuleQuotient M) s
  have hc : J.moduleSpan (I.ModuleQuotient M) ≤ LinearMap.range c := by
    rw [← hs]
    exact LinearMap.moduleSpan_le_range_coefficientMap (N := I.ModuleQuotient M) s
  let f : M →ₗ[R] LinearMap.range c :=
    (u.comp (I.moduleQuotientMk M)).codRestrict (LinearMap.range c) (fun m =>
      hc (hu ⟨I.moduleQuotientMk M m, rfl⟩))
  have hc_surj : Function.Surjective c.rangeRestrict := by
    intro q
    obtain ⟨v, hv⟩ := q.property
    exact ⟨v, Subtype.ext hv⟩
  obtain ⟨l, hl⟩ := Module.projective_lifting_property c.rangeRestrict f hc_surj
  let v : s → (I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M) := fun a =>
    I.descendModuleQuotient M ((LinearMap.proj a).comp l)
  refine ⟨s, v, ?_, ?_⟩
  · intro a
    rw [← hs]
    exact Submodule.subset_span a.property
  · apply LinearMap.ext
    intro q
    obtain ⟨m, rfl⟩ := I.moduleQuotientMk_surjective M q
    have hm : c (l m) = u (I.moduleQuotientMk M m) :=
      congrArg (fun z : LinearMap.range c => (z : I.ModuleQuotient M))
        (LinearMap.congr_fun hl m)
    simpa [c, v] using hm.symm

/-- The finitely generated coefficient-ideal alternative. No finiteness
hypothesis on the quotient or on the range is needed. -/
theorem endomorphism_mem_moduleSpan_of_fg (hJ : J.FG)
    (u : I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)
    (hu : LinearMap.range u ≤ J.moduleSpan (I.ModuleQuotient M)) :
    u ∈ J.moduleSpan (I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M) := by
  obtain ⟨s, v, hs, hv⟩ := I.exists_endomorphism_coefficients_of_fg J hJ u hu
  rw [hv]
  exact Submodule.sum_mem _ (fun a _ => J.smul_mem_moduleSpan (hs a) (v a))

omit [Module.Projective R M] [SMulCommClass R R (I.ModuleQuotient M)] in
/-- Finite generation of the range supplies a finitely generated left
coefficient ideal contained in `J`; no containment of `I` is required. -/
theorem exists_fg_subideal_cover_range
    (u : I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)
    (hfg : (LinearMap.range u).FG)
    (hu : LinearMap.range u ≤ J.moduleSpan (I.ModuleQuotient M)) :
    ∃ J₀ : Ideal R, J₀.FG ∧ J₀ ≤ J ∧
      LinearMap.range u ≤ J₀.moduleSpan (I.ModuleQuotient M) :=
  exists_fg_subideal_cover hfg hu

/-- The finite-range coefficient theorem. It requires neither finite
generation of `J` nor finite generation of the quotient. -/
theorem endomorphism_mem_moduleSpan_of_range_fg
    (u : I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)
    (hfg : (LinearMap.range u).FG)
    (hu : LinearMap.range u ≤ J.moduleSpan (I.ModuleQuotient M)) :
    u ∈ J.moduleSpan (I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M) := by
  obtain ⟨J₀, hJ₀, hle, hcover⟩ := I.exists_fg_subideal_cover_range J u hfg hu
  exact moduleSpan_mono hle (I.endomorphism_mem_moduleSpan_of_fg J₀ hJ₀ u hcover)

/-- The finitely generated quotient alternative, with no finite-generation
hypothesis on the coefficient ideal. -/
theorem endomorphism_mem_moduleSpan_of_finite
    [Module.Finite R (I.ModuleQuotient M)]
    (u : I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M)
    (hu : LinearMap.range u ≤ J.moduleSpan (I.ModuleQuotient M)) :
    u ∈ J.moduleSpan (I.ModuleQuotient M →ₗ[R] I.ModuleQuotient M) := by
  apply I.endomorphism_mem_moduleSpan_of_range_fg J u _ hu
  simp

end Ideal
