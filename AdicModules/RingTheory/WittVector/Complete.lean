module

public import Mathlib.RingTheory.WittVector.Complete

/-!
# Adic completeness of Witt vectors in prime characteristic

For a commutative ring `k` of characteristic `p`, membership in the `n`th power
of the ideal generated by `p` in `WittVector p k` is characterized by a zero
prefix and the existence of `p ^ n`th roots of the remaining coefficients.
For each fixed `n`, these roots are chosen independently for each coefficient;
no compatible tower of roots is required.

## Main declarations

* `WittVector.mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq`: the
  coefficient characterization of membership in a power of the ideal `(p)`.
* `WittVector.isAdicComplete_span_p`: Witt vectors over any commutative ring
  of characteristic `p` are Hausdorff and complete for the ideal `(p)`.

For nonperfect coefficient rings, a zero prefix alone need not characterize
membership in `(p) ^ n`. No identification with the Verschiebung filtration,
quotient identification with `k`, or torsion-freeness assertion is made here.

## References

Mathlib's `RingTheory/WittVector/Complete.lean` (Jiedong Jiang) provides the
perfect-ring coefficient criterion and adic completeness result.
`RingTheory/WittVector/Identities.lean` (Johan Commelin) provides the
characteristic-`p` multiplication coefficient formulas without perfectness.
-/

@[expose] public section

universe u

namespace WittVector

variable {p : ℕ} [Fact p.Prime] {k : Type u} [CommRing k] [CharP k p]

/-- A Witt vector belongs to the `n`th power of the ideal generated by `p`
exactly when its first `n` coefficients vanish and each remaining coefficient
has a `p ^ n`th root in `k`. The roots are independent for this fixed `n`;
no perfectness or compatibility between roots is assumed. -/
theorem mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq
    (x : WittVector p k) (n : ℕ) :
    x ∈ (Ideal.span {(p : WittVector p k)}) ^ n ↔
      (∀ m : ℕ, m < n → x.coeff m = 0) ∧
        (∀ i : ℕ, ∃ a : k, a ^ (p ^ n) = x.coeff (i + n)) := by
  classical
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨y, rfl⟩
    refine ⟨fun m hm ↦ mul_pow_charP_coeff_zero y hm, ?_⟩
    intro i
    exact ⟨y.coeff i, (mul_pow_charP_coeff_succ y).symm⟩
  · rintro ⟨hzero, hroot⟩
    let y : WittVector p k := .mk p (fun i ↦ Classical.choose (hroot i))
    refine ⟨y, ?_⟩
    apply WittVector.ext
    intro m
    by_cases hm : m < n
    · rw [mul_pow_charP_coeff_zero y hm, hzero m hm]
    · rw [← Nat.sub_add_cancel (Nat.le_of_not_gt hm), mul_pow_charP_coeff_succ]
      exact Classical.choose_spec (hroot (m - n))

private theorem sub_coeff_eq_of_coeff_eq
    {x y z : WittVector p k} {n : ℕ}
    (h : ∀ i < n + 1, y.coeff i = z.coeff i) :
    (x - y).coeff n = (x - z).coeff n := by
  have hsub : ∀ i < n + 1, ((x - y) - (x - z)).coeff i = 0 := by
    have heq : (x - y) - (x - z) = z - y := by
      exact sub_sub_sub_cancel_left y z x
    rw [heq]
    exact le_coeff_eq_iff_le_sub_coeff_eq_zero.mp fun i hi => (h i hi).symm
  exact (le_coeff_eq_iff_le_sub_coeff_eq_zero.mpr hsub) n (Nat.lt_succ_self n)

/-- Witt vectors over a commutative ring of prime characteristic are complete
and Hausdorff for the ideal generated by `p`. Unlike the perfect-ring instance
in Mathlib, this assertion does not require surjectivity of Frobenius. -/
theorem isAdicComplete_span_p (p : ℕ) [Fact p.Prime]
    (k : Type u) [CommRing k] [CharP k p] :
    IsAdicComplete (Ideal.span {(p : WittVector p k)}) (WittVector p k) := by
  refine { haus' := ?_, prec' := ?_ }
  · intro x hx
    ext i
    have hmem : x ∈ (Ideal.span {(p : WittVector p k)}) ^ (i + 1) := by
      simpa only [smul_eq_mul, Ideal.mul_top, SModEq.zero] using hx (i + 1)
    simpa only [zero_coeff] using
      ((mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq x (i + 1)).mp hmem).1
        i (Nat.lt_succ_self i)
  · intro f hf
    have hmem : ∀ {m n : ℕ}, m ≤ n →
        f m - f n ∈ (Ideal.span {(p : WittVector p k)}) ^ m := by
      intro m n hmn
      simpa only [smul_eq_mul, Ideal.mul_top, SModEq.sub_mem] using hf hmn
    have hcoeff : ∀ {m n : ℕ}, m ≤ n →
        ∀ i < m, (f m).coeff i = (f n).coeff i := by
      intro m n hmn
      apply le_coeff_eq_iff_le_sub_coeff_eq_zero.mpr
      exact ((mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq _ m).mp
        (hmem hmn)).1
    -- The Cauchy condition stabilizes each finite prefix.
    let w : WittVector p k := .mk p (fun i => (f (i + 1)).coeff i)
    have hw : ∀ n i, i < n → w.coeff i = (f n).coeff i := by
      intro n i hi
      exact hcoeff (Nat.succ_le_of_lt hi) i (Nat.lt_succ_self i)
    refine ⟨w, ?_⟩
    intro n
    simp only [smul_eq_mul, Ideal.mul_top, SModEq.sub_mem]
    apply (mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq (f n - w) n).mpr
    constructor
    · apply le_coeff_eq_iff_le_sub_coeff_eq_zero.mp
      intro i hi
      exact (hw n i hi).symm
    · intro i
      -- At this precision the difference agrees with one already in `(p)^n`.
      have hni : n ≤ i + n + 1 :=
        Nat.le_trans (Nat.le_add_left n i) (Nat.le_succ (i + n))
      have heq := sub_coeff_eq_of_coeff_eq (x := f n) (n := i + n) (hw (i + n + 1))
      rw [heq]
      exact ((mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq
        (f n - f (i + n + 1)) n).mp (hmem hni)).2 i

end WittVector
