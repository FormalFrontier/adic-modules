/-!
# Multivariate polynomial values and secant matrices on ideal neighborhoods

Let `P` have coefficients in a commutative semiring `C`, evaluated through a homomorphism
`φ : C →+* R` into a commutative ring. If `I ≤ Ideal.jacobson ⊥` and each coordinate
difference `b i - a i` with `i ∈ P.vars` belongs to `Ideal.span {P.eval₂ φ a} * I`, then
the values at `b` and `a` are associated in `R`. Coordinates not occurring in `P` are
unrestricted.

For the association result there is no finiteness condition on the variable type.
The target points need not
belong to the image of the coefficient map. Zero values and zero divisors are allowed;
no Henselian or completeness hypothesis is used.

For finitely many variables, a family of polynomials also admits a secant matrix
between any two points `b` and `c` whose displacements from `a` lie in
`Ideal.span {d} * I`. Its entries are the partial derivatives evaluated at `a`,
up to `d` times an `I`-valued matrix. The row type is arbitrary.

## Proof and references

The coordinate congruences on `P.vars` give equal evaluations in the quotient by
`Ideal.span {P.eval₂ φ a} * I`, using Mathlib's quotient, support-local evaluation-congruence
and evaluation-composition APIs. The resulting value congruence is an application of
`Polynomial.associated_eval_of_sub_mem_span_mul` to `Polynomial.X`. Thus all association
and Jacobson-radical reasoning is supplied by the scalar evaluation theorem in
`AdicModules.Polynomial.Evaluation`.

The secant result uses constant/addition/multiplication-by-variable induction,
tracking both value congruences and the derivative congruence of a secant row.
`Ideal.mem_span_singleton_mul` extracts the correction entries without cancelling `d`.
-/

@[expose] public section

universe uσ uC uR
universe uτ

namespace MvPolynomial

variable {σ : Type uσ} {C : Type uC} {R : Type uR} [CommSemiring C] [CommRing R]

/-- A multivariate polynomial's values are associated if each displacement in a coordinate
occurring in the polynomial belongs to the product of the ideal generated by its value at
`a` with an ideal in the Jacobson radical of the target ring.

The points are arbitrary target points, the variable type is unrestricted, and the
value at `a` may be zero or a zero divisor. This uses
`Polynomial.associated_eval_of_sub_mem_span_mul` with the scalar polynomial `X`. -/
theorem associated_eval₂_of_sub_mem_span_mul (I : Ideal R)
    (hI : I ≤ Ideal.jacobson (⊥ : Ideal R)) (φ : C →+* R) (P : MvPolynomial σ C)
    (a b : σ → R)
    (hab : ∀ i ∈ P.vars, b i - a i ∈ Ideal.span {P.eval₂ φ a} * I) :
    Associated (P.eval₂ φ b) (P.eval₂ φ a) := by
  let J : Ideal R := Ideal.span {P.eval₂ φ a} * I
  let q : R →+* R ⧸ J := Ideal.Quotient.mk J
  have hvalue : q (P.eval₂ φ b) = q (P.eval₂ φ a) := by
    rw [eval₂_comp_left q φ b P, eval₂_comp_left q φ a P]
    exact eval₂Hom_congr' rfl (fun i hi _ => Ideal.Quotient.eq.mpr (hab i hi)) rfl
  have hsub : P.eval₂ φ b - P.eval₂ φ a ∈ Ideal.span {P.eval₂ φ a} * I :=
    Ideal.Quotient.eq.mp hvalue
  simpa only [Polynomial.eval_X] using
    Polynomial.associated_eval_of_sub_mem_span_mul I hI (Polynomial.X : Polynomial R)
      (P.eval₂ φ a) (P.eval₂ φ b) (by simpa only [Polynomial.eval_X] using hsub)


private theorem exists_eval₂_sub_eq_sum [Fintype σ] (φ : C →+* R)
    (a b c : σ → R) (J : Ideal R)
    (hb : ∀ i, b i - a i ∈ J) (hc : ∀ i, c i - a i ∈ J)
    (P : MvPolynomial σ C) :
    P.eval₂ φ b - P.eval₂ φ a ∈ J ∧
      P.eval₂ φ c - P.eval₂ φ a ∈ J ∧
      ∃ q : σ → R, P.eval₂ φ b - P.eval₂ φ c = ∑ i, q i * (b i - c i) ∧
        ∀ i, q i - (pderiv i P).eval₂ φ a ∈ J := by
  classical
  induction P using MvPolynomial.induction_on with
  | C r =>
      refine ⟨?_, ?_, (fun _ => 0), ?_, ?_⟩ <;> simp
  | add P Q hP hQ =>
      rcases hP with ⟨hPb, hPc, q, hq, hqJ⟩
      rcases hQ with ⟨hQb, hQc, r, hr, hrJ⟩
      refine ⟨?_, ?_, (fun i => q i + r i), ?_, ?_⟩
      · simpa only [eval₂_add, add_sub_add_comm] using J.add_mem hPb hQb
      · simpa only [eval₂_add, add_sub_add_comm] using J.add_mem hPc hQc
      · simp only [eval₂_add, add_mul, Finset.sum_add_distrib]
        rw [← hq, ← hr]
        ring
      · intro i
        simpa only [map_add, eval₂_add, add_sub_add_comm] using
          J.add_mem (hqJ i) (hrJ i)
  | mul_X P n hP =>
      rcases hP with ⟨hPb, hPc, q, hq, hqJ⟩
      refine ⟨?_, ?_, (fun i => b n * q i + P.eval₂ φ c * if i = n then 1 else 0),
        ?_, ?_⟩
      · simp only [eval₂_mul, eval₂_X]
        rw [show P.eval₂ φ b * b n - P.eval₂ φ a * a n =
          b n * (P.eval₂ φ b - P.eval₂ φ a) + P.eval₂ φ a * (b n - a n) by ring]
        exact J.add_mem (J.mul_mem_left _ hPb) (J.mul_mem_left _ (hb n))
      · simp only [eval₂_mul, eval₂_X]
        rw [show P.eval₂ φ c * c n - P.eval₂ φ a * a n =
          c n * (P.eval₂ φ c - P.eval₂ φ a) + P.eval₂ φ a * (c n - a n) by ring]
        exact J.add_mem (J.mul_mem_left _ hPc) (J.mul_mem_left _ (hc n))
      · calc
          (P * X n).eval₂ φ b - (P * X n).eval₂ φ c =
              b n * (P.eval₂ φ b - P.eval₂ φ c) + P.eval₂ φ c * (b n - c n) := by
            simp only [eval₂_mul, eval₂_X]
            ring
          _ = b n * (∑ i, q i * (b i - c i)) + P.eval₂ φ c * (b n - c n) := by
            rw [hq]
          _ = ∑ i, (b n * q i + P.eval₂ φ c * if i = n then 1 else 0) *
              (b i - c i) := by
            simp [add_mul, mul_assoc, ite_mul, Finset.sum_add_distrib, ← Finset.mul_sum]
      · intro i
        have hcorr :
            (q i * (b n - a n) + a n * (q i - (pderiv i P).eval₂ φ a)) +
              (if i = n then 1 else 0) * (P.eval₂ φ c - P.eval₂ φ a) ∈ J :=
          J.add_mem (J.add_mem (J.mul_mem_left _ (hb n))
            (J.mul_mem_left _ (hqJ i))) (J.mul_mem_left _ hPc)
        have hid : b n * q i + P.eval₂ φ c * (if i = n then 1 else 0) -
            (pderiv i (P * X n)).eval₂ φ a =
            (q i * (b n - a n) + a n * (q i - (pderiv i P).eval₂ φ a)) +
              (if i = n then 1 else 0) * (P.eval₂ φ c - P.eval₂ φ a) := by
          simp only [pderiv_mul, eval₂_add, eval₂_mul, eval₂_X, pderiv_X]
          by_cases h : i = n
          · subst i
            simp; ring
          · simp [h, Ne.symm h]; ring
        rw [hid]
        exact hcorr

/-- A family of polynomial differences is a derivative matrix at `a`, corrected by
`d` times an `I`-valued matrix, applied to `b - c`.

Both `b` and `c` may move from `a`; only the variable type must be finite. To obtain
an `I`-valued correction matrix, use `obtain ⟨E, hE, hsecant⟩ :=
exists_eval₂_sub_eq_mulVec_of_sub_mem_span_mul φ F a b c d I hb hc`.
No regularity of `d` or injectivity of `φ` is required.
For example, over `ZMod 256`, take `I = (2)`, `d = 4`, `F = (XY + Y, 2Y²)`,
`a = c = (0, 1)`, and `b = (8, 9)`. The correction matrix can be
`E = [[2, 0], [0, 4]]`, although `d` is a zero divisor. As a moved-center example,
over `𝔽₃[[s,t]]` take `F = XY + Y`, `a = (s,t)`, `c = (s+s²,t)`,
`b = (s+s²,t+st)`, `d = s`, and `I = (s,t)`: the row `E = (0,s)` works. -/
theorem exists_eval₂_sub_eq_mulVec_of_sub_mem_span_mul
    {τ : Type uτ} [Fintype σ] (φ : C →+* R) (F : τ → MvPolynomial σ C)
    (a b c : σ → R) (d : R) (I : Ideal R)
    (hb : ∀ i, b i - a i ∈ Ideal.span {d} * I)
    (hc : ∀ i, c i - a i ∈ Ideal.span {d} * I) :
    ∃ E : Matrix τ σ R,
      (∀ j i, E j i ∈ I) ∧
      (fun j => (F j).eval₂ φ b - (F j).eval₂ φ c) =
        (Matrix.of (fun j i => (pderiv i (F j)).eval₂ φ a) + d • E).mulVec
          (fun i => b i - c i) := by
  classical
  have hrow (j : τ) : ∃ q : σ → R,
      (F j).eval₂ φ b - (F j).eval₂ φ c = ∑ i, q i * (b i - c i) ∧
      ∀ i, q i - (pderiv i (F j)).eval₂ φ a ∈ Ideal.span {d} * I :=
    (exists_eval₂_sub_eq_sum φ a b c (Ideal.span {d} * I) hb hc (F j)).2.2
  choose q hq hqJ using hrow
  have he (j : τ) (i : σ) :
      ∃ e ∈ I, d * e = q j i - (pderiv i (F j)).eval₂ φ a :=
    Ideal.mem_span_singleton_mul.mp (hqJ j i)
  choose E hE hEq using he
  refine ⟨E, hE, ?_⟩
  funext j
  rw [Matrix.mulVec_apply_eq_sum]
  change (F j).eval₂ φ b - (F j).eval₂ φ c =
    ∑ i, ((pderiv i (F j)).eval₂ φ a + d * E j i) * (b i - c i)
  rw [hq j]
  apply Finset.sum_congr rfl
  intro i _
  have hentry : (pderiv i (F j)).eval₂ φ a + d * E j i = q j i := by
    rw [hEq j i]
    ring
  rw [hentry]

/-- On a coordinatewise `(d) I` neighborhood, the error of linearization at `a`
lies in `(d²) I²`. The scalar is arbitrary, and only the column type is finite. -/
theorem eval₂_sub_sub_mulVec_mem_span_sq_mul
    {τ : Type uτ} [Fintype σ] (φ : C →+* R) (F : τ → MvPolynomial σ C)
    (a b : σ → R) (d : R) (I : Ideal R)
    (hb : ∀ i, b i - a i ∈ Ideal.span {d} * I) :
    ∀ j, (F j).eval₂ φ b - (F j).eval₂ φ a -
      (Matrix.of (fun j i => (pderiv i (F j)).eval₂ φ a)).mulVec
        (fun i => b i - a i) j ∈ Ideal.span {d ^ 2} * I ^ 2 := by
  classical
  obtain ⟨E, hEI, hE⟩ :=
    exists_eval₂_sub_eq_mulVec_of_sub_mem_span_mul φ F a b a d I hb
      (fun i => by simp)
  choose z hzI hz using fun i => Ideal.mem_span_singleton_mul.mp (hb i)
  intro j
  refine Ideal.mem_span_singleton_mul.mpr ⟨∑ i, E j i * z i, ?_, ?_⟩
  · exact (I ^ 2).sum_mem fun i _ => by
      simpa only [pow_two] using Ideal.mul_mem_mul (hEI j i) (hzI i)
  · have hrow := congrFun hE j
    change (F j).eval₂ φ b - (F j).eval₂ φ a =
      ∑ i, ((pderiv i (F j)).eval₂ φ a + d * E j i) * (b i - a i) at hrow
    change d ^ 2 * (∑ i, E j i * z i) =
      (F j).eval₂ φ b - (F j).eval₂ φ a -
        ∑ i, (pderiv i (F j)).eval₂ φ a * (b i - a i)
    rw [hrow, ← Finset.sum_sub_distrib, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [← hz i]
    ring

end MvPolynomial
