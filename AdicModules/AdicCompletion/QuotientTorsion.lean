module

public import GroupTheory.QuotientTorsion
public import Mathlib.Algebra.Category.ModuleCat.Limits
public import Mathlib.CategoryTheory.Functor.OfSequence
public import Mathlib.RingTheory.AdicCompletion.Basic
import Mathlib.RingTheory.Int.Basic

/-!
# Scalar-power torsion sections and adic completion

Let `V` be an additive commutative group, `L` a subgroup, and `ℓ : ℤ` a scalar
whose action on `V` is bijective. Compatible sections of the kernels of `ℓ ^ n`
on `V / L`, with successor maps multiplication by `ℓ`, identify linearly with
the completion of `L` at the ideal generated by `ℓ`.

The finite coordinates use Group Theory's quotient-torsion equivalence, the
same-element identification of signed and absolute-value kernels, and
representative-preserving quotient transports. Multiplication by
`(if ℓ < 0 then -1 else 1) ^ n` corrects the sign at level `n`. Indeed, writing
`a = ℓ.natAbs` and `ε = if ℓ < 0 then -1 else 1`, one has `ℓ = ε * a` and
`ℓ ^ n = ε ^ n * a ^ n`; `ε` is a unit even when `ℓ = 0`. Thus a coordinate
represented by `v` maps to the class of `ℓ ^ n • v`, not `ℓ.natAbs ^ n • v`.
The source is Mathlib's `ModuleCat.sectionsSubmodule` of `Functor.ofOpSequence`;
the target is Mathlib's `AdicCompletion`.

## Limitations

There are no finiteness, freeness, primality, positivity or nonzero assumptions.
For `ℓ = 0`, ambient bijectivity forces `V` to be subsingleton; for `ℓ = ±1`,
the stages are zero and the ideal is the unit ideal.

## References

The finite quotient identification and its scalar-transition law are provided
by `GroupTheory.QuotientTorsion`, using Mathlib's snake lemma. The present
construction uses Mathlib's sequence functors, sections and adic-completion lift.
-/

@[expose] public section

open CategoryTheory

universe u

namespace QuotientAddGroup

variable {V : Type u} [AddCommGroup V] (L : AddSubgroup V) (ℓ : ℤ)

-- These notations expand to stock constructions, including in public signatures.
local notation "I" => Ideal.span (Set.singleton ℓ)
local notation "N" n => (I ^ n • ⊤ : Submodule ℤ L)
local notation "Q" => Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (L ⧸ N n))
  (fun n => ModuleCat.ofHom (Submodule.factorPowSucc I L n))

private theorem signed_kernel_iff (n : ℕ) (x : V ⧸ L) :
    (ℓ ^ n) • x = 0 ↔ (ℓ.natAbs ^ n) • x = 0 := by
  simpa only [Int.natAbs_pow] using (natAbs_nsmul_eq_zero (n := ℓ ^ n) (a := x)).symm

private def signedKernelEquiv (n : ℕ) :
    (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n)).ker ≃ₗ[ℤ]
      (nsmulAddMonoidHom (α := V ⧸ L) (ℓ.natAbs ^ n)).ker :=
  AddEquiv.toIntLinearEquiv
    { toFun := fun x => ⟨x.val, (signed_kernel_iff L ℓ n x.val).mp x.property⟩
      invFun := fun x => ⟨x.val, (signed_kernel_iff L ℓ n x.val).mpr x.property⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl }

private theorem natAbs_pow_bijective
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) (n : ℕ) :
    Function.Bijective (nsmulAddMonoidHom (α := V) (ℓ.natAbs ^ n)) := by
  change Function.Bijective (fun x : V => ℓ • x) at h
  have hnat : Function.Bijective (fun x : V => ℓ.natAbs • x) := by
    cases ℓ with
    | ofNat a =>
      change Function.Bijective (fun x : V => (a : ℤ) • x) at h
      change Function.Bijective (fun x : V => a • x)
      simpa only [natCast_zsmul] using h
    | negSucc a =>
      simpa only [Function.comp_def, negSucc_zsmul, neg_neg, Int.natAbs_negSucc]
        using (neg_bijective.comp h)
  change Function.Bijective (fun x : V => (ℓ.natAbs ^ n) • x)
  simpa only [smul_iterate] using hnat.iterate n

private theorem range_eq_principal_power (n : ℕ) :
    ((nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range).toIntSubmodule = N n := by
  change _ = ((Ideal.span ({ℓ} : Set ℤ)) ^ n • ⊤ : Submodule ℤ L)
  rw [← Int.span_natAbs ℓ, Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul]
  ext x
  change (∃ y : L, (ℓ.natAbs ^ n) • y = x) ↔ _
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    ← Int.natCast_pow, natCast_zsmul]

private def signUnit : ℤˣ := if ℓ < 0 then -1 else 1

private theorem signUnit_mul_natAbs :
    (signUnit ℓ : ℤ) * (ℓ.natAbs : ℤ) = ℓ := by
  by_cases hℓ : ℓ < 0
  · simp [signUnit, hℓ, abs_of_neg hℓ]
  · simp [signUnit, hℓ, abs_of_nonneg (le_of_not_gt hℓ)]

private theorem signUnit_pow_mul_natAbs (n : ℕ) :
    (↑(signUnit ℓ ^ n) : ℤ) * (↑(ℓ.natAbs ^ n) : ℤ) = ℓ ^ n := by
  rw [Units.val_pow_eq_pow_val, Nat.cast_pow, ← mul_pow, signUnit_mul_natAbs]

private noncomputable def coordinateEquiv
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) (n : ℕ) :
    (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n)).ker ≃ₗ[ℤ] L ⧸ N n :=
  let g : (nsmulAddMonoidHom (α := V ⧸ L) (ℓ.natAbs ^ n)).ker ≃ₗ[ℤ]
      L ⧸ (nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range :=
    (nsmulTorsionEquivQuotient L (ℓ.natAbs ^ n)
      (natAbs_pow_bijective ℓ h n)).toIntLinearEquiv
  let t : (L ⧸ (nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range) ≃ₗ[ℤ]
      L ⧸ (nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range :=
    LinearEquiv.smulOfUnit (signUnit ℓ ^ n)
  let q : (L ⧸ (nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range) ≃ₗ[ℤ] L ⧸ N n :=
    (Submodule.quotEquivOfEq
      ((nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range).toIntSubmodule
      (N n) (range_eq_principal_power L ℓ n)).toAddEquiv.toIntLinearEquiv
  (signedKernelEquiv L ℓ n).trans (g.trans (t.trans q))

private theorem coordinateEquiv_apply
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) (n : ℕ)
    (x : (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n)).ker)
    (v : V) (hv : (ℓ ^ n) • v ∈ L) (hx : (x : V ⧸ L) = (v : V ⧸ L)) :
    coordinateEquiv L ℓ h n x = (N n).mkQ ⟨(ℓ ^ n) • v, hv⟩ := by
  have hsmul : (↑(signUnit ℓ ^ n) : ℤ) • ((ℓ.natAbs ^ n) • v) = (ℓ ^ n) • v := by
    rw [← natCast_zsmul, ← mul_smul, signUnit_pow_mul_natAbs]
  -- Inverting the sign unit obtains membership without an extra hypothesis.
  have hnat : (ℓ.natAbs ^ n) • v ∈ L := by
    have hm := L.zsmul_mem hv (↑((signUnit ℓ ^ n)⁻¹) : ℤ)
    rw [← hsmul, ← mul_smul, Units.inv_mul, one_smul] at hm
    exact hm
  have hs : signedKernelEquiv L ℓ n x =
      ⟨(v : V ⧸ L), by simpa using (eq_zero_iff ((ℓ.natAbs ^ n) • v)).mpr hnat⟩ :=
    Subtype.ext hx
  change Submodule.quotEquivOfEq
      ((nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range).toIntSubmodule
      (N n) (range_eq_principal_power L ℓ n)
      ((↑(signUnit ℓ ^ n) : ℤ) •
        nsmulTorsionEquivQuotient L (ℓ.natAbs ^ n) (natAbs_pow_bijective ℓ h n)
          (signedKernelEquiv L ℓ n x)) = _
  rw [hs, nsmulTorsionEquivQuotient_apply_mk]
  change Submodule.quotEquivOfEq
      ((nsmulAddMonoidHom (α := L) (ℓ.natAbs ^ n)).range).toIntSubmodule
      (N n) (range_eq_principal_power L ℓ n)
      (Submodule.Quotient.mk
        ((↑(signUnit ℓ ^ n) : ℤ) • (⟨(ℓ.natAbs ^ n) • v, hnat⟩ : L))) = _
  rw [Submodule.quotEquivOfEq_mk]
  exact congrArg (N n).mkQ (Subtype.ext hsmul)

private theorem coordinateEquiv_succ
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) (n : ℕ) :
    ((Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx)))))).map (homOfLE (n.le_add_right 1)).op ≫
        (coordinateEquiv L ℓ h n).toModuleIso.hom =
      (coordinateEquiv L ℓ h (n + 1)).toModuleIso.hom ≫
        (Q).map (homOfLE (n.le_add_right 1)).op := by
  rw [Functor.ofOpSequence_map_homOfLE_succ, Functor.ofOpSequence_map_homOfLE_succ]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))).ker at x
  let y : (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n)).ker :=
    ⟨ℓ • (x : V ⧸ L), by
      change (ℓ ^ n) • (ℓ • (x : V ⧸ L)) = 0
      rw [← mul_smul, ← pow_succ]
      exact x.property⟩
  change coordinateEquiv L ℓ h n y =
    Submodule.factorPowSucc I L n (coordinateEquiv L ℓ h (n + 1) x)
  -- Both paths send a representative `v` to the class of `ℓ ^ (n + 1) • v`.
  obtain ⟨v, hv⟩ := mk'_surjective L (x : V ⧸ L)
  have hvL : (ℓ ^ (n + 1)) • v ∈ L := by
    apply (eq_zero_iff _).mp
    rw [mk_zsmul]
    exact (congrArg (fun q : V ⧸ L => (ℓ ^ (n + 1)) • q) hv).trans x.property
  have hvLn : (ℓ ^ n) • (ℓ • v) ∈ L := by
    simpa only [← mul_smul, ← pow_succ] using hvL
  have hy : (y : V ⧸ L) = ((ℓ • v : V) : V ⧸ L) := by
    change ℓ • (x : V ⧸ L) = ((ℓ • v : V) : V ⧸ L)
    rw [mk_zsmul]
    exact congrArg (fun q : V ⧸ L => ℓ • q) hv.symm
  rw [coordinateEquiv_apply L ℓ h n y (ℓ • v) hvLn hy,
    coordinateEquiv_apply L ℓ h (n + 1) x v hvL hv.symm, Submodule.factor_mk]
  apply congrArg (N n).mkQ
  apply Subtype.ext
  change (ℓ ^ n) • (ℓ • v) = (ℓ ^ (n + 1)) • v
  rw [← mul_smul, ← pow_succ]

private noncomputable def coordinateNatTrans
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) : (Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx))))) ⟶ Q :=
  NatTrans.ofOpSequence
    (fun n => (coordinateEquiv L ℓ h n).toModuleIso.hom)
    (coordinateEquiv_succ L ℓ h)

private noncomputable def coordinateIso
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) : (Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx))))) ≅ Q :=
  NatIso.ofComponents (fun n => (coordinateEquiv L ℓ h n.unop).toModuleIso)
    (fun f => (coordinateNatTrans L ℓ h).naturality f)

private noncomputable def sectionsCongr {F G : ℕᵒᵖ ⥤ ModuleCat.{u} ℤ}
    (e : F ≅ G) : ModuleCat.sectionsSubmodule F ≃ₗ[ℤ] ModuleCat.sectionsSubmodule G :=
  AddEquiv.toIntLinearEquiv
  { toFun := fun s => ⟨fun n => e.hom.app n (s.val n), by
      intro i j f
      change G.map f (e.hom.app i (s.val i)) = e.hom.app j (s.val j)
      have hs : F.map f (s.val i) = s.val j := s.property f
      have hn := ConcreteCategory.congr_hom (e.hom.naturality f) (s.val i)
      simpa only [ModuleCat.comp_apply, hs] using hn.symm⟩
    invFun := fun s => ⟨fun n => e.inv.app n (s.val n), by
      intro i j f
      change F.map f (e.inv.app i (s.val i)) = e.inv.app j (s.val j)
      have hs : G.map f (s.val i) = s.val j := s.property f
      have hn := ConcreteCategory.congr_hom (e.inv.naturality f) (s.val i)
      simpa only [ModuleCat.comp_apply, hs] using hn.symm⟩
    left_inv := fun s => by
      apply Subtype.ext
      funext n
      exact ConcreteCategory.congr_hom (congrArg (fun a => a.app n) e.hom_inv_id) (s.val n)
    right_inv := fun s => by
      apply Subtype.ext
      funext n
      exact ConcreteCategory.congr_hom (congrArg (fun a => a.app n) e.inv_hom_id) (s.val n)
    map_add' := fun s t => by
      apply Subtype.ext
      funext n
      exact (e.hom.app n).hom.map_add (s.val n) (t.val n) }

private def sectionEval (n : ℕ) : ModuleCat.sectionsSubmodule Q →ₗ[ℤ] L ⧸ N n where
  toFun s := s.val (Opposite.op n)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private theorem quotientSequence_map_apply {m n : ℕ} (hmn : m ≤ n) (x : L ⧸ N n) :
    (Q).map (homOfLE hmn).op x = AdicCompletion.transitionMap I L hmn x := by
  have hmap : (Q).map (homOfLE hmn).op =
      ModuleCat.ofHom (AdicCompletion.transitionMap I L hmn) := by
    clear x
    induction n, hmn using Nat.le_induction with
    | base =>
        apply Eq.trans ((Q).map_id (Opposite.op m))
        apply ModuleCat.hom_ext
        change LinearMap.id = Submodule.factor (Submodule.pow_smul_top_le I L le_rfl)
        simp only [Submodule.factor, Submodule.mapQ_id]
    | succ n hmn ih =>
        erw [← homOfLE_comp hmn n.le_succ, op_comp, Functor.map_comp,
          Functor.ofOpSequence_map_homOfLE_succ, ih]
        exact congrArg ModuleCat.ofHom
          (Submodule.factor_comp (Submodule.pow_smul_top_le I L n.le_succ)
            (Submodule.pow_smul_top_le I L hmn))
  exact ConcreteCategory.congr_hom hmap x

private theorem sectionEval_compatible {m n : ℕ} (hmn : m ≤ n) :
    AdicCompletion.transitionMap I L hmn ∘ₗ sectionEval L ℓ n = sectionEval L ℓ m := by
  apply LinearMap.ext
  intro s
  change AdicCompletion.transitionMap I L hmn (s.val (Opposite.op n)) =
    s.val (Opposite.op m)
  exact (quotientSequence_map_apply L ℓ hmn (s.val (Opposite.op n))).symm.trans
    (s.property (homOfLE hmn).op)

private theorem completion_section (c : AdicCompletion I L) :
    (fun n : ℕᵒᵖ => AdicCompletion.eval I L n.unop c) ∈ ModuleCat.sectionsSubmodule Q := by
  intro i j f
  change (Q).map f (AdicCompletion.eval I L i.unop c) =
    AdicCompletion.eval I L j.unop c
  have hji : j.unop ≤ i.unop := leOfHom f.unop
  have hf : f = (homOfLE hji).op := Subsingleton.elim _ _
  rw [hf, quotientSequence_map_apply L ℓ hji]
  exact AdicCompletion.transitionMap_comp_eval_apply I L hji c

private noncomputable def completionSectionsEquiv :
    ModuleCat.sectionsSubmodule Q ≃ₗ[ℤ] AdicCompletion I L where
  toFun := AdicCompletion.lift I (sectionEval L ℓ) (sectionEval_compatible L ℓ)
  invFun c := ⟨fun n => AdicCompletion.eval I L n.unop c, completion_section L ℓ c⟩
  left_inv := by
    intro s
    apply Subtype.ext
    funext n
    exact AdicCompletion.eval_lift_apply I (sectionEval L ℓ) (sectionEval_compatible L ℓ)
      n.unop s
  right_inv := by
    intro c
    apply AdicCompletion.ext
    intro n
    exact AdicCompletion.eval_lift_apply I (sectionEval L ℓ) (sectionEval_compatible L ℓ)
      n ⟨fun n => AdicCompletion.eval I L n.unop c, completion_section L ℓ c⟩
  map_add' := (AdicCompletion.lift I (sectionEval L ℓ) (sectionEval_compatible L ℓ)).map_add
  map_smul' := (AdicCompletion.lift I (sectionEval L ℓ) (sectionEval_compatible L ℓ)).map_smul

/-- Compatible signed scalar-power torsion sections of `V / L` identify linearly
with the `span {ℓ}`-adic completion of `L`, when multiplication by `ℓ` is bijective
on `V`. At level `n` the coordinate represented by `v` is sent to `[ℓ ^ n • v]`.
The construction composes the natural isomorphism of coordinate diagrams with
Mathlib's completion lift. -/
@[no_expose] noncomputable def scalarTorsionEquivAdicCompletion
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ)) :
    ModuleCat.sectionsSubmodule (Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx))))) ≃ₗ[ℤ] AdicCompletion I L :=
  (sectionsCongr (coordinateIso L ℓ h)).trans (completionSectionsEquiv L ℓ)

/-- Evaluation of the comparison on a coordinate represented by `v` is the class
of the signed multiple `ℓ ^ n • v` in the corresponding principal-power quotient. -/
theorem scalarTorsionEquivAdicCompletion_eval
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ))
    (s : ModuleCat.sectionsSubmodule (Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx)))))) (n : ℕ) (v : V) (hv : (ℓ ^ n) • v ∈ L)
    (hs : Subtype.val (s.val (Opposite.op n)) = (v : V ⧸ L)) :
    AdicCompletion.eval I L n (scalarTorsionEquivAdicCompletion L ℓ h s) =
      (N n).mkQ ⟨(ℓ ^ n) • v, hv⟩ := by
  change (AdicCompletion.eval I L n ∘ₗ
      AdicCompletion.lift I (sectionEval L ℓ) (sectionEval_compatible L ℓ))
      (sectionsCongr (coordinateIso L ℓ h) s) = _
  rw [AdicCompletion.eval_lift]
  exact coordinateEquiv_apply L ℓ h n (s.val (Opposite.op n)) v hv hs

/-- A coordinate of the inverse comparison is represented by `v` precisely when
the corresponding completion residue is the class of `ℓ ^ n • v`. -/
theorem scalarTorsionEquivAdicCompletion_symm_coordinate_iff
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ))
    (c : AdicCompletion I L) (n : ℕ) (v : V) (hv : (ℓ ^ n) • v ∈ L) :
    Subtype.val (((scalarTorsionEquivAdicCompletion L ℓ h).symm c).val (Opposite.op n)) =
        (v : V ⧸ L) ↔
      AdicCompletion.eval I L n c = (N n).mkQ ⟨(ℓ ^ n) • v, hv⟩ := by
  constructor
  · intro hs
    have heval := scalarTorsionEquivAdicCompletion_eval L ℓ h
      ((scalarTorsionEquivAdicCompletion L ℓ h).symm c) n v hv hs
    simpa only [LinearEquiv.apply_symm_apply] using heval
  · intro heval
    let x : (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n)).ker :=
      ⟨(v : V ⧸ L), by
        change (ℓ ^ n) • (v : V ⧸ L) = 0
        rw [← mk_zsmul]
        exact (eq_zero_iff _).mpr hv⟩
    change Subtype.val ((coordinateEquiv L ℓ h n).symm (AdicCompletion.eval I L n c)) =
      Subtype.val x
    apply congrArg Subtype.val
    apply (coordinateEquiv L ℓ h n).injective
    rw [LinearEquiv.apply_symm_apply, coordinateEquiv_apply L ℓ h n x v hv rfl]
    exact heval

/-- A section represents the image of `l : L` in the completion exactly when each
of its signed coordinates has the same residue as `l`. This criterion only uses
representatives in `V` and quotient maps on `L`. -/
theorem scalarTorsionEquivAdicCompletion_eq_of_iff
    (h : Function.Bijective (zsmulAddGroupHom (α := V) ℓ))
    (s : ModuleCat.sectionsSubmodule (Functor.ofOpSequence
  (X := fun n => ModuleCat.of ℤ (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))))
  (fun n => ModuleCat.ofHom
    (AddMonoidHom.toIntLinearMap
      (AddMonoidHom.restrict
        (show Set.MapsTo (zsmulAddGroupHom (α := V ⧸ L) ℓ)
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ (n + 1))))
          (AddMonoidHom.ker (zsmulAddGroupHom (α := V ⧸ L) (ℓ ^ n))) from by
          intro x hx
          change (ℓ ^ n) • (ℓ • x) = 0
          rw [← mul_smul, ← pow_succ]
          exact hx)))))) (l : L) :
    scalarTorsionEquivAdicCompletion L ℓ h s = AdicCompletion.of I L l ↔
      ∀ (n : ℕ) (v : V) (hv : (ℓ ^ n) • v ∈ L),
        Subtype.val (s.val (Opposite.op n)) = (v : V ⧸ L) →
          (N n).mkQ ⟨(ℓ ^ n) • v, hv⟩ = (N n).mkQ l := by
  constructor
  · intro hs n v hv hcoord
    rw [← scalarTorsionEquivAdicCompletion_eval L ℓ h s n v hv hcoord, hs,
      AdicCompletion.eval_of]
  · intro hs
    apply AdicCompletion.ext
    intro n
    change AdicCompletion.eval I L n (scalarTorsionEquivAdicCompletion L ℓ h s) =
      AdicCompletion.eval I L n (AdicCompletion.of I L l)
    obtain ⟨v, hv⟩ := mk'_surjective L (Subtype.val (s.val (Opposite.op n)))
    have hvL : (ℓ ^ n) • v ∈ L := by
      apply (eq_zero_iff _).mp
      rw [mk_zsmul]
      exact (congrArg (fun x : V ⧸ L => (ℓ ^ n) • x) hv).trans
        (s.val (Opposite.op n)).property
    rw [scalarTorsionEquivAdicCompletion_eval L ℓ h s n v hvL hv.symm,
      AdicCompletion.eval_of]
    exact hs n v hvL hv.symm

end QuotientAddGroup
