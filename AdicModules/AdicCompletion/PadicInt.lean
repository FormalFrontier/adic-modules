/-!
# Integer adic completions and p-adic integers

The completion of `ℤ` for the ideal generated by a prime `p` is canonically isomorphic to
`ℤ_[p]` as a `ℤ`-algebra. The comparison is normalized by every residue modulo `p ^ n`,
including `n = 0`, and sends the canonical image of an integer to its p-adic cast.

`AdicCompletion.evalZModPow` expresses the existing completion evaluation in `ZMod`
coordinates for any natural generator, including zero and one. It uses
`AdicCompletion.evalₐ`, transport along `Ideal.span_singleton_pow`, and
`Int.quotientSpanNatEquivZMod`; there is no additional quotient or limit carrier.

The comparison uses the residue-limit universal properties formalized in Mathlib by
Kenny Lau, Judith Ludwig, Christian Merten and Jiedong Jiang for adic completions, and
Johan Commelin and Robert Y. Lewis for p-adic integers. Anne Baanen's quotient equivalence supplies
the finite-level identification. Separately, `PadicInt.uniformContinuous_intCast_adic`
and `PadicInt.intCastAdicCLM` give the canonical integer cast its adic source
uniformity and the original p-adic norm target. These do not identify either completion
carrier, and leave the original additive and integer-module structures unchanged.

## References

* The inverse-limit description of the p-adic integers is formalized in Mathlib's
  `NumberTheory/Padics/RingHoms`.
* The ideal-adic inverse limit and its ring-valued universal property are formalized in
  Mathlib's `RingTheory/AdicCompletion/Basic` and `RingTheory/AdicCompletion/Algebra`.
-/

@[expose] public section

namespace AdicCompletion

/-- Evaluation of the completion of `ℤ` at `(m)` modulo `m ^ n`.
This is the usual completion evaluation followed by the integer quotient equivalence.
No primality or nonzero-generator hypothesis is needed. -/
noncomputable def evalZModPow (m n : ℕ) :
    AdicCompletion (Ideal.span {(m : ℤ)}) ℤ →+* ZMod (m ^ n) :=
  (Int.quotientSpanNatEquivZMod (m ^ n)).toRingHom.comp
    ((Ideal.quotEquivOfEq (show (Ideal.span {(m : ℤ)}) ^ n =
      Ideal.span {((m ^ n : ℕ) : ℤ)} by
        rw [Ideal.span_singleton_pow, Nat.cast_pow])).toRingHom.comp
      (evalₐ (Ideal.span {(m : ℤ)}) n).toRingHom)

/-- The residue of a canonical integer in the completion is its integer cast. -/
@[simp]
theorem evalZModPow_of (m n : ℕ) (a : ℤ) :
    evalZModPow m n (of (Ideal.span {(m : ℤ)}) ℤ a) = (a : ZMod (m ^ n)) := by
  simp [evalZModPow]

-- The stock finite-level transport, named only for the two universal-property proofs.
private noncomputable def quotientPowEquivZMod (m n : ℕ) :
    ℤ ⧸ (Ideal.span {(m : ℤ)}) ^ n ≃+* ZMod (m ^ n) :=
  (Ideal.quotEquivOfEq (show (Ideal.span {(m : ℤ)}) ^ n =
    Ideal.span {((m ^ n : ℕ) : ℤ)} by
      rw [Ideal.span_singleton_pow, Nat.cast_pow])).trans
    (Int.quotientSpanNatEquivZMod (m ^ n))

private theorem quotientPowEquivZMod_mk (m n : ℕ) (a : ℤ) :
    quotientPowEquivZMod m n (Ideal.Quotient.mk _ a) = (a : ZMod (m ^ n)) := by
  simp [quotientPowEquivZMod]

private theorem quotientPowEquivZMod_factor (m : ℕ) {i j : ℕ} (h : i ≤ j)
    (x : ℤ ⧸ (Ideal.span {(m : ℤ)}) ^ j) :
    quotientPowEquivZMod m i
        (Ideal.Quotient.factorPow (Ideal.span {(m : ℤ)}) h x) =
      ZMod.castHom (pow_dvd_pow m h) _ (quotientPowEquivZMod m j x) := by
  induction x using Quotient.inductionOn' with
  | h a =>
      change quotientPowEquivZMod m i (Ideal.Quotient.mk _ a) =
        ZMod.castHom (pow_dvd_pow m h) _
          (quotientPowEquivZMod m j (Ideal.Quotient.mk _ a))
      simp

private theorem quotientPowEquivZMod_eval (m n : ℕ)
    (x : AdicCompletion (Ideal.span {(m : ℤ)}) ℤ) :
    quotientPowEquivZMod m n (evalₐ (Ideal.span {(m : ℤ)}) n x) =
      evalZModPow m n x := rfl

/-- Completion coordinates commute with reduction between any two precisions. -/
theorem castHom_comp_evalZModPow (m i j : ℕ) (h : i ≤ j) :
    (ZMod.castHom (pow_dvd_pow m h) _).comp (evalZModPow m j) =
      evalZModPow m i := by
  ext x
  rw [RingHom.comp_apply, ← quotientPowEquivZMod_eval m j,
    ← quotientPowEquivZMod_factor m h, ← quotientPowEquivZMod_eval m i]
  apply congrArg (quotientPowEquivZMod m i)
  induction x using AdicCompletion.induction_on with
  | h f => simpa using Ideal.mk_eq_mk (Ideal.span {(m : ℤ)}) h f

variable (p : ℕ) [Fact p.Prime]

private theorem padicIntToCompletion_compat {i j : ℕ} (h : i ≤ j) :
    (Ideal.Quotient.factorPow (Ideal.span {(p : ℤ)}) h).comp
        ((quotientPowEquivZMod p j).symm.toRingHom.comp (PadicInt.toZModPow j)) =
      (quotientPowEquivZMod p i).symm.toRingHom.comp (PadicInt.toZModPow i) := by
  ext z
  apply (quotientPowEquivZMod p i).injective
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, quotientPowEquivZMod_factor, RingEquiv.apply_symm_apply]
  exact RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow i j h) z

private noncomputable def padicIntToCompletion :
    ℤ_[p] →+* AdicCompletion (Ideal.span {(p : ℤ)}) ℤ :=
  liftRingHom (Ideal.span {(p : ℤ)})
    (fun n => (quotientPowEquivZMod p n).symm.toRingHom.comp (PadicInt.toZModPow n))
    (padicIntToCompletion_compat p)

private theorem evalZModPow_padicIntToCompletion (n : ℕ) (z : ℤ_[p]) :
    evalZModPow p n (padicIntToCompletion p z) = PadicInt.toZModPow n z := by
  rw [← quotientPowEquivZMod_eval]
  have h := evalₐ_liftRingHom (Ideal.span {(p : ℤ)})
    (fun n => (quotientPowEquivZMod p n).symm.toRingHom.comp (PadicInt.toZModPow n))
    (padicIntToCompletion_compat p) n z
  exact (congrArg (quotientPowEquivZMod p n) h).trans
    ((quotientPowEquivZMod p n).apply_symm_apply _)

/-- The canonical `ℤ`-algebra equivalence between the `(p)`-adic completion of `ℤ` and
`ℤ_[p]`, characterized by all residue coordinates in `toZModPow_padicIntEquiv`. -/
noncomputable def padicIntEquiv :
    AdicCompletion (Ideal.span {(p : ℤ)}) ℤ ≃ₐ[ℤ] ℤ_[p] :=
  (RingEquiv.ofBijective (PadicInt.lift (castHom_comp_evalZModPow p)) (by
    constructor
    · intro x y h
      apply ext_evalₐ
      intro n
      apply (quotientPowEquivZMod p n).injective
      simpa only [quotientPowEquivZMod_eval, ← RingHom.comp_apply,
        PadicInt.lift_spec] using congrArg (PadicInt.toZModPow n) h
    · intro z
      refine ⟨padicIntToCompletion p z, ?_⟩
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      calc
        _ = evalZModPow p n (padicIntToCompletion p z) :=
          RingHom.congr_fun (PadicInt.lift_spec (castHom_comp_evalZModPow p) n) _
        _ = _ := evalZModPow_padicIntToCompletion p n z)).toIntAlgEquiv

/-- Every residue of the comparison is the corresponding completion coordinate. -/
@[simp]
theorem toZModPow_padicIntEquiv (n : ℕ)
    (x : AdicCompletion (Ideal.span {(p : ℤ)}) ℤ) :
    PadicInt.toZModPow n (padicIntEquiv p x) = evalZModPow p n x :=
  RingHom.congr_fun (PadicInt.lift_spec (castHom_comp_evalZModPow p) n) x

/-- The coordinate normalization as an equality of ring homomorphisms. -/
theorem toZModPow_comp_padicIntEquiv (n : ℕ) :
    (PadicInt.toZModPow n).comp (padicIntEquiv p).toRingEquiv.toRingHom =
      evalZModPow p n := by
  ext x
  exact toZModPow_padicIntEquiv p n x

/-- The inverse comparison recovers every p-adic residue as a completion coordinate. -/
@[simp]
theorem evalZModPow_padicIntEquiv_symm (n : ℕ) (z : ℤ_[p]) :
    evalZModPow p n ((padicIntEquiv p).symm z) = PadicInt.toZModPow n z := by
  rw [← toZModPow_padicIntEquiv, AlgEquiv.apply_symm_apply]

/-- The comparison sends the canonical image of an integer to its p-adic cast. -/
@[simp]
theorem padicIntEquiv_of (a : ℤ) :
    padicIntEquiv p (of (Ideal.span {(p : ℤ)}) ℤ a) = (a : ℤ_[p]) := by
  apply PadicInt.ext_of_toZModPow.mp
  intro n
  simp

/-- The inverse comparison sends an integer cast to its canonical completion image. -/
theorem padicIntEquiv_symm_intCast (a : ℤ) :
    (padicIntEquiv p).symm (a : ℤ_[p]) = of (Ideal.span {(p : ℤ)}) ℤ a := by
  apply (padicIntEquiv p).injective
  simp

end AdicCompletion

namespace PadicInt

/-- Integer casting is uniformly continuous from the `(p)`-adic module
uniformity to the existing norm uniformity on the p-adic integers. -/
theorem uniformContinuous_intCast_adic (p : ℕ) [Fact p.Prime] :
    @UniformContinuous ℤ ℤ_[p]
      ((Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ)
      (inferInstance : UniformSpace ℤ_[p]) (Int.castRingHom ℤ_[p]) := by
  let I : Ideal ℤ := Ideal.span {(p : ℤ)}
  let J : Ideal ℤ_[p] := Ideal.span {(p : ℤ_[p])}
  let : UniformSpace ℤ := I.adicModuleUniformSpace ℤ
  let : TopologicalSpace ℤ := (I.adicModuleUniformSpace ℤ).toTopologicalSpace
  let : IsUniformAddGroup ℤ := I.adicModuleUniformSpace_isUniformAddGroup ℤ
  have hmap : I.map (Int.castRingHom ℤ_[p]) = J := by
    simp [I, J, Ideal.map_span]
  exact IsAdic.uniformContinuous_of_map_le
    (I := I) (J := J)
    I.adicModuleUniformSpace_self_toTopologicalSpace
    (isAdic_span_p p) hmap.le

section AdicSource

variable (p : ℕ) [Fact p.Prime]

/-- The usual integer cast, with its original `ℤ`-linear map, is continuous for
the canonical `(p)`-adic source topology and the target norm topology. -/
noncomputable def intCastAdicCLM :
    @ContinuousLinearMap ℤ ℤ _ _ (RingHom.id ℤ) ℤ
      ((Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ).toTopologicalSpace _
      ℤ_[p] _ _ _ _ := by
  letI : UniformSpace ℤ := (Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ
  letI : TopologicalSpace ℤ :=
    ((Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ).toTopologicalSpace
  exact ⟨(Int.castAddHom ℤ_[p]).toIntLinearMap,
    (uniformContinuous_intCast_adic p).continuous⟩

@[simp]
theorem intCastAdicCLM_apply (z : ℤ) :
    intCastAdicCLM p z = (z : ℤ_[p]) := rfl

/-- The underlying linear map is the usual integer-linear cast. -/
@[simp]
theorem intCastAdicCLM_toLinearMap :
    @ContinuousLinearMap.toLinearMap ℤ ℤ _ _ (RingHom.id ℤ) ℤ
      ((Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ).toTopologicalSpace _
      ℤ_[p] _ _ _ _ (intCastAdicCLM p) = (Int.castAddHom ℤ_[p]).toIntLinearMap := rfl

end AdicSource

/-- The original integer scalar action is jointly continuous even when the scalar
ring is given its `(p)`-adic topology, rather than its discrete topology. -/
theorem continuousSMul_int_adic (p : ℕ) [Fact p.Prime] :
    @ContinuousSMul ℤ ℤ_[p] (inferInstance : SMul ℤ ℤ_[p])
      (Ideal.span {(p : ℤ)}).adicTopology (inferInstance : TopologicalSpace ℤ_[p]) := by
  let : TopologicalSpace ℤ := (Ideal.span {(p : ℤ)}).adicTopology
  have hcast := @UniformContinuous.continuous ℤ ℤ_[p]
    ((Ideal.span {(p : ℤ)}).adicModuleUniformSpace ℤ)
    (inferInstance : UniformSpace ℤ_[p]) (Int.castRingHom ℤ_[p])
    (uniformContinuous_intCast_adic p)
  rw [Ideal.adicModuleUniformSpace_self_toTopologicalSpace] at hcast
  constructor
  have hmul : Continuous (fun x : ℤ × ℤ_[p] => (x.1 : ℤ_[p]) * x.2) :=
    (hcast.comp continuous_fst).mul continuous_snd
  simpa only [zsmul_eq_mul] using hmul

end PadicInt
