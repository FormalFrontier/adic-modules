module

public import AdicModules.AdicCompletion.TensorProduct
public import AdicModules.AdicCompletion.RestrictScalars
import CoherentModules.RingTheory.Flat.BaseChange
import CoherentModules.RingTheory.Ideal.Annihilator
import CoherentModules.RingTheory.Ideal.Quotient.Annihilator
import CoherentModules.RingTheory.Noetherian
import Mathlib.RingTheory.AdicCompletion.Exactness

/-!
# Annihilators of completed Noetherian modules

For any ideal `I` and Noetherian original module `M`, the annihilator of the raw
completion over the completed coefficient ring is the kernel of the completed
quotient map by the original annihilator. Both completions use their canonical
completed scalar actions. The quotient by this completed annihilator is canonically
isomorphic, as an algebra over the original ring, to the completion of the original
annihilator quotient. Its forward and inverse maps commute with the completed
coefficient map on every completed coefficient.

The proof passes to the coefficient ring modulo the original annihilator. This
quotient ring is Noetherian, and the original module is finite and faithful over
it. Flat base change to its completion preserves faithfulness. The canonical
tensor comparison and restriction-of-scalars comparison then identify the desired
annihilator as a comap of the zero ideal.

No Noetherianity of the original ring, finiteness of the ideal, flatness of the
original module, separation or completeness is required. The resulting kernel
need not be the ideal generated by the original annihilator in the completed ring.

## References

The proof composes Mathlib's stock annihilator-quotient action (Pierre-Alexandre
Bazin), Noetherian scalar-tower and finite-module APIs, and completed-ring flatness
and tensor comparison (Judith Ludwig and Christian Merten), with this library's
independent-universe tensor comparison and semilinear restriction-of-scalars map.
Coherent Modules supplies Noetherianity of the annihilator quotient, faithfulness
of its stock action, preservation of finite faithful actions under flat base
change, and the annihilator-comap formula for bijective semilinear maps. The latter
follows Mathlib's elementwise annihilator arguments. These interfaces and proof
ideas are reused without copying their proof bodies. The effective coefficient
comparison additionally uses Mathlib's surjectivity of completed linear maps
(Judith Ludwig and Christian Merten), and its quotient transport and algebra
first-isomorphism APIs (Kenny Lau, Chris Hughes, Mario Carneiro, Anne Baanen and
Patrick Massot).
-/

@[expose] public section

universe u v

open scoped TensorProduct

/-- For a Noetherian original module, the annihilator of its raw completion under
its canonical completed-ring action is the kernel of the completed quotient map
by the original annihilator. The ideal is arbitrary and the ring and module
universes are independent. -/
theorem AdicCompletion.annihilator_eq_ker_mapRingHom
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M] :
    Module.annihilator (AdicCompletion I R) (AdicCompletion I M) =
      RingHom.ker
        (AdicCompletion.mapRingHom I
          (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
          (Ideal.Quotient.mk (Module.annihilator R M))
          Ideal.le_comap_map) := by
  let B := R ⧸ Module.annihilator R M
  let : Module B M := Module.quotientAnnihilator
  let : IsScalarTower R B M := (Module.isTorsionBySet_annihilator R M).isScalarTower
  have : IsNoetherian B M := isNoetherian_of_tower R inferInstance
  have : Module.Finite B M := inferInstance
  have : IsNoetherianRing B := isNoetherianRing_quotient_annihilator M
  have : FaithfulSMul B M := Module.quotientAnnihilator_faithfulSMul R M
  let J := I.map (Ideal.Quotient.mk (Module.annihilator R M))
  have : Module.Flat B (AdicCompletion J B) := AdicCompletion.flat_of_isNoetherian J
  have : FaithfulSMul (AdicCompletion J B) (AdicCompletion J B ⊗[B] M) :=
    FaithfulSMul.baseChange_of_finite_of_flat B (AdicCompletion J B) M
  have hHB : Module.annihilator (AdicCompletion J B) (AdicCompletion J M) = ⊥ := by
    have hF := (AdicCompletion.ofTensorProduct J M).annihilator_eq_comap_of_bijective
      (AdicCompletion.ofTensorProduct_bijective J M)
    rw [Ideal.comap_id] at hF
    exact hF.symm.trans (Module.annihilator_eq_bot.mpr inferInstance)
  have hg : Module.annihilator (AdicCompletion I R) (AdicCompletion I M) =
      Ideal.comap
        (AdicCompletion.mapRingHom I J (Ideal.Quotient.mk (Module.annihilator R M))
          Ideal.le_comap_map)
        (Module.annihilator (AdicCompletion J B) (AdicCompletion J M)) :=
    LinearMap.annihilator_eq_comap_of_bijective
      (AdicCompletion.restrictScalarsSemilinearMap (S := B) I M)
      (AdicCompletion.restrictScalarsSemilinearMap_bijective (S := B) I M)
  rw [hHB] at hg
  exact hg

namespace AdicCompletion

/-- The effective coefficient ring of a completed Noetherian original module is
canonically the completion of its original annihilator quotient, as an algebra
over the original ring. The quotient uses the annihilator for the canonical
completed-ring action, not the ideal generated by the original annihilator. -/
noncomputable def quotientAnnihilatorEquiv
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M] :
    (AdicCompletion I R ⧸
      Module.annihilator (AdicCompletion I R) (AdicCompletion I M)) ≃ₐ[R]
      AdicCompletion (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
        (R ⧸ Module.annihilator R M) := by
  let B := R ⧸ Module.annihilator R M
  let J := I.map (Ideal.Quotient.mk (Module.annihilator R M))
  let ρ : AdicCompletion I R →ₐ[R] AdicCompletion J B :=
    { AdicCompletion.mapRingHom I J (Ideal.Quotient.mk (Module.annihilator R M))
        Ideal.le_comap_map with
      commutes' := by
        intro r
        change AdicCompletion.mapRingHom I J
          (Ideal.Quotient.mk (Module.annihilator R M)) Ideal.le_comap_map
          (AdicCompletion.of I R r) =
            AdicCompletion.of J B (Ideal.Quotient.mk (Module.annihilator R M) r)
        exact AdicCompletion.mapRingHom_of I J _ _ r }
  have hρ : Function.Surjective ρ := by
    have hq : Function.Surjective (Algebra.linearMap R B) := Ideal.Quotient.mk_surjective
    intro y
    obtain ⟨x, hx⟩ := AdicCompletion.map_surjective I hq
      (AdicCompletion.restrictScalarsEquiv (S := B) I B y)
    refine ⟨x, (AdicCompletion.restrictScalarsEquiv (S := B) I B).injective ?_⟩
    change AdicCompletion.restrictScalarsEquiv (S := B) I B
        (AdicCompletion.mapRingHom I (I.map (algebraMap R B)) (algebraMap R B)
          Ideal.le_comap_map x) = _
    rw [AdicCompletion.restrictScalarsEquiv_mapRingHom]
    exact hx
  have hker : Module.annihilator (AdicCompletion I R) (AdicCompletion I M) =
      RingHom.ker ρ.toRingHom := AdicCompletion.annihilator_eq_ker_mapRingHom I M
  exact (Ideal.quotientEquivAlgOfEq R hker).trans
    (Ideal.quotientKerAlgEquivOfSurjective hρ)

/-- The coefficient quotient comparison agrees with the completed quotient map
on every completed coefficient. -/
@[simp]
theorem quotientAnnihilatorEquiv_mk
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M]
    (x : AdicCompletion I R) :
    quotientAnnihilatorEquiv I M
        (Ideal.Quotient.mk
          (Module.annihilator (AdicCompletion I R) (AdicCompletion I M)) x) =
      mapRingHom I (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
        (Ideal.Quotient.mk (Module.annihilator R M)) Ideal.le_comap_map x := by
  rfl

/-- The inverse coefficient comparison recovers the annihilator class of every
completed coefficient. -/
@[simp]
theorem quotientAnnihilatorEquiv_symm_mapRingHom
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M]
    (x : AdicCompletion I R) :
    (quotientAnnihilatorEquiv I M).symm
        (mapRingHom I (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
          (Ideal.Quotient.mk (Module.annihilator R M)) Ideal.le_comap_map x) =
      Ideal.Quotient.mk
        (Module.annihilator (AdicCompletion I R) (AdicCompletion I M)) x := by
  apply (quotientAnnihilatorEquiv I M).injective
  rw [AlgEquiv.apply_symm_apply, quotientAnnihilatorEquiv_mk]

/-- The forward comparison factors the whole completed coefficient map through
the quotient by the completed annihilator. -/
theorem quotientAnnihilatorEquiv_comp_mk
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M] :
    (quotientAnnihilatorEquiv I M).toRingHom.comp
        (Ideal.Quotient.mk
          (Module.annihilator (AdicCompletion I R) (AdicCompletion I M))) =
      mapRingHom I (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
        (Ideal.Quotient.mk (Module.annihilator R M)) Ideal.le_comap_map := by
  apply RingHom.ext
  intro x
  exact quotientAnnihilatorEquiv_mk I M x

/-- The inverse comparison factors the whole annihilator quotient map through
the completed coefficient map. -/
theorem quotientAnnihilatorEquiv_symm_comp_mapRingHom
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M] :
    (quotientAnnihilatorEquiv I M).symm.toRingHom.comp
        (mapRingHom I (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
          (Ideal.Quotient.mk (Module.annihilator R M)) Ideal.le_comap_map) =
      Ideal.Quotient.mk
        (Module.annihilator (AdicCompletion I R) (AdicCompletion I M)) := by
  apply RingHom.ext
  intro x
  exact quotientAnnihilatorEquiv_symm_mapRingHom I M x

end AdicCompletion
