module

public import AdicModules.AdicCompletion.TensorProduct
public import AdicModules.AdicCompletion.RestrictScalars
import CoherentModules.RingTheory.Flat.BaseChange
import CoherentModules.RingTheory.Ideal.Annihilator
import CoherentModules.RingTheory.Ideal.Quotient.Annihilator
import CoherentModules.RingTheory.Noetherian

/-!
# Annihilators of completed Noetherian modules

For any ideal `I` and Noetherian original module `M`, the annihilator of the raw
completion over the completed coefficient ring is the kernel of the completed
quotient map by the original annihilator. Both completions use their canonical
completed scalar actions.

The proof passes to the coefficient ring modulo the original annihilator. This
quotient ring is Noetherian, and the original module is finite and faithful over
it. Flat base change to its completion preserves faithfulness. The canonical
tensor comparison and restriction-of-scalars comparison then identify the desired
annihilator as a comap of the zero ideal.

No Noetherianity of the original ring, finiteness of the ideal, flatness of the
original module, separation or completeness is required. The resulting kernel
need not be the ideal generated by the original annihilator in the completed ring.

## References

The proof composes Mathlib's stock annihilator-quotient action (Pierre-Alexandre
Bazin), Noetherian scalar-tower and finite-module APIs, and completed-ring flatness
and tensor comparison (Judith Ludwig and Christian Merten), with this library's
independent-universe tensor comparison and semilinear restriction-of-scalars map.
Coherent Modules supplies Noetherianity of the annihilator quotient, faithfulness
of its stock action, preservation of finite faithful actions under flat base
change, and the annihilator-comap formula for bijective semilinear maps. The latter
follows Mathlib's elementwise annihilator arguments. These interfaces and proof
ideas are reused without copying their proof bodies.
-/

@[expose] public section

universe u v

open scoped TensorProduct

/-- For a Noetherian original module, the annihilator of its raw completion under
its canonical completed-ring action is the kernel of the completed quotient map
by the original annihilator. The ideal is arbitrary and the ring and module
universes are independent. -/
theorem AdicCompletion.annihilator_eq_ker_mapRingHom
    {R : Type u} [CommRing R] (I : Ideal R)
    (M : Type v) [AddCommGroup M] [Module R M] [IsNoetherian R M] :
    Module.annihilator (AdicCompletion I R) (AdicCompletion I M) =
      RingHom.ker
        (AdicCompletion.mapRingHom I
          (I.map (Ideal.Quotient.mk (Module.annihilator R M)))
          (Ideal.Quotient.mk (Module.annihilator R M))
          Ideal.le_comap_map) := by
  let B := R ⧸ Module.annihilator R M
  let : Module B M := Module.quotientAnnihilator
  let : IsScalarTower R B M := (Module.isTorsionBySet_annihilator R M).isScalarTower
  have : IsNoetherian B M := isNoetherian_of_tower R inferInstance
  have : Module.Finite B M := inferInstance
  have : IsNoetherianRing B := isNoetherianRing_quotient_annihilator M
  have : FaithfulSMul B M := Module.quotientAnnihilator_faithfulSMul R M
  let J := I.map (Ideal.Quotient.mk (Module.annihilator R M))
  have : Module.Flat B (AdicCompletion J B) := AdicCompletion.flat_of_isNoetherian J
  have : FaithfulSMul (AdicCompletion J B) (AdicCompletion J B ⊗[B] M) :=
    FaithfulSMul.baseChange_of_finite_of_flat B (AdicCompletion J B) M
  have hHB : Module.annihilator (AdicCompletion J B) (AdicCompletion J M) = ⊥ := by
    have hF := (AdicCompletion.ofTensorProduct J M).annihilator_eq_comap_of_bijective
      (AdicCompletion.ofTensorProduct_bijective J M)
    rw [Ideal.comap_id] at hF
    exact hF.symm.trans (Module.annihilator_eq_bot.mpr inferInstance)
  have hg : Module.annihilator (AdicCompletion I R) (AdicCompletion I M) =
      Ideal.comap
        (AdicCompletion.mapRingHom I J (Ideal.Quotient.mk (Module.annihilator R M))
          Ideal.le_comap_map)
        (Module.annihilator (AdicCompletion J B) (AdicCompletion J M)) :=
    LinearMap.annihilator_eq_comap_of_bijective
      (AdicCompletion.restrictScalarsSemilinearMap (S := B) I M)
      (AdicCompletion.restrictScalarsSemilinearMap_bijective (S := B) I M)
  rw [hHB] at hg
  exact hg
