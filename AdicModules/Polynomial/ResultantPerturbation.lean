module

public import Mathlib.Algebra.GroupWithZero.Associated
public import Mathlib.Algebra.Regular.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.Polynomial.Resultant.Basic

/-!
# Stability of resultants under coefficient perturbations

The resultant with fixed nominal bounds respects coefficient congruences modulo any ideal.
If the perturbations lie in the product of the original resultant's principal ideal with
an ideal contained in the Jacobson radical, the new resultant is the old one multiplied
by a unit congruent to one modulo that ideal. Consequently, their principal ideals agree
and regularity is preserved.

The nominal bounds are kept unchanged under coefficient maps, even when degrees drop.
No degree, monicity, regularity, or nonvanishing assumption is needed.
-/

@[expose] public section

universe u

namespace Polynomial

variable {R : Type u} [CommRing R]

/-- Coefficient congruences modulo an ideal give a congruence of resultants at the same
nominal bounds. These bounds need not be the degrees of any of the polynomials. -/
theorem resultant_sub_mem_of_coeff_sub_mem
    (J : Ideal R) (g₀ h₀ g₁ h₁ : R[X]) (n m : ℕ)
    (hg : ∀ i, (g₁ - g₀).coeff i ∈ J)
    (hh : ∀ i, (h₁ - h₀).coeff i ∈ J) :
    g₁.resultant h₁ n m - g₀.resultant h₀ n m ∈ J := by
  have hmap (f g : R[X]) (h : ∀ i, (f - g).coeff i ∈ J) :
      f.map (Ideal.Quotient.mk J) = g.map (Ideal.Quotient.mk J) := by
    ext i
    simp only [coeff_map]
    apply sub_eq_zero.mp
    rw [← map_sub, ← coeff_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (h i)
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [map_sub,
    ← resultant_map_map g₁ h₁ n m (Ideal.Quotient.mk J),
    ← resultant_map_map g₀ h₀ n m (Ideal.Quotient.mk J),
    hmap g₁ g₀ hg, hmap h₁ h₀ hh, sub_self]

/-- Perturbing coefficients by multiples of the original resultant with factors in a
Jacobson-radical ideal multiplies the resultant by a unit congruent to one modulo that ideal.
The two nominal bounds are fixed throughout. -/
theorem exists_unit_resultant_eq_mul_of_coeff_sub_mem
    (I : Ideal R) (hI : I ≤ (⊥ : Ideal R).jacobson)
    (g₀ h₀ g₁ h₁ : R[X]) (n m : ℕ)
    (hg : ∀ i, (g₁ - g₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I)
    (hh : ∀ i, (h₁ - h₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I) :
    ∃ u : Rˣ, g₁.resultant h₁ n m = g₀.resultant h₀ n m * (u : R) ∧
      (u : R) - 1 ∈ I := by
  obtain ⟨a, ha, hmul⟩ := Ideal.mem_span_singleton_mul.mp
    (resultant_sub_mem_of_coeff_sub_mem (Ideal.span {g₀.resultant h₀ n m} * I)
      g₀ h₀ g₁ h₁ n m hg hh)
  have hunit : IsUnit (a + 1) := by
    simpa only [mul_one] using (Ideal.mem_jacobson_bot.mp (hI ha)) 1
  obtain ⟨u, hu⟩ := hunit
  refine ⟨u, ?_, ?_⟩
  · rw [hu, mul_add, mul_one, hmul, sub_add_cancel]
  · rw [hu, add_sub_cancel_right]
    exact ha

/-- The original and perturbed resultants are associated under a Jacobson-radical
coefficient perturbation of the indicated size. -/
theorem resultant_associated_of_coeff_sub_mem
    (I : Ideal R) (hI : I ≤ (⊥ : Ideal R).jacobson)
    (g₀ h₀ g₁ h₁ : R[X]) (n m : ℕ)
    (hg : ∀ i, (g₁ - g₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I)
    (hh : ∀ i, (h₁ - h₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I) :
    Associated (g₀.resultant h₀ n m) (g₁.resultant h₁ n m) := by
  obtain ⟨u, hu, _⟩ :=
    exists_unit_resultant_eq_mul_of_coeff_sub_mem I hI g₀ h₀ g₁ h₁ n m hg hh
  exact ⟨u, hu.symm⟩

/-- The principal ideal generated by the resultant is unchanged by the indicated
coefficient perturbations. -/
theorem span_resultant_eq_of_coeff_sub_mem
    (I : Ideal R) (hI : I ≤ (⊥ : Ideal R).jacobson)
    (g₀ h₀ g₁ h₁ : R[X]) (n m : ℕ)
    (hg : ∀ i, (g₁ - g₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I)
    (hh : ∀ i, (h₁ - h₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I) :
    Ideal.span {g₁.resultant h₁ n m} = Ideal.span {g₀.resultant h₀ n m} := by
  obtain ⟨u, hu, _⟩ :=
    exists_unit_resultant_eq_mul_of_coeff_sub_mem I hI g₀ h₀ g₁ h₁ n m hg hh
  rw [hu, Ideal.span_singleton_mul_right_unit]
  exact u.isUnit

/-- Regularity of the resultant is preserved in both directions under the indicated
coefficient perturbations, including over rings with zero divisors. -/
theorem isRegular_resultant_iff_of_coeff_sub_mem
    (I : Ideal R) (hI : I ≤ (⊥ : Ideal R).jacobson)
    (g₀ h₀ g₁ h₁ : R[X]) (n m : ℕ)
    (hg : ∀ i, (g₁ - g₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I)
    (hh : ∀ i, (h₁ - h₀).coeff i ∈ Ideal.span {g₀.resultant h₀ n m} * I) :
    IsRegular (g₁.resultant h₁ n m) ↔ IsRegular (g₀.resultant h₀ n m) := by
  obtain ⟨u, hu, _⟩ :=
    exists_unit_resultant_eq_mul_of_coeff_sub_mem I hI g₀ h₀ g₁ h₁ n m hg hh
  rw [hu, isRegular_mul_iff]
  exact ⟨And.left, fun h => ⟨h, u.isRegular⟩⟩

end Polynomial
