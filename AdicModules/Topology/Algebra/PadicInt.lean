/-!
# P-adic integer neighborhood bases and proper dense integer spans

For a prime `p`, the ideals generated by `p ^ n` form a basis at zero for the
usual norm topology on `ℤ_[p]`. Restricting their scalars to `ℤ` preserves their
carriers, including all p-adic multiples of the generators. The topology is
linear both for the ring's self-action and for integer scalars. These are
theorems about the existing topology, not new global instances.

The integer span of any p-adic unit is dense. In particular the span of an
integer not divisible by `p` is dense, but the integer span of every integer
generator is proper, including `0` and `±1`. The inverse of `p + 1` is a uniform
nonmembership witness. In `ℤ_[2]`, the integer span of `3` is proper and dense,
and does not contain `1`. Its supremum with every restricted ideal-power
zero neighborhood is nevertheless top. This is an integer submodule, not the
self-scalar ideal generated by the unit `3`, which is top.

## Implementation notes

The basis uses Mathlib's geometric closed-ball basis and
`PadicInt.norm_le_pow_iff_mem_span_pow`. This norm characterization includes
zero, whereas the valuation characterization requires either a nonzero element
or a zero disjunct: `PadicInt.valuation_zero = 0`. The index `n = 0` is included
and its ideal is top. Scalar restriction uses the existing submodule API.

Density specializes the ring-level unit-transport result for integer spans and
Mathlib's density of integer casts. Properness uses the existing p-adic inverse
and faithful integer casts to reduce span membership to an integer product
equal to one. The supremum result applies
`Submodule.topologicalClosure_eq_iInf_sup` to the restricted ideal-power basis,
then uses density and the complete-lattice API. It consumes the generic closure
formula rather than copying its proof. No new submodule family, topology or
instance is defined.

## References

* Mathlib's p-adic development by Robert Y. Lewis, Mario Carneiro and Johan
  Commelin: `NumberTheory/Padics/PadicIntegers` and `NumberTheory/Padics/RingHoms`.
* Mathlib's metric, integer-span, scalar-restriction and continuous-action APIs.
* Mathlib's linear-topology development by Antoine Chambert-Loir,
  María Inés de Frutos-Fernández and Anatole Dedecker.
-/

@[expose] public section

open scoped Topology

namespace PadicInt

/-- Powers of the ideal generated by `p` form a zero-neighborhood basis in the norm topology. -/
theorem hasBasis_nhds_zero_span_pow (p : ℕ) [Fact p.Prime] :
    (𝓝 (0 : ℤ_[p])).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((Ideal.span {(p : ℤ_[p]) ^ n} : Ideal ℤ_[p]) : Set ℤ_[p])) := by
  have hp : (1 : ℝ) < (p : ℝ) := Nat.one_lt_cast.mpr (Fact.out : p.Prime).one_lt
  have hp0 : (0 : ℝ) < (p : ℝ) := zero_lt_one.trans hp
  refine (Metric.nhds_basis_closedBall_pow (x := (0 : ℤ_[p])) (r := (p : ℝ)⁻¹)
    (inv_pos.mpr hp0) ((inv_lt_one₀ hp0).mpr hp)).congr (fun _ ↦ Iff.rfl) ?_
  intro n _
  apply Set.ext
  intro x
  rw [Metric.mem_closedBall, dist_zero_right, SetLike.mem_coe, ← norm_le_pow_iff_mem_span_pow,
    zpow_neg, zpow_natCast, inv_pow]

/-- Restricting the ideal-power basis to integer scalars preserves its set carriers. -/
theorem hasBasis_nhds_zero_int_submodule_pow (p : ℕ) [Fact p.Prime] :
    (𝓝 (0 : ℤ_[p])).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((Ideal.span {(p : ℤ_[p]) ^ n} : Ideal ℤ_[p]).restrictScalars ℤ)
        : Set ℤ_[p])) := by
  simpa only [Submodule.coe_restrictScalars] using hasBasis_nhds_zero_span_pow p

/-- The norm topology on the p-adic integers is linear for the ring's self-action. -/
theorem isLinearTopology_self (p : ℕ) [Fact p.Prime] :
    IsLinearTopology ℤ_[p] ℤ_[p] := by
  exact IsLinearTopology.mk_of_hasBasis ℤ_[p] (hasBasis_nhds_zero_span_pow p)

/-- The norm topology on the p-adic integers is linear for integer scalars. -/
theorem isLinearTopology_int (p : ℕ) [Fact p.Prime] :
    IsLinearTopology ℤ ℤ_[p] := by
  exact IsLinearTopology.mk_of_hasBasis ℤ (hasBasis_nhds_zero_int_submodule_pow p)

/-- The integer span of a unit of the p-adic integers is dense in the norm topology. -/
theorem dense_int_span_of_isUnit {p : ℕ} [Fact p.Prime]
    {x : ℤ_[p]} (hx : IsUnit x) :
    Dense (Submodule.span ℤ {x} : Set ℤ_[p]) := by
  exact Submodule.dense_int_span_of_isUnit_of_denseRange_intCast denseRange_intCast hx

/-- An integer not divisible by `p` generates a dense integer submodule of `ℤ_[p]`. -/
theorem dense_int_span_intCast {p : ℕ} [Fact p.Prime]
    (a : ℤ) (ha : ¬ (p : ℤ) ∣ a) :
    Dense (Submodule.span ℤ {(a : ℤ_[p])} : Set ℤ_[p]) := by
  apply dense_int_span_of_isUnit
  by_contra h
  exact ha (norm_intCast_lt_one_iff.mp (not_isUnit_iff.mp h))

/-- The p-adic inverse of `p + 1` belongs to no singleton integer span of an integer cast.
This witness applies uniformly to all integer generators, including `0` and `±1`. -/
theorem inv_succ_notMem_int_span_intCast (p : ℕ) [Fact p.Prime] (a : ℤ) :
    PadicInt.inv ((p + 1 : ℕ) : ℤ_[p]) ∉ Submodule.span ℤ {(a : ℤ_[p])} := by
  intro h
  obtain ⟨z, hz⟩ := Submodule.mem_span_singleton.mp h
  have hnorm : ‖((p + 1 : ℕ) : ℤ_[p])‖ = 1 :=
    PadicInt.norm_natCast_eq_one_iff.mpr
      (Nat.coprime_self_add_right.mpr ((Nat.coprime_one_right_iff p).mpr trivial))
  have hmul : ((p + 1 : ℕ) : ℤ) * (z * a) = 1 := by
    apply (PadicInt.intCast_eq (p := p) _ 1).mp
    calc
      ((((p + 1 : ℕ) : ℤ) * (z * a) : ℤ) : ℤ_[p]) =
          ((p + 1 : ℕ) : ℤ_[p]) * (z • (a : ℤ_[p])) := by
            simp only [Int.cast_mul, Int.cast_natCast, zsmul_eq_mul]
      _ = ((p + 1 : ℕ) : ℤ_[p]) *
          PadicInt.inv ((p + 1 : ℕ) : ℤ_[p]) := by rw [hz]
      _ = ((1 : ℤ) : ℤ_[p]) := by
        simpa only [Int.cast_one] using PadicInt.mul_inv hnorm
  have hq : (1 : ℤ) < ((p + 1 : ℕ) : ℤ) :=
    Nat.one_lt_cast.mpr ((Fact.out : p.Prime).one_lt.trans_le (Nat.le_succ p))
  rcases Int.eq_one_or_neg_one_of_mul_eq_one hmul with hq_one | hq_neg_one
  · exact hq.ne' hq_one
  · have hbad : (1 : ℤ) < -1 := by simpa only [hq_neg_one] using hq
    exact (by decide : ¬ (1 : ℤ) < -1) hbad

/-- The integer span of every integer cast in `ℤ_[p]` is proper, including for `0` and `±1`. -/
theorem int_span_intCast_ne_top (p : ℕ) [Fact p.Prime] (a : ℤ) :
    Submodule.span ℤ {(a : ℤ_[p])} ≠ ⊤ := by
  intro htop
  apply inv_succ_notMem_int_span_intCast p a
  rw [htop]
  exact Submodule.mem_top

/-- The integer span of `3` in `ℤ_[2]` does not contain `1`. -/
theorem one_notMem_int_span_three_two :
    (1 : ℤ_[2]) ∉ Submodule.span ℤ {(3 : ℤ_[2])} := by
  intro h
  obtain ⟨z, hz⟩ := Submodule.mem_span_singleton.mp h
  have hz' : (3 : ℤ) * z = 1 := by
    apply (PadicInt.intCast_eq (p := 2) _ 1).mp
    simpa only [Int.cast_mul, Int.cast_ofNat, Int.cast_one, zsmul_eq_mul'] using hz
  rcases Int.eq_one_or_neg_one_of_mul_eq_one hz' with hthree_one | hthree_neg_one
  · exact (by decide : (3 : ℤ) ≠ 1) hthree_one
  · exact (by decide : (3 : ℤ) ≠ -1) hthree_neg_one

/-- The integer span of `3` in `ℤ_[2]` is a proper dense integer submodule.
It is not the self-scalar ideal generated by the p-adic unit `3`, which is top. -/
theorem int_span_three_two_proper_dense :
    Submodule.span ℤ {(3 : ℤ_[2])} ≠ ⊤ ∧
      Dense (Submodule.span ℤ {(3 : ℤ_[2])} : Set ℤ_[2]) := by
  constructor
  · simpa only [Int.cast_ofNat] using int_span_intCast_ne_top 2 3
  · simpa only [Int.cast_ofNat] using
      dense_int_span_intCast (p := 2) 3 (by decide : ¬ (2 : ℤ) ∣ 3)

/-- The proper integer span of `3` has top supremum with every restricted ideal-power
zero neighborhood in the 2-adic integers. -/
theorem int_span_three_two_proper_sup_pow :
    Submodule.span ℤ {(3 : ℤ_[2])} ≠ ⊤ ∧
      ∀ n : ℕ, Submodule.span ℤ {(3 : ℤ_[2])} ⊔
        (Ideal.span {(2 : ℤ_[2]) ^ n} : Ideal ℤ_[2]).restrictScalars ℤ = ⊤ := by
  let N : Submodule ℤ ℤ_[2] := Submodule.span ℤ {(3 : ℤ_[2])}
  have hN := int_span_three_two_proper_dense
  have htop : N.topologicalClosure = ⊤ :=
    Submodule.dense_iff_topologicalClosure_eq_top.mp hN.2
  have hclosure : N.topologicalClosure =
      ⨅ n : ℕ, N ⊔ (Ideal.span {(2 : ℤ_[2]) ^ n} : Ideal ℤ_[2]).restrictScalars ℤ := by
    simpa only [iInf_const, Nat.cast_ofNat] using
      Submodule.topologicalClosure_eq_iInf_sup N (hasBasis_nhds_zero_int_submodule_pow 2)
  refine ⟨hN.1, ?_⟩
  intro n
  apply le_antisymm le_top
  calc
    ⊤ = N.topologicalClosure := htop.symm
    _ = ⨅ n : ℕ, N ⊔ (Ideal.span {(2 : ℤ_[2]) ^ n} : Ideal ℤ_[2]).restrictScalars ℤ :=
      hclosure
    _ ≤ N ⊔ (Ideal.span {(2 : ℤ_[2]) ^ n} : Ideal ℤ_[2]).restrictScalars ℤ := iInf_le _ n

/-- The usual norm topology on the p-adic integers is the topology defined by powers
of the ideal generated by `p`. The ambient norm topology is not replaced. -/
theorem isAdic_span_p (p : ℕ) [Fact p.Prime] :
    IsAdic (Ideal.span {(p : ℤ_[p])}) := by
  apply IsTopologicalAddGroup.ext
  · infer_instance
  · exact (Ideal.span {(p : ℤ_[p])}).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup
  · apply (hasBasis_nhds_zero_span_pow p).eq_of_same_basis
    simpa only [Ideal.span_singleton_pow] using
      (Ideal.span {(p : ℤ_[p])}).hasBasis_nhds_zero_adic

end PadicInt
