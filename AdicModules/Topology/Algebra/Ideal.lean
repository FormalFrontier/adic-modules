/-!
# Density and closedness of ideals in adic topologies

If the powers of a left ideal `I` form a neighborhood basis at zero in a
ring with a compatible additive group topology, a left ideal `J` is dense
exactly when `J ⊔ I = ⊤`. Neither ideal needs to be two-sided, and multiplication
need not be continuous.

Translating the basis at zero gives a neighborhood basis at each ring element.
Density therefore means that every coset of every ideal power meets `J`.
The algebraic theorem `Ideal.sup_pow_eq_top_of_sup_eq_top` passes from
`J ⊔ I = ⊤` to `J ⊔ I ^ n = ⊤` for every natural number `n`, so each
ring element decomposes as a sum of an element of `J` and an element of `I ^ n`.
All powers and sums are formed as ideals over the original ring.

For example, the proper ideal generated by `3` is dense in the integers
with the topology defined by powers of the ideal generated by `2`.
The explicit powers topology is essential: the same ideal is not dense in
the discrete integers.

For a commutative ring with its `I`-adic topology, a maximal ideal `m` is closed
if and only if `I ≤ m`. Containment makes `m` an open additive subgroup, hence
closed. Otherwise maximality gives `m ⊔ I = ⊤`, so the density criterion above
makes `m` dense, contradicting closedness and properness. Consequently all
maximal ideals are closed if and only if `I` lies in the Jacobson radical.

## Main results

* `Ideal.dense_iff_sup_eq_top_of_hasBasis`: density of a left ideal in a supplied
  compatible additive-group topology with an ideal-power basis.
* `Ideal.isClosed_adicTopology_iff_le_of_isMaximal`: closedness of a maximal
  ideal in the canonical ring-adic topology is equivalent to containment of `I`.
* `Ideal.le_jacobson_bot_iff_forall_isClosed_adicTopology`: containment in the
  Jacobson radical is equivalent to closedness of every maximal ideal.

The Jacobson criterion isolates the ring-only reverse implication of
Fujiwara–Kato, Proposition 0.7.4.16, without the APf hypothesis. This removes
APf only from that implication; it does not establish the whole equivalence
or the finite-module completeness statements.

## References

* K. Fujiwara and F. Kato, *Foundations of Rigid Geometry I*,
  [arXiv:1308.4734v5](https://arxiv.org/abs/1308.4734v5), Proposition 0.7.4.16
  (reverse implication).
* Mathlib's ideal and submodule APIs, especially `Submodule.mem_sup` and
  `Submodule.sub_mem_sup`.
* Mathlib's canonical adic power basis, maximal-ideal/coatom characterization,
  open-additive-subgroup closedness and Jacobson radical as an infimum of
  maximal ideals.
* Mathlib's topological-group neighborhood and closure APIs, especially
  `Filter.HasBasis.nhds_of_zero` and `mem_closure_iff_nhds_basis`.
* `Ideal.sup_pow_eq_top_of_sup_eq_top` in
  `AdicModules.RingTheory.Ideal.Operations`, whose subtraction-free recurrence
  supplies the comaximal-power step.
-/

@[expose] public section

universe u
open Filter Topology

/-- A left ideal is dense in a compatible additive group topology with an
ideal-power basis at zero if and only if its sum with the filtration ideal is
all of the ring. Both ideals may be arbitrary left ideals. The proof uses
translated neighborhood bases and comaximality of all ideal powers. -/
theorem Ideal.dense_iff_sup_eq_top_of_hasBasis
    {R : Type u} [Ring R] [TopologicalSpace R] [IsTopologicalAddGroup R]
    {I J : Ideal R}
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((I ^ n : Ideal R) : Set R))) :
    Dense (J : Set R) ↔ J ⊔ I = ⊤ := by
  constructor
  · intro hJ
    obtain ⟨j, hj, hjI⟩ :=
      (mem_closure_iff_nhds_basis (hI.nhds_of_zero (1 : R))).mp (hJ 1) 1 trivial
    have hjI' : j - 1 ∈ I := by
      change j - 1 ∈ (I ^ 1 : Ideal R) at hjI
      simpa only [Submodule.pow_one] using hjI
    apply (Ideal.eq_top_iff_one (J ⊔ I)).mpr
    simpa only [sub_sub_cancel] using Submodule.sub_mem_sup hj hjI'
  · intro h r
    apply (mem_closure_iff_nhds_basis (hI.nhds_of_zero r)).mpr
    intro n _
    have hr : r ∈ J ⊔ I ^ n := by
      rw [Ideal.sup_pow_eq_top_of_sup_eq_top (n := n) h]
      exact Submodule.mem_top
    obtain ⟨j, hj, i, hi, hji⟩ := Submodule.mem_sup.mp hr
    refine ⟨j, hj, ?_⟩
    change j - r ∈ I ^ n
    rw [← hji, sub_add_cancel_left]
    exact (I ^ n).neg_mem hi

universe uR

namespace Ideal

/-- A maximal ideal of a commutative ring is closed in the `I`-adic topology
if and only if it contains `I`. Containment makes it open and hence closed;
failure of containment makes it dense by `Ideal.dense_iff_sup_eq_top_of_hasBasis`.
This is the maximal-ideal criterion for the ring-only reverse implication of
Fujiwara–Kato, *Foundations of Rigid Geometry I*, Proposition 0.7.4.16, with no
APf hypothesis. -/
theorem isClosed_adicTopology_iff_le_of_isMaximal
    {R : Type uR} [CommRing R] (I m : Ideal R) (hm : m.IsMaximal) :
    @IsClosed R I.adicTopology (m : Set R) ↔ I ≤ m := by
  let := I.adicTopology
  have : IsTopologicalRing R := I.ringFilterBasis.isTopologicalRing
  constructor
  · intro hclosed
    by_contra hle
    have hsup : m ⊔ I = ⊤ :=
      codisjoint_iff.mp (hm.out.not_le_iff_codisjoint.mp hle)
    have hdense : Dense (m : Set R) :=
      (dense_iff_sup_eq_top_of_hasBasis I.hasBasis_nhds_zero_adic).mpr hsup
    exact hm.ne_top ((Ideal.eq_top_iff_one m).mpr
      (by simpa only [hclosed.closure_eq, SetLike.mem_coe] using hdense (1 : R)))
  · intro hle
    have hm_nhds : (m : Set R) ∈ 𝓝 (0 : R) :=
      I.hasBasis_nhds_zero_adic.mem_iff.mpr ⟨1, trivial, by
        simpa only [Submodule.pow_one, SetLike.coe_subset_coe] using hle⟩
    exact m.toAddSubgroup.isClosed_of_isOpen
      (m.toAddSubgroup.isOpen_of_mem_nhds hm_nhds)

/-- An ideal lies in the Jacobson radical of a commutative ring if and only if
all maximal ideals are closed in its adic topology. This gives the ring-only
reverse implication of Fujiwara–Kato, *Foundations of Rigid Geometry I*,
Proposition 0.7.4.16 without the APf hypothesis on that implication; it does
not assert the whole equivalence or any finite-module completeness result.
The statement includes the zero ring, with no nontriviality assumption. -/
theorem le_jacobson_bot_iff_forall_isClosed_adicTopology
    {R : Type uR} [CommRing R] (I : Ideal R) :
    I ≤ (⊥ : Ideal R).jacobson ↔
      ∀ m : Ideal R, m.IsMaximal → @IsClosed R I.adicTopology (m : Set R) := by
  constructor
  · intro hI m hm
    exact (isClosed_adicTopology_iff_le_of_isMaximal I m hm).mpr
      (hI.trans (sInf_le ⟨bot_le, hm⟩))
  · intro h
    refine le_sInf fun m hm => ?_
    exact (isClosed_adicTopology_iff_le_of_isMaximal I m hm.2).mp (h m hm.2)

end Ideal
