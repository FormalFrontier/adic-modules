module

public import GroupTheory.Topology.Algebra.Group.SubgroupFamily
public import Mathlib.Algebra.Module.Submodule.Defs
public import Mathlib.Topology.Algebra.UniformMulAction

/-!
# Fixed scalars for topologies generated by submodule families

For an arbitrary family of submodules of a module over a ring, apply
`AddSubgroup.familyBasis` to their additive subgroups. Multiplication by a fixed
scalar is continuous for this topology and uniformly continuous for its right
uniformity. Both results use the original module action.

The family may be empty or undirected. No topology on the scalar ring, separation
of the module, or joint continuity of scalar multiplication is required. The ring
hypothesis is needed for `Submodule.toAddSubgroup`; it does not strengthen the
scalar hypotheses of the underlying subgroup-family theorem.

The proofs specialize `AddSubgroup.familyBasis_continuousConstSMul` and the stock
continuity-to-uniform-continuity upgrade. They introduce no new topology or action.
-/

@[expose] public section

universe uR uM uI

namespace Submodule

variable {R : Type uR} {M : Type uM} {I : Type uI}
  [r : Ring R] [g : AddCommGroup M] [m : Module R M]

/-- Multiplication by each fixed scalar is continuous for the subgroup-family
basis of an arbitrary submodule family, with the original module action. -/
theorem familyBasis_continuousConstSMul (F : I → Submodule R M) :
    let H : I → @AddSubgroup M g.toAddGroup := fun i => (F i).toAddSubgroup
    let B : @AddGroupFilterBasis M g.toAddGroup := @AddSubgroup.familyBasis M I g H
    @ContinuousConstSMul R M B.topology m.toDistribMulAction.toMulAction.toSMul := by
  intro H B
  let d : @DistribSMul R M g.toAddGroup.toAddMonoid.toAddZeroClass :=
    @DistribMulAction.toDistribSMul R M r.toSemiring.toMonoid
      g.toAddCommMonoid.toAddMonoid m.toDistribMulAction
  exact @AddSubgroup.familyBasis_continuousConstSMul M I g R d H
    (fun a i x hx => (F i).smul_mem a hx)

/-- Multiplication by each fixed scalar is uniformly continuous for the right
uniformity of the subgroup-family basis of an arbitrary submodule family. -/
theorem familyBasis_uniformContinuousConstSMul (F : I → Submodule R M) :
    let H : I → @AddSubgroup M g.toAddGroup := fun i => (F i).toAddSubgroup
    let B : @AddGroupFilterBasis M g.toAddGroup := @AddSubgroup.familyBasis M I g H
    let u : UniformSpace M :=
      @IsTopologicalAddGroup.rightUniformSpace M g.toAddGroup B.topology
        (@AddGroupFilterBasis.isTopologicalAddGroup M g.toAddGroup B)
    @UniformContinuousConstSMul R M u m.toDistribMulAction.toMulAction.toSMul := by
  intro H B u
  let d : @DistribSMul R M g.toAddGroup.toAddMonoid.toAddZeroClass :=
    @DistribMulAction.toDistribSMul R M r.toSemiring.toMonoid
      g.toAddCommMonoid.toAddMonoid m.toDistribMulAction
  have hTop : @IsTopologicalAddGroup M B.topology g.toAddGroup :=
    @AddGroupFilterBasis.isTopologicalAddGroup M g.toAddGroup B
  have hU : @IsUniformAddGroup M u g.toAddGroup :=
    @isUniformAddGroup_of_addCommGroup M g B.topology hTop
  have hC : @ContinuousConstSMul R M B.topology d.toSMulZeroClass.toSMul :=
    @familyBasis_continuousConstSMul R M I r g m F
  exact @uniformContinuousConstSMul_of_continuousConstSMul R M g.toAddGroup d u hU hC

end Submodule
