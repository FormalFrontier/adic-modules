module

import AdicModules.AdicCompletion.Completeness
import AdicModules.AdicCompletion.Endomorphism
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.Prod

/-!
# A nonscalar shear congruent to the identity

Over `R = ZMod 4`, the ideal generated by `2` is nonzero, proper, and square-zero.
The canonical module `R × R` is complete by
`IsAdicComplete.of_pow_smul_top_eq_bot`. The shear `(x, y) ↦ (x + 2 * y, y)`
is pointwise congruent to the identity modulo this ideal, but is neither the
identity nor a scalar map. Its involution gives an independent unit witness and
a stock linear equivalence with both inverse identities.

All declarations below are private witnesses for this single model.
-/

namespace AdicModulesTest.IdentityCongruence

private abbrev R := ZMod 4
private abbrev M := R × R

private def I : Ideal R := Ideal.span {(2 : R)}

/-- The shear on the canonical product module. -/
private def shear : Module.End R M :=
  (LinearMap.fst R R R + (2 : R) • LinearMap.snd R R R).prod
    (LinearMap.snd R R R)

@[simp] private theorem shear_apply (m : M) :
    shear m = (m.1 + 2 * m.2, m.2) := rfl

private theorem two_ne_zero : (2 : R) ≠ 0 := by decide

private theorem two_add_two : (2 : R) + 2 = 0 := by decide

private theorem two_sq_zero : (2 : R) ^ 2 = 0 := by decide

private theorem two_mem_I : (2 : R) ∈ I :=
  Ideal.subset_span (Set.mem_singleton (2 : R))

private theorem I_sq_eq_bot : I ^ 2 = ⊥ := by
  change (Ideal.span {(2 : R)}) ^ 2 = ⊥
  rw [Ideal.span_singleton_pow, two_sq_zero, Ideal.span_singleton_zero]

private theorem I_ne_bot : I ≠ ⊥ := by
  intro h
  exact two_ne_zero (Ideal.span_singleton_eq_bot.mp h)

private theorem I_ne_top : I ≠ ⊤ := by
  intro h
  have ht : (⊤ : Ideal R) = ⊥ := by simpa only [h, Ideal.top_pow] using I_sq_eq_bot
  exact I_ne_bot (h.trans ht)

private theorem module_nonzero : ((0, 1) : M) ≠ 0 := by
  intro h
  have hz : (1 : R) = 0 := congrArg Prod.snd h
  exact (by decide : (1 : R) ≠ 0) hz

/-- Completeness of the product module, from annihilation by the square of the ideal. -/
private theorem complete : IsAdicComplete I M := by
  apply IsAdicComplete.of_pow_smul_top_eq_bot (n := 2)
  rw [I_sq_eq_bot, Submodule.bot_smul]

/-- Pointwise congruence modulo the ideal acting on the whole module. -/
private theorem pointwise_near_identity (m : M) :
    shear m - m ∈ I • (⊤ : Submodule R M) := by
  have heq : shear m - m = (2 : R) • (m.2, (0 : R)) := by
    apply Prod.ext <;> simp [shear_apply, smul_eq_mul]
  rw [heq]
  exact Submodule.smul_mem_smul two_mem_I
    (show (m.2, (0 : R)) ∈ (⊤ : Submodule R M) from Submodule.mem_top)

/-- Completeness and pointwise congruence also make the shear a unit. -/
private theorem shear_isUnit_of_sub_mem_smul : IsUnit shear := by
  letI : IsAdicComplete I M := complete
  exact Module.End.isUnit_of_sub_mem_smul I shear pointwise_near_identity

/-- The shear is its own inverse, independently of completeness. -/
private theorem shear_involutive : Function.Involutive shear := by
  intro m
  apply Prod.ext
  · change (m.1 + 2 * m.2) + 2 * m.2 = m.1
    rw [add_assoc, ← add_mul, two_add_two, zero_mul, add_zero]
  · rfl

private theorem shear_mul_self : shear * shear = 1 := by
  apply LinearMap.ext
  intro m
  exact shear_involutive m

/-- The involution directly supplies a unit of the endomorphism ring. -/
private theorem shear_isUnit : IsUnit shear := by
  exact ⟨⟨shear, shear, shear_mul_self, shear_mul_self⟩, rfl⟩

private theorem shear_apply_unit_inv (m : M) : shear (shear_isUnit.unit.inv m) = m :=
  Module.End.isUnit_apply_inv_apply_of_isUnit shear_isUnit m

private theorem shear_unit_inv_apply (m : M) : shear_isUnit.unit.inv (shear m) = m :=
  Module.End.isUnit_inv_apply_apply_of_isUnit shear_isUnit m

/-- The same involution as a linear automorphism. -/
private def shearAut : M ≃ₗ[R] M :=
  LinearEquiv.ofInvolutive shear shear_involutive

@[simp] private theorem shearAut_apply (m : M) : shearAut m = shear m := rfl
@[simp] private theorem shearAut_symm_apply (m : M) : shearAut.symm m = shear m := rfl

private theorem shearAut_toLinearMap : shearAut.toLinearMap = shear := rfl

private theorem shearAut_apply_symm_apply (m : M) : shearAut (shearAut.symm m) = m :=
  shearAut.apply_symm_apply m

private theorem shearAut_symm_apply_apply (m : M) : shearAut.symm (shearAut m) = m :=
  shearAut.symm_apply_apply m

/-- Evaluation at the vector `(0, 1)` detects nonidentity. -/
private theorem shear_ne_one : shear ≠ 1 := by
  intro h
  have hc := congrArg (fun e : Module.End R M => (e (0, 1)).1) h
  exact two_ne_zero (by simpa [shear_apply] using hc)

/-- Every scalar map has zero first coordinate at (0,1); the shear does not. -/
private theorem shear_not_scalar (a : R) : shear ≠ a • (1 : Module.End R M) := by
  intro h
  have hc := congrArg (fun e : Module.End R M => (e (0, 1)).1) h
  exact two_ne_zero (by simpa [shear_apply] using hc)

end AdicModulesTest.IdentityCongruence
