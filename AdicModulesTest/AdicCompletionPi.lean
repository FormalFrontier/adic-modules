module

import AdicModules.AdicCompletion.Pi
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Ideal.Operations

noncomputable section

/-!
# An infinite product over the ideal generated by two in `ZMod 4`

The family is the entire product `ℕ → ZMod 4`, with the original regular-module,
product-module and completed-ring-module instances. The ideal is nonzero and proper,
but its square vanishes. Evaluation at level two detects the nonzero coordinates
of the alternating canonical element independently of the product equivalence.

The only boundary below is the empty dependent product over an arbitrary ring.
These are algebraic statements; no assertion about the default product topology
is made. The completion, evaluation and finite-product constructions are Mathlib's.
-/

namespace AdicCompletionPiTest

/-- The ideal generated by the residue class of two. -/
def twoIdeal : Ideal (ZMod 4) := Ideal.span {(2 : ZMod 4)}

theorem one_ne_zero : (1 : ZMod 4) ≠ 0 := by decide

theorem two_ne_zero : (2 : ZMod 4) ≠ 0 := by decide

theorem two_mul_two : (2 : ZMod 4) * 2 = 0 := by decide

/-- The ideal has exactly the two residues zero and two. -/
theorem mem_twoIdeal (x : ZMod 4) : x ∈ twoIdeal ↔ x = 0 ∨ x = 2 := by
  change x ∈ Ideal.span {(2 : ZMod 4)} ↔ x = 0 ∨ x = 2
  rw [Ideal.mem_span_singleton']
  exact (by decide : ∀ x : ZMod 4, (∃ a, a * 2 = x) ↔ x = 0 ∨ x = 2) x

theorem twoIdeal_ne_bot : twoIdeal ≠ ⊥ := by
  intro h
  have htwo : (2 : ZMod 4) ∈ twoIdeal := (mem_twoIdeal 2).2 (Or.inr rfl)
  rw [h] at htwo
  exact two_ne_zero (by simpa using htwo)

theorem twoIdeal_ne_top : twoIdeal ≠ ⊤ := by
  intro h
  have hone : (1 : ZMod 4) ∈ twoIdeal := by simp [h]
  have hbad := (mem_twoIdeal 1).1 hone
  exact (by decide : ¬ ((1 : ZMod 4) = 0 ∨ (1 : ZMod 4) = 2)) hbad

/-- The singleton generating set, without any completion hypothesis. -/
theorem twoIdeal_fg : twoIdeal.FG := by
  refine ⟨{(2 : ZMod 4)}, ?_⟩
  simp [twoIdeal]

theorem twoIdeal_sq : twoIdeal ^ 2 = ⊥ := by
  simp [twoIdeal, pow_two, Ideal.span_singleton_mul_span_singleton, two_mul_two]

/-- The defining quotient tower has zero denominator from level two onward. -/
theorem twoIdeal_pow_eq_bot {n : ℕ} (hn : 2 ≤ n) : twoIdeal ^ n = ⊥ := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
  simp [pow_add, twoIdeal_sq]

/-- Stock evaluation at level two detects the original residue class. -/
theorem eval_two_of_eq_zero (x : ZMod 4) :
    AdicCompletion.eval twoIdeal (ZMod 4) 2
      (AdicCompletion.of twoIdeal (ZMod 4) x) = 0 ↔ x = 0 := by
  rw [AdicCompletion.eval_of, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  simp only [twoIdeal_sq, Submodule.bot_smul, Submodule.mem_bot]

/-- The two nonzero residues recur at the even and odd coordinates. -/
def alternating (n : ℕ) : ZMod 4 := if n % 2 = 0 then 1 else 2

@[simp] theorem alternating_even (k : ℕ) : alternating (2 * k) = 1 := by
  simp [alternating, Nat.mul_mod]

@[simp] theorem alternating_odd (k : ℕ) : alternating (2 * k + 1) = 2 := by
  simp [alternating, Nat.add_mod, Nat.mul_mod]

theorem alternating_ne_zero (n : ℕ) : alternating n ≠ 0 := by
  unfold alternating
  split <;> first | exact one_ne_zero | exact two_ne_zero

/-- One element of the full product of completions, not a finitely supported family. -/
def completedAlternating : ℕ → AdicCompletion twoIdeal (ZMod 4) :=
  fun n ↦ AdicCompletion.of twoIdeal (ZMod 4) (alternating n)

theorem completedAlternating_ne_zero (n : ℕ) : completedAlternating n ≠ 0 := by
  intro h
  have heval := congrArg (AdicCompletion.eval twoIdeal (ZMod 4) 2) h
  have hz : AdicCompletion.eval twoIdeal (ZMod 4) 2
      (AdicCompletion.of twoIdeal (ZMod 4) (alternating n)) = 0 := by
    simpa [completedAlternating] using heval
  exact alternating_ne_zero n ((eval_two_of_eq_zero (alternating n)).1 hz)

-- The generic theorem applies to arbitrary completed coordinates on the full Nat product.
example : Function.Bijective
    (AdicCompletion.pi twoIdeal (fun _ : ℕ ↦ ZMod 4)) :=
  AdicCompletion.pi_bijective_of_fg twoIdeal (fun _ : ℕ ↦ ZMod 4) twoIdeal_fg

example (y : ℕ → AdicCompletion twoIdeal (ZMod 4)) (n : ℕ) :
    AdicCompletion.map twoIdeal (LinearMap.proj n)
      ((AdicCompletion.piEquivOfFG twoIdeal (fun _ : ℕ ↦ ZMod 4) twoIdeal_fg).symm y) =
        y n :=
  AdicCompletion.map_proj_piEquivOfFG_symm twoIdeal (fun _ : ℕ ↦ ZMod 4)
    twoIdeal_fg y n

/-- The alternating family has the canonical image of the entire original sequence as preimage. -/
theorem completedAlternating_preimage :
    (AdicCompletion.piEquivOfFG twoIdeal (fun _ : ℕ ↦ ZMod 4) twoIdeal_fg).symm
        completedAlternating = AdicCompletion.of twoIdeal (ℕ → ZMod 4) alternating := by
  change (AdicCompletion.piEquivOfFG twoIdeal (fun _ : ℕ ↦ ZMod 4) twoIdeal_fg).symm
      (fun n ↦ AdicCompletion.of twoIdeal (ZMod 4) (alternating n)) =
    AdicCompletion.of twoIdeal (ℕ → ZMod 4) alternating
  exact AdicCompletion.piEquivOfFG_symm_of twoIdeal (fun _ : ℕ ↦ ZMod 4)
    twoIdeal_fg alternating

section Empty

variable {R : Type*} [CommRing R] (I : Ideal R) (M : Empty → Type*)
  [∀ j, AddCommGroup (M j)] [∀ j, Module R (M j)]

-- The stock finite equivalence already handles the original empty product without FG.
example : AdicCompletion I (∀ j, M j) ≃ₗ[AdicCompletion I R]
    (∀ j, AdicCompletion I (M j)) :=
  AdicCompletion.piEquivOfFintype I M

-- On the overlap, equality follows on the very same empty-product dictionaries.
example (hI : I.FG) :
    AdicCompletion.piEquivOfFG I M hI = AdicCompletion.piEquivOfFintype I M := by
  ext x j
  exact isEmptyElim j

end Empty

end AdicCompletionPiTest
