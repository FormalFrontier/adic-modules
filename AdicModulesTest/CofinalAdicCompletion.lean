module

public import AdicModules.AdicCompletion.ChangeIdeal
import Mathlib.Tactic.NormNum

/-!
# Cofinal powers of the ideals (2) and (4) in the integers

All completions and quotients below use the original integer self-module. The first two
positive quotient stages are nonzero, whereas the zeroth stages are zero. The comparison
of completions is characterized on arbitrary completed inputs, with an explicit linear
transport between the equal, but not definitionally identical, quotient submodules.
-/

@[expose] public section

noncomputable section

namespace AdicCompletion.IntegerPowerCompletion

/-- The ideal generated by two in the original integer ring. -/
def twoIdeal : Ideal ℤ := Ideal.span {(2 : ℤ)}

/-- The ideal generated by four in the same integer ring. -/
def fourIdeal : Ideal ℤ := Ideal.span {(4 : ℤ)}

lemma twoIdeal_pow (n : ℕ) : twoIdeal ^ n = Ideal.span {(2 : ℤ) ^ n} :=
  Ideal.span_singleton_pow (2 : ℤ) n

lemma fourIdeal_pow (n : ℕ) : fourIdeal ^ n = Ideal.span {(4 : ℤ) ^ n} :=
  Ideal.span_singleton_pow (4 : ℤ) n

lemma two_mem_twoIdeal : (2 : ℤ) ∈ twoIdeal := by
  simp [twoIdeal, Ideal.mem_span_singleton]

lemma four_mem_fourIdeal : (4 : ℤ) ∈ fourIdeal := by
  simp [fourIdeal, Ideal.mem_span_singleton]

lemma one_not_mem_twoIdeal : (1 : ℤ) ∉ twoIdeal := by
  norm_num [twoIdeal, Ideal.mem_span_singleton]

lemma one_not_mem_fourIdeal : (1 : ℤ) ∉ fourIdeal := by
  norm_num [fourIdeal, Ideal.mem_span_singleton]

lemma two_not_mem_fourIdeal : (2 : ℤ) ∉ fourIdeal := by
  norm_num [fourIdeal, Ideal.mem_span_singleton]

lemma twoIdeal_ne_top : twoIdeal ≠ ⊤ := by
  intro h
  apply one_not_mem_twoIdeal
  rw [h]
  exact Submodule.mem_top

lemma fourIdeal_ne_top : fourIdeal ≠ ⊤ := by
  intro h
  apply one_not_mem_fourIdeal
  rw [h]
  exact Submodule.mem_top

lemma twoIdeal_ne_fourIdeal : twoIdeal ≠ fourIdeal := by
  intro h
  exact two_not_mem_fourIdeal (h ▸ two_mem_twoIdeal)

/-- Every power has its nonzero integer generator; this does not use any completion map. -/
lemma twoIdeal_pow_ne_bot (n : ℕ) : twoIdeal ^ n ≠ ⊥ := by
  intro h
  have hm : (2 : ℤ) ^ n ∈ twoIdeal ^ n := by
    rw [twoIdeal_pow]
    exact Ideal.subset_span (by simp)
  rw [h] at hm
  exact (pow_ne_zero n (by norm_num : (2 : ℤ) ≠ 0)) (by simpa using hm)

lemma fourIdeal_pow_ne_bot (n : ℕ) : fourIdeal ^ n ≠ ⊥ := by
  intro h
  have hm : (4 : ℤ) ^ n ∈ fourIdeal ^ n := by
    rw [fourIdeal_pow]
    exact Ideal.subset_span (by simp)
  rw [h] at hm
  exact (pow_ne_zero n (by norm_num : (4 : ℤ) ≠ 0)) (by simpa using hm)

lemma twoIdeal_ne_bot : twoIdeal ≠ ⊥ := by
  simpa only [pow_one] using twoIdeal_pow_ne_bot 1

lemma fourIdeal_ne_bot : fourIdeal ≠ ⊥ := by
  simpa only [pow_one] using fourIdeal_pow_ne_bot 1

lemma twoIdeal_not_isNilpotent : ¬ IsNilpotent twoIdeal := by
  rintro ⟨n, hn⟩
  exact twoIdeal_pow_ne_bot n hn

lemma fourIdeal_not_isNilpotent : ¬ IsNilpotent fourIdeal := by
  rintro ⟨n, hn⟩
  exact fourIdeal_pow_ne_bot n hn

lemma twoIdeal_sq : twoIdeal ^ 2 = fourIdeal := by
  rw [twoIdeal_pow]
  norm_num [fourIdeal]

lemma fourIdeal_le_twoIdeal : fourIdeal ≤ twoIdeal := by
  norm_num [twoIdeal, fourIdeal, Ideal.span_singleton_le_span_singleton,
    Ideal.mem_span_singleton]

/-- The forward cofinality witness is two, not zero. -/
lemma two_to_four : ∃ a : ℕ, twoIdeal ^ a ≤ fourIdeal :=
  ⟨2, le_of_eq twoIdeal_sq⟩

/-- The reverse cofinality witness is one. -/
lemma four_to_two : ∃ b : ℕ, fourIdeal ^ b ≤ twoIdeal :=
  ⟨1, by simpa only [pow_one] using fourIdeal_le_twoIdeal⟩

private lemma two_stage_eq (n : ℕ) :
    (twoIdeal ^ n • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(2 : ℤ) ^ n} := by
  change (twoIdeal ^ n • (⊤ : Ideal ℤ)) = _
  rw [Ideal.smul_eq_mul, Ideal.mul_top, twoIdeal_pow]

private lemma four_stage_eq (n : ℕ) :
    (fourIdeal ^ n • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(4 : ℤ) ^ n} := by
  change (fourIdeal ^ n • (⊤ : Ideal ℤ)) = _
  rw [Ideal.smul_eq_mul, Ideal.mul_top, fourIdeal_pow]

lemma two_stage_one_eq :
    (twoIdeal ^ 1 • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(2 : ℤ)} := by
  simpa only [pow_one] using two_stage_eq 1

lemma two_stage_two_eq :
    (twoIdeal ^ 2 • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(4 : ℤ)} := by
  rw [two_stage_eq]
  norm_num

lemma four_stage_one_eq :
    (fourIdeal ^ 1 • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(4 : ℤ)} := by
  simpa only [pow_one] using four_stage_eq 1

lemma four_stage_two_eq :
    (fourIdeal ^ 2 • (⊤ : Submodule ℤ ℤ)) = Ideal.span {(16 : ℤ)} := by
  rw [four_stage_eq]
  norm_num

/-- The class of one in the original quotient by (2) is nonzero. -/
lemma two_level_one_nonzero :
    (twoIdeal ^ 1 • (⊤ : Submodule ℤ ℤ)).mkQ (1 : ℤ) ≠ 0 := by
  simpa only [ne_eq, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    two_stage_one_eq, Ideal.mem_span_singleton] using
    (show ¬ (2 : ℤ) ∣ 1 by norm_num)

/-- The second positive stage for (2) is the original quotient by (4). -/
lemma two_level_two_nonzero :
    (twoIdeal ^ 2 • (⊤ : Submodule ℤ ℤ)).mkQ (1 : ℤ) ≠ 0 := by
  simpa only [ne_eq, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    two_stage_two_eq, Ideal.mem_span_singleton] using
    (show ¬ (4 : ℤ) ∣ 1 by norm_num)

lemma four_level_one_nonzero :
    (fourIdeal ^ 1 • (⊤ : Submodule ℤ ℤ)).mkQ (1 : ℤ) ≠ 0 := by
  simpa only [ne_eq, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    four_stage_one_eq, Ideal.mem_span_singleton] using
    (show ¬ (4 : ℤ) ∣ 1 by norm_num)

lemma four_level_two_nonzero :
    (fourIdeal ^ 2 • (⊤ : Submodule ℤ ℤ)).mkQ (1 : ℤ) ≠ 0 := by
  simpa only [ne_eq, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    four_stage_two_eq, Ideal.mem_span_singleton] using
    (show ¬ (16 : ℤ) ∣ 1 by norm_num)

/-- Level zero is the zero quotient, not a positive nonzero stage. -/
lemma two_level_zero (q : ℤ ⧸ (twoIdeal ^ 0 • (⊤ : Submodule ℤ ℤ))) : q = 0 := by
  have h : (twoIdeal ^ 0 • (⊤ : Submodule ℤ ℤ)) = ⊤ := by
    change (twoIdeal ^ 0 • (⊤ : Ideal ℤ)) = ⊤
    rw [Ideal.smul_eq_mul, Ideal.mul_top, pow_zero, Ideal.one_eq_top]
  haveI : Subsingleton (ℤ ⧸ (twoIdeal ^ 0 • (⊤ : Submodule ℤ ℤ))) :=
    Submodule.Quotient.subsingleton_iff.mpr h
  exact Subsingleton.elim _ _

lemma four_level_zero (q : ℤ ⧸ (fourIdeal ^ 0 • (⊤ : Submodule ℤ ℤ))) : q = 0 := by
  have h : (fourIdeal ^ 0 • (⊤ : Submodule ℤ ℤ)) = ⊤ := by
    change (fourIdeal ^ 0 • (⊤ : Ideal ℤ)) = ⊤
    rw [Ideal.smul_eq_mul, Ideal.mul_top, pow_zero, Ideal.one_eq_top]
  haveI : Subsingleton (ℤ ⧸ (fourIdeal ^ 0 • (⊤ : Submodule ℤ ℤ))) :=
    Submodule.Quotient.subsingleton_iff.mpr h
  exact Subsingleton.elim _ _

/-- The canonical comparison is linear over the original integers. -/
def completionEquiv : AdicCompletion twoIdeal ℤ ≃ₗ[ℤ] AdicCompletion fourIdeal ℤ :=
  equivOfCofinal twoIdeal fourIdeal ℤ two_to_four four_to_two

lemma two_pow_even (n : ℕ) : twoIdeal ^ (2 * n) = fourIdeal ^ n := by
  rw [pow_mul, twoIdeal_sq]

lemma two_stage_eq_four_stage (n : ℕ) :
    (twoIdeal ^ (2 * n) • (⊤ : Submodule ℤ ℤ)) =
      (fourIdeal ^ n • (⊤ : Submodule ℤ ℤ)) := by
  rw [two_pow_even]

/-- Explicit stock transport, retaining the two original quotient types and their scalars. -/
def quotientTransport (n : ℕ) :
    (ℤ ⧸ (twoIdeal ^ (2 * n) • (⊤ : Submodule ℤ ℤ))) ≃ₗ[ℤ]
      (ℤ ⧸ (fourIdeal ^ n • (⊤ : Submodule ℤ ℤ))) :=
  Submodule.quotEquivOfEq _ _ (two_stage_eq_four_stage n)

lemma quotientTransport_mkQ (n : ℕ) (z : ℤ) :
    quotientTransport n ((twoIdeal ^ (2 * n) • (⊤ : Submodule ℤ ℤ)).mkQ z) =
      (fourIdeal ^ n • (⊤ : Submodule ℤ ℤ)).mkQ z := by
  exact Submodule.quotEquivOfEq_mk _ _ (two_stage_eq_four_stage n) z

/-- The equality transport is exactly the stock identity-induced quotient map. -/
lemma quotientTransport_apply (n : ℕ)
    (q : ℤ ⧸ (twoIdeal ^ (2 * n) • (⊤ : Submodule ℤ ℤ))) :
    quotientTransport n q =
      Submodule.factor (le_of_eq (two_stage_eq_four_stage n)) q := by
  refine Submodule.Quotient.induction_on _ q ?_
  intro z
  rfl

/-- The forward stage formula holds on every completed input, including at level zero. -/
lemma eval_completionEquiv (n : ℕ) (x : AdicCompletion twoIdeal ℤ) :
    eval fourIdeal ℤ n (completionEquiv x) =
      quotientTransport n (eval twoIdeal ℤ (2 * n) x) := by
  rw [quotientTransport_apply]
  simpa only [completionEquiv, equivOfCofinal_apply] using
    (eval_mapOfPowLE twoIdeal fourIdeal ℤ two_to_four (le_of_eq (two_pow_even n)) x)

/-- The inverse uses the stock quotient factor for the inclusion (4)^n ≤ (2)^n. -/
lemma eval_completionEquiv_symm (n : ℕ) (y : AdicCompletion fourIdeal ℤ) :
    eval twoIdeal ℤ n (completionEquiv.symm y) =
      Submodule.factor
        (Submodule.smul_mono (Ideal.pow_right_mono fourIdeal_le_twoIdeal n) le_rfl)
        (eval fourIdeal ℤ n y) := by
  simpa only [completionEquiv, equivOfCofinal_symm_apply,
    mapOfPowLE_eq_mapOfLE ℤ fourIdeal_le_twoIdeal four_to_two] using
    (mapOfLE_eval ℤ fourIdeal_le_twoIdeal n y)

lemma completionEquiv_left_inverse (x : AdicCompletion twoIdeal ℤ) :
    completionEquiv.symm (completionEquiv x) = x :=
  completionEquiv.symm_apply_apply x

lemma completionEquiv_right_inverse (y : AdicCompletion fourIdeal ℤ) :
    completionEquiv (completionEquiv.symm y) = y :=
  completionEquiv.apply_symm_apply y

lemma completionEquiv_of (z : ℤ) :
    completionEquiv (of twoIdeal ℤ z) = of fourIdeal ℤ z :=
  equivOfCofinal_of twoIdeal fourIdeal ℤ two_to_four four_to_two z

lemma completionEquiv_symm_of (z : ℤ) :
    completionEquiv.symm (of fourIdeal ℤ z) = of twoIdeal ℤ z :=
  equivOfCofinal_symm_of twoIdeal fourIdeal ℤ two_to_four four_to_two z

lemma completionEquiv_of_one :
    completionEquiv (of twoIdeal ℤ (1 : ℤ)) = of fourIdeal ℤ (1 : ℤ) :=
  completionEquiv_of 1

lemma of_one_two_positive_coordinates :
    eval twoIdeal ℤ 1 (of twoIdeal ℤ (1 : ℤ)) ≠ 0 ∧
      eval twoIdeal ℤ 2 (of twoIdeal ℤ (1 : ℤ)) ≠ 0 :=
  ⟨two_level_one_nonzero, two_level_two_nonzero⟩

lemma of_one_four_positive_coordinates :
    eval fourIdeal ℤ 1 (of fourIdeal ℤ (1 : ℤ)) ≠ 0 ∧
      eval fourIdeal ℤ 2 (of fourIdeal ℤ (1 : ℤ)) ≠ 0 :=
  ⟨four_level_one_nonzero, four_level_two_nonzero⟩

/-- Naturality uses the two stock maps, each with its own completed scalar ring. -/
lemma completionEquiv_map (f : ℤ →ₗ[ℤ] ℤ) (x : AdicCompletion twoIdeal ℤ) :
    completionEquiv (map twoIdeal f x) = map fourIdeal f (completionEquiv x) :=
  equivOfCofinal_map twoIdeal fourIdeal two_to_four four_to_two f x

/-- A concrete original-integer-linear endomorphism, not a completed-scalar identification. -/
def timesThree : ℤ →ₗ[ℤ] ℤ := (3 : ℤ) • LinearMap.id

lemma timesThree_apply (z : ℤ) : timesThree z = 3 * z := by
  simp [timesThree, smul_eq_mul]

lemma completionEquiv_timesThree (x : AdicCompletion twoIdeal ℤ) :
    completionEquiv (map twoIdeal timesThree x) =
      map fourIdeal timesThree (completionEquiv x) :=
  completionEquiv_map timesThree x

/-- The positive-power equivalence at two agrees after the explicit ideal-equality transport. -/
lemma powEquiv_two_agrees :
    (twoIdeal_sq ▸ powEquiv twoIdeal ℤ 2 (by norm_num)) = completionEquiv :=
  powEquiv_eq_equivOfCofinal twoIdeal fourIdeal ℤ 2 (by norm_num)
    twoIdeal_sq two_to_four four_to_two

end AdicCompletion.IntegerPowerCompletion
