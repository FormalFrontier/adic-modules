module

import AdicModules.RingTheory.HenselianCriterion
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.Data.ZMod.Basic

/-!
# Finite-algebra idempotents over the 2-adic pair

The pair of 2-adic integers and the ideal generated by 2 has the entire finite-algebra
idempotent-lifting property, by `HenselianRing.existsUnique_isIdempotentElem_map` and
Mathlib's canonical Henselian structure. The equivalence below applies the finite-algebra
criterion to this concrete lifting family. Its reverse implication is not a proof of the
converse for arbitrary pairs: the 2-adic pair is already Henselian independently.

The same-universe application uses the criterion with both universe parameters zero.
A zero-ring calculation also gives uniqueness through the quotient by the top ideal.
-/

universe v

namespace PadicInt

/-- Every finite algebra over the 2-adic pair has unique idempotent lifts through the
quotient by the extended ideal. -/
private theorem two_finite_algebra_idempotent_lifting :
    ∀ (B : Type v) [CommRing B] [Algebra (PadicInt 2) B]
      [Module.Finite (PadicInt 2) B]
      (e0 : B ⧸ (Ideal.span {(2 : PadicInt 2)}).map (algebraMap (PadicInt 2) B)),
      IsIdempotentElem e0 →
        ∃! e : B, IsIdempotentElem e ∧
          Ideal.Quotient.mk
            ((Ideal.span {(2 : PadicInt 2)}).map (algebraMap (PadicInt 2) B)) e = e0 := by
  let : HenselianRing (PadicInt 2) (Ideal.span {(2 : PadicInt 2)}) := by
    have h : IsLocalRing.maximalIdeal (PadicInt 2) =
        Ideal.span {(2 : PadicInt 2)} := by
      simpa only [Nat.cast_ofNat] using (maximalIdeal_eq_span_p (p := 2))
    rw [← h]
    infer_instance
  intro B _ _ _ e0 he0
  exact HenselianRing.existsUnique_isIdempotentElem_map
    (Ideal.span {(2 : PadicInt 2)}) he0

/-- The 2-adic pair satisfies both sides of the finite-algebra criterion in every algebra
universe; the reverse application uses its independently supplied lifting family. -/
private theorem two_henselian_criterion :
    HenselianRing (PadicInt 2) (Ideal.span {(2 : PadicInt 2)}) ↔
      ∀ (B : Type v) [CommRing B] [Algebra (PadicInt 2) B]
        [Module.Finite (PadicInt 2) B]
        (e0 : B ⧸ (Ideal.span {(2 : PadicInt 2)}).map (algebraMap (PadicInt 2) B)),
        IsIdempotentElem e0 →
          ∃! e : B, IsIdempotentElem e ∧
            Ideal.Quotient.mk
              ((Ideal.span {(2 : PadicInt 2)}).map (algebraMap (PadicInt 2) B)) e = e0 := by
  constructor
  · intro _
    exact two_finite_algebra_idempotent_lifting
  · intro _
    exact (HenselianRing.iff_existsUnique_isIdempotentElem_map.{0, v}
      (Ideal.span {(2 : PadicInt 2)})).mpr two_finite_algebra_idempotent_lifting

/-- The finite-algebra criterion applies to the 2-adic pair with same-universe algebras. -/
private theorem two_henselian_of_finite_algebra_idempotents :
    HenselianRing (PadicInt 2) (Ideal.span {(2 : PadicInt 2)}) := by
  exact (HenselianRing.iff_existsUnique_isIdempotentElem_map.{0, 0}
    (Ideal.span {(2 : PadicInt 2)})).mpr two_finite_algebra_idempotent_lifting

end PadicInt

namespace ZMod

/-- The zero ring has a unique idempotent with any prescribed image modulo the top ideal. -/
private theorem one_top_unique_idempotent_lift
    (e0 : (ZMod 1) ⧸ (⊤ : Ideal (ZMod 1))) :
    ∃! e : ZMod 1, IsIdempotentElem e ∧
      Ideal.Quotient.mk (⊤ : Ideal (ZMod 1)) e = e0 := by
  refine ⟨0, ⟨?_, Subsingleton.elim _ _⟩, ?_⟩
  · exact isIdempotentElem_iff.mpr (Subsingleton.elim _ _)
  · intro e _
    exact Subsingleton.elim _ _

end ZMod
