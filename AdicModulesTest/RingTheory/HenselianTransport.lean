module

import AdicModules.RingTheory.HenselianTransport
import Mathlib.Data.ZMod.Basic

/-!
# Henselian pairs in modular integer rings

The canonical homomorphism from `ZMod 8` to `ZMod 4` maps the ideal generated by `2`
to a nonzero ideal. The two rings and both ideals are nontrivial, and the kernel is
elementwise nil. The class of `4` gives a nonzero element of the kernel, so this
homomorphism does not have kernel contained in the zero ideal.

The ring structures, characteristic structures, homomorphism and ideal operations
are those of Mathlib.
-/

@[expose] public section

private lemma zmod_eight_span_two_isNilpotent :
    ∀ x ∈ Ideal.span ({2} : Set (ZMod 8)), IsNilpotent x := by
  intro x hx
  obtain ⟨r, hr⟩ := dvd_def.mp (Ideal.mem_span_singleton.mp hx)
  apply IsNilpotent.mk x 3
  rw [hr]
  exact (by decide : ∀ r : ZMod 8, ((2 : ZMod 8) * r) ^ 3 = 0) r

private lemma zmod_eight_reduction_properties :
    let f : ZMod 8 →+* ZMod 4 :=
      ZMod.castHom (show 4 ∣ 8 from by decide) (ZMod 4)
    let I : Ideal (ZMod 8) := Ideal.span ({2} : Set (ZMod 8))
    (0 : ZMod 8) ≠ 1 ∧ (0 : ZMod 4) ≠ 1 ∧
      Function.Surjective f ∧
      (∀ x : ZMod 8, f x = 0 → IsNilpotent x) ∧
      I ≠ ⊥ ∧ I.map f ≠ ⊥ := by
  let f : ZMod 8 →+* ZMod 4 :=
    ZMod.castHom (show 4 ∣ 8 from by decide) (ZMod 4)
  let I : Ideal (ZMod 8) := Ideal.span ({2} : Set (ZMod 8))
  refine ⟨by decide, by decide, ?_, ?_, ?_, ?_⟩
  · exact ZMod.castHom_surjective (show 4 ∣ 8 from by decide)
  · intro x hx
    apply IsNilpotent.mk x 2
    exact (by decide : ∀ y : ZMod 8, f y = 0 → y ^ 2 = 0) x hx
  · intro hI
    have htwo : (2 : ZMod 8) ∈ I := Ideal.mem_span_singleton_self 2
    have hzero : (2 : ZMod 8) = 0 := Ideal.mem_bot.mp (hI ▸ htwo)
    exact (by decide : (2 : ZMod 8) ≠ 0) hzero
  · intro hmap
    have htwo : (2 : ZMod 8) ∈ I := Ideal.mem_span_singleton_self 2
    have himage : f (2 : ZMod 8) ∈ I.map f := Ideal.mem_map_of_mem f htwo
    have hzero : f (2 : ZMod 8) = 0 := Ideal.mem_bot.mp (hmap ▸ himage)
    exact (by decide : f (2 : ZMod 8) ≠ 0) hzero

/-- The reduction from integers modulo eight to integers modulo four, together with the
ideal generated by two and its image, satisfies the Henselian-pair conditions. -/
private lemma zmod_eight_henselian_reduction :
    let f : ZMod 8 →+* ZMod 4 :=
      ZMod.castHom (show 4 ∣ 8 from by decide) (ZMod 4)
    let I : Ideal (ZMod 8) := Ideal.span ({2} : Set (ZMod 8))
    (0 : ZMod 8) ≠ 1 ∧ (0 : ZMod 4) ≠ 1 ∧
      Function.Surjective f ∧
      (∀ x : ZMod 8, f x = 0 → IsNilpotent x) ∧
      I ≠ ⊥ ∧ I.map f ≠ ⊥ ∧
      HenselianRing (ZMod 8) I ∧ HenselianRing (ZMod 4) (I.map f) := by
  let f : ZMod 8 →+* ZMod 4 :=
    ZMod.castHom (show 4 ∣ 8 from by decide) (ZMod 4)
  let I : Ideal (ZMod 8) := Ideal.span ({2} : Set (ZMod 8))
  obtain ⟨h8, h4, hf, hker, hI, hIf⟩ := zmod_eight_reduction_properties
  have hH8 : HenselianRing (ZMod 8) I := by
    apply (HenselianRing.iff_existsUnique_isIdempotentElem_map.{0, 0} I).mpr
    intro B _ _ _ e0 he0
    let J : Ideal B := I.map (algebraMap (ZMod 8) B)
    have hJ : J ≤ nilradical B := by
      apply Ideal.map_le_iff_le_comap.mpr
      intro x hx
      exact mem_nilradical.mpr
        ((zmod_eight_span_two_isNilpotent x hx).map (algebraMap (ZMod 8) B))
    have hq : ∀ x ∈ RingHom.ker (Ideal.Quotient.mk J), IsNilpotent x := by
      intro x hx
      exact mem_nilradical.mp
        (hJ (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hx)))
    exact existsUnique_isIdempotentElem_eq_of_ker_isNilpotent
      (Ideal.Quotient.mk J) hq e0
      (RingHom.mem_range.mpr (Ideal.Quotient.mk_surjective (I := J) e0)) he0
  have hH4 : HenselianRing (ZMod 4) (I.map f) := by
    have : HenselianRing (ZMod 8) I := hH8
    exact HenselianRing.map_of_surjective I f hf
  have hH8' : HenselianRing (ZMod 8) I :=
    (HenselianRing.iff_map_of_surjective_of_nil_ker I f hf hker).mpr hH4
  exact ⟨h8, h4, hf, hker, hI, hIf, hH8', hH4⟩

/-- Reduction modulo four kills the nonzero class of four modulo eight. -/
example :
    let f : ZMod 8 →+* ZMod 4 :=
      ZMod.castHom (show 4 ∣ 8 from by decide) (ZMod 4)
    f 4 = 0 ∧ (4 : ZMod 8) ≠ 0 := by
  decide
