module

import AdicModules.RingTheory.Idempotents
import Mathlib.Algebra.Algebra.Prod
import Mathlib.Algebra.GroupWithZero.Idempotent
import Mathlib.Data.ZMod.Defs
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.RingTheory.AdicCompletion.Basic
import Mathlib.RingTheory.Finiteness.Prod
import Mathlib.RingTheory.Ideal.Lattice
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Idempotents over the 2-adic integers

The examples use the ideal generated by two in the 2-adic integers, and the product
of that ring with its quotient by this ideal, with their canonical algebra structures.
The zero ring also permits the top ideal without a properness or nontriviality hypothesis.
-/

@[expose] public section

-- The base-ring input is the image of one modulo the ideal generated by two.
example :
    ∃! e : ℤ_[2], IsIdempotentElem e ∧
      Ideal.Quotient.mk (Ideal.span {(2 : ℤ_[2])}) e =
        Ideal.Quotient.mk (Ideal.span {(2 : ℤ_[2])}) 1 := by
  have hcomplete : IsAdicComplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := by
    simpa [PadicInt.maximalIdeal_eq_span_p (p := 2)] using
      (inferInstance : IsAdicComplete (IsLocalRing.maximalIdeal ℤ_[2]) ℤ_[2])
  have : IsAdicComplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := hcomplete
  have : HenselianRing ℤ_[2] (Ideal.span {(2 : ℤ_[2])}) :=
    IsAdicComplete.henselianRing ℤ_[2] (Ideal.span {(2 : ℤ_[2])})
  apply HenselianRing.existsUnique_isIdempotentElem (Ideal.span {(2 : ℤ_[2])})
  exact IsIdempotentElem.one.map (Ideal.Quotient.mk (Ideal.span {(2 : ℤ_[2])}))

-- The product input is the image of (1, 0) in the quotient by the extended ideal.
example :
    ∃! e : ℤ_[2] × (ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])}),
      IsIdempotentElem e ∧
        Ideal.Quotient.mk
            ((Ideal.span {(2 : ℤ_[2])}).map
              (algebraMap ℤ_[2] (ℤ_[2] × (ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])})))) e =
          Ideal.Quotient.mk
            ((Ideal.span {(2 : ℤ_[2])}).map
              (algebraMap ℤ_[2] (ℤ_[2] × (ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])})))) (1, 0) := by
  have hcomplete : IsAdicComplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := by
    simpa [PadicInt.maximalIdeal_eq_span_p (p := 2)] using
      (inferInstance : IsAdicComplete (IsLocalRing.maximalIdeal ℤ_[2]) ℤ_[2])
  have : IsAdicComplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := hcomplete
  have : HenselianRing ℤ_[2] (Ideal.span {(2 : ℤ_[2])}) :=
    IsAdicComplete.henselianRing ℤ_[2] (Ideal.span {(2 : ℤ_[2])})
  have : Module.Finite ℤ_[2] (ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])}) :=
    Module.finite_def.mpr <| by
      rw [← Ideal.Quotient.span_singleton_one (Ideal.span {(2 : ℤ_[2])})]
      exact Submodule.fg_span_singleton (1 : ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])})
  have h10 : IsIdempotentElem
      ((1 : ℤ_[2]), (0 : ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2])})) := by
    apply isIdempotentElem_iff.mpr
    simp only [Prod.mk_mul_mk, mul_one, mul_zero]
  apply HenselianRing.existsUnique_isIdempotentElem_map
    (R := ℤ_[2]) (Ideal.span {(2 : ℤ_[2])})
  exact h10.map (Ideal.Quotient.mk _)

-- Both the Henselian premise and the unique lift exist at the top ideal of the zero ring.
example :
    HenselianRing (ZMod 1) (⊤ : Ideal (ZMod 1)) ∧
      ∃! e : ZMod 1, IsIdempotentElem e ∧
        Ideal.Quotient.mk
            ((⊤ : Ideal (ZMod 1)).map (algebraMap (ZMod 1) (ZMod 1))) e =
          Ideal.Quotient.mk
            ((⊤ : Ideal (ZMod 1)).map (algebraMap (ZMod 1) (ZMod 1))) 0 := by
  have hbot_top : (⊥ : Ideal (ZMod 1)) = ⊤ := by
    apply (Ideal.eq_top_iff_one (I := (⊥ : Ideal (ZMod 1)))).2
    have h10 : (1 : ZMod 1) = 0 := Subsingleton.elim _ _
    rw [h10]
    exact (⊥ : Ideal (ZMod 1)).zero_mem
  have hcomplete : IsAdicComplete (⊤ : Ideal (ZMod 1)) (ZMod 1) := by
    simpa only [hbot_top] using
      (inferInstance : IsAdicComplete (⊥ : Ideal (ZMod 1)) (ZMod 1))
  have : IsAdicComplete (⊤ : Ideal (ZMod 1)) (ZMod 1) := hcomplete
  refine ⟨IsAdicComplete.henselianRing (ZMod 1) (⊤ : Ideal (ZMod 1)), ?_⟩
  refine ⟨0, ⟨IsIdempotentElem.zero, rfl⟩, ?_⟩
  intro e _
  exact Subsingleton.elim e 0
