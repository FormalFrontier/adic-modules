module

import AdicModules.RingTheory.WittVector.Complete
import Mathlib.Algebra.Field.ZMod
import Mathlib.Algebra.Polynomial.Coeff
import Mathlib.Algebra.Polynomial.Degree.Domain

/-!
# Completeness and a nonperfect coefficient boundary for Witt vectors

The standard coefficient ring `ZMod 3` satisfies the perfect-ring completeness
result already in Mathlib. In contrast, `Polynomial (ZMod 3)` is not perfect:
`X` has no cube root. In the latter ring, `verschiebung (teichmuller 3 X)` has
zero zeroth coefficient but is not divisible by `3`.

Under perfectness, the coefficient-and-root condition agrees with Mathlib's
criterion for membership in the ideal generated by `p ^ n`. Rewriting
`Ideal.span_singleton_pow` identifies that ideal with `(Ideal.span {p}) ^ n`.

The application to the canonical adic completion over `Polynomial (ZMod 3)`
uses `WittVector.isAdicComplete_span_p`. Divisibility over `ZMod 3` follows
from the coefficient-and-root criterion; the polynomial boundary follows
from the characteristic-`p` multiplication identities.
-/

universe u

namespace WittVector

-- Mathlib's perfect-ring instance gives completeness for the finite coefficient field.
private theorem zmod_three_isAdicComplete_span_three :
    IsAdicComplete (Ideal.span {(3 : WittVector 3 (ZMod 3))})
      (WittVector 3 (ZMod 3)) := by
  exact WittVector.isAdicCompleteIdealSpanP (p := 3) (k := ZMod 3)

private theorem zmod_three_verschiebung_teichmuller_mem_span_three (a : ZMod 3) :
    verschiebung (teichmuller 3 a) ∈ Ideal.span {(3 : WittVector 3 (ZMod 3))} := by
  suffices hmem : verschiebung (teichmuller 3 a) ∈
      (Ideal.span {(3 : WittVector 3 (ZMod 3))}) ^ 1 by
    simpa only [pow_one] using hmem
  apply (mem_span_p_pow_iff_coeff_eq_zero_and_exists_pow_eq _ 1).mpr
  constructor
  · intro m hm
    have hm0 : m = 0 := Nat.lt_one_iff.mp hm
    subst m
    exact verschiebung_coeff_zero _
  · intro i
    refine ⟨(_root_.frobeniusEquiv (ZMod 3) 3).symm
      ((verschiebung (teichmuller 3 a)).coeff (i + 1)), ?_⟩
    simpa only [pow_one] using _root_.frobeniusEquiv_symm_pow_p (ZMod 3) 3
      ((verschiebung (teichmuller 3 a)).coeff (i + 1))

private theorem polynomial_X_not_cube (q : Polynomial (ZMod 3)) :
    q ^ 3 ≠ Polynomial.X := by
  intro h
  have hdegree : 3 * q.natDegree = 1 := by
    simpa only [Polynomial.natDegree_pow, Polynomial.natDegree_X] using
      congrArg Polynomial.natDegree h
  exact Nat.prime_three.not_dvd_one ⟨q.natDegree, hdegree.symm⟩

private theorem not_perfectRing_polynomial_zmod_three :
    ¬ PerfectRing (Polynomial (ZMod 3)) 3 := by
  intro h
  have hs : Function.Surjective (fun q : Polynomial (ZMod 3) => q ^ 3) :=
    (@PerfectRing.bijective_frobenius (Polynomial (ZMod 3)) 3 _ h).2
  obtain ⟨q, hq⟩ := hs Polynomial.X
  exact polynomial_X_not_cube q hq

private theorem verschiebung_teichmuller_X_zero_not_mem_span_three :
    (verschiebung (teichmuller 3 (Polynomial.X : Polynomial (ZMod 3)))).coeff 0 = 0 ∧
      verschiebung (teichmuller 3 (Polynomial.X : Polynomial (ZMod 3))) ∉
        Ideal.span {(3 : WittVector 3 (Polynomial (ZMod 3)))} := by
  refine ⟨verschiebung_coeff_zero _, ?_⟩
  intro h
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h
  have hcube := congrArg
    (fun w : WittVector 3 (Polynomial (ZMod 3)) => w.coeff (0 + 1)) ha
  rw [(show (a * 3).coeff (0 + 1) = a.coeff 0 ^ 3 from by
      simpa only [Nat.cast_ofNat] using (mul_charP_coeff_succ (p := 3) a 0)),
    verschiebung_coeff_succ, teichmuller_coeff_zero] at hcube
  exact polynomial_X_not_cube (a.coeff 0) hcube

-- Bijectivity of the canonical completion map for polynomial coefficients.
private theorem polynomial_zmod_three_adicCompletion_of_bijective :
    Function.Bijective
      (AdicCompletion.of (Ideal.span {(3 : WittVector 3 (Polynomial (ZMod 3)))})
        (WittVector 3 (Polynomial (ZMod 3)))) := by
  exact AdicCompletion.of_bijective_iff.mpr
    (WittVector.isAdicComplete_span_p 3 (Polynomial (ZMod 3)))

/-- For a perfect coefficient ring, the root conditions add no restriction to
Mathlib's coefficient criterion for the principal ideal generated by `p ^ n`. -/
private theorem coeff_condition_iff_mem_span_p_pow
    {p : ℕ} [Fact p.Prime] {k : Type u} [CommRing k] [CharP k p] [PerfectRing k p]
    (x : WittVector p k) (n : ℕ) :
    ((∀ m : ℕ, m < n → x.coeff m = 0) ∧
        (∀ i : ℕ, ∃ a : k, a ^ (p ^ n) = x.coeff (i + n))) ↔
      x ∈ Ideal.span {((p : WittVector p k) ^ n)} := by
  rw [WittVector.mem_span_p_pow_iff_le_coeff_eq_zero]
  constructor
  · exact fun h => h.1
  · intro h
    refine ⟨h, fun i => ?_⟩
    exact ⟨((_root_.frobeniusEquiv k p).symm^[n]) (x.coeff (i + n)),
      _root_.iterate_frobeniusEquiv_symm_pow_p_pow k p (x.coeff (i + n)) n⟩

-- The zeroth-power case has no vanishing or root restrictions.
private theorem mem_span_p_pow_zero_iff
    {p : ℕ} [Fact p.Prime] {k : Type u} [CommRing k] (x : WittVector p k) :
    x ∈ (Ideal.span {(p : WittVector p k)}) ^ 0 ↔
      (∀ m : ℕ, m < 0 → x.coeff m = 0) ∧
        (∀ i : ℕ, ∃ a : k, a ^ (p ^ 0) = x.coeff (i + 0)) := by
  simp

end WittVector
