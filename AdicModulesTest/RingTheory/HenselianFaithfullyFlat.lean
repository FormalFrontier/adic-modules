module

public import AdicModules.RingTheory.HenselianRadical
public import AdicModules.RingTheory.HenselianTransport
import Mathlib.Algebra.Algebra.Prod
import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.Basis.Prod
import Mathlib.RingTheory.Finiteness.Prod
import Mathlib.RingTheory.Ideal.Prod
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.LocalRing.NonLocalRing

/-!
# A faithfully flat diagonal over the integers modulo four

The diagonal map from `ZMod 4` to its square is integral and faithfully flat: the
product algebra is finite and free. The ideal generated by `2` is nonzero and proper,
and its extension is the product of the two coordinate ideals in a nonlocal ring.

The target pair is Henselian independently: the extended ideal has square zero, so
its radical agrees with the radical of the zero ideal. Completeness at the zero ideal
and radical invariance then supply the target Henselian structure before descent.
-/

@[expose] public section

local notation "R" => ZMod 4
local notation "S" => R × R
local notation "I" => Ideal.span ({(2 : R)} : Set R)
local notation "f" => algebraMap R S
local notation "J" => Ideal.map f I

example : I ≠ ⊥ ∧ I ≠ ⊤ ∧ J = Ideal.prod I I ∧ ¬ IsLocalRing S ∧ HenselianRing R I := by
  let : Fact (1 < 4) := ⟨by decide⟩
  let : Module.Free R S := Module.Free.prod R R R
  have hff : RingHom.FaithfullyFlat f :=
    RingHom.faithfullyFlat_algebraMap_iff.mpr (inferInstance : Module.FaithfullyFlat R S)
  have hf : RingHom.IsIntegral f :=
    algebraMap_isIntegral_iff.mpr (inferInstance : Algebra.IsIntegral R S)
  have hI2 : I ^ 2 = ⊥ := by
    rw [Ideal.span_singleton_pow, show (2 : R) ^ 2 = 0 by decide]
    simp
  have hJ2 : J ^ 2 = ⊥ := by
    rw [← Ideal.map_pow, hI2, Ideal.map_bot]
  have hzero : HenselianRing S (⊥ : Ideal S) :=
    IsAdicComplete.henselianRing S ⊥
  have hrad : Ideal.radical J = (⊥ : Ideal S).radical := by
    rw [← hJ2, Ideal.radical_pow J (by decide : 2 ≠ 0)]
  have htarget : HenselianRing S J := by
    apply (HenselianRing.iff_radical J).mpr
    rw [hrad]
    exact (HenselianRing.iff_radical (⊥ : Ideal S)).mp hzero
  refine ⟨?_, ?_, ?_, IsLocalRing.not_isLocalRing_of_prod_of_nontrivial R R, ?_⟩
  · rw [ne_eq, Ideal.span_singleton_eq_bot]
    decide
  · intro h
    simp only [h, Ideal.top_pow, top_ne_bot] at hI2
  · rw [Ideal.map_span, Set.image_singleton]
    ext x
    simp only [Ideal.mem_span_singleton', Ideal.mem_prod]
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨⟨a.1, rfl⟩, ⟨a.2, rfl⟩⟩
    · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
      exact ⟨(a, b), Prod.ext ha hb⟩
  · exact (HenselianRing.iff_map_of_isIntegral_of_faithfullyFlat I f hf hff).mpr htarget
