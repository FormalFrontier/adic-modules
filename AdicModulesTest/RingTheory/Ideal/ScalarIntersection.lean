module

import AdicModules.RingTheory.Ideal.Operations
import Mathlib.Algebra.GCDMonoid.Nat
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Tactic.NormNum.GCD

/-!
# Scalar images of comaximal ideals

The scalar image of an ideal on a submodule uses the canonical action generated
by finite sums of scalar multiples. The scalar semiring and the additive module
may lie in independent universes. No multiplication on the module is involved.

For the regular integer module, the singleton-generated ideals `(2)` and `(3)`
are comaximal. On the proper submodule generated by `5`, their images are `(10)`
and `(15)`, with nonzero intersection `(30)`. On the integer module `ZMod 6`,
their images are respectively `{0, 2, 4}` and `{0, 3}`, with zero intersection.

The regular module over `ℕ × (ℕ × ℕ)` gives a semiring example without additive
inverses. The kernels of the first and second coordinate projections are
comaximal. On the proper span of `(2, 3, 5)`, their images have coordinate
conditions `0 × 3ℕ × 5ℕ` and `2ℕ × 0 × 5ℕ`, with nonzero common image
`0 × 0 × 5ℕ`. Its addition is cancellative; no noncancellation assertion is made.

## References

* Mathlib's canonical ideal action, singleton-span image and ideal product APIs
  in `Mathlib.RingTheory.Ideal.Operations`, authored by Kenny Lau.
* Mathlib's `span_singleton_inf_span_singleton` and the stock integer GCD monoid
  compute the intersection of the integer images.
* Mathlib's product projection ring homomorphisms and their ideal kernels give
  the coordinate ideals; all three modules use stock module structures.
-/

namespace AdicModulesTest.ScalarIntersection

universe u v

universe w

-- The submodule factor also covers the empty finite family.
private abbrev finiteScalarIntersection
    {R : Type u} {M : Type v} {ι : Type w}
    [CommSemiring R] [AddCommMonoid M] [Module R M]
    (I : ι → Ideal R) (s : Finset ι) (N : Submodule R M) : Prop :=
  (s : Set ι).Pairwise (fun i j => I i ⊔ I j = ⊤) →
    (⨅ i ∈ s, I i) • N = N ⊓ (⨅ i ∈ s, I i • N)

-- Only the proposition is recorded here; no general proof is supplied.
private abbrev scalarIntersection (R : Type u) (M : Type v)
    [CommSemiring R] [AddCommMonoid M] [Module R M] : Prop :=
  ∀ (I J : Ideal R) (N : Submodule R M),
    I ⊔ J = ⊤ → (I ⊓ J) • N = (I • N) ⊓ (J • N)

section Integers

private def intIdeal (n : ℤ) : Ideal ℤ := Ideal.span {n}

private def intN : Submodule ℤ ℤ := Submodule.span ℤ {5}

private lemma mem_intIdeal_iff (n x : ℤ) : x ∈ intIdeal n ↔ n ∣ x :=
  Ideal.mem_span_singleton

private theorem int_comaximal : intIdeal 2 ⊔ intIdeal 3 = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  refine ⟨-2, ?_, 3, Ideal.mem_span_singleton_self _, by norm_num⟩
  exact Ideal.mem_span_singleton'.mpr ⟨-1, by norm_num⟩

private lemma int_ideal_meet : intIdeal 2 ⊓ intIdeal 3 = intIdeal 6 := by
  rw [← Ideal.mul_eq_inf_of_coprime int_comaximal]
  change Ideal.span {(2 : ℤ)} * Ideal.span {3} = Ideal.span {6}
  simpa using Ideal.span_singleton_mul_span_singleton (2 : ℤ) 3

-- In the regular module the stock ideal action is definitionally ideal multiplication.
private lemma int_two_image : intIdeal 2 • intN = intIdeal 10 := by
  change Ideal.span {(2 : ℤ)} * Ideal.span {5} = Ideal.span {10}
  simpa using Ideal.span_singleton_mul_span_singleton (2 : ℤ) 5

private lemma int_three_image : intIdeal 3 • intN = intIdeal 15 := by
  change Ideal.span {(3 : ℤ)} * Ideal.span {5} = Ideal.span {15}
  simpa using Ideal.span_singleton_mul_span_singleton (3 : ℤ) 5

private lemma int_six_image : intIdeal 6 • intN = intIdeal 30 := by
  change Ideal.span {(6 : ℤ)} * Ideal.span {5} = Ideal.span {30}
  simpa using Ideal.span_singleton_mul_span_singleton (6 : ℤ) 5

private lemma int_image_meet :
    (intIdeal 2 • intN) ⊓ (intIdeal 3 • intN) = intIdeal 30 := by
  rw [int_two_image, int_three_image]
  ext x
  simp only [Submodule.mem_inf, mem_intIdeal_iff]
  have h := (lcm_dvd_iff (a := (10 : ℤ)) (b := 15) (c := x)).symm
  norm_num [← Int.coe_lcm] at h
  exact h

private theorem int_proper : intN ≠ ⊤ := by
  intro h
  have h1 : (1 : ℤ) ∈ intN := by
    rw [h]
    exact Submodule.mem_top
  have hd : (5 : ℤ) ∣ 1 := (mem_intIdeal_iff 5 1).mp h1
  norm_num at hd

private theorem int_nonzero_common :
    (intIdeal 2 • intN) ⊓ (intIdeal 3 • intN) ≠ ⊥ := by
  rw [int_image_meet]
  intro h
  have hz : (30 : ℤ) = 0 := Ideal.span_singleton_eq_bot.mp h
  norm_num at hz

private theorem int_fixed_equality :
    (intIdeal 2 ⊓ intIdeal 3) • intN =
      (intIdeal 2 • intN) ⊓ (intIdeal 3 • intN) := by
  rw [int_ideal_meet, int_six_image, int_image_meet]

private theorem int_equality_of_comaximal :
    (intIdeal 2 ⊓ intIdeal 3) • intN =
      (intIdeal 2 • intN) ⊓ (intIdeal 3 • intN) :=
  Submodule.ideal_smul_inf_of_sup_eq_top intN int_comaximal

private theorem int_common_witness :
    (30 : ℤ) ≠ 0 ∧ (30 : ℤ) ∈ (intIdeal 2 ⊓ intIdeal 3) • intN := by
  refine ⟨by norm_num, ?_⟩
  rw [int_ideal_meet, int_six_image]
  exact Ideal.mem_span_singleton_self _

-- The ambient index type is infinite; only these three ideals are selected.
private def intIndices : Finset ℕ := {2, 3, 5}

private def intFamily (i : ℕ) : Ideal ℤ := intIdeal (i : ℤ)

private lemma int_two_five_comaximal : intIdeal 2 ⊔ intIdeal 5 = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  refine ⟨-4, ?_, 5, Ideal.mem_span_singleton_self _, by norm_num⟩
  exact (mem_intIdeal_iff 2 (-4)).mpr (by norm_num)

private lemma int_three_five_comaximal : intIdeal 3 ⊔ intIdeal 5 = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  refine ⟨6, ?_, -5, ?_, by norm_num⟩
  · exact (mem_intIdeal_iff 3 6).mpr (by norm_num)
  · exact (mem_intIdeal_iff 5 (-5)).mpr (by norm_num)

private theorem int_finite_comaximal :
    (intIndices : Set ℕ).Pairwise (fun i j => intFamily i ⊔ intFamily j = ⊤) := by
  intro i hi j hj hij
  have hi' : i = 2 ∨ i = 3 ∨ i = 5 := by simpa [intIndices] using hi
  have hj' : j = 2 ∨ j = 3 ∨ j = 5 := by simpa [intIndices] using hj
  rcases hi' with rfl | rfl | rfl <;> rcases hj' with rfl | rfl | rfl
  · exact (hij rfl).elim
  · exact int_comaximal
  · exact int_two_five_comaximal
  · exact (sup_comm _ _).trans int_comaximal
  · exact (hij rfl).elim
  · exact int_three_five_comaximal
  · exact (sup_comm _ _).trans int_two_five_comaximal
  · exact (sup_comm _ _).trans int_three_five_comaximal
  · exact (hij rfl).elim

private theorem int_finite_ideals_proper :
    ∀ i ∈ intIndices, intFamily i ≠ ⊤ := by
  intro i hi htop
  have h1 : (1 : ℤ) ∈ intFamily i := by
    rw [htop]
    exact Submodule.mem_top
  have hi' : i = 2 ∨ i = 3 ∨ i = 5 := by simpa [intIndices] using hi
  rcases hi' with rfl | rfl | rfl <;>
    norm_num [intFamily, mem_intIdeal_iff] at h1

private lemma int_finite_ideal_meet :
    (⨅ i ∈ intIndices, intFamily i) = intIdeal 30 := by
  have hp : (intIndices : Set ℕ).Pairwise
      (fun i j => IsCoprime (intFamily i) (intFamily j)) := by
    intro i hi j hj hij
    exact Ideal.isCoprime_iff_sup_eq.mpr (int_finite_comaximal hi hj hij)
  rw [← Ideal.prod_eq_iInf_of_pairwise_isCoprime hp]
  simpa [intIndices, intFamily, intIdeal] using
    Ideal.prod_span_singleton intIndices (fun i : ℕ => (i : ℤ))

private lemma int_five_image : intIdeal 5 • intN = intIdeal 25 := by
  change Ideal.span {(5 : ℤ)} * Ideal.span {5} = Ideal.span {25}
  simpa using Ideal.span_singleton_mul_span_singleton (5 : ℤ) 5

private lemma int_thirty_image : intIdeal 30 • intN = intIdeal 150 := by
  change Ideal.span {(30 : ℤ)} * Ideal.span {5} = Ideal.span {150}
  simpa using Ideal.span_singleton_mul_span_singleton (30 : ℤ) 5

private lemma int_finite_image_meet :
    (⨅ i ∈ intIndices, intFamily i • intN) = intIdeal 150 := by
  have hfold : (⨅ i ∈ intIndices, intFamily i • intN) =
      ((intIdeal 2 • intN) ⊓ (intIdeal 3 • intN)) ⊓ (intIdeal 5 • intN) := by
    simp only [intIndices, Finset.iInf_insert, Finset.iInf_singleton, intFamily,
      Nat.cast_ofNat, inf_assoc]
  rw [hfold, int_image_meet, int_five_image]
  ext x
  simp only [Submodule.mem_inf, mem_intIdeal_iff]
  have h := (lcm_dvd_iff (a := (30 : ℤ)) (b := 25) (c := x)).symm
  norm_num [← Int.coe_lcm] at h
  exact h

private theorem int_finite_fixed_equality :
    (⨅ i ∈ intIndices, intFamily i) • intN =
      intN ⊓ (⨅ i ∈ intIndices, intFamily i • intN) := by
  have hle : intIdeal 150 ≤ intN := by
    rw [← int_thirty_image]
    exact Submodule.smul_le_right
  rw [int_finite_ideal_meet, int_thirty_image, int_finite_image_meet,
    inf_eq_right.mpr hle]

private theorem int_finite_statement :
    finiteScalarIntersection intFamily intIndices intN := by
  intro _
  exact int_finite_fixed_equality

private theorem int_finite_equality_of_comaximal :
    (⨅ i ∈ intIndices, intFamily i) • intN =
      intN ⊓ (⨅ i ∈ intIndices, intFamily i • intN) :=
  Submodule.ideal_smul_iInf_of_pairwise_sup_eq_top
    intFamily intIndices intN int_finite_comaximal

private theorem int_finite_common_witness :
    (150 : ℤ) ≠ 0 ∧
      (150 : ℤ) ∈ intN ⊓ (⨅ i ∈ intIndices, intFamily i • intN) ∧
      (5 : ℤ) ∈ intN ∧
      (5 : ℤ) ∉ intN ⊓ (⨅ i ∈ intIndices, intFamily i • intN) := by
  refine ⟨by norm_num, ?_, ?_, ?_⟩
  · rw [← int_finite_fixed_equality, int_finite_ideal_meet, int_thirty_image]
    exact Ideal.mem_span_singleton_self _
  · exact Submodule.subset_span (Set.mem_singleton _)
  · intro h
    have hcommon := h.2
    rw [int_finite_image_meet] at hcommon
    have hd : (150 : ℤ) ∣ 5 := (mem_intIdeal_iff 150 5).mp hcommon
    norm_num at hd

private theorem int_empty_equality :
    (⨅ i ∈ (∅ : Finset ℕ), intFamily i) • intN =
      intN ⊓ (⨅ i ∈ (∅ : Finset ℕ), intFamily i • intN) := by
  simp

private theorem int_empty_omitted_cap_fails :
    (⨅ i ∈ (∅ : Finset ℕ), intFamily i) • intN ≠
      (⨅ i ∈ (∅ : Finset ℕ), intFamily i • intN) := by
  simpa using int_proper

end Integers

section IntegerTorsion

private abbrev torsionN : Submodule ℤ (ZMod 6) := ⊤

private lemma mem_two_torsion_image_iff (x : ZMod 6) :
    x ∈ intIdeal 2 • torsionN ↔ x = 0 ∨ x = 2 ∨ x = 4 := by
  rw [intIdeal, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists]
  simp only [torsionN, Submodule.mem_top, true_and]
  simp only [← Int.cast_smul_eq_zsmul (ZMod 6), smul_eq_mul]
  constructor
  · rintro ⟨b, rfl⟩
    fin_cases b
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
  · rintro (rfl | rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩

private lemma mem_three_torsion_image_iff (x : ZMod 6) :
    x ∈ intIdeal 3 • torsionN ↔ x = 0 ∨ x = 3 := by
  rw [intIdeal, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists]
  simp only [torsionN, Submodule.mem_top, true_and]
  simp only [← Int.cast_smul_eq_zsmul (ZMod 6), smul_eq_mul]
  constructor
  · rintro ⟨b, rfl⟩
    fin_cases b
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

private lemma torsion_six_image : intIdeal 6 • torsionN = ⊥ := by
  ext x
  rw [intIdeal, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_bot]
  simp only [torsionN, Submodule.mem_top, true_and]
  simp only [← Int.cast_smul_eq_zsmul (ZMod 6), smul_eq_mul]
  constructor
  · rintro ⟨b, rfl⟩
    fin_cases b <;> rfl
  · rintro rfl
    exact ⟨0, rfl⟩

private lemma torsion_image_meet :
    (intIdeal 2 • torsionN) ⊓ (intIdeal 3 • torsionN) = ⊥ := by
  ext x
  rw [Submodule.mem_inf, mem_two_torsion_image_iff, mem_three_torsion_image_iff,
    Submodule.mem_bot]
  constructor
  · rintro ⟨h2, h3⟩
    rcases h2 with h0 | h2 | h4
    · exact h0
    · rcases h3 with h0 | h3
      · exact h0
      · have h23 : (2 : ℕ) = 3 := congrArg ZMod.val (h2.symm.trans h3)
        cases h23
    · rcases h3 with h0 | h3
      · exact h0
      · have h43 : (4 : ℕ) = 3 := congrArg ZMod.val (h4.symm.trans h3)
        cases h43
  · intro h0
    exact ⟨Or.inl h0, Or.inl h0⟩

private theorem torsion_fixed_equality :
    (intIdeal 2 ⊓ intIdeal 3) • torsionN =
      (intIdeal 2 • torsionN) ⊓ (intIdeal 3 • torsionN) := by
  rw [int_ideal_meet, torsion_six_image, torsion_image_meet]

private theorem torsion_nonzero_images :
    (2 : ZMod 6) ≠ 0 ∧ (2 : ZMod 6) ∈ intIdeal 2 • torsionN ∧
      (3 : ZMod 6) ≠ 0 ∧ (3 : ZMod 6) ∈ intIdeal 3 • torsionN := by
  refine ⟨by decide, (mem_two_torsion_image_iff _).mpr (Or.inr (Or.inl rfl)),
    by decide, (mem_three_torsion_image_iff _).mpr (Or.inr rfl)⟩

private theorem torsion_witness :
    ∃ x : ZMod 6, x ≠ 0 ∧ (6 : ℤ) • x = 0 := by
  exact ⟨1, by decide, by decide⟩

end IntegerTorsion

section NaturalCoordinates

private abbrev NatTriple := ℕ × (ℕ × ℕ)

private def firstProjection : NatTriple →+* ℕ := RingHom.fst ℕ (ℕ × ℕ)

private def secondProjection : NatTriple →+* ℕ :=
  (RingHom.fst ℕ ℕ).comp (RingHom.snd ℕ (ℕ × ℕ))

private def firstKernel : Ideal NatTriple := RingHom.ker firstProjection
private def secondKernel : Ideal NatTriple := RingHom.ker secondProjection

private def coordinateGenerator : NatTriple := (2, 3, 5)
private def coordinateN : Submodule NatTriple NatTriple :=
  Submodule.span NatTriple {coordinateGenerator}

private lemma mem_firstKernel_iff (x : NatTriple) : x ∈ firstKernel ↔ x.1 = 0 := by
  rfl

private lemma mem_secondKernel_iff (x : NatTriple) :
    x ∈ secondKernel ↔ x.2.1 = 0 := by
  rfl

private lemma mem_coordinateN_iff (x : NatTriple) :
    x ∈ coordinateN ↔ 2 ∣ x.1 ∧ 3 ∣ x.2.1 ∧ 5 ∣ x.2.2 := by
  rw [coordinateN, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨r, hr⟩
    change r * coordinateGenerator = x at hr
    refine ⟨⟨r.1, ?_⟩, ⟨r.2.1, ?_⟩, ⟨r.2.2, ?_⟩⟩
    · simpa [coordinateGenerator, Nat.mul_comm] using (congrArg Prod.fst hr).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.1) hr).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.2) hr).symm
  · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩⟩
    refine ⟨(a, b, c), ?_⟩
    change (a * 2, b * 3, c * 5) = x
    apply Prod.ext
    · simpa [Nat.mul_comm] using ha.symm
    · apply Prod.ext
      · simpa [Nat.mul_comm] using hb.symm
      · simpa [Nat.mul_comm] using hc.symm

private theorem coordinate_comaximal : firstKernel ⊔ secondKernel = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  exact ⟨(0, 1, 1), (mem_firstKernel_iff _).mpr rfl,
    (1, 0, 0), (mem_secondKernel_iff _).mpr rfl, rfl⟩

private lemma mem_first_image_iff (x : NatTriple) :
    x ∈ firstKernel • coordinateN ↔ x.1 = 0 ∧ 3 ∣ x.2.1 ∧ 5 ∣ x.2.2 := by
  rw [coordinateN, Submodule.mem_smul_span_singleton]
  constructor
  · rintro ⟨r, hr, h⟩
    have hr0 := (mem_firstKernel_iff r).mp hr
    change r * coordinateGenerator = x at h
    refine ⟨?_, ⟨r.2.1, ?_⟩, ⟨r.2.2, ?_⟩⟩
    · simpa [coordinateGenerator, hr0] using (congrArg Prod.fst h).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.1) h).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.2) h).symm
  · rintro ⟨hx, ⟨b, hb⟩, ⟨c, hc⟩⟩
    refine ⟨(0, b, c), (mem_firstKernel_iff _).mpr rfl, ?_⟩
    change (0 * 2, b * 3, c * 5) = x
    apply Prod.ext
    · simpa using hx.symm
    · apply Prod.ext
      · simpa [Nat.mul_comm] using hb.symm
      · simpa [Nat.mul_comm] using hc.symm

private lemma mem_second_image_iff (x : NatTriple) :
    x ∈ secondKernel • coordinateN ↔ x.2.1 = 0 ∧ 2 ∣ x.1 ∧ 5 ∣ x.2.2 := by
  rw [coordinateN, Submodule.mem_smul_span_singleton]
  constructor
  · rintro ⟨r, hr, h⟩
    have hr0 := (mem_secondKernel_iff r).mp hr
    change r * coordinateGenerator = x at h
    refine ⟨?_, ⟨r.1, ?_⟩, ⟨r.2.2, ?_⟩⟩
    · simpa [coordinateGenerator, hr0] using
        (congrArg (fun y : NatTriple ↦ y.2.1) h).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using (congrArg Prod.fst h).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.2) h).symm
  · rintro ⟨hx, ⟨a, ha⟩, ⟨c, hc⟩⟩
    refine ⟨(a, 0, c), (mem_secondKernel_iff _).mpr rfl, ?_⟩
    change (a * 2, 0 * 3, c * 5) = x
    apply Prod.ext
    · simpa [Nat.mul_comm] using ha.symm
    · apply Prod.ext
      · simpa using hx.symm
      · simpa [Nat.mul_comm] using hc.symm

private lemma mem_common_image_iff (x : NatTriple) :
    x ∈ (firstKernel ⊓ secondKernel) • coordinateN ↔
      x.1 = 0 ∧ x.2.1 = 0 ∧ 5 ∣ x.2.2 := by
  rw [coordinateN, Submodule.mem_smul_span_singleton]
  constructor
  · rintro ⟨r, hr, h⟩
    have hr1 := (mem_firstKernel_iff r).mp hr.1
    have hr2 := (mem_secondKernel_iff r).mp hr.2
    change r * coordinateGenerator = x at h
    refine ⟨?_, ?_, ⟨r.2.2, ?_⟩⟩
    · simpa [coordinateGenerator, hr1] using (congrArg Prod.fst h).symm
    · simpa [coordinateGenerator, hr2] using
        (congrArg (fun y : NatTriple ↦ y.2.1) h).symm
    · simpa [coordinateGenerator, Nat.mul_comm] using
        (congrArg (fun y : NatTriple ↦ y.2.2) h).symm
  · rintro ⟨hx1, hx2, ⟨c, hc⟩⟩
    refine ⟨(0, 0, c), ⟨(mem_firstKernel_iff _).mpr rfl,
      (mem_secondKernel_iff _).mpr rfl⟩, ?_⟩
    change (0 * 2, 0 * 3, c * 5) = x
    apply Prod.ext
    · simpa using hx1.symm
    · apply Prod.ext
      · simpa using hx2.symm
      · simpa [Nat.mul_comm] using hc.symm

private theorem coordinate_proper : coordinateN ≠ ⊤ := by
  intro h
  have h1 : (1 : NatTriple) ∈ coordinateN := by
    rw [h]
    exact Submodule.mem_top
  have hd : (2 : ℕ) ∣ 1 := ((mem_coordinateN_iff _).mp h1).1
  norm_num at hd

private theorem coordinate_fixed_equality :
    (firstKernel ⊓ secondKernel) • coordinateN =
      (firstKernel • coordinateN) ⊓ (secondKernel • coordinateN) := by
  ext x
  rw [Submodule.mem_inf, mem_common_image_iff, mem_first_image_iff, mem_second_image_iff]
  constructor
  · rintro ⟨hx1, hx2, h5⟩
    refine ⟨⟨hx1, ?_, h5⟩, ⟨hx2, ?_, h5⟩⟩
    · rw [hx2]
      exact dvd_zero _
    · rw [hx1]
      exact dvd_zero _
  · rintro ⟨⟨hx1, _, h5⟩, ⟨hx2, _, _⟩⟩
    exact ⟨hx1, hx2, h5⟩

private theorem coordinate_equality_of_comaximal :
    (firstKernel ⊓ secondKernel) • coordinateN =
      (firstKernel • coordinateN) ⊓ (secondKernel • coordinateN) :=
  Submodule.ideal_smul_inf_of_sup_eq_top coordinateN coordinate_comaximal

private theorem coordinate_common_witness :
    ((0, 0, 5) : NatTriple) ≠ 0 ∧
      ((0, 0, 5) : NatTriple) ∈ (firstKernel ⊓ secondKernel) • coordinateN := by
  constructor
  · intro h
    have h5 := congrArg (fun x : NatTriple ↦ x.2.2) h
    norm_num at h5
  · exact (mem_common_image_iff _).mpr ⟨rfl, rfl, dvd_rfl⟩

private theorem coordinate_common_ne_bot :
    (firstKernel ⊓ secondKernel) • coordinateN ≠ ⊥ := by
  intro h
  have hw := coordinate_common_witness.2
  rw [h, Submodule.mem_bot] at hw
  exact coordinate_common_witness.1 hw

private theorem coordinate_image_meet_ne_bot :
    (firstKernel • coordinateN) ⊓ (secondKernel • coordinateN) ≠ ⊥ := by
  rw [← coordinate_fixed_equality]
  exact coordinate_common_ne_bot

-- This excludes additive inverses for the canonical addition, not unrelated
-- structures transported onto the underlying type.
private theorem coordinate_no_additive_inverse :
    ¬ ∃ y : NatTriple, (1 : NatTriple) + y = 0 := by
  rintro ⟨y, hy⟩
  have h1 := congrArg Prod.fst hy
  change 1 + y.1 = 0 at h1
  norm_num at h1

private theorem coordinate_no_negation :
    ¬ ∃ neg : NatTriple → NatTriple, ∀ x, neg x + x = 0 := by
  rintro ⟨neg, hneg⟩
  apply coordinate_no_additive_inverse
  exact ⟨neg 1, by rw [add_comm]; exact hneg 1⟩

end NaturalCoordinates

end AdicModulesTest.ScalarIntersection
