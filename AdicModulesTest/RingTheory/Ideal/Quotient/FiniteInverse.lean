module

import AdicModules.RingTheory.Ideal.Quotient.Finite
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-!
# Inverse classes and all integer representatives

For the span ideals generated by `2` and `3`, the public equivalence sends the
class of `8` to the classes of `0` and `2`. Its inverse recovers that class,
uniquely in the quotient. All ring representatives are precisely the integers
whose difference from `8` lies in the span ideal generated by `6`.
-/

namespace Ideal

local notation "moduli" => (![2, 3] : Fin 2 → ℤ)
local notation "residues" => (![0, 2] : Fin 2 → ℤ)
local notation "integerIdeals" => (fun i : Fin 2 => (Ideal.span {moduli i} : Ideal ℤ))
local notation "prescribedClasses" =>
  (fun i : Fin 2 => Ideal.Quotient.mk (integerIdeals i) (residues i))

private theorem moduli_coprime : Pairwise (fun i j => IsCoprime (moduli i) (moduli j)) := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact ⟨-1, 1, by norm_num⟩
  · exact ⟨1, -1, by norm_num⟩
  · exact (hij rfl).elim

private theorem integerIdeals_pairwise_sup_eq_top :
    Pairwise (fun i j => integerIdeals i ⊔ integerIdeals j = ⊤) := by
  intro i j hij
  exact (Ideal.sup_eq_top_iff_isCoprime (moduli i) (moduli j)).mpr (moduli_coprime hij)

local notation "integerEquiv" =>
  (Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop
    integerIdeals integerIdeals_pairwise_sup_eq_top)

private theorem congruences_eight (i : Fin 2) :
    (8 : ℤ) - residues i ∈ integerIdeals i := by
  rw [Ideal.mem_span_singleton]
  fin_cases i <;> norm_num

private theorem inverse_eight :
    (integerEquiv).symm prescribedClasses = Ideal.Quotient.mk (⨅ i, integerIdeals i) 8 := by
  apply (Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_symm_apply_eq_mk_iff
    integerIdeals integerIdeals_pairwise_sup_eq_top prescribedClasses 8).mpr
  intro i
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (congruences_eight i)

private theorem inverse_scalar_two_eight :
    (integerEquiv).symm ((2 : ℤ) • prescribedClasses) =
      (2 : ℤ) • Ideal.Quotient.mk (⨅ i, integerIdeals i) 8 := by
  rw [Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_symm_smul, inverse_eight]

private theorem forward_eight :
    integerEquiv (Ideal.Quotient.mk (⨅ i, integerIdeals i) 8) = prescribedClasses := by
  rw [← inverse_eight]
  exact (integerEquiv).apply_symm_apply prescribedClasses

private theorem unique_quotient_class :
    ∃! z : ℤ ⧸ ⨅ i, integerIdeals i,
      Ideal.quotientInfToPiQuotient integerIdeals z = prescribedClasses :=
  Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_existsUnique_preimage
    integerIdeals integerIdeals_pairwise_sup_eq_top prescribedClasses

private theorem intersection_eq_span_six :
    (⨅ i, integerIdeals i) = Ideal.span {(6 : ℤ)} := by
  rw [Ideal.iInf_span_singleton (I := moduli) (fun i j hij => moduli_coprime hij)]
  norm_num [Fin.prod_univ_two]

private theorem integer_generator_characteristics (a : ℤ) :
    (a • integerEquiv (Ideal.Quotient.mk (⨅ i, integerIdeals i) (1 : ℤ)) = 0 ↔
      (6 : ℤ) ∣ a) ∧
      Submodule.span ℤ
        {integerEquiv (Ideal.Quotient.mk (⨅ i, integerIdeals i) (1 : ℤ))} = ⊤ := by
  constructor
  · rw [Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_smul_mk_one_eq_zero_iff,
      intersection_eq_span_six, Ideal.mem_span_singleton]
  · exact Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_span_singleton_mk_one
      integerIdeals integerIdeals_pairwise_sup_eq_top

private theorem all_integer_representatives (r : ℤ) :
    (∀ i, Ideal.Quotient.mk (integerIdeals i) r = prescribedClasses i) ↔
      r - 8 ∈ Ideal.span {(6 : ℤ)} := by
  rw [← intersection_eq_span_six]
  exact Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_forall_mk_eq_iff_sub_mem
    integerIdeals integerIdeals_pairwise_sup_eq_top prescribedClasses inverse_eight.symm r

private theorem stock_inverse_eight :
    (Ideal.quotientInfRingEquivPiQuotient integerIdeals
      (fun i j hij => (Ideal.isCoprime_span_singleton_iff (moduli i) (moduli j)).mpr
        (moduli_coprime hij))).symm prescribedClasses =
      Ideal.Quotient.mk (⨅ i, integerIdeals i) 8 := by
  apply (Ideal.quotientInfRingEquivPiQuotient_symm_apply_eq_mk_iff
    integerIdeals _ prescribedClasses 8).mpr
  intro i
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (congruences_eight i)

end Ideal
