module

import AdicModules.RingTheory.Ideal.Quotient.Finite
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-!
# A fixed integer use of the finite Chinese remainder equivalence

The public equivalence for the ideals generated by `2` and `3` sends the class
of `8` to the classes of `0` and `2`. The ideals are spans of integer elements,
not numerals in the ideal semiring.

## References

The `[8]` calculation uses the canonical finite ring equivalence of
`AdicModules.RingTheory.Ideal.Quotient.Finite`, with Mathlib's integer principal
ideals and quotient-residue arithmetic for `(2)` and `(3)`.
-/

namespace Ideal

private def moduli : Fin 2 → ℤ := ![2, 3]
private def residues : Fin 2 → ℤ := ![0, 2]
private def integerIdeals (i : Fin 2) : Ideal ℤ := Ideal.span {moduli i}

private theorem moduli_coprime : Pairwise (fun i j => IsCoprime (moduli i) (moduli j)) := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact ⟨-1, 1, by norm_num [moduli]⟩
  · exact ⟨1, -1, by norm_num [moduli]⟩
  · exact (hij rfl).elim

private theorem integerIdeals_pairwise_sup_eq_top :
    Pairwise (fun i j => integerIdeals i ⊔ integerIdeals j = ⊤) := by
  intro i j hij
  exact Ideal.isCoprime_iff_sup_eq.mp
    ((Ideal.isCoprime_span_singleton_iff (moduli i) (moduli j)).mpr (moduli_coprime hij))

private theorem congruences_eight (i : Fin 2) :
    (8 : ℤ) - residues i ∈ integerIdeals i := by
  rw [integerIdeals, Ideal.mem_span_singleton]
  fin_cases i <;> norm_num [moduli, residues]

private theorem forward_eight :
    Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop
        integerIdeals integerIdeals_pairwise_sup_eq_top
        (Ideal.Quotient.mk (⨅ i, integerIdeals i) 8) =
      fun i => Ideal.Quotient.mk (integerIdeals i) (residues i) := by
  rw [Ideal.quotientInfRingEquivPiQuotientOfPairwiseSupEqTop_mk]
  funext i
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (congruences_eight i)

end Ideal
