/-!
# Finite congruence classes in ideal quotients

The canonical map from the quotient by an intersection of two-sided ideals
has values in the product of the individual quotients. Its characteristic
formulas involve quotient classes, not chosen representatives. The left ring
actions on both sides are the quotient and coordinatewise module actions.
Reduction along ideal inclusions, including decreasing powers, compares these
classes at different precisions.

For the integer ideals generated by `2`, `3`, and `5`, with exponents `2`, `2`,
and `1`, the Chinese remainder equivalence sends the class of `172` to the
classes of `0`, `1`, and `2`. The intersection is generated by `180`, so the
representatives of this class are exactly `172 + 180 * k`. Empty and singleton
families, zeroth powers, and the one-element ring describe the boundary cases.
Repeated powers of the ideal generated by `2` give incompatible congruences
and exhibit the role of pairwise comaximality.

The commutative equivalences below use Mathlib's
`Ideal.quotientInfRingEquivPiQuotient`. Principal ideals are specified by spans
of integer elements, rather than by numerals in the ideal semiring.

## References

These original integer and boundary calculations use Mathlib's commutative
`Ideal.quotientInfRingEquivPiQuotient`, canonical quotient module actions and
integer span, divisibility, intersection and congruence APIs. They do not assume
an arbitrary-left-ideal ring CRT.
-/

universe u v

namespace Ideal

-- The finite two-sided surjectivity proposition and the full equivalence type.
#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  {I : ι → Ideal R} [∀ i, (I i).IsTwoSided],
  Pairwise (fun i j => I i ⊔ I j = ⊤) →
  Function.Surjective (Ideal.quotientInfToPiQuotient I))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided],
  Pairwise (fun i j => I i ⊔ I j = ⊤) →
  ((R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i)))

-- Characterization at the canonical carriers, with no selected representative.
#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided],
  Pairwise (fun i j => I i ⊔ I j = ⊤) →
  ∃ e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i),
    e.toRingHom = Ideal.quotientInfToPiQuotient I)

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (_he : e.toRingHom = Ideal.quotientInfToPiQuotient I),
  (∀ r : R, e (Ideal.Quotient.mk (⨅ i, I i) r) =
    fun i => Ideal.Quotient.mk (I i) r) ∧
  (∀ (r : R) (i : ι), e (Ideal.Quotient.mk (⨅ j, I j) r) i =
    Ideal.Quotient.mk (I i) r) ∧
  (∀ (z : R ⧸ ⨅ j, I j) (i : ι),
    e z i = Ideal.Quotient.factor (iInf_le I i) z))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (_he : e.toRingHom = Ideal.quotientInfToPiQuotient I),
  (∀ q : (i : ι) → R ⧸ I i,
    Ideal.quotientInfToPiQuotient I (e.symm q) = q) ∧
  (∀ (q : (i : ι) → R ⧸ I i) (i : ι),
    Ideal.Quotient.factor (iInf_le I i) (e.symm q) = q i) ∧
  (∀ r : R, e.symm (fun i => Ideal.Quotient.mk (I i) r) =
    Ideal.Quotient.mk (⨅ i, I i) r) ∧
  (∀ q : (i : ι) → R ⧸ I i,
    ∃! z : R ⧸ ⨅ i, I i, Ideal.quotientInfToPiQuotient I z = q) ∧
  (∀ (q : (i : ι) → R ⧸ I i) (r : R),
    (∀ i, Ideal.Quotient.mk (I i) r = q i) ↔
      Ideal.Quotient.mk (⨅ i, I i) r = e.symm q))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤)),
  (∀ a : ι → R, ∃ r : R, ∀ i, r - a i ∈ I i) ∧
  (∀ r s : R,
    (∀ i, Ideal.Quotient.mk (I i) r = Ideal.Quotient.mk (I i) s) ↔
      r - s ∈ ⨅ i, I i) ∧
  (∀ (a : ι → R) (r₀ : R), (∀ i, r₀ - a i ∈ I i) →
    ∀ r : R, (∀ i, r - a i ∈ I i) ↔ r - r₀ ∈ ⨅ i, I i))

-- Scalar compatibility is a hypothesis of the additive-to-linear conversion.
#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (_he : e.toRingHom = Ideal.quotientInfToPiQuotient I),
  (∀ c x : R, c • Ideal.Quotient.mk (⨅ i, I i) x =
    Ideal.Quotient.mk (⨅ i, I i) (c * x)) ∧
  (∀ (c : R) (z : R ⧸ ⨅ i, I i),
    c • z = Ideal.Quotient.mk (⨅ i, I i) c * z) ∧
  (∀ (c : R) (q : (i : ι) → R ⧸ I i) (i : ι), (c • q) i = c • q i) ∧
  (∀ (c : R) (z : R ⧸ ⨅ i, I i), e (c • z) = c • e z) ∧
  (∀ (c : R) (q : (i : ι) → R ⧸ I i), e.symm (c • q) = c • e.symm q))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (_he : e.toRingHom = Ideal.quotientInfToPiQuotient I)
  (hsmul : ∀ (c : R) (z : R ⧸ ⨅ i, I i), e (c • z) = c • e z),
  (⇑(e.toAddEquiv.toLinearEquiv hsmul :
      (R ⧸ ⨅ i, I i) ≃ₗ[R] ((i : ι) → R ⧸ I i)) :
      (R ⧸ ⨅ i, I i) → ((i : ι) → R ⧸ I i)) = e ∧
  (⇑(e.toAddEquiv.toLinearEquiv hsmul).symm :
      ((i : ι) → R ⧸ I i) → (R ⧸ ⨅ i, I i)) = e.symm)

-- The meet inclusion and coordinate factors point from finer to coarser ideals.
#check (∀ {R : Type u} {ι : Type v} [Ring R]
  (I J : ι → Ideal R) [∀ i, (I i).IsTwoSided] [∀ i, (J i).IsTwoSided]
  (hIJ : ∀ i, I i ≤ J i) (z : R ⧸ ⨅ i, I i) (i : ι),
  Ideal.quotientInfToPiQuotient J
      (Ideal.Quotient.factor (iInf_mono hIJ) z) i =
    Ideal.Quotient.factor (hIJ i) (Ideal.quotientInfToPiQuotient I z i))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I J : ι → Ideal R) [∀ i, (I i).IsTwoSided] [∀ i, (J i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (_hJ : Pairwise (fun i j => J i ⊔ J j = ⊤))
  (hIJ : ∀ i, I i ≤ J i)
  (eI : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (eJ : (R ⧸ ⨅ i, J i) ≃+* ((i : ι) → R ⧸ J i))
  (_heI : eI.toRingHom = Ideal.quotientInfToPiQuotient I)
  (_heJ : eJ.toRingHom = Ideal.quotientInfToPiQuotient J),
  (∀ (z : R ⧸ ⨅ i, I i) (i : ι),
    eJ (Ideal.Quotient.factor (iInf_mono hIJ) z) i =
      Ideal.Quotient.factor (hIJ i) (eI z i)) ∧
  (∀ q : (i : ι) → R ⧸ I i,
    Ideal.Quotient.factor (iInf_mono hIJ) (eI.symm q) =
      eJ.symm (fun i => Ideal.Quotient.factor (hIJ i) (q i))))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤)) (n : ι → ℕ),
  Function.Surjective (Ideal.quotientInfToPiQuotient (fun i => I i ^ n i)))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤)) (n : ι → ℕ),
  ((R ⧸ ⨅ i, I i ^ n i) ≃+* ((i : ι) → R ⧸ I i ^ n i)))

#check (∀ {R : Type u} {ι : Type v} [Ring R] [Finite ι]
  (I : ι → Ideal R) [∀ i, (I i).IsTwoSided]
  (_hI : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (n m : ι → ℕ) (hnm : ∀ i, n i ≤ m i)
  (em : (R ⧸ ⨅ i, I i ^ m i) ≃+* ((i : ι) → R ⧸ I i ^ m i))
  (en : (R ⧸ ⨅ i, I i ^ n i) ≃+* ((i : ι) → R ⧸ I i ^ n i))
  (_hem : em.toRingHom = Ideal.quotientInfToPiQuotient (fun i => I i ^ m i))
  (_hen : en.toRingHom = Ideal.quotientInfToPiQuotient (fun i => I i ^ n i)),
  (∀ (z : R ⧸ ⨅ i, I i ^ m i) (i : ι),
    en (Ideal.Quotient.factor
      (iInf_mono (fun i => Ideal.pow_le_pow_right (hnm i))) z) i =
      Ideal.Quotient.factorPow (I i) (hnm i) (em z i)) ∧
  (∀ q : (i : ι) → R ⧸ I i ^ m i,
    Ideal.Quotient.factor
        (iInf_mono (fun i => Ideal.pow_le_pow_right (hnm i))) (em.symm q) =
      en.symm (fun i => Ideal.Quotient.factorPow (I i) (hnm i) (q i))))

-- Agreement of equivalences, and hence of inverse classes, in a commutative ring.
#check (∀ {R : Type u} {ι : Type v} [CommRing R] [Finite ι]
  (I : ι → Ideal R) (hSup : Pairwise (fun i j => I i ⊔ I j = ⊤))
  (e : (R ⧸ ⨅ i, I i) ≃+* ((i : ι) → R ⧸ I i))
  (_he : e.toRingHom = Ideal.quotientInfToPiQuotient I),
  e = Ideal.quotientInfRingEquivPiQuotient I
      (fun _ _ hij => Ideal.isCoprime_iff_sup_eq.mpr (hSup hij)) ∧
  e.symm = (Ideal.quotientInfRingEquivPiQuotient I
      (fun _ _ hij => Ideal.isCoprime_iff_sup_eq.mpr (hSup hij))).symm)

private theorem pairwise_sup_powers {R : Type u} {ι : Type v} [Semiring R]
    (I : ι → Ideal R) (hI : Pairwise (fun i j => I i ⊔ I j = ⊤)) (n : ι → ℕ) :
    Pairwise (fun i j => I i ^ n i ⊔ I j ^ n j = ⊤) := by
  intro i j hij
  have h : I i ⊔ I j ^ n j = ⊤ :=
    sup_pow_eq_top_of_sup_eq_top (J := I i) (I := I j) (n := n j) (hI hij)
  have h' : I j ^ n j ⊔ I i ^ n i = ⊤ :=
    sup_pow_eq_top_of_sup_eq_top (J := I j ^ n j) (I := I i) (n := n i)
      ((sup_comm (I j ^ n j) (I i)).trans h)
  exact (sup_comm (I i ^ n i) (I j ^ n j)).trans h'

section Integers

private def primes : Fin 3 → ℤ := ![2, 3, 5]
private def exponents : Fin 3 → ℕ := ![2, 2, 1]
private def residues : Fin 3 → ℤ := ![0, 1, 2]
private def primeIdeals (i : Fin 3) : Ideal ℤ := Ideal.span {primes i}
private def poweredIdeals (i : Fin 3) : Ideal ℤ := primeIdeals i ^ exponents i
private def moduli (i : Fin 3) : ℤ := primes i ^ exponents i
private def prescribedClasses (i : Fin 3) : ℤ ⧸ poweredIdeals i :=
  Ideal.Quotient.mk (poweredIdeals i) (residues i)

private theorem primes_coprime : Pairwise (fun i j => IsCoprime (primes i) (primes j)) := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact ⟨-1, 1, by norm_num [primes]⟩
  · exact ⟨-2, 1, by norm_num [primes]⟩
  · exact ⟨1, -1, by norm_num [primes]⟩
  · exact (hij rfl).elim
  · exact ⟨2, -1, by norm_num [primes]⟩
  · exact ⟨1, -2, by norm_num [primes]⟩
  · exact ⟨-1, 2, by norm_num [primes]⟩
  · exact (hij rfl).elim

private theorem primeIdeals_coprime : Pairwise (fun i j => IsCoprime (primeIdeals i)
    (primeIdeals j)) := by
  intro i j hij
  exact (Ideal.isCoprime_span_singleton_iff (primes i) (primes j)).mpr
    (primes_coprime hij)

private theorem primeIdeals_powers_coprime (n : Fin 3 → ℕ) :
    Pairwise (fun i j => IsCoprime (primeIdeals i ^ n i) (primeIdeals j ^ n j)) := by
  intro i j hij
  exact (primeIdeals_coprime hij).pow

private theorem poweredIdeals_coprime :
    Pairwise (fun i j => IsCoprime (poweredIdeals i) (poweredIdeals j)) :=
  primeIdeals_powers_coprime exponents

private theorem powered_eq_span (i : Fin 3) : poweredIdeals i = Ideal.span {moduli i} :=
  Ideal.span_singleton_pow (primes i) (exponents i)

private theorem positive_parameters : (∀ i, 0 < primes i) ∧ (∀ i, 0 < exponents i) := by
  constructor <;> intro i <;> fin_cases i <;> norm_num [primes, exponents]

private theorem primeIdeal_controls (i : Fin 3) :
    primeIdeals i ≠ ⊥ ∧ primeIdeals i ≠ ⊤ := by
  constructor
  · rw [primeIdeals, Ne, Ideal.span_singleton_eq_bot]
    fin_cases i <;> norm_num [primes]
  · apply (Ideal.ne_top_iff_one _).mpr
    rw [primeIdeals, Ideal.mem_span_singleton]
    fin_cases i <;> norm_num [primes]

private theorem poweredIdeal_controls (i : Fin 3) :
    poweredIdeals i ≠ ⊥ ∧ poweredIdeals i ≠ ⊤ := by
  rw [powered_eq_span]
  constructor
  · rw [Ne, Ideal.span_singleton_eq_bot]
    fin_cases i <;> norm_num [moduli, primes, exponents]
  · apply (Ideal.ne_top_iff_one _).mpr
    rw [Ideal.mem_span_singleton]
    fin_cases i <;> norm_num [moduli, primes, exponents]

private theorem primeIdeals_distinct : Pairwise (fun i j => primeIdeals i ≠ primeIdeals j) := by
  intro i j hij h
  have hm : primes i ∈ primeIdeals j := h ▸ Ideal.mem_span_singleton_self (primes i)
  have hd : primes j ∣ primes i := Ideal.mem_span_singleton.mp hm
  fin_cases i <;> fin_cases j <;> first
  | exact (hij rfl).elim
  | norm_num [primes] at hd

private theorem poweredIdeals_distinct :
    Pairwise (fun i j => poweredIdeals i ≠ poweredIdeals j) := by
  intro i j hij h
  have hm : moduli i ∈ poweredIdeals i := by
    rw [powered_eq_span]
    exact Ideal.mem_span_singleton_self _
  have hm' : moduli i ∈ poweredIdeals j := h ▸ hm
  rw [powered_eq_span, Ideal.mem_span_singleton] at hm'
  fin_cases i <;> fin_cases j <;> first
  | exact (hij rfl).elim
  | norm_num [moduli, primes, exponents] at hm'

private theorem differences :
    (172 : ℤ) - 0 = 43 * 4 ∧ (172 : ℤ) - 1 = 19 * 9 ∧ (172 : ℤ) - 2 = 34 * 5 := by
  norm_num

private theorem congruences_172 (i : Fin 3) : (172 : ℤ) - residues i ∈ poweredIdeals i := by
  rw [powered_eq_span, Ideal.mem_span_singleton']
  fin_cases i
  · exact ⟨43, by simp [moduli, primes, exponents, residues]⟩
  · exact ⟨19, by simp [moduli, primes, exponents, residues]⟩
  · exact ⟨34, by simp [moduli, primes, exponents, residues]⟩

private noncomputable def integerEquiv :
    (ℤ ⧸ ⨅ i, poweredIdeals i) ≃+* ((i : Fin 3) → ℤ ⧸ poweredIdeals i) :=
  Ideal.quotientInfRingEquivPiQuotient poweredIdeals poweredIdeals_coprime

private theorem forward_172 :
    integerEquiv (Ideal.Quotient.mk (⨅ i, poweredIdeals i) 172) = prescribedClasses := by
  change Ideal.quotientInfToPiQuotient poweredIdeals
    (Ideal.Quotient.mk (⨅ i, poweredIdeals i) 172) = prescribedClasses
  rw [Ideal.quotientInfToPiQuotient_mk]
  funext i
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (congruences_172 i)

private theorem inverse_172 :
    integerEquiv.symm prescribedClasses = Ideal.Quotient.mk (⨅ i, poweredIdeals i) 172 := by
  apply integerEquiv.injective
  rw [integerEquiv.apply_symm_apply, forward_172]

private theorem class_of_all_representatives (x : ℤ) :
    (∀ i, Ideal.Quotient.mk (poweredIdeals i) x = prescribedClasses i) ↔
      Ideal.Quotient.mk (⨅ i, poweredIdeals i) x =
        Ideal.Quotient.mk (⨅ i, poweredIdeals i) 172 := by
  constructor
  · intro hx
    apply integerEquiv.injective
    calc
      integerEquiv (Ideal.Quotient.mk (⨅ i, poweredIdeals i) x) = prescribedClasses := by
        change Ideal.quotientInfToPiQuotient poweredIdeals
          (Ideal.Quotient.mk (⨅ i, poweredIdeals i) x) = prescribedClasses
        rw [Ideal.quotientInfToPiQuotient_mk]
        exact funext hx
      _ = integerEquiv (Ideal.Quotient.mk (⨅ i, poweredIdeals i) 172) := forward_172.symm
  · intro hx i
    exact congrFun ((congrArg integerEquiv hx).trans forward_172) i

private theorem intersection_eq_span_180 :
    (⨅ i, poweredIdeals i) = Ideal.span {(180 : ℤ)} := by
  simp_rw [powered_eq_span]
  rw [Ideal.iInf_span_singleton (I := moduli) (fun i j hij => (primes_coprime hij).pow)]
  norm_num [moduli, primes, exponents, Fin.prod_univ_succ]

private theorem all_integer_solutions (x : ℤ) :
    (∀ i, Ideal.Quotient.mk (poweredIdeals i) x = prescribedClasses i) ↔
      ∃ k : ℤ, x = 172 + 180 * k := by
  rw [class_of_all_representatives, Ideal.Quotient.mk_eq_mk_iff_sub_mem,
    intersection_eq_span_180, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    calc
      x = 172 + (x - 172) := by ring
      _ = 172 + 180 * k := by rw [hk]
  · rintro ⟨k, rfl⟩
    exact ⟨k, by ring⟩

end Integers

section Boundary

private theorem empty_coprime :
    Pairwise (fun _ _ : Fin 0 => IsCoprime (Ideal.span {(2 : ℤ)})
      (Ideal.span {(2 : ℤ)})) := by
  intro i
  exact Fin.elim0 i

private noncomputable def emptyEquiv :
    (ℤ ⧸ ⨅ _i : Fin 0, Ideal.span {(2 : ℤ)}) ≃+*
      ((_i : Fin 0) → ℤ ⧸ Ideal.span {(2 : ℤ)}) :=
  Ideal.quotientInfRingEquivPiQuotient (fun _ : Fin 0 => Ideal.span {(2 : ℤ)}) empty_coprime

private theorem empty_inverse (q : (_i : Fin 0) → ℤ ⧸ Ideal.span {(2 : ℤ)}) (r : ℤ) :
    emptyEquiv.symm q = Ideal.Quotient.mk (⨅ _i : Fin 0, Ideal.span {(2 : ℤ)}) r := by
  apply emptyEquiv.injective
  funext i
  exact Fin.elim0 i

private theorem singleton_coprime :
    Pairwise (fun _i _j : Fin 1 => IsCoprime (poweredIdeals 0) (poweredIdeals 0)) := by
  intro i j hij
  exact (hij (Subsingleton.elim i j)).elim

private noncomputable def singletonEquiv :
    (ℤ ⧸ ⨅ _i : Fin 1, poweredIdeals 0) ≃+*
      ((_i : Fin 1) → ℤ ⧸ poweredIdeals 0) :=
  Ideal.quotientInfRingEquivPiQuotient (fun _ : Fin 1 => poweredIdeals 0) singleton_coprime

private theorem singleton_inverse (r : ℤ) :
    singletonEquiv.symm (fun _ => Ideal.Quotient.mk (poweredIdeals 0) r) =
      Ideal.Quotient.mk (⨅ _i : Fin 1, poweredIdeals 0) r := by
  apply singletonEquiv.injective
  rw [singletonEquiv.apply_symm_apply]
  rfl

private theorem singleton_nontrivial : Nontrivial (ℤ ⧸ poweredIdeals 0) :=
  Ideal.Quotient.nontrivial_iff.mpr (poweredIdeal_controls 0).2

private theorem zero_component (i : Fin 3) : Subsingleton (ℤ ⧸ primeIdeals i ^ 0) :=
  Ideal.Quotient.subsingleton_iff.mpr (by simp)

private noncomputable def zeroEquiv :
    (ℤ ⧸ ⨅ i, primeIdeals i ^ 0) ≃+* ((i : Fin 3) → ℤ ⧸ primeIdeals i ^ 0) :=
  Ideal.quotientInfRingEquivPiQuotient (fun i => primeIdeals i ^ 0)
    (primeIdeals_powers_coprime (fun _ => 0))

private theorem zero_inverse (q : (i : Fin 3) → ℤ ⧸ primeIdeals i ^ 0) (r : ℤ) :
    zeroEquiv.symm q = Ideal.Quotient.mk (⨅ i, primeIdeals i ^ 0) r := by
  apply zeroEquiv.injective
  funext i
  exact @Subsingleton.elim _ (zero_component i) _ _

private def mixedExponents : Fin 3 → ℕ := ![0, 2, 1]
private def mixedIdeals (i : Fin 3) : Ideal ℤ := primeIdeals i ^ mixedExponents i

private noncomputable def mixedEquiv :
    (ℤ ⧸ ⨅ i, mixedIdeals i) ≃+* ((i : Fin 3) → ℤ ⧸ mixedIdeals i) :=
  Ideal.quotientInfRingEquivPiQuotient mixedIdeals
    (primeIdeals_powers_coprime mixedExponents)

private theorem mixed_components : Subsingleton (ℤ ⧸ mixedIdeals 0) ∧
    Nontrivial (ℤ ⧸ mixedIdeals 1) ∧ Nontrivial (ℤ ⧸ mixedIdeals 2) := by
  refine ⟨?_, ?_, ?_⟩
  · exact zero_component 0
  · exact Ideal.Quotient.nontrivial_iff.mpr (poweredIdeal_controls 1).2
  · exact Ideal.Quotient.nontrivial_iff.mpr (poweredIdeal_controls 2).2

private theorem mixed_congruences_172 (i : Fin 3) :
    (172 : ℤ) - residues i ∈ mixedIdeals i := by
  fin_cases i
  · simp [mixedIdeals, mixedExponents]
  · exact congruences_172 1
  · exact congruences_172 2

private theorem mixed_inverse :
    mixedEquiv.symm (fun i => Ideal.Quotient.mk (mixedIdeals i) (residues i)) =
      Ideal.Quotient.mk (⨅ i, mixedIdeals i) 172 := by
  apply mixedEquiv.injective
  rw [mixedEquiv.apply_symm_apply]
  change (fun i => Ideal.Quotient.mk (mixedIdeals i) (residues i)) =
    Ideal.quotientInfToPiQuotient mixedIdeals (Ideal.Quotient.mk (⨅ i, mixedIdeals i) 172)
  rw [Ideal.quotientInfToPiQuotient_mk]
  funext i
  exact ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (mixed_congruences_172 i)).symm

private theorem trivial_bottom_eq_top : (⊥ : Ideal PUnit) = ⊤ := by
  apply top_unique
  intro x _hx
  exact (Submodule.mem_bot PUnit).mpr (Subsingleton.elim _ _)

private theorem trivial_coprime :
    Pairwise (fun _i _j : Fin 3 => IsCoprime (⊥ : Ideal PUnit) ⊥) := by
  intro i j _hij
  apply Ideal.isCoprime_iff_sup_eq.mpr
  simp only [trivial_bottom_eq_top, sup_idem]

private noncomputable def trivialEquiv :
    (PUnit ⧸ ⨅ _i : Fin 3, (⊥ : Ideal PUnit)) ≃+*
      ((_i : Fin 3) → PUnit ⧸ (⊥ : Ideal PUnit)) :=
  Ideal.quotientInfRingEquivPiQuotient (fun _ : Fin 3 => (⊥ : Ideal PUnit)) trivial_coprime

private theorem trivial_inverse (q : (_i : Fin 3) → PUnit ⧸ (⊥ : Ideal PUnit)) :
    trivialEquiv.symm q =
      Ideal.Quotient.mk (⨅ _i : Fin 3, (⊥ : Ideal PUnit)) PUnit.unit := by
  apply trivialEquiv.injective
  funext i
  exact Subsingleton.elim _ _

private theorem repeated_two_not_comaximal :
    Ideal.span {(2 : ℤ)} ^ 2 ⊔ Ideal.span {(2 : ℤ)} ^ 3 ≠ ⊤ := by
  rw [sup_of_le_left (Ideal.pow_le_pow_right (I := Ideal.span {(2 : ℤ)})
    (by norm_num : 2 ≤ 3))]
  rw [Ideal.span_singleton_pow]
  apply (Ideal.ne_top_iff_one _).mpr
  rw [Ideal.mem_span_singleton]
  norm_num

private theorem repeated_two_incompatible :
    ¬ ∃ x : ℤ,
      Ideal.Quotient.mk (Ideal.span {(2 : ℤ)} ^ 2) x =
        Ideal.Quotient.mk (Ideal.span {(2 : ℤ)} ^ 2) 0 ∧
      Ideal.Quotient.mk (Ideal.span {(2 : ℤ)} ^ 3) x =
        Ideal.Quotient.mk (Ideal.span {(2 : ℤ)} ^ 3) 1 := by
  rintro ⟨x, hx, hy⟩
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton] at hx hy
  have hx' : (4 : ℤ) ∣ x := by simpa using hx
  have hy' : (8 : ℤ) ∣ x - 1 := by simpa using hy
  have h : (4 : ℤ) ∣ x - (x - 1) :=
    dvd_sub hx' (dvd_trans (by norm_num : (4 : ℤ) ∣ 8) hy')
  rw [show x - (x - 1) = 1 by ring] at h
  norm_num at h

end Boundary

end Ideal
