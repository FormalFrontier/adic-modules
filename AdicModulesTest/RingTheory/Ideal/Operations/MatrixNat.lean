module

import AdicModules.RingTheory.Ideal.Operations
import Mathlib.LinearAlgebra.Matrix.StdBasis
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-!
# Column ideals over the natural numbers

In `Matrix (Fin 2) (Fin 2) ℕ`, the left ideals generated by the diagonal
matrix units are comaximal, nonzero, proper, idempotent, and not two-sided.
Their positive ideal powers remain unchanged. The ambient semiring is neither
commutative nor cancellative under multiplication, and its first diagonal matrix
unit has no additive inverse.

Here “matrix unit” means an elementary matrix `Eij`, not an invertible element
of the semiring. In fact none of the four elementary matrices is invertible.
The off-diagonal matrix `E01` (also written `E12` with one-based indices) has
square zero, but the square of its generated left ideal contains `E11` and is
nonzero. Thus powers of left ideals cannot be replaced by spans of powers of
chosen generators.

## References

These examples use Mathlib's `Matrix.stdBasis_eq_single`, matrix-unit products,
`Ideal.mem_span_singleton'`, and submodule power recursion. They follow the
column-ideal interpretation also used in the integer-matrix examples in
`AdicModulesTest.Topology.Algebra.Ideal.Matrix`; the semiring membership and
idempotency arguments below use the span universal property directly.
-/

namespace Matrix

universe u v

-- These two private contracts work over any coefficient semiring. The scalar
-- action in the spans is multiplication by the whole square-matrix semiring.
private lemma mem_span_diagonalUnit_iff
    {ι : Type u} {S : Type v} [Fintype ι] [DecidableEq ι] [Semiring S]
    (j : ι) (B : Matrix ι ι S) :
    B ∈ Ideal.span {(Matrix.single j j (1 : S))} ↔
      ∀ r c, c ≠ j → B r c = 0 := by
  rw [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨A, rfl⟩ r c hc
    exact Matrix.mul_single_apply_of_ne 1 j j r c hc A
  · intro hB
    refine ⟨B, ?_⟩
    ext r c
    by_cases hc : c = j
    · subst c
      simp
    · rw [Matrix.mul_single_apply_of_ne 1 j j r c hc B, hB r c hc]

private lemma span_diagonalUnit_mul_self
    {ι : Type u} {S : Type v} [Fintype ι] [DecidableEq ι] [Semiring S]
    (j : ι) :
    (Ideal.span {Matrix.single j j (1 : S)} : Ideal (Matrix ι ι S)) *
        Ideal.span {Matrix.single j j (1 : S)} =
      Ideal.span {Matrix.single j j (1 : S)} := by
  apply le_antisymm Ideal.mul_le_right
  apply (Ideal.span_singleton_le_iff_mem _).mpr
  have he := Ideal.mem_span_singleton_self (Matrix.single j j (1 : S))
  simpa only [Matrix.single_mul_single_same, one_mul] using Ideal.mul_mem_mul he he

section NatColumnIdeals

private abbrev NatMatrix := Matrix (Fin 2) (Fin 2) ℕ

private def matrixUnit (i j : Fin 2) : NatMatrix := Matrix.single i j 1

private def leftColumnIdeal : Ideal NatMatrix := Ideal.span {matrixUnit 0 0}
private def rightColumnIdeal : Ideal NatMatrix := Ideal.span {matrixUnit 1 1}
private def upperMatrixUnitIdeal : Ideal NatMatrix := Ideal.span {matrixUnit 0 1}

private lemma matrixUnit_eq_stdBasis (i j : Fin 2) :
    matrixUnit i j = Matrix.stdBasis ℕ (Fin 2) (Fin 2) (i, j) := by
  exact (Matrix.stdBasis_eq_single ℕ i j).symm

private lemma matrixUnits_mul (i j k l : Fin 2) :
    matrixUnit i j * matrixUnit k l = if j = k then matrixUnit i l else 0 := by
  by_cases h : j = k
  · subst k
    simp [matrixUnit]
  · simp [matrixUnit, h, Matrix.single_mul_single_of_ne]

private lemma matrixUnit_ne_zero (i j : Fin 2) : matrixUnit i j ≠ 0 := by
  intro h
  have hij := congrArg (fun B : NatMatrix ↦ B i j) h
  norm_num [matrixUnit] at hij

private theorem matrixUnits_not_isUnit (i j : Fin 2) : ¬ IsUnit (matrixUnit i j) := by
  intro h
  obtain ⟨B, hB⟩ := h.exists_right_inv
  fin_cases i
  · have h11 := congrArg (fun A : NatMatrix ↦ A 1 1) hB
    norm_num [matrixUnit, Matrix.single_mul_apply_of_ne] at h11
  · have h00 := congrArg (fun A : NatMatrix ↦ A 0 0) hB
    norm_num [matrixUnit, Matrix.single_mul_apply_of_ne] at h00

private theorem matrixUnits_noncommuting_products :
    matrixUnit 0 1 * matrixUnit 1 0 = matrixUnit 0 0 ∧
      matrixUnit 1 0 * matrixUnit 0 1 = matrixUnit 1 1 ∧
      matrixUnit 0 1 * matrixUnit 1 0 ≠ matrixUnit 1 0 * matrixUnit 0 1 := by
  have h01 : matrixUnit 0 1 * matrixUnit 1 0 = matrixUnit 0 0 := by
    simp [matrixUnits_mul]
  have h10 : matrixUnit 1 0 * matrixUnit 0 1 = matrixUnit 1 1 := by
    simp [matrixUnits_mul]
  refine ⟨h01, h10, ?_⟩
  intro h
  rw [h01, h10] at h
  have h00 := congrArg (fun B : NatMatrix ↦ B 0 0) h
  norm_num [matrixUnit, Matrix.single_apply] at h00

private theorem matrixSemiring_noncommutative :
    ¬ ∀ A B : NatMatrix, A * B = B * A := by
  intro h
  exact matrixUnits_noncommuting_products.2.2 (h (matrixUnit 0 1) (matrixUnit 1 0))

private theorem e00_no_additive_inverse : ¬ ∃ B : NatMatrix, matrixUnit 0 0 + B = 0 := by
  rintro ⟨B, hB⟩
  have h00 := congrArg (fun A : NatMatrix ↦ A 0 0) hB
  norm_num [matrixUnit, Matrix.add_apply] at h00

-- This forbids a ring structure compatible with the canonical addition, not
-- unrelated ring operations transported onto the same underlying type.
private theorem matrixSemiring_no_negation :
    ¬ ∃ neg : NatMatrix → NatMatrix, ∀ B, neg B + B = 0 := by
  rintro ⟨neg, hneg⟩
  apply e00_no_additive_inverse
  exact ⟨neg (matrixUnit 0 0), by rw [add_comm]; exact hneg _⟩

private lemma e01_sq : matrixUnit 0 1 ^ 2 = 0 := by
  simp [pow_two, matrixUnits_mul]

private theorem diagonalUnits_zero_divisors :
    matrixUnit 0 0 ≠ 0 ∧ matrixUnit 1 1 ≠ 0 ∧
      matrixUnit 0 0 * matrixUnit 1 1 = 0 ∧
      matrixUnit 1 1 * matrixUnit 0 0 = 0 := by
  refine ⟨matrixUnit_ne_zero 0 0, matrixUnit_ne_zero 1 1, ?_, ?_⟩ <;>
    simp [matrixUnits_mul]

private theorem diagonalUnits_mul_collisions :
    matrixUnit 0 0 * matrixUnit 1 1 = matrixUnit 0 0 * 0 ∧
      matrixUnit 1 1 * matrixUnit 0 0 = 0 * matrixUnit 0 0 := by
  simpa only [mul_zero, zero_mul] using diagonalUnits_zero_divisors.2.2

private theorem matrixSemiring_not_leftCancelMulZero : ¬ IsLeftCancelMulZero NatMatrix := by
  intro h
  let := h
  exact matrixUnit_ne_zero 1 1
    (mul_left_cancel₀ (matrixUnit_ne_zero 0 0) diagonalUnits_mul_collisions.1)

private theorem matrixSemiring_not_rightCancelMulZero : ¬ IsRightCancelMulZero NatMatrix := by
  intro h
  let := h
  exact matrixUnit_ne_zero 1 1
    (mul_right_cancel₀ (matrixUnit_ne_zero 0 0) diagonalUnits_mul_collisions.2)

private theorem matrixSemiring_not_cancelMulZero : ¬ IsCancelMulZero NatMatrix := by
  intro h
  let := h
  exact matrixSemiring_not_leftCancelMulZero inferInstance

private lemma mem_leftColumnIdeal_iff (B : NatMatrix) :
    B ∈ leftColumnIdeal ↔ ∀ r, B r 1 = 0 := by
  change B ∈ Ideal.span {Matrix.single 0 0 (1 : ℕ)} ↔ _
  rw [mem_span_diagonalUnit_iff]
  constructor
  · intro h r
    exact h r 1 (by decide)
  · intro h r c hc
    fin_cases c
    · exact (hc rfl).elim
    · exact h r

private lemma mem_rightColumnIdeal_iff (B : NatMatrix) :
    B ∈ rightColumnIdeal ↔ ∀ r, B r 0 = 0 := by
  change B ∈ Ideal.span {Matrix.single 1 1 (1 : ℕ)} ↔ _
  rw [mem_span_diagonalUnit_iff]
  constructor
  · intro h r
    exact h r 0 (by decide)
  · intro h r c hc
    fin_cases c
    · exact h r
    · exact (hc rfl).elim

private lemma e00_mem_leftColumnIdeal : matrixUnit 0 0 ∈ leftColumnIdeal :=
  Ideal.mem_span_singleton_self _

private lemma e11_mem_rightColumnIdeal : matrixUnit 1 1 ∈ rightColumnIdeal :=
  Ideal.mem_span_singleton_self _

private lemma e11_notMem_leftColumnIdeal : matrixUnit 1 1 ∉ leftColumnIdeal := by
  intro h
  have h11 := (mem_leftColumnIdeal_iff _).mp h 1
  norm_num [matrixUnit] at h11

private lemma e00_notMem_rightColumnIdeal : matrixUnit 0 0 ∉ rightColumnIdeal := by
  intro h
  have h00 := (mem_rightColumnIdeal_iff _).mp h 0
  norm_num [matrixUnit] at h00

private theorem leftColumnIdeal_nonzero_proper :
    leftColumnIdeal ≠ ⊥ ∧ leftColumnIdeal ≠ ⊤ := by
  constructor
  · intro h
    exact matrixUnit_ne_zero 0 0 (Ideal.span_singleton_eq_bot.mp h)
  · intro h
    apply e11_notMem_leftColumnIdeal
    rw [h]
    exact Submodule.mem_top

private theorem rightColumnIdeal_nonzero_proper :
    rightColumnIdeal ≠ ⊥ ∧ rightColumnIdeal ≠ ⊤ := by
  constructor
  · intro h
    exact matrixUnit_ne_zero 1 1 (Ideal.span_singleton_eq_bot.mp h)
  · intro h
    apply e00_notMem_rightColumnIdeal
    rw [h]
    exact Submodule.mem_top

private theorem leftColumnIdeal_not_twoSided : ¬ leftColumnIdeal.IsTwoSided := by
  intro h
  let := h
  have hm := leftColumnIdeal.mul_mem_right (matrixUnit 0 1) e00_mem_leftColumnIdeal
  have h01 := (mem_leftColumnIdeal_iff _).mp hm 0
  norm_num [matrixUnits_mul, matrixUnit] at h01

private theorem rightColumnIdeal_not_twoSided : ¬ rightColumnIdeal.IsTwoSided := by
  intro h
  let := h
  have hm := rightColumnIdeal.mul_mem_right (matrixUnit 1 0) e11_mem_rightColumnIdeal
  have h10 := (mem_rightColumnIdeal_iff _).mp hm 1
  norm_num [matrixUnits_mul, matrixUnit] at h10

private theorem columnIdeals_idempotent :
    leftColumnIdeal * leftColumnIdeal = leftColumnIdeal ∧
      rightColumnIdeal * rightColumnIdeal = rightColumnIdeal := by
  exact ⟨span_diagonalUnit_mul_self (S := ℕ) (0 : Fin 2),
    span_diagonalUnit_mul_self (S := ℕ) (1 : Fin 2)⟩

-- Ideal powers here use Submodule's recursion, without a right-unit law.
private theorem columnIdeals_pow_succ (n : ℕ) :
    leftColumnIdeal ^ (n + 1) = leftColumnIdeal ∧
      rightColumnIdeal ^ (n + 1) = rightColumnIdeal := by
  induction n with
  | zero => exact ⟨Submodule.pow_one _, Submodule.pow_one _⟩
  | succ n ih =>
    constructor
    · rw [Submodule.pow_succ, ih.1, columnIdeals_idempotent.1]
    · rw [Submodule.pow_succ, ih.2, columnIdeals_idempotent.2]

private theorem columnIdeals_positive_powers {n : ℕ} (hn : n ≠ 0) :
    leftColumnIdeal ^ n = leftColumnIdeal ∧ rightColumnIdeal ^ n = rightColumnIdeal := by
  cases n with
  | zero => exact (hn rfl).elim
  | succ n => exact columnIdeals_pow_succ n

private theorem columnIdeals_pow_zero_one :
    leftColumnIdeal ^ 0 = ⊤ ∧ rightColumnIdeal ^ 0 = ⊤ ∧
      leftColumnIdeal ^ 1 = leftColumnIdeal ∧ rightColumnIdeal ^ 1 = rightColumnIdeal := by
  exact ⟨Ideal.one_eq_top, Ideal.one_eq_top, Submodule.pow_one _, Submodule.pow_one _⟩

private lemma diagonalUnits_add : matrixUnit 0 0 + matrixUnit 1 1 = (1 : NatMatrix) := by
  ext r c
  fin_cases r <;> fin_cases c <;> norm_num [matrixUnit, Matrix.single_apply]

private theorem rightColumnIdeal_sup_leftColumnIdeal :
    rightColumnIdeal ⊔ leftColumnIdeal = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  exact ⟨matrixUnit 1 1, e11_mem_rightColumnIdeal,
    matrixUnit 0 0, e00_mem_leftColumnIdeal, by rw [add_comm, diagonalUnits_add]⟩

private theorem rightColumnIdeal_sup_leftColumnIdeal_pow (n : ℕ) :
    rightColumnIdeal ⊔ leftColumnIdeal ^ n = ⊤ := by
  cases n with
  | zero => rw [Submodule.pow_zero, Ideal.one_eq_top, sup_top_eq]
  | succ n => rw [(columnIdeals_pow_succ n).1, rightColumnIdeal_sup_leftColumnIdeal]

private theorem leftColumnIdeal_sup_rightColumnIdeal_pow (n : ℕ) :
    leftColumnIdeal ⊔ rightColumnIdeal ^ n = ⊤ := by
  cases n with
  | zero => rw [Submodule.pow_zero, Ideal.one_eq_top, sup_top_eq]
  | succ n => rw [(columnIdeals_pow_succ n).2, sup_comm, rightColumnIdeal_sup_leftColumnIdeal]

private theorem leftColumnIdeal_sup_bot_pow_zero_one :
    leftColumnIdeal ⊔ (⊥ : Ideal NatMatrix) ^ 0 = ⊤ ∧
      leftColumnIdeal ⊔ (⊥ : Ideal NatMatrix) ^ 1 ≠ ⊤ := by
  constructor
  · rw [Submodule.pow_zero, Ideal.one_eq_top, sup_top_eq]
  · simpa only [Submodule.pow_one, sup_bot_eq] using leftColumnIdeal_nonzero_proper.2

private lemma upperMatrixUnitIdeal_eq_rightColumnIdeal :
    upperMatrixUnitIdeal = rightColumnIdeal := by
  apply le_antisymm
  · apply (Ideal.span_singleton_le_iff_mem _).mpr
    apply (mem_rightColumnIdeal_iff _).mpr
    intro r
    simp [matrixUnit]
  · apply (Ideal.span_singleton_le_iff_mem _).mpr
    apply Ideal.mem_span_singleton'.mpr
    exact ⟨matrixUnit 1 0, by simp [matrixUnits_mul]⟩

private lemma e11_mem_upperMatrixUnitIdeal : matrixUnit 1 1 ∈ upperMatrixUnitIdeal := by
  apply Ideal.mem_span_singleton'.mpr
  exact ⟨matrixUnit 1 0, by simp [matrixUnits_mul]⟩

-- Both factors are E11, an element of span {E01} obtained by left multiplication.
-- The generator's square is not used to calculate this ideal square.
private theorem e11_mem_upperMatrixUnitIdeal_sq :
    matrixUnit 1 1 ∈ upperMatrixUnitIdeal ^ 2 := by
  rw [Submodule.pow_succ, Submodule.pow_one]
  simpa [matrixUnits_mul] using
    Ideal.mul_mem_mul e11_mem_upperMatrixUnitIdeal e11_mem_upperMatrixUnitIdeal

private theorem upperMatrixUnitIdeal_sq_ne_bot : upperMatrixUnitIdeal ^ 2 ≠ ⊥ := by
  intro h
  have hz : matrixUnit 1 1 = 0 := by
    simpa only [h, Submodule.mem_bot] using e11_mem_upperMatrixUnitIdeal_sq
  exact matrixUnit_ne_zero 1 1 hz

private theorem upperMatrixUnitIdeal_sq_ne_span_sq :
    upperMatrixUnitIdeal ^ 2 ≠ Ideal.span {matrixUnit 0 1 ^ 2} := by
  rw [e01_sq, Ideal.span_singleton_zero]
  exact upperMatrixUnitIdeal_sq_ne_bot

private theorem upperMatrixUnitIdeal_not_twoSided : ¬ upperMatrixUnitIdeal.IsTwoSided := by
  rw [upperMatrixUnitIdeal_eq_rightColumnIdeal]
  exact rightColumnIdeal_not_twoSided

private theorem upperMatrixUnit_power_warning :
    matrixUnit 0 1 ^ 2 = 0 ∧
      matrixUnit 1 1 ∈ (Ideal.span {matrixUnit 0 1} : Ideal NatMatrix) ^ 2 ∧
      (Ideal.span {matrixUnit 0 1} : Ideal NatMatrix) ^ 2 ≠ ⊥ ∧
      (Ideal.span {matrixUnit 0 1} : Ideal NatMatrix) ^ 2 ≠
        Ideal.span {matrixUnit 0 1 ^ 2} ∧
      ¬ (Ideal.span {matrixUnit 0 1} : Ideal NatMatrix).IsTwoSided := by
  exact ⟨e01_sq, e11_mem_upperMatrixUnitIdeal_sq, upperMatrixUnitIdeal_sq_ne_bot,
    upperMatrixUnitIdeal_sq_ne_span_sq, upperMatrixUnitIdeal_not_twoSided⟩

-- Comaximal column ideals illustrate powers of arbitrary left ideals.
private theorem columnIdeals_sup_powers_eq_top (n : ℕ) :
    rightColumnIdeal ⊔ leftColumnIdeal ^ n = ⊤ :=
  Ideal.sup_pow_eq_top_of_sup_eq_top
    (J := rightColumnIdeal) (I := leftColumnIdeal) (n := n)
    rightColumnIdeal_sup_leftColumnIdeal

end NatColumnIdeals

end Matrix
