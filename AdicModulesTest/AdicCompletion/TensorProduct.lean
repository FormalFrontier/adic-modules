module

public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct

import AdicModules.AdicCompletion.TensorProduct
import Mathlib.LinearAlgebra.StdBasis
import Mathlib.RingTheory.Finiteness.Projective
import Mathlib.RingTheory.Int.Basic

/-!
# Canonical tensor comparisons for finite projective modules

For a finite projective module over a commutative ring, the canonical comparison
`AdicCompletion.ofTensorProduct` is bijective and underlies the completion-ring-linear equivalence
`AdicCompletion.ofTensorProductEquivOfFiniteProjective`. The integer rank-two models below apply
this bijectivity theorem and exhibit that equivalence with its canonical-map, pure-tensor and
inverse-generator identities.

Separate integer models use Mathlib's Noetherian comparison, checking both coordinate vectors,
inverse images of generators and the full equivalence API. Finiteness comes from finite products,
and projectivity from the standard basis. A rank-zero model uses the finite-product comparison
without any positive-rank assumption.

## Implementation notes

The ring and module universes in the main properties are independent. Only the separate equality
property for Mathlib's Noetherian equivalence uses a common universe, as required by that provider.
The four private `Prop` definitions are type specifications, not proofs of their universal
statements; the finite-projective equivalence itself is constructed in
`AdicModules.AdicCompletion.TensorProduct`.

## References

Mathlib's `RingTheory/AdicCompletion/AsTensorProduct.lean`, by Judith Ludwig and Christian Merten,
supplies the canonical comparison, finite-product bijectivity, and the Noetherian equivalence
used in the integer models.
-/

set_option warningAsError true

noncomputable section

universe uR uM

open TensorProduct

namespace AdicModulesTest.AdicCompletion.TensorProduct

/-- The canonical tensor comparison sends each integer coordinate vector to its scalar multiple
in the completion at the ideal generated by two. -/
public theorem int_pair_ofTensorProduct_tmul
    (a : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) (i : Fin 2) :
    AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)
        (a ⊗ₜ[ℤ] Pi.single i (1 : ℤ)) =
      a • AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)
        (Pi.single i (1 : ℤ)) :=
  AdicCompletion.ofTensorProduct_tmul _ _ _ _

private def tensorProductBijectivity : Prop :=
  ∀ (R : Type uR) [CommRing R] (M : Type uM) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] (I : Ideal R),
    Function.Bijective (AdicCompletion.ofTensorProduct I M)

private def tensorProductEquivCompatibility
    (R : Type uR) [CommRing R] (M : Type uM) [AddCommGroup M] [Module R M]
    (I : Ideal R) : Prop :=
  ∃ e : AdicCompletion I R ⊗[R] M ≃ₗ[AdicCompletion I R] AdicCompletion I M,
    e.toLinearMap = AdicCompletion.ofTensorProduct I M ∧
      (∀ (a : AdicCompletion I R) (m : M), e (a ⊗ₜ[R] m) = a • AdicCompletion.of I M m) ∧
      (∀ m : M, e.symm (AdicCompletion.of I M m) = (1 : AdicCompletion I R) ⊗ₜ[R] m)

private def finiteProjectiveTensorEquivalence : Prop :=
  ∀ (R : Type uR) [CommRing R] (M : Type uM) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] (I : Ideal R),
    tensorProductEquivCompatibility R M I

private def finiteProjectiveTensorEquivalenceNoetherian : Prop :=
  ∀ (R : Type uR) [CommRing R] (M : Type uR) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] [IsNoetherianRing R] (I : Ideal R),
    ∃ e : AdicCompletion I R ⊗[R] M ≃ₗ[AdicCompletion I R] AdicCompletion I M,
      e.toLinearMap = AdicCompletion.ofTensorProduct I M ∧
        (∀ (a : AdicCompletion I R) (m : M), e (a ⊗ₜ[R] m) = a • AdicCompletion.of I M m) ∧
        (∀ m : M, e.symm (AdicCompletion.of I M m) = (1 : AdicCompletion I R) ⊗ₜ[R] m) ∧
        e = AdicCompletion.ofTensorProductEquivOfFiniteNoetherian I M

private instance intPair_finite : Module.Finite ℤ (Fin 2 → ℤ) :=
  Module.Finite.pi

private instance intPair_projective : Module.Projective ℤ (Fin 2 → ℤ) :=
  Module.Projective.of_basis (Pi.basisFun ℤ (Fin 2))

private theorem intPair_bijective_of_finite_projective :
    Function.Bijective
      (AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)) :=
  AdicCompletion.ofTensorProduct_bijective_of_finite_of_projective _ _

private theorem intPair_finiteProjective_compatibility :
    tensorProductEquivCompatibility ℤ (Fin 2 → ℤ) (Ideal.span ({(2 : ℤ)} : Set ℤ)) := by
  refine ⟨AdicCompletion.ofTensorProductEquivOfFiniteProjective _ _,
    AdicCompletion.coe_ofTensorProductEquivOfFiniteProjective _ _, ?_, ?_⟩
  · intro a m
    exact AdicCompletion.ofTensorProductEquivOfFiniteProjective_apply _ _ a m
  · intro m
    exact AdicCompletion.ofTensorProductEquivOfFiniteProjective_symm_of _ _ m

private theorem intPair_bijective :
    Function.Bijective
      (AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)) :=
  AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian _ _

private theorem intPair_equiv_toLinearMap :
    (AdicCompletion.ofTensorProductEquivOfFiniteNoetherian
      (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)).toLinearMap =
      AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ) :=
  AdicCompletion.coe_ofTensorProductEquivOfFiniteNoetherian _ _

private theorem intPair_equiv_tmul_basis
    (a : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) (i : Fin 2) :
    AdicCompletion.ofTensorProductEquivOfFiniteNoetherian
        (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ) (a ⊗ₜ[ℤ] Pi.single i (1 : ℤ)) =
      a • AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)
        (Pi.single i (1 : ℤ)) := by
  simp

private theorem intPair_equiv_symm_of_basis (i : Fin 2) :
    (AdicCompletion.ofTensorProductEquivOfFiniteNoetherian
        (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)).symm
        (AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 2 → ℤ)
          (Pi.single i (1 : ℤ))) =
      (1 : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) ⊗ₜ[ℤ]
        Pi.single i (1 : ℤ) :=
  AdicCompletion.ofTensorProductEquivOfFiniteNoetherian_symm_of _ _ _

private theorem intPair_equiv_compatibility :
    tensorProductEquivCompatibility ℤ (Fin 2 → ℤ) (Ideal.span ({(2 : ℤ)} : Set ℤ)) := by
  refine ⟨AdicCompletion.ofTensorProductEquivOfFiniteNoetherian _ _,
    intPair_equiv_toLinearMap, ?_, ?_⟩
  · intro a m
    simp
  · intro m
    exact AdicCompletion.ofTensorProductEquivOfFiniteNoetherian_symm_of _ _ m

private theorem intZero_bijective :
    Function.Bijective
      (AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (Fin 0 → ℤ)) :=
  AdicCompletion.ofTensorProduct_bijective_of_pi_of_fintype _ (Fin 0)

end AdicModulesTest.AdicCompletion.TensorProduct
