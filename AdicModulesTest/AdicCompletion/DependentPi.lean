module

public import AdicModules.LinearAlgebra.Pi
public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import Mathlib.RingTheory.Finiteness.Ideal
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic.NormNum

/-!
# Adic completion of dependent products

The propositions below specify bijectivity of `AdicCompletion.pi` at a finitely generated ideal
and the characteristic API of the corresponding completed-ring-linear equivalence. The index
and fiber universes are independent of the ring universe. The finite-index specialization is
compared with `AdicCompletion.piEquivOfFintype`, which requires no finite-generation hypothesis.

For the constant family of integers indexed by the natural numbers, the completion of the
constant-one vector at the ideal generated by two, and its image under that same `pi`, are
nonzero. The proof uses reduction in degree one at coordinate zero.

## Implementation notes

The two proposition definitions supply neither a universal bijectivity proof nor an equivalence.
The intended equivalence construction is `LinearEquiv.ofBijective` applied to the existing `pi`;
no alternative comparison or scalar action is defined here. The integer data and proofs do not
use either proposition. Completion denotes the algebraic inverse limit; no identification of
the intrinsic adic topology on an infinite product with its product topology is asserted.

## References

The comparison, finite equivalence, and completion-map and evaluation APIs are Mathlib's, from
`Mathlib.RingTheory.AdicCompletion.Functoriality` and
`Mathlib.RingTheory.AdicCompletion.Basic`, by Judith Ludwig, Christian Merten, Kenny Lau, and
Jiedong Jiang. The quotient and principal-ideal membership APIs used below are from Mathlib's
ideal and submodule quotient files and `Mathlib.RingTheory.Ideal.Span`, with contributions by
Kenny Lau, Chris Hughes, Mario Carneiro, and Anne Baanen. The dependent linear Pi and submodule
quotient APIs are by Johannes Hölzl, Mario Carneiro, Kevin Buzzard, Yury Kudryashov, and
Eric Wieser; the finite-ideal API is by Johan Commelin. The formalization here was written with
AI assistance.
-/

set_option warningAsError true

noncomputable section

universe uR uJ uM uN

namespace AdicModulesTest.AdicCompletion.DependentPi

section Statements

variable {R : Type uR} [CommRing R] (I : Ideal R)
variable {J : Type uJ} (M : J → Type uM)
variable [∀ j, AddCommGroup (M j)] [∀ j, Module R (M j)]

/-- Bijectivity of the existing dependent-product comparison at a finitely generated ideal. -/
private def piBijectivity : Prop :=
  I.FG → Function.Bijective (AdicCompletion.pi I M)

/-- The canonical equivalence contract, including its common-forward-map finite overlap.
Naturality allows a separate universe for the target fibers and uses the target's canonical
comparison, without assuming a target equivalence. -/
private def piEquivalenceContract : Prop :=
  I.FG → ∃ e : AdicCompletion I (∀ j, M j) ≃ₗ[AdicCompletion I R]
      ((j : J) → AdicCompletion I (M j)),
    e.toLinearMap = AdicCompletion.pi I M ∧
    (e : AdicCompletion I (∀ j, M j) → ((j : J) → AdicCompletion I (M j))) =
      (AdicCompletion.pi I M :
        AdicCompletion I (∀ j, M j) → ((j : J) → AdicCompletion I (M j))) ∧
    e.toLinearMap.restrictScalars R = (AdicCompletion.pi I M).restrictScalars R ∧
    (∀ (x : AdicCompletion I (∀ j, M j)) (j : J),
      e x j = AdicCompletion.map I (LinearMap.proj j) x) ∧
    (∀ m : ∀ j, M j,
      e (AdicCompletion.of I (∀ j, M j) m) =
        fun j ↦ AdicCompletion.of I (M j) (m j)) ∧
    (∀ (x : AdicCompletion I (∀ j, M j)) (n : ℕ) (j : J),
      AdicCompletion.eval I (M j) n (e x j) =
        (LinearMap.proj j : (∀ j, M j) →ₗ[R] M j).reduceModIdeal (I ^ n)
          (AdicCompletion.eval I (∀ j, M j) n x)) ∧
    (∀ x : AdicCompletion I (∀ j, M j), e.symm (e x) = x) ∧
    (∀ y : (j : J) → AdicCompletion I (M j), e (e.symm y) = y) ∧
    (∀ (y : (j : J) → AdicCompletion I (M j)) (x : AdicCompletion I (∀ j, M j)),
      e.symm y = x ↔ ∀ j, AdicCompletion.map I (LinearMap.proj j) x = y j) ∧
    (∀ m : ∀ j, M j,
      e.symm (fun j ↦ AdicCompletion.of I (M j) (m j)) =
        AdicCompletion.of I (∀ j, M j) m) ∧
    (∀ (y : (j : J) → AdicCompletion I (M j)) (n : ℕ) (j : J),
      (LinearMap.proj j : (∀ j, M j) →ₗ[R] M j).reduceModIdeal (I ^ n)
          (AdicCompletion.eval I (∀ j, M j) n (e.symm y)) =
        AdicCompletion.eval I (M j) n (y j)) ∧
    (∀ (N : J → Type uN) [∀ j, AddCommGroup (N j)] [∀ j, Module R (N j)]
        (f : ∀ j, M j →ₗ[R] N j),
      (∀ x : AdicCompletion I (∀ j, M j),
        AdicCompletion.pi I N (AdicCompletion.map I (LinearMap.piMap f) x) =
          fun j ↦ AdicCompletion.map I (f j) (e x j)) ∧
      (∀ y : (j : J) → AdicCompletion I (M j),
        AdicCompletion.pi I N (AdicCompletion.map I (LinearMap.piMap f) (e.symm y)) =
          fun j ↦ AdicCompletion.map I (f j) (y j))) ∧
    (∀ [DecidableEq J] [Fintype J], e = AdicCompletion.piEquivOfFintype I M)

end Statements

/-- The ideal generated by two in the integers. -/
private def twoIdeal : Ideal ℤ := Ideal.span ({(2 : ℤ)} : Set ℤ)

/-- A singleton finite generating set for the ideal generated by two. -/
private theorem twoIdeal_fg : twoIdeal.FG := by
  refine ⟨{(2 : ℤ)}, ?_⟩
  simp only [Finset.coe_singleton, twoIdeal, Ideal.span]

/-- The constant-one vector in the infinite product of integer modules. -/
private def ones : ℕ → ℤ := fun _ ↦ 1

/-- The canonical completion of the constant-one vector. -/
private def completedOnes : AdicCompletion twoIdeal (ℕ → ℤ) :=
  AdicCompletion.of twoIdeal (ℕ → ℤ) ones

/-- The image of that same completion element under the canonical dependent-product map. -/
private def completedOnesImage : ℕ → AdicCompletion twoIdeal ℤ :=
  AdicCompletion.pi twoIdeal (fun _ : ℕ ↦ ℤ) completedOnes

/-- The class of one is nonzero in the positive-degree integer quotient. -/
private theorem one_residue_ne_zero :
    Submodule.mkQ (twoIdeal ^ 1 • ⊤ : Submodule ℤ ℤ) (1 : ℤ) ≠ 0 := by
  intro h
  have hmem : (1 : ℤ) ∈ Ideal.span ({(2 : ℤ)} : Set ℤ) := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
    simpa only [pow_one, smul_eq_mul, Ideal.mul_top, twoIdeal] using h
  have hdiv : (2 : ℤ) ∣ 1 := Ideal.mem_span_singleton.mp hmem
  norm_num at hdiv

private theorem ones_not_mem_twoIdeal_smul_top :
    ones ∉ twoIdeal ^ 1 • (⊤ : Submodule ℤ (ℕ → ℤ)) := by
  intro hmem
  have hker : ones ∈ LinearMap.ker
      (LinearMap.piMap fun _ : ℕ =>
        (twoIdeal ^ 1 • (⊤ : Submodule ℤ ℤ)).mkQ) := by
    rw [(twoIdeal_fg.pow (n := 1)).ker_piMap_mkQ (fun _ : ℕ => ℤ)]
    exact hmem
  have hz := congr_fun (LinearMap.mem_ker.mp hker) (0 : ℕ)
  apply one_residue_ne_zero
  simpa only [LinearMap.piMap, LinearMap.pi_apply, LinearMap.comp_apply,
    LinearMap.proj_apply, ones, Pi.zero_apply] using hz

/-- Coordinate zero of the canonical image reduces to the class of one in degree one. -/
private theorem completedOnesImage_reduction :
    AdicCompletion.eval twoIdeal ℤ 1 (completedOnesImage 0) =
      Submodule.mkQ (twoIdeal ^ 1 • ⊤ : Submodule ℤ ℤ) (1 : ℤ) := by
  change AdicCompletion.eval twoIdeal ℤ 1
    (AdicCompletion.map twoIdeal (LinearMap.proj (0 : ℕ))
      (AdicCompletion.of twoIdeal (ℕ → ℤ) ones)) = _
  simp only [AdicCompletion.map_of, AdicCompletion.eval_of, LinearMap.proj_apply, ones]

/-- The ideal generated by two is finitely generated, and the completed constant-one integer
vector and its canonical dependent-product image are both nonzero. -/
public theorem int_pi_ones_nonzero :
    (Ideal.span ({(2 : ℤ)} : Set ℤ)).FG ∧
    AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ℕ → ℤ)
      (fun _ : ℕ ↦ (1 : ℤ)) ≠ 0 ∧
    AdicCompletion.pi (Ideal.span ({(2 : ℤ)} : Set ℤ)) (fun _ : ℕ ↦ ℤ)
      (AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ℕ → ℤ)
        (fun _ : ℕ ↦ (1 : ℤ))) ≠ 0 := by
  refine ⟨twoIdeal_fg, ?_⟩
  change completedOnes ≠ 0 ∧ completedOnesImage ≠ 0
  have hred : AdicCompletion.eval twoIdeal ℤ 1 (completedOnesImage 0) ≠ 0 := by
    rw [completedOnesImage_reduction]
    exact one_residue_ne_zero
  constructor
  · intro h
    apply hred
    simp only [completedOnesImage, h, map_zero, Pi.zero_apply]
  · intro h
    apply hred
    simp only [h, Pi.zero_apply, map_zero]

end AdicModulesTest.AdicCompletion.DependentPi
