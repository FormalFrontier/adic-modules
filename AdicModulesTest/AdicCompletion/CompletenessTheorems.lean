module

public import AdicModules.AdicCompletion.Completeness
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import Mathlib.RingTheory.AdicCompletion.Noetherian
public import Mathlib.Basic.Nontrivial.Defs
public import Mathlib.RingTheory.Int.Basic
public import Mathlib.Tactic.NormNum

/-!
# Two-adic examples of completeness theorems

The canonical completion of `ℤ` at `(2)` is complete by finite generation of `(2)`.
Its canonical map from `ℤ` is injective, so this is a nonzero module. The ideals
`(2)` and `(4)` illustrate binary and finite suprema, and transfer to a principal
ideal generated by an element of `(2)`. The Hausdorffification of this complete
module remains complete and, since the module is Hausdorff, does not collapse it.

The empty finite supremum and the Hausdorffification for the unit ideal illustrate
the bottom and zero-quotient boundary cases. The latter does not require `ℤ` to
be Hausdorff for the unit ideal.

The finite generators `{2, 4}` also illustrate precompleteness for their span and
the completeness equivalence with Hausdorffness for the whole span. For any finite
subset of a commutative ring, principal completeness gives completeness of the
Hausdorffification for its generated ideal, without Hausdorffness of the source.
-/

set_option warningAsError true

@[expose] public section

local notation "I₂" => (Ideal.span {(2 : ℤ)} : Ideal ℤ)
local notation "I₄" => (Ideal.span {(4 : ℤ)} : Ideal ℤ)
local notation "M₂" => AdicCompletion I₂ ℤ

local instance : IsAdicComplete I₂ M₂ :=
  AdicCompletion.isAdicComplete (M := ℤ) (Submodule.fg_span_singleton (2 : ℤ))

local instance : IsHausdorff I₂ ℤ := by
  apply IsHausdorff.of_isDomain
  intro h
  have hmem : (1 : ℤ) ∈ I₂ := by simp [h]
  norm_num [Ideal.mem_span_singleton] at hmem

local instance : Nontrivial M₂ := by
  refine ⟨⟨AdicCompletion.of I₂ ℤ 0, AdicCompletion.of I₂ ℤ 1, ?_⟩⟩
  intro h
  exact zero_ne_one (AdicCompletion.of_injective I₂ ℤ h)

local instance : IsAdicComplete I₄ M₂ :=
  IsAdicComplete.span_singleton (I := I₂) (a := (4 : ℤ)) (M := M₂)
    (Ideal.mem_span_singleton.mpr ⟨(2 : ℤ), rfl⟩)

example : IsPrecomplete (I₂ ⊔ I₄) M₂ := by
  apply IsPrecomplete.sup <;> infer_instance

example : IsPrecomplete
    ((Finset.univ : Finset (Fin 2)).sup (fun i => if i = 0 then I₂ else I₄)) M₂ := by
  apply IsPrecomplete.finset_sup (fun i : Fin 2 => if i = 0 then I₂ else I₄) Finset.univ
  intro i _
  by_cases h : i = 0
  · simpa only [ite_eq_left h] using (inferInstance : IsPrecomplete I₂ M₂)
  · simpa only [ite_eq_right h] using (inferInstance : IsPrecomplete I₄ M₂)

example : IsAdicComplete I₂ (Hausdorffification I₂ M₂) := by
  infer_instance

example : IsAdicComplete I₄ M₂ :=
  IsAdicComplete.span_singleton (I := I₂) (a := (4 : ℤ)) (M := M₂)
    (Ideal.mem_span_singleton.mpr ⟨(2 : ℤ), rfl⟩)

example : IsPrecomplete ((∅ : Finset ℕ).sup (fun _ => (⊥ : Ideal ℤ))) ℤ := by
  apply IsPrecomplete.finset_sup (fun _ : ℕ => (⊥ : Ideal ℤ)) ∅
  intro _ _
  exact IsPrecomplete.bot (R := ℤ) (M := ℤ)

example : IsAdicComplete (⊤ : Ideal ℤ) (Hausdorffification (⊤ : Ideal ℤ) ℤ) := by
  infer_instance

example : IsPrecomplete (Ideal.span (({2, 4} : Finset ℤ) : Set ℤ)) M₂ := by
  apply IsPrecomplete.span_finset
  intro a ha
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl <;> infer_instance

example : IsAdicComplete (Ideal.span (({2, 4} : Finset ℤ) : Set ℤ)) M₂ := by
  have hle : Ideal.span (({2, 4} : Finset ℤ) : Set ℤ) ≤ I₂ := by
    apply Ideal.span_le.mpr
    intro a ha
    simp only [Finset.mem_coe, Finset.mem_insert, Finset.mem_singleton] at ha
    rcases ha with rfl | rfl
    · exact Ideal.subset_span (by simp)
    · exact Ideal.mem_span_singleton.mpr ⟨(2 : ℤ), rfl⟩
  have : IsHausdorff (Ideal.span (({2, 4} : Finset ℤ) : Set ℤ)) M₂ :=
    ⟨fun x hx => (inferInstance : IsHausdorff I₂ M₂).haus x fun n =>
      (hx n).mono (Submodule.smul_mono (pow_le_pow_left' hle n) le_rfl)⟩
  apply (isAdicComplete_span_finset_iff ({2, 4} : Finset ℤ)).mpr
  intro a ha
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl <;> infer_instance

example : IsPrecomplete (Ideal.span ((∅ : Finset ℤ) : Set ℤ)) ℤ := by
  exact IsPrecomplete.span_finset ∅ (by simp)

universe u v

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

example (t : Set R) (ht : t.Finite)
    (h : ∀ a ∈ t, IsAdicComplete (Ideal.span {a}) M) :
    IsAdicComplete (Ideal.span t) (Hausdorffification (Ideal.span t) M) := by
  classical
  have hpre : ∀ a ∈ ht.toFinset, IsPrecomplete (Ideal.span {a}) M := by
    intro a ha
    have := h a (ht.mem_toFinset.mp ha)
    infer_instance
  have : IsPrecomplete (Ideal.span t) M := by
    simpa only [ht.coe_toFinset] using IsPrecomplete.span_finset ht.toFinset hpre
  infer_instance
