module

public import AdicModules.AdicCompletion.LinearMap
public import Mathlib.LinearAlgebra.Basis.Cardinality
public import Mathlib.LinearAlgebra.Finsupp.Defs
public import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.Tactic.NormNum

/-!
# A nonzero map from a countably generated free module

For `I = (2)` in `ℤ`, the target is `AdicCompletion I ℤ` itself. Evaluation at
coordinate zero, followed by the canonical map to this completion, is nonzero on
`Finsupp.single 0 1`. Projection to `ℤ ⧸ I` detects this nonzero value.

The base and directly computed extension values use only the definition of
`AdicCompletion.extend` and Mathlib's maps and completeness theorem. These
calculations are independent of the general uniqueness and equivalence theorems.
The same map also gives a nonzero value through the inverse Hom equivalence.
-/

@[expose] public section

noncomputable section

namespace AdicCompletion

namespace TwoAdicLinearMap

/-- The principal ideal generated by two in the integers. -/
def ideal : Ideal ℤ := Ideal.span ({2} : Set ℤ)

/-- The ideal `(2)` is finitely generated. -/
theorem ideal_fg : ideal.FG := by
  refine ⟨{2}, ?_⟩
  simp [ideal]

/-- The target is the adic completion of `ℤ`, not the completion of its quotient. -/
instance targetComplete : IsAdicComplete ideal (AdicCompletion ideal ℤ) :=
  AdicCompletion.isAdicComplete (M := ℤ) ideal_fg

/-- The source `ℕ →₀ ℤ` is not a finitely generated integer module. -/
theorem source_not_finite : ¬ Module.Finite ℤ (ℕ →₀ ℤ) := by
  intro h
  obtain ⟨s, hs⟩ := h.fg_top
  have : Finite ℕ :=
    finite_of_span_finite_eq_top_finsupp (R := ℤ) s.finite_toSet hs
  exact not_finite ℕ

/-- Coordinate zero, followed by the canonical map into the completion. -/
def coordinateZero : (ℕ →₀ ℤ) →ₗ[ℤ] AdicCompletion ideal ℤ :=
  (of ideal ℤ).comp (Finsupp.lapply 0)

/-- The image of the zeroth free generator. -/
theorem coordinateZero_single :
    coordinateZero (Finsupp.single 0 1) = of ideal ℤ 1 := by
  simp [coordinateZero, Finsupp.lapply]

/-- Reduction modulo two distinguishes the canonical image of one from zero. -/
theorem of_one_ne_zero : of ideal ℤ 1 ≠ 0 := by
  intro h
  have hq : Ideal.Quotient.mk ideal (1 : ℤ) = 0 := by
    simpa using congrArg (evalOneₐ ideal) h
  have hd : (2 : ℤ) ∣ 1 := by
    simpa [ideal, Ideal.mem_span_singleton] using
      (Ideal.Quotient.eq_zero_iff_mem.mp hq)
  norm_num at hd

/-- A nonzero value of the base map, independent of any extension law. -/
theorem coordinateZero_single_ne_zero : coordinateZero (Finsupp.single 0 1) ≠ 0 := by
  rw [coordinateZero_single]
  exact of_one_ne_zero

/-- The directly defined extension on the canonical image of the zeroth generator.
This calculation uses only the definitional bridge and Mathlib's `map_of` and
`ofLinearEquiv_symm_of`, not a generic factorization or uniqueness law. -/
theorem extend_coordinateZero_single :
    extend ideal coordinateZero (of ideal (ℕ →₀ ℤ) (Finsupp.single 0 1)) =
      of ideal ℤ 1 := by
  rw [extend_apply, map_of, ofLinearEquiv_symm_of, coordinateZero_single]

/-- The canonical extension has a nonzero value as well. -/
theorem extend_coordinateZero_single_ne_zero :
    extend ideal coordinateZero (of ideal (ℕ →₀ ℤ) (Finsupp.single 0 1)) ≠ 0 := by
  rw [extend_coordinateZero_single]
  exact of_one_ne_zero

/-- The same nonzero map is extended by the inverse Hom equivalence.
Its nonzero value follows from the independent computation above. -/
theorem precompOfLinearEquiv_symm_coordinateZero_single_ne_zero :
    (precompOfLinearEquiv ideal (M := ℕ →₀ ℤ) (N := AdicCompletion ideal ℤ) ideal_fg).symm
      coordinateZero (of ideal (ℕ →₀ ℤ) (Finsupp.single 0 1)) ≠ 0 := by
  rw [precompOfLinearEquiv_symm_apply]
  exact extend_coordinateZero_single_ne_zero

end TwoAdicLinearMap

end AdicCompletion
