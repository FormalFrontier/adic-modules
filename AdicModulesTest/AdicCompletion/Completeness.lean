module

public import Mathlib.RingTheory.AdicCompletion.Basic
import Mathlib.NumberTheory.Padics.PadicIntegers

/-!
# Adic completeness for finite sets of generators

The binary proposition below concerns precompleteness for arbitrary ideals on the
same module, without finiteness or Hausdorff assumptions. The finite-generator
propositions instead use Hausdorff completeness: principal completeness implies
completeness of the canonical separated quotient, and explicit separatedness of
the original module accompanies both directions of the equivalence.

The principal ideal generated by `2` in `ℤ_[2]` is nonzero and proper. The module
and its canonical separated quotient are nonzero. The singleton set of generators
has complete principal input and a Hausdorff generated-ideal input, supplied by
maximal-ideal completeness. Surjectivity of the canonical completion map for the
sum of this ideal with itself follows directly from that input and idempotence of
supremum. For the integer module, the bottom ideal is complete, whereas the top
ideal is precomplete but not Hausdorff. The empty set generates the bottom ideal.

## References

* [K. Fujiwara and F. Kato, *Foundations of Rigid Geometry I*,
  arXiv:1308.4734v5 (2017-02-28), Exercise 0.7.4](https://arxiv.org/abs/1308.4734v5).

The cited exercise assumes Hausdorff completeness for finitely many principal
ideals and concludes Hausdorff completeness of the separated quotient for their
generated ideal. Its equivalence for the original module explicitly assumes
separatedness for that ideal. The binary proposition allows arbitrary ideals and
only precompleteness; it differs from the exercise's statement.
-/

set_option warningAsError true

section

universe u v

variable {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]

#check (∀ I J : Ideal R, IsPrecomplete I M → IsPrecomplete J M →
  IsPrecomplete (I ⊔ J) M : Prop)

#check (∀ s : Set R, s.Finite →
  (∀ a ∈ s, IsAdicComplete (Ideal.span {a}) M) →
  IsAdicComplete (Ideal.span s) (Hausdorffification (Ideal.span s) M) : Prop)

#check (∀ s : Set R, s.Finite → IsHausdorff (Ideal.span s) M →
  (IsAdicComplete (Ideal.span s) M ↔
    ∀ a ∈ s, IsAdicComplete (Ideal.span {a}) M) : Prop)

end

namespace AdicModulesTest.AdicCompletion.Completeness

local instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

private theorem two_adic_complete :
    IsAdicComplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := by
  simpa only [PadicInt.maximalIdeal_eq_span_p, Nat.cast_ofNat] using
    (inferInstance : IsAdicComplete (IsLocalRing.maximalIdeal ℤ_[2]) ℤ_[2])

private theorem two_adic_precomplete :
    IsPrecomplete (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := by
  simpa only [PadicInt.maximalIdeal_eq_span_p, Nat.cast_ofNat] using
    (inferInstance : IsPrecomplete (IsLocalRing.maximalIdeal ℤ_[2]) ℤ_[2])

private theorem two_adic_principal_inputs :
    ({(2 : ℤ_[2])} : Set ℤ_[2]).Finite ∧
      (∀ a ∈ ({(2 : ℤ_[2])} : Set ℤ_[2]),
        IsAdicComplete (Ideal.span {a}) ℤ_[2]) ∧
      IsHausdorff (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] := by
  refine ⟨Set.finite_singleton _, ?_, two_adic_complete.toIsHausdorff⟩
  intro a ha
  rcases Set.mem_singleton_iff.mp ha with rfl
  exact two_adic_complete

private theorem two_adic_nondegenerate :
    (0 : ℤ_[2]) ≠ 1 ∧
      Ideal.span {(2 : ℤ_[2])} ≠ ⊥ ∧ Ideal.span {(2 : ℤ_[2])} ≠ ⊤ := by
  refine ⟨zero_ne_one, ?_, ?_⟩
  · intro h
    exact (two_ne_zero : (2 : ℤ_[2]) ≠ 0) (Ideal.span_singleton_eq_bot.mp h)
  · exact Ideal.span_singleton_ne_top (PadicInt.p_nonunit (p := 2))

private theorem two_adic_hausdorffification_nonzero :
    Hausdorffification.of (Ideal.span {(2 : ℤ_[2])}) ℤ_[2] 1 ≠ 0 := by
  intro h
  have hmem : (1 : ℤ_[2]) ∈
      LinearMap.ker (Hausdorffification.of (Ideal.span {(2 : ℤ_[2])}) ℤ_[2]) :=
    LinearMap.mem_ker.mpr h
  rw [Hausdorffification.of, Submodule.ker_mkQ,
    two_adic_complete.toIsHausdorff.iInf_pow_smul] at hmem
  exact one_ne_zero ((Submodule.mem_bot _).mp hmem)

private theorem two_adic_join_surjective :
    Function.Surjective
      (AdicCompletion.of
        (Ideal.span {(2 : ℤ_[2])} ⊔ Ideal.span {(2 : ℤ_[2])}) ℤ_[2]) := by
  apply AdicCompletion.of_surjective_iff.mpr
  simpa only [sup_idem] using two_adic_precomplete

private theorem integers_bottom_complete :
    IsAdicComplete (⊥ : Ideal ℤ) ℤ := inferInstance

/-- The integers are precomplete but not Hausdorff for the unit-ideal filtration. -/
public theorem integers_top_precomplete_not_hausdorff :
    IsPrecomplete (⊤ : Ideal ℤ) ℤ ∧ ¬ IsHausdorff (⊤ : Ideal ℤ) ℤ := by
  refine ⟨inferInstance, fun h => ?_⟩
  exact (zero_ne_one : (0 : ℤ) ≠ 1) (@Subsingleton.elim ℤ h.subsingleton 0 1)

end AdicModulesTest.AdicCompletion.Completeness
