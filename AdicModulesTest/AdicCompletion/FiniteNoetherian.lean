module

public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
public import Mathlib.RingTheory.Finiteness.Projective
public import Mathlib.RingTheory.Int.Basic
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Algebra.Module.ULift

import AdicModules.AdicCompletion.TensorProduct

/-!
# The tensor comparison for the lifted module of integers modulo two

The finite integer module `ULift.{1} (ZMod 2)` lies in a higher universe than the ring of
integers and is not projective. For the ideal generated by two, its canonical tensor
comparison sends the tensor of one with the lifted residue of one to a nonzero completion
element. Evaluation at level one detects this nonzero element.

Bijectivity in this example follows independently from Mathlib's comparison for `ZMod 2`,
transported along `ULift.moduleEquiv` by the naturality of the canonical comparison.

## References

Mathlib's adic-completion tensor comparison and its naturality, by Judith Ludwig and
Christian Merten, supply the comparison map and the finite-Noetherian result for `ZMod 2`.
The module APIs of Kim Morrison and Johan Commelin supply the lift and finiteness. The
projective lifting property of Kevin Buzzard and Antoine Labelle and the integer quotient
map in Chris Hughes's `ZMod` API show nonprojectivity.
-/

set_option warningAsError true

@[expose] public section

noncomputable section

open TensorProduct

namespace AdicModulesTest.AdicCompletion.FiniteNoetherian

/-- The lifted module of residues modulo two is finite over the integers. -/
theorem uliftZModTwo_finite : Module.Finite ℤ (ULift.{1} (ZMod 2)) :=
  inferInstance

/-- Multiplication by two annihilates every lifted residue. -/
theorem uliftZModTwo_two_smul (m : ULift.{1} (ZMod 2)) : (2 : ℤ) • m = 0 := by
  apply ULift.ext
  change (2 : ℤ) • m.down = 0
  simp only [zsmul_eq_mul]
  rw [show ((2 : ℤ) : ZMod 2) = 0 by decide, zero_mul]

/-- The lifted residue of one is nonzero. -/
theorem uliftZModTwo_one_ne_zero : (ULift.up (1 : ZMod 2) : ULift.{1} (ZMod 2)) ≠ 0 := by
  intro h
  have : (1 : ZMod 2) = 0 := congrArg ULift.down h
  exact one_ne_zero this

/-- The lifted module of residues modulo two is not projective over the integers. -/
theorem uliftZModTwo_not_projective : ¬ Module.Projective ℤ (ULift.{1} (ZMod 2)) := by
  intro h
  let f : ℤ →ₗ[ℤ] ULift.{1} (ZMod 2) :=
    (ULift.moduleEquiv : ULift.{1} (ZMod 2) ≃ₗ[ℤ] ZMod 2).symm.toLinearMap.comp
      (Int.castAddHom (ZMod 2)).toIntLinearMap
  have hf : Function.Surjective f := by
    intro m
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective m.down
    exact ⟨z, ULift.ext _ _ hz⟩
  obtain ⟨g, hg⟩ := Module.projective_lifting_property f LinearMap.id hf
  have htwo : (2 : ℤ) • g (ULift.up (1 : ZMod 2)) = 0 := by
    rw [← map_smul, uliftZModTwo_two_smul, map_zero]
  have hzero : g (ULift.up (1 : ZMod 2)) = 0 := by
    simpa only [smul_eq_mul, mul_eq_zero, OfNat.ofNat_ne_zero, false_or] using htwo
  have hsplit := LinearMap.congr_fun hg (ULift.up (1 : ZMod 2))
  simp only [LinearMap.comp_apply, LinearMap.id_apply, hzero, map_zero] at hsplit
  exact uliftZModTwo_one_ne_zero hsplit.symm

/-- The ideal generated by two annihilates the lifted module. -/
theorem uliftZModTwo_ideal_smul_top :
    Ideal.span ({(2 : ℤ)} : Set ℤ) • (⊤ : Submodule ℤ (ULift.{1} (ZMod 2))) = ⊥ := by
  rw [Submodule.ideal_span_singleton_smul]
  apply le_antisymm _ bot_le
  rintro x hx
  obtain ⟨m, _, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hx
  exact (Submodule.mem_bot ℤ).mpr (uliftZModTwo_two_smul m)

/-- Evaluation at level one detects the nonzero completion of the lifted residue of one. -/
theorem uliftZModTwo_of_ne_zero :
    AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))
      (ULift.up (1 : ZMod 2)) ≠ 0 := by
  intro h
  have he := congrArg
    (AdicCompletion.eval (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2)) 1) h
  rw [AdicCompletion.eval_of, map_zero] at he
  have hm := (Submodule.Quotient.mk_eq_zero _).mp he
  rw [pow_one, uliftZModTwo_ideal_smul_top, Submodule.mem_bot] at hm
  exact uliftZModTwo_one_ne_zero hm

/-- The canonical comparison on the lifted residue module is bijective, by transport of
Mathlib's comparison for the unlifted residue module. -/
theorem uliftZModTwo_bijective :
    Function.Bijective (AdicCompletion.ofTensorProduct
      (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))) := by
  let I := Ideal.span ({(2 : ℤ)} : Set ℤ)
  let e : ULift.{1} (ZMod 2) ≃ₗ[ℤ] ZMod 2 := ULift.moduleEquiv
  have hc := AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian I (ZMod 2)
  have he : Function.Bijective (AdicCompletion.map I e.toLinearMap) :=
    (AdicCompletion.congr I e).bijective
  apply (Function.Bijective.of_comp_iff' he _).mp
  change Function.Bijective (AdicCompletion.map I e.toLinearMap ∘ₗ
    AdicCompletion.ofTensorProduct I (ULift.{1} (ZMod 2)))
  rw [AdicCompletion.ofTensorProduct_naturality]
  exact hc.comp (e.baseChange ℤ (AdicCompletion I ℤ) _ _).bijective

/-- The canonical comparison sends the tensor of one with the lifted residue of one
to its canonical image in the completion. -/
theorem uliftZModTwo_ofTensorProduct_one :
    AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))
      ((1 : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) ⊗ₜ[ℤ]
        ULift.up (1 : ZMod 2)) =
      AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))
        (ULift.up (1 : ZMod 2)) := by
  simp

/-- The image of the tensor of one with the lifted residue of one is nonzero. -/
theorem uliftZModTwo_ofTensorProduct_ne_zero :
    AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))
      ((1 : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) ⊗ₜ[ℤ]
        ULift.up (1 : ZMod 2)) ≠ 0 := by
  rw [uliftZModTwo_ofTensorProduct_one]
  exact uliftZModTwo_of_ne_zero

/-- The inverse constructed from the general comparison recovers the tensor of one with the
nonzero lifted residue from its canonical completion image. -/
private theorem uliftZModTwo_inverse_of :
    (LinearEquiv.ofBijective
      (AdicCompletion.ofTensorProduct (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2)))
      (AdicCompletion.ofTensorProduct_bijective
        (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2)))).symm
      (AdicCompletion.of (Ideal.span ({(2 : ℤ)} : Set ℤ)) (ULift.{1} (ZMod 2))
        (ULift.up (1 : ZMod 2))) =
      (1 : AdicCompletion (Ideal.span ({(2 : ℤ)} : Set ℤ)) ℤ) ⊗ₜ[ℤ]
        ULift.up (1 : ZMod 2) := by
  apply (LinearEquiv.symm_apply_eq _).mpr
  exact uliftZModTwo_ofTensorProduct_one.symm

end AdicModulesTest.AdicCompletion.FiniteNoetherian
