module

import AdicModules.AdicCompletion.Quotient
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.Data.ZMod.QuotientRing

/-!
# Quotient of the two-adic completion

The quotient of the two-adic completion of the integers by the extended ideal generated by two
is isomorphic to `ZMod 2` as an integer algebra. The isomorphism and its inverse respect the
canonical integer residues, and distinguish the residues of zero and one.

The degree-zero quotients are subsingleton, so the quotient map induced by the canonical
integer algebra map has a uniquely determined value on every residue.

## References

The construction uses Mathlib's `AdicCompletion.ker_evalOneₐ_eq_map`, the first isomorphism
theorem for algebras, and `Int.quotientSpanNatEquivZMod`.
-/

@[expose] public section

private abbrev twoIdeal : Ideal ℤ := Ideal.span {(2 : ℤ)}

private abbrev twoCompletion := AdicCompletion twoIdeal ℤ

private noncomputable abbrev twoExtendedIdeal : Ideal twoCompletion :=
  twoIdeal.map (algebraMap ℤ twoCompletion)

private lemma twoExtendedIdeal_pow_one_eq_ker_evalOne :
    twoExtendedIdeal ^ 1 = RingHom.ker (AdicCompletion.evalOneₐ twoIdeal).toRingHom := by
  simpa only [pow_one] using
    (AdicCompletion.ker_evalOneₐ_eq_map twoIdeal
      (Submodule.fg_span_singleton (2 : ℤ))).symm

private noncomputable def quotientSpanTwoAlgEquivZMod :
    (twoCompletion ⧸ twoExtendedIdeal ^ 1) ≃ₐ[ℤ] ZMod 2 :=
  ((Ideal.quotientEquivAlgOfEq ℤ twoExtendedIdeal_pow_one_eq_ker_evalOne).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (AdicCompletion.evalOneₐ_surjective twoIdeal))).trans
    (Int.quotientSpanNatEquivZMod 2).toIntAlgEquiv

private lemma quotientSpanTwoAlgEquivZMod_mk (x : twoCompletion) :
    quotientSpanTwoAlgEquivZMod (Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) x) =
      Int.quotientSpanNatEquivZMod 2 (AdicCompletion.evalOneₐ twoIdeal x) := by
  unfold quotientSpanTwoAlgEquivZMod
  change Int.quotientSpanNatEquivZMod 2
      ((Ideal.quotientKerAlgEquivOfSurjective
        (AdicCompletion.evalOneₐ_surjective twoIdeal))
        (Ideal.Quotient.mk (RingHom.ker (AdicCompletion.evalOneₐ twoIdeal).toRingHom) x)) = _
  exact congrArg (Int.quotientSpanNatEquivZMod 2)
    (Ideal.quotientKerAlgEquivOfSurjective_mk
      (AdicCompletion.evalOneₐ_surjective twoIdeal) x)

private lemma quotientSpanTwoAlgEquivZMod_apply_algebraMap (r : ℤ) :
    quotientSpanTwoAlgEquivZMod
        (Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion r)) =
      (r : ZMod 2) := by
  rw [quotientSpanTwoAlgEquivZMod_mk]
  have heval : AdicCompletion.evalOneₐ twoIdeal (algebraMap ℤ twoCompletion r) =
      Ideal.Quotient.mk twoIdeal r :=
    RingHom.congr_fun (AdicCompletion.evalOneₐ_comp_algebraMap_eq_mk twoIdeal) r
  rw [heval]
  exact RingHom.congr_fun (Int.quotientSpanNatEquivZMod_comp_Quotient_mk 2) r

private lemma quotientSpanTwoAlgEquivZMod_symm_intCast (r : ℤ) :
    quotientSpanTwoAlgEquivZMod.symm (r : ZMod 2) =
      Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion r) := by
  apply quotientSpanTwoAlgEquivZMod.injective
  rw [AlgEquiv.apply_symm_apply, quotientSpanTwoAlgEquivZMod_apply_algebraMap]

private lemma quotientSpanTwoAlgEquivZMod_zero_ne_one :
    quotientSpanTwoAlgEquivZMod
        (Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion 0)) ≠
      quotientSpanTwoAlgEquivZMod
        (Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion 1)) := by
  rw [quotientSpanTwoAlgEquivZMod_apply_algebraMap,
    quotientSpanTwoAlgEquivZMod_apply_algebraMap]
  simpa only [Int.cast_zero, Int.cast_one] using (zero_ne_one : (0 : ZMod 2) ≠ 1)

private theorem twoCompletion_and_quotient_nontrivial :
    Nontrivial twoCompletion ∧ Nontrivial (twoCompletion ⧸ twoExtendedIdeal ^ 1) := by
  have hq :
      Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion 0) ≠
        Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion 1) := by
    intro h
    exact quotientSpanTwoAlgEquivZMod_zero_ne_one (congrArg quotientSpanTwoAlgEquivZMod h)
  constructor
  · refine ⟨⟨algebraMap ℤ twoCompletion 0, algebraMap ℤ twoCompletion 1, ?_⟩⟩
    intro h
    exact hq (congrArg (Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 1)) h)
  · exact ⟨⟨_, _, hq⟩⟩

private theorem degreeZero_subsingleton :
    Subsingleton (twoCompletion ⧸ twoExtendedIdeal ^ 0) ∧
      Subsingleton (ℤ ⧸ twoIdeal ^ 0) := by
  simp only [pow_zero, Ideal.one_eq_top]
  exact ⟨inferInstance, inferInstance⟩

private theorem degreeZero_inverse_algebraMap (r : ℤ) :
    Ideal.quotientMapₐ (I := twoIdeal ^ 0) (twoExtendedIdeal ^ 0)
        (Algebra.ofId ℤ twoCompletion)
        (by simp only [pow_zero, Ideal.one_eq_top, Ideal.comap_top, le_top])
        (Ideal.Quotient.mkₐ ℤ (twoIdeal ^ 0) r) =
      Ideal.Quotient.mkₐ ℤ (twoExtendedIdeal ^ 0) (algebraMap ℤ twoCompletion r) := by
  exact @Subsingleton.elim _ degreeZero_subsingleton.1 _ _

private lemma twoIdeal_pow_one_fg : (twoIdeal ^ 1).FG := by
  rw [pow_one]
  change (Submodule.span ℤ {(2 : ℤ)}).FG
  exact Submodule.fg_span_singleton (R := ℤ) (2 : ℤ)

private theorem quotientPowAlgEquiv_two_mk (x : twoCompletion) :
    AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg
        (Ideal.Quotient.mk (twoExtendedIdeal ^ 1) x) =
      AdicCompletion.evalₐ twoIdeal 1 x := by
  unfold AdicCompletion.quotientPowAlgEquiv
  change (Ideal.quotientKerAlgEquivOfSurjective
      (AdicCompletion.surjective_evalₐ twoIdeal 1))
      (Ideal.Quotient.mk (RingHom.ker (AdicCompletion.evalₐ twoIdeal 1).toRingHom) x) = _
  exact Ideal.quotientKerAlgEquivOfSurjective_mk
    (AdicCompletion.surjective_evalₐ twoIdeal 1) x

private theorem quotientPowAlgEquiv_two_trans_eq :
    (AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg).trans
        ((Ideal.quotientEquivAlgOfEq ℤ (pow_one twoIdeal)).trans
          (Int.quotientSpanNatEquivZMod 2).toIntAlgEquiv) =
      quotientSpanTwoAlgEquivZMod := by
  apply AlgEquiv.ext
  intro q
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℤ (twoExtendedIdeal ^ 1) q
  change Int.quotientSpanNatEquivZMod 2
      (Ideal.Quotient.factor (le_of_eq (pow_one twoIdeal))
        (AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg
          (Ideal.Quotient.mk (twoExtendedIdeal ^ 1) x))) =
    quotientSpanTwoAlgEquivZMod (Ideal.Quotient.mk (twoExtendedIdeal ^ 1) x)
  rw [quotientPowAlgEquiv_two_mk, AdicCompletion.factorₐ_evalₐ_one]
  exact (quotientSpanTwoAlgEquivZMod_mk x).symm

private theorem quotientPowAlgEquiv_two_symm_mk (r : ℤ) :
    (AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg).symm
        (Ideal.Quotient.mk (twoIdeal ^ 1) r) =
      Ideal.Quotient.mk (twoExtendedIdeal ^ 1) (algebraMap ℤ twoCompletion r) := by
  apply (AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg).injective
  simpa only [AlgEquiv.apply_symm_apply, quotientPowAlgEquiv_two_mk,
    Ideal.Quotient.algebraMap_eq] using
    ((AdicCompletion.evalₐ twoIdeal 1).commutes r).symm

private theorem quotientPowAlgEquiv_two_symm_toAlgHom :
    (AdicCompletion.quotientPowAlgEquiv twoIdeal 1 twoIdeal_pow_one_fg).symm.toAlgHom =
      Ideal.quotientMapₐ (I := twoIdeal ^ 1) (twoExtendedIdeal ^ 1)
        (Algebra.ofId ℤ twoCompletion)
        (by
          change twoIdeal ^ 1 ≤
            (twoExtendedIdeal ^ 1).comap (algebraMap ℤ twoCompletion)
          rw [← Ideal.map_pow (algebraMap ℤ twoCompletion) twoIdeal 1]
          exact Ideal.le_comap_map) := by
  apply AlgHom.ext
  intro q
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  simpa only [AlgEquiv.toAlgHom_apply, Ideal.quotient_map_mkₐ,
    Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply] using
    quotientPowAlgEquiv_two_symm_mk r
