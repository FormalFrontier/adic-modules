namespace Module.End.ZModNine

private abbrev R := ZMod 9

private def idealThree : Ideal R := Ideal.span ({(3 : R)} : Set R)

private theorem three_mem_idealThree : (3 : R) ∈ idealThree :=
  Ideal.subset_span (by simp)

private theorem idealThree_fg : idealThree.FG := ⟨{3}, by simp [idealThree]⟩

private theorem idealThree_le_jacobson : idealThree ≤ Ideal.jacobson (⊥ : Ideal R) := by
  apply Ideal.span_le.mpr
  intro x hx
  have hx3 : x = (3 : R) := Set.mem_singleton_iff.mp hx
  subst x
  apply Ideal.mem_jacobson_bot.mpr
  intro y
  have hy : ((3 : R) * y + 1) * (1 - (3 : R) * y) = 1 := by
    calc
      _ = 1 - (9 : R) * (y * y) := by ring
      _ = 1 := by rw [show (9 : R) = 0 by decide]; simp
  exact ⟨⟨(3 : R) * y + 1, 1 - (3 : R) * y, hy, by rw [mul_comm]; exact hy⟩, rfl⟩

private theorem idealThree_ne_top : idealThree ≠ ⊤ := by
  intro h
  have h1 : (1 : R) ∈ Ideal.jacobson (⊥ : Ideal R) :=
    idealThree_le_jacobson (by simp [h])
  have hu := (Ideal.mem_jacobson_bot.mp h1) (-1)
  have hz : (0 : R) = 1 := by simpa using hu
  exact (by decide : (0 : R) ≠ 1) hz

private theorem idealThree_ne_bot : idealThree ≠ ⊥ := by
  intro h
  have hz : (3 : R) = 0 := by simpa [h] using three_mem_idealThree
  exact (by decide : (3 : R) ≠ 0) hz

private def multiply (a : R) : Module.End R R where
  toFun x := a * x
  map_add' x y := mul_add _ _ _
  map_smul' r x := by
    change a * (r * x) = r * (a * x)
    ring

private def doubleUnit : (Module.End R R)ˣ where
  val := multiply 2
  inv := multiply 5
  val_inv := by
    apply LinearMap.ext
    intro x
    change (2 : R) * ((5 : R) * x) = x
    rw [← mul_assoc, show (2 : R) * 5 = 1 by decide, one_mul]
  inv_val := by
    apply LinearMap.ext
    intro x
    change (5 : R) * ((2 : R) * x) = x
    rw [← mul_assoc, show (5 : R) * 2 = 1 by decide, one_mul]

private def quotientDouble :
    (Module.End R (R ⧸ (idealThree • (⊤ : Submodule R R))))ˣ :=
  Units.map (Module.End.reduceModIdeal idealThree).toMonoidHom doubleUnit

example (x : R) :
    (quotientDouble : Module.End R (R ⧸ (idealThree • (⊤ : Submodule R R))))
        (Submodule.Quotient.mk x) = Submodule.Quotient.mk ((2 : R) * x) :=
  Module.End.reduceModIdeal_apply_mk idealThree (multiply 2) x

private theorem quotientDouble_ne_one : quotientDouble ≠ 1 := by
  intro h
  have hred : Module.End.reduceModIdeal idealThree (multiply 2) = 1 :=
    congrArg Units.val h
  have hm := (Module.End.reduceModIdeal_eq_iff idealThree (multiply 2) 1).mp
    (by simpa using hred) 1
  have hdiff : (multiply 2) 1 - (1 : Module.End R R) 1 = (1 : R) := by decide
  have hmem : (1 : R) ∈ idealThree • (⊤ : Submodule R R) := hdiff ▸ hm
  have hsub : idealThree • (⊤ : Submodule R R) ≤ idealThree := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    simpa only [smul_eq_mul, mul_comm a x] using idealThree.smul_mem x ha
  apply idealThree_ne_top
  apply top_unique
  intro a _
  simpa using idealThree.smul_mem a (hsub hmem)

example : idealThree ≠ ⊥ ∧ idealThree ≠ ⊤ ∧ quotientDouble ≠ 1 :=
  ⟨idealThree_ne_bot, idealThree_ne_top, quotientDouble_ne_one⟩

example : ∃ u : (Module.End R R)ˣ,
    Units.map (Module.End.reduceModIdeal idealThree).toMonoidHom u = quotientDouble :=
  Module.End.unitsMap_reduceModIdeal_surjective idealThree
    (idealThree_le_jacobson.trans (Ideal.jacobson_mono bot_le)) quotientDouble

private def upper : Module.End R (R × R) where
  toFun p := (p.2, 0)
  map_add' p q := by simp
  map_smul' a p := by simp

private def offDiagonal : Module.End R (R × R) := (3 : R) • upper

private theorem offDiagonal_mem :
    offDiagonal ∈ idealThree • (⊤ : Submodule R (Module.End R (R × R))) :=
  Submodule.smul_mem_smul three_mem_idealThree (by trivial)

example : ∃ g : Module.End R (R × R), offDiagonal = (3 : R) • g := ⟨upper, rfl⟩

example : offDiagonal (0, 1) = (3, 0) := by
  change ((3 : R) * 1, (3 : R) * 0) = (3, 0)
  simp

example : offDiagonal ≠ 0 := by
  intro h
  have hz := congrArg (fun g : Module.End R (R × R) => (g (0, 1)).1) h
  change (3 : R) * 1 = 0 at hz
  exact (by decide : (3 : R) ≠ 0) (by simpa using hz)

example : Module.End.reduceModIdeal idealThree offDiagonal = 0 :=
  (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top_of_fg idealThree
    ⟨{3}, by simp [idealThree]⟩ offDiagonal).mpr offDiagonal_mem

example : Module.End.reduceModIdeal idealThree offDiagonal = 0 :=
  (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr offDiagonal_mem

private theorem offDiagonal_mem_span :
    offDiagonal ∈ Ideal.span
      ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)) :=
  (Module.End.mem_span_smul_one idealThree offDiagonal).mpr offDiagonal_mem

example : Module.End.reduceModIdeal idealThree offDiagonal = 0 := by
  change offDiagonal ∈ RingHom.ker (Module.End.reduceModIdeal (M := R × R) idealThree)
  rw [Module.End.ker_reduceModIdeal_eq_span_smul_one_of_fg idealThree
    ⟨{3}, by simp [idealThree]⟩]
  exact offDiagonal_mem_span

example : Module.End.reduceModIdeal idealThree offDiagonal = 0 := by
  change offDiagonal ∈ RingHom.ker (Module.End.reduceModIdeal (M := R × R) idealThree)
  rw [Module.End.ker_reduceModIdeal_eq_span_smul_one]
  exact offDiagonal_mem_span

private theorem first_basis_class_ne_zero :
    (Submodule.Quotient.mk ((1, 0) : R × R) :
      (R × R) ⧸ (idealThree • (⊤ : Submodule R (R × R)))) ≠ 0 := by
  intro h
  have hm : ((1, 0) : R × R) ∈ idealThree • (⊤ : Submodule R (R × R)) := by
    simpa using (Submodule.Quotient.eq _).mp h
  have hfirst : ∀ p ∈ idealThree • (⊤ : Submodule R (R × R)), p.1 ∈ idealThree := by
    intro p hp
    refine Submodule.smul_induction_on hp ?_ ?_
    · intro a ha p _
      change a * p.1 ∈ idealThree
      simpa only [smul_eq_mul, mul_comm] using idealThree.smul_mem p.1 ha
    · intro p q hp hq
      exact idealThree.add_mem hp hq
  apply idealThree_ne_top
  apply top_unique
  intro a _
  simpa using idealThree.smul_mem a (hfirst _ hm)

private theorem upper_reduction_ne_zero :
    Module.End.reduceModIdeal idealThree upper ≠ 0 := by
  intro h
  apply first_basis_class_ne_zero
  have hv := DFunLike.congr_fun h (Submodule.Quotient.mk ((0, 1) : R × R))
  simpa [upper] using hv

example : Ideal.Quotient.mk
    (Ideal.span ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)))
      upper ≠ 0 := by
  intro h
  apply upper_reduction_ne_zero
  have hv := congrArg (Module.End.reduceModIdealQuotientEquiv (M := R × R) idealThree) h
  simpa using hv

example : Module.End.reduceModIdealQuotientEquivOfFG idealThree
    idealThree_fg (Ideal.Quotient.mk _ upper)
      (Submodule.Quotient.mk ((0, 1) : R × R)) = Submodule.Quotient.mk ((1, 0) : R × R) := by
  simp [upper]

example : Module.End.reduceModIdealQuotientEquiv idealThree (Ideal.Quotient.mk _ upper)
    (Submodule.Quotient.mk ((0, 1) : R × R)) = Submodule.Quotient.mk ((1, 0) : R × R) := by
  simp [upper]

example : Module.End.reduceModIdealQuotientEquivOfFG idealThree
    idealThree_fg (Ideal.Quotient.mk _ offDiagonal) = 0 := by
  simp only [Module.End.reduceModIdealQuotientEquivOfFG_apply_mk]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
    offDiagonal_mem

example : Module.End.reduceModIdealQuotientEquiv idealThree
    (Ideal.Quotient.mk _ offDiagonal) = 0 := by
  simp only [Module.End.reduceModIdealQuotientEquiv_apply_mk]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
    offDiagonal_mem

example : Ideal.Quotient.mk
    (Ideal.span ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)))
      offDiagonal = 0 := by
  apply (Module.End.reduceModIdealQuotientEquiv (M := R × R) idealThree).injective
  simp only [Module.End.reduceModIdealQuotientEquiv_apply_mk, map_zero]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
    offDiagonal_mem

example : Ideal.span
    ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)) ≠ ⊥ := by
  intro h
  have hz : offDiagonal = 0 := by simpa [h] using offDiagonal_mem_span
  have he := congrArg (fun g : Module.End R (R × R) => (g (0, 1)).1) hz
  exact (by decide : (3 : R) ≠ 0) (by simpa [offDiagonal, upper] using he)

example : Ideal.span
    ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)) ≠ ⊤ := by
  intro h
  apply upper_reduction_ne_zero
  change upper ∈ RingHom.ker (Module.End.reduceModIdeal (M := R × R) idealThree)
  rw [Module.End.ker_reduceModIdeal_eq_span_smul_one, h]
  trivial

end Module.End.ZModNine

section AutomorphismBoundaries

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable [Module.Finite R M] [Module.Projective R M]

example : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := M) (⊥ : Ideal R)).toMonoidHom) :=
  Module.End.unitsMap_reduceModIdeal_surjective ⊥ bot_le

example (I : Ideal R) : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := Fin 0 → R) I).toMonoidHom) := by
  apply Module.End.unitsMap_reduceModIdeal_surjective I
  have hAnn : Module.annihilator R (Fin 0 → R) = ⊤ := by
    apply top_unique
    intro a _
    exact Module.mem_annihilator.mpr (fun m => Subsingleton.elim _ _)
  simp [hAnn]

example (I : Ideal R) (f : Module.End R (Fin 0 → R)) :
    Module.End.reduceModIdealQuotientEquiv I (Ideal.Quotient.mk _ f) = 0 :=
  Subsingleton.elim _ _

end AutomorphismBoundaries
