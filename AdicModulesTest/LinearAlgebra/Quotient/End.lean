module

public import AdicModules.LinearAlgebra.Quotient.End
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Tactic.Ring

/-!
# Endomorphism reduction over the integers modulo four

For the proper nonzero ideal generated by two, multiplication by three is a
nonidentity involutory unit whose reduction is the identity. The model uses
quotient equality and elementary arithmetic independently of the general
finite-module unit-reflection theorem.
-/

@[expose] public section

namespace Module.End.ZModFour

/-- The ring of integers modulo four. -/
abbrev R := ZMod 4

/-- The ideal generated by two in the integers modulo four. -/
def idealTwo : Ideal R := Ideal.span ({(2 : R)} : Set R)

theorem two_mem_idealTwo : (2 : R) ∈ idealTwo :=
  Ideal.subset_span (by simp)

theorem idealTwo_ne_bot : idealTwo ≠ ⊥ := by
  intro h
  have hz : (2 : R) = 0 := by simpa [h] using two_mem_idealTwo
  exact (by decide : (2 : R) ≠ 0) hz

theorem idealTwo_le_jacobson : idealTwo ≤ Ideal.jacobson (⊥ : Ideal R) := by
  apply Ideal.span_le.mpr
  intro x hx
  have hx2 : x = (2 : R) := Set.mem_singleton_iff.mp hx
  subst x
  apply Ideal.mem_jacobson_bot.mpr
  intro y
  have hy : ((2 : R) * y + 1) * ((2 : R) * y + 1) = 1 := by
    calc
      _ = (4 : R) * (y * y + y) + 1 := by ring
      _ = 1 := by rw [show (4 : R) = 0 by decide]; simp
  exact ⟨⟨(2 : R) * y + 1, (2 : R) * y + 1, hy, hy⟩, rfl⟩

theorem idealTwo_ne_top : idealTwo ≠ ⊤ := by
  intro h
  have h1 : (1 : R) ∈ Ideal.jacobson (⊥ : Ideal R) :=
    idealTwo_le_jacobson (by simp [h])
  have hu := (Ideal.mem_jacobson_bot.mp h1) (-1)
  have hz : (0 : R) = 1 := by simpa using hu
  exact (by decide : (0 : R) ≠ 1) hz

theorem quotient_nontrivial :
    Nontrivial (R ⧸ (idealTwo • (⊤ : Submodule R R))) := by
  apply Submodule.Quotient.nontrivial_iff.mpr
  intro hp
  have hsub : idealTwo • (⊤ : Submodule R R) ≤ idealTwo := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    simpa only [smul_eq_mul, mul_comm a x] using idealTwo.smul_mem x ha
  apply idealTwo_ne_top
  exact top_unique (by simpa only [hp] using hsub)

/-- Multiplication by three, a nonidentity involutory endomorphism. -/
def triple : Module.End R R where
  toFun x := (3 : R) * x
  map_add' x y := mul_add _ _ _
  map_smul' r x := by
    change (3 : R) * (r * x) = r * ((3 : R) * x)
    ring

@[simp]
theorem triple_apply (x : R) : triple x = (3 : R) * x := rfl

theorem triple_square : triple * triple = 1 := by
  apply LinearMap.ext
  intro x
  change (3 : R) * ((3 : R) * x) = x
  rw [← mul_assoc, show (3 : R) * 3 = 1 by decide, one_mul]

theorem triple_isUnit : IsUnit triple :=
  ⟨⟨triple, triple, triple_square, triple_square⟩, rfl⟩

theorem triple_ne_one : triple ≠ 1 := by
  intro h
  have h1 := congrArg (fun f : Module.End R R => f 1) h
  have hc : (3 : R) = 1 := by simpa using h1
  exact (by decide : (3 : R) ≠ 1) hc

theorem triple_reduces_to_one : Module.End.reduceModIdeal idealTwo triple = 1 := by
  rw [← (Module.End.reduceModIdeal (M := R) idealTwo).map_one]
  apply (Module.End.reduceModIdeal_eq_iff idealTwo triple 1).mpr
  intro x
  change (3 : R) * x - x ∈ idealTwo • (⊤ : Submodule R R)
  have hx : (3 : R) * x - x = (2 : R) • x := by
    simp only [smul_eq_mul]
    ring
  rw [hx]
  exact Submodule.smul_mem_smul two_mem_idealTwo (by trivial)

theorem triple_reduction_isUnit :
    IsUnit (Module.End.reduceModIdeal idealTwo triple) := by
  rw [triple_reduces_to_one]
  exact isUnit_one

example : Module.Finite R R := inferInstance

example : idealTwo ≤ Ideal.jacobson (Module.annihilator R R) :=
  idealTwo_le_jacobson.trans (Ideal.jacobson_mono bot_le)

example : IsUnit triple := by
  let : IsLocalHom (Module.End.reduceModIdeal (M := R) idealTwo) :=
    Module.End.isLocalHom_reduceModIdeal idealTwo
      (idealTwo_le_jacobson.trans (Ideal.jacobson_mono bot_le))
  exact (isUnit_map_iff (Module.End.reduceModIdeal (M := R) idealTwo) triple).mp
    triple_reduction_isUnit

end Module.End.ZModFour
