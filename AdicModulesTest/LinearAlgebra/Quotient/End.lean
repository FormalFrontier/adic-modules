example : Module.End.reduceModIdealQuotientEquiv idealThree
    (Ideal.Quotient.mk _ offDiagonal) = 0 := by
  simp only [Module.End.reduceModIdealQuotientEquiv_apply_mk]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
    offDiagonal_mem

example : Ideal.Quotient.mk
    (Ideal.span ((fun r : R => r • (1 : Module.End R (R × R))) '' (idealThree : Set R)))
      offDiagonal = 0 := by
  apply (Module.End.reduceModIdealQuotientEquiv (M := R × R) idealThree).injective
  simp only [Module.End.reduceModIdealQuotientEquiv_apply_mk, map_zero]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
