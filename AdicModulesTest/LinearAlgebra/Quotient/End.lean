section AutomorphismBoundaries

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable [Module.Finite R M] [Module.Projective R M]

example : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := M) (⊥ : Ideal R)).toMonoidHom) :=
  Module.End.unitsMap_reduceModIdeal_surjective ⊥ bot_le

example (I : Ideal R) : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := Fin 0 → R) I).toMonoidHom) := by
  apply Module.End.unitsMap_reduceModIdeal_surjective I
  have hAnn : Module.annihilator R (Fin 0 → R) = ⊤ := by
    apply top_unique
    intro a _
    exact Module.mem_annihilator.mpr (fun m => Subsingleton.elim _ _)
  simp [hAnn]

example (I : Ideal R) (f : Module.End R (Fin 0 → R)) :
    Module.End.reduceModIdealQuotientEquiv I (Ideal.Quotient.mk _ f) = 0 :=
  Subsingleton.elim _ _

end AutomorphismBoundaries

namespace Module.End.ZModSixteen

private abbrev R := ZMod 16

private def idealEight : Ideal R := Ideal.span ({(8 : R)} : Set R)

private def idealTwo : Ideal R := Ideal.span ({(2 : R)} : Set R)

private theorem eight_mem_idealEight : (8 : R) ∈ idealEight :=
  Ideal.subset_span (by simp)

private theorem two_mem_idealTwo : (2 : R) ∈ idealTwo :=
  Ideal.subset_span (by simp)

private theorem idealEight_le_idealTwo : idealEight ≤ idealTwo := by
  apply Ideal.span_le.mpr
  intro a ha
  have ha8 : a = (8 : R) := Set.mem_singleton_iff.mp ha
  subst a
  have h := idealTwo.smul_mem (4 : R) two_mem_idealTwo
  exact (show (4 : R) • (2 : R) = 8 by decide) ▸ h

private theorem mul_eq_zero_of_mem_span {a b x : R} (hab : a * b = 0)
    (hx : x ∈ Ideal.span ({b} : Set R)) : a * x = 0 := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
      have hyb : y = b := Set.mem_singleton_iff.mp hy
      simpa only [hyb] using hab
  | zero => exact mul_zero a
  | add y z hy hz ihy ihz => rw [mul_add, ihy, ihz, add_zero]
  | smul r y hy ih =>
      change a * (r * y) = 0
      calc
        _ = r * (a * y) := by ring
        _ = 0 := by rw [ih, mul_zero]

private theorem one_not_mem_idealTwo : (1 : R) ∉ idealTwo := by
  intro h
  have hz := mul_eq_zero_of_mem_span (by decide : (8 : R) * 2 = 0) h
  exact (by decide : (8 : R) ≠ 0) (by simpa using hz)

private theorem two_not_mem_idealEight : (2 : R) ∉ idealEight := by
  intro h
  have hz := mul_eq_zero_of_mem_span (by decide : (2 : R) * 8 = 0) h
  exact (by decide : (4 : R) ≠ 0)
    ((show (2 : R) * 2 = 4 by decide) ▸ hz)

example : idealEight ≠ ⊥ ∧ idealTwo ≠ ⊥ ∧ idealEight ≠ ⊤ ∧
    idealTwo ≠ ⊤ ∧ idealEight ≠ idealTwo := by
  have hTwo : idealTwo ≠ ⊤ := by
    intro h
    exact one_not_mem_idealTwo (by simp [h])
  refine ⟨?_, ?_, ?_, hTwo, ?_⟩
  · intro h
    exact (by decide : (8 : R) ≠ 0) (by simpa [h] using eight_mem_idealEight)
  · intro h
    exact (by decide : (2 : R) ≠ 0) (by simpa [h] using two_mem_idealTwo)
  · intro h
    exact hTwo (top_unique (h ▸ idealEight_le_idealTwo))
  · intro h
    exact two_not_mem_idealEight (h.symm ▸ two_mem_idealTwo)

private abbrev upper : Module.End R (R × R) := rankTwoUpper R

private def first : Module.End R (R × R) where
  toFun p := (p.1, 0)
  map_add' p q := by simp
  map_smul' a p := by simp

private abbrev upperEight := Module.End.reduceModIdeal idealEight upper

private theorem first_class_ne_zero :
    (Submodule.Quotient.mk ((1, 0) : R × R) :
      (R × R) ⧸ (idealTwo • (⊤ : Submodule R (R × R)))) ≠ 0 :=
  rankTwo_first_class_ne_zero idealTwo 1 one_not_mem_idealTwo

private theorem double_upperEight_ne_zero : upperEight + upperEight ≠ 0 := by
  intro h
  apply rankTwo_first_class_ne_zero idealEight 2 two_not_mem_idealEight
  have hv := DFunLike.congr_fun h (Submodule.Quotient.mk ((0, 1) : R × R))
  change (Submodule.Quotient.mk (((1, 0) : R × R) + (1, 0)) :
    (R × R) ⧸ (idealEight • (⊤ : Submodule R (R × R)))) = 0 at hv
  exact (show ((1, 0) : R × R) + (1, 0) = (2, 0) by decide) ▸ hv

private theorem double_upper_reduces_zero :
    Module.End.reduceModIdeal idealTwo (upper + upper) = 0 := by
  rw [← (Module.End.reduceModIdeal (M := R × R) idealTwo).map_zero]
  apply (Module.End.reduceModIdeal_eq_iff idealTwo (upper + upper) 0).mpr
  intro p
  simp only [LinearMap.zero_apply, sub_zero]
  change (p.2 + p.2, 0) ∈ idealTwo • (⊤ : Submodule R (R × R))
  have hp : ((p.2 + p.2, 0) : R × R) = (2 : R) • (p.2, 0) := by
    ext <;> simp [two_mul]
  rw [hp]
  exact Submodule.smul_mem_smul two_mem_idealTwo (by trivial)

private theorem nested_double_upper_eq_zero :
    Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo
      (upperEight + upperEight) = 0 := by
  change Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo
    (Module.End.reduceModIdeal idealEight upper +
      Module.End.reduceModIdeal idealEight upper) = 0
  rw [← (Module.End.reduceModIdeal (M := R × R) idealEight).map_add,
    Module.End.reduceModIdealOfLE_apply_reduceModIdeal]
  exact double_upper_reduces_zero

example : Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo
    upperEight = Module.End.reduceModIdeal idealTwo upper :=
  Module.End.reduceModIdealOfLE_apply_reduceModIdeal
    idealEight idealTwo idealEight_le_idealTwo upper

example : Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo
    upperEight (Submodule.Quotient.mk ((0, 1) : R × R)) =
      Submodule.Quotient.mk ((1, 0) : R × R) := by
  rw [Module.End.reduceModIdealOfLE_apply_reduceModIdeal]
  exact Module.End.reduceModIdeal_apply_mk idealTwo upper (0, 1)

example : upperEight ≠ 0 ∧
    Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo upperEight ≠ 0 := by
  constructor
  · intro h
    exact double_upperEight_ne_zero (by simp [h])
  · intro h
    apply first_class_ne_zero
    have hv := DFunLike.congr_fun h (Submodule.Quotient.mk ((0, 1) : R × R))
    rw [Module.End.reduceModIdealOfLE_apply_reduceModIdeal] at hv
    simpa [upper, rankTwoUpper] using hv

example : upperEight + upperEight ≠ 0 ∧
    Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo
      (upperEight + upperEight) = 0 := by
  refine ⟨double_upperEight_ne_zero, ?_⟩
  apply (Module.End.reduceModIdealOfLE_eq_zero_iff_mem_smul_top_of_fg
    idealEight idealTwo idealEight_le_idealTwo ⟨{2}, by simp [idealTwo]⟩
    (upperEight + upperEight)).mpr
  rw [← two_smul R upperEight]
  exact Submodule.smul_mem_smul two_mem_idealTwo (by trivial)

example : upperEight + upperEight ≠ 0 ∧
    Module.End.reduceModIdeal idealTwo (upperEight + upperEight) = 0 := by
  refine ⟨double_upperEight_ne_zero, ?_⟩
  have hf : upperEight + upperEight ∈ RingHom.ker
      (Module.End.reduceModIdealOfLE (M := R × R)
        idealEight idealTwo idealEight_le_idealTwo) := nested_double_upper_eq_zero
  rw [Module.End.ker_reduceModIdealOfLE_eq_ker_reduceModIdeal
    (M := R × R) idealEight idealTwo idealEight_le_idealTwo] at hf
  exact hf

example : ¬ Function.Injective
    (Module.End.reduceModIdealOfLE (M := R × R)
      idealEight idealTwo idealEight_le_idealTwo) := by
  intro h
  apply double_upperEight_ne_zero
  apply h
  simpa only [map_zero] using nested_double_upper_eq_zero

example : ∃ f g : Module.End R
    ((R × R) ⧸ (idealEight • (⊤ : Submodule R (R × R)))), f * g ≠ g * f := by
  refine ⟨Module.End.reduceModIdeal idealEight first, upperEight, ?_⟩
  intro h
  apply rankTwo_first_class_ne_zero idealEight 1
    (fun ha => one_not_mem_idealTwo (idealEight_le_idealTwo ha))
  have hv := DFunLike.congr_fun h (Submodule.Quotient.mk ((0, 1) : R × R))
  change Module.End.reduceModIdeal idealEight first
      (upperEight (Submodule.Quotient.mk ((0, 1) : R × R))) =
    upperEight (Module.End.reduceModIdeal idealEight first
      (Submodule.Quotient.mk ((0, 1) : R × R))) at hv
  simp only [upperEight, Module.End.reduceModIdeal_apply_mk] at hv
  change (Submodule.Quotient.mk ((1, 0) : R × R) :
      (R × R) ⧸ (idealEight • (⊤ : Submodule R (R × R)))) =
    Submodule.Quotient.mk ((0, 0) : R × R) at hv
  exact hv.trans (idealEight • (⊤ : Submodule R (R × R))).mkQ.map_zero

example : Module.Projective R (R × R) := inferInstance

example : Function.Surjective (Module.End.reduceModIdealOfLE (M := R × R)
    idealEight idealTwo idealEight_le_idealTwo) :=
  Module.End.reduceModIdealOfLE_surjective idealEight idealTwo idealEight_le_idealTwo

example : Module.End.reduceModIdealOfLE (M := R × R) idealEight idealEight le_rfl =
    RingHom.id (Module.End R
      ((R × R) ⧸ (idealEight • (⊤ : Submodule R (R × R))))) :=
  Module.End.reduceModIdealOfLE_refl idealEight

example : (Module.End.reduceModIdealOfLE (M := R × R) idealTwo idealTwo le_rfl).comp
    (Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo) =
      Module.End.reduceModIdealOfLE idealEight idealTwo idealEight_le_idealTwo := by
  exact Module.End.reduceModIdealOfLE_comp
    idealEight idealTwo idealTwo idealEight_le_idealTwo le_rfl

end Module.End.ZModSixteen
