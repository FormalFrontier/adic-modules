example : Module.End.reduceModIdealQuotientEquivOfFG idealThree
    idealThree_fg (Ideal.Quotient.mk _ offDiagonal) = 0 := by
  simp only [Module.End.reduceModIdealQuotientEquivOfFG_apply_mk]
  exact (Module.End.reduceModIdeal_eq_zero_iff_mem_smul_top idealThree offDiagonal).mpr
