public import AdicModules.LinearAlgebra.Quotient.End
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Tactic.Ring

/-!
# Reduction, injectivity and lifting of endomorphisms

For the rank-one integer module, every endomorphism modulo five lifts. The ideal
is nonzero and the quotient is nontrivial. Reduction also lifts endomorphisms at
the zero and top ideals and for the zero free module.

Multiplication by five is nonzero on the integer module but reduces to zero, so
reduction modulo five is not injective there. On `ZMod 5` with its original
integer action, the same ideal annihilates the module and reduction is injective.
The injectivity criterion requires neither finiteness nor projectivity.

Over the integers modulo four, for the proper nonzero ideal generated by two,
multiplication by three is a nonidentity involutory unit whose reduction is the
identity. The model uses quotient equality and elementary arithmetic
independently of the general finite-module unit-reflection theorem.

Over the integers modulo nine, the ideal generated by three satisfies the
Jacobson hypothesis. Multiplication by two is a nonidentity quotient unit,
lifted by multiplication by two with inverse multiplication by five. The
finite-projective automorphism-lifting theorem applies to this model, the zero
ideal, and the zero module with arbitrary ideal.
-/

@[expose] public section

namespace Module.End.ZModFour

/-- The ring of integers modulo four. -/
abbrev R := ZMod 4

/-- The ideal generated by two in the integers modulo four. -/
def idealTwo : Ideal R := Ideal.span ({(2 : R)} : Set R)

theorem two_mem_idealTwo : (2 : R) ∈ idealTwo :=
  Ideal.subset_span (by simp)

theorem idealTwo_ne_bot : idealTwo ≠ ⊥ := by
  intro h
  have hz : (2 : R) = 0 := by simpa [h] using two_mem_idealTwo
  exact (by decide : (2 : R) ≠ 0) hz

theorem idealTwo_le_jacobson : idealTwo ≤ Ideal.jacobson (⊥ : Ideal R) := by
  apply Ideal.span_le.mpr
  intro x hx
  have hx2 : x = (2 : R) := Set.mem_singleton_iff.mp hx
  subst x
  apply Ideal.mem_jacobson_bot.mpr
  intro y
  have hy : ((2 : R) * y + 1) * ((2 : R) * y + 1) = 1 := by
    calc
      _ = (4 : R) * (y * y + y) + 1 := by ring
      _ = 1 := by rw [show (4 : R) = 0 by decide]; simp
  exact ⟨⟨(2 : R) * y + 1, (2 : R) * y + 1, hy, hy⟩, rfl⟩

theorem idealTwo_ne_top : idealTwo ≠ ⊤ := by
  intro h
  have h1 : (1 : R) ∈ Ideal.jacobson (⊥ : Ideal R) :=
    idealTwo_le_jacobson (by simp [h])
  have hu := (Ideal.mem_jacobson_bot.mp h1) (-1)
  have hz : (0 : R) = 1 := by simpa using hu
  exact (by decide : (0 : R) ≠ 1) hz

theorem quotient_nontrivial :
    Nontrivial (R ⧸ (idealTwo • (⊤ : Submodule R R))) := by
  apply Submodule.Quotient.nontrivial_iff.mpr
  intro hp
  have hsub : idealTwo • (⊤ : Submodule R R) ≤ idealTwo := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    simpa only [smul_eq_mul, mul_comm a x] using idealTwo.smul_mem x ha
  apply idealTwo_ne_top
  exact top_unique (by simpa only [hp] using hsub)

/-- Multiplication by three, a nonidentity involutory endomorphism. -/
def triple : Module.End R R where
  toFun x := (3 : R) * x
  map_add' x y := mul_add _ _ _
  map_smul' r x := by
    change (3 : R) * (r * x) = r * ((3 : R) * x)
    ring

@[simp]
theorem triple_apply (x : R) : triple x = (3 : R) * x := rfl

theorem triple_square : triple * triple = 1 := by
  apply LinearMap.ext
  intro x
  change (3 : R) * ((3 : R) * x) = x
  rw [← mul_assoc, show (3 : R) * 3 = 1 by decide, one_mul]

theorem triple_isUnit : IsUnit triple :=
  ⟨⟨triple, triple, triple_square, triple_square⟩, rfl⟩

theorem triple_ne_one : triple ≠ 1 := by
  intro h
  have h1 := congrArg (fun f : Module.End R R => f 1) h
  have hc : (3 : R) = 1 := by simpa using h1
  exact (by decide : (3 : R) ≠ 1) hc

theorem triple_reduces_to_one : Module.End.reduceModIdeal idealTwo triple = 1 := by
  rw [← (Module.End.reduceModIdeal (M := R) idealTwo).map_one]
  apply (Module.End.reduceModIdeal_eq_iff idealTwo triple 1).mpr
  intro x
  change (3 : R) * x - x ∈ idealTwo • (⊤ : Submodule R R)
  have hx : (3 : R) * x - x = (2 : R) • x := by
    simp only [smul_eq_mul]
    ring
  rw [hx]
  exact Submodule.smul_mem_smul two_mem_idealTwo (by trivial)

theorem triple_reduction_isUnit :
    IsUnit (Module.End.reduceModIdeal idealTwo triple) := by
  rw [triple_reduces_to_one]
  exact isUnit_one

example : Module.Finite R R := inferInstance

example : idealTwo ≤ Ideal.jacobson (Module.annihilator R R) :=
  idealTwo_le_jacobson.trans (Ideal.jacobson_mono bot_le)

example : IsUnit triple := by
  let : IsLocalHom (Module.End.reduceModIdeal (M := R) idealTwo) :=
    Module.End.isLocalHom_reduceModIdeal idealTwo
      (idealTwo_le_jacobson.trans (Ideal.jacobson_mono bot_le))
  exact (isUnit_map_iff (Module.End.reduceModIdeal (M := R) idealTwo) triple).mp
    triple_reduction_isUnit

end Module.End.ZModFour

namespace Module.End.IntFive

/-- The ideal generated by five in the integers. -/
def idealFive : Ideal ℤ := Ideal.span ({(5 : ℤ)} : Set ℤ)

theorem five_mem_idealFive : (5 : ℤ) ∈ idealFive :=
  Ideal.subset_span (by simp)

theorem idealFive_ne_bot : idealFive ≠ ⊥ := by
  intro h
  have hz : (5 : ℤ) = 0 := by simpa [h] using five_mem_idealFive
  exact (by decide : (5 : ℤ) ≠ 0) hz

theorem idealFive_ne_top : idealFive ≠ ⊤ := by
  have hker : idealFive ≤ RingHom.ker (Int.castRingHom (ZMod 5)) := by
    apply Ideal.span_le.mpr
    intro x hx
    have hx5 : x = (5 : ℤ) := Set.mem_singleton_iff.mp hx
    subst x
    change (5 : ZMod 5) = 0
    decide
  intro h
  have h1 : (1 : ℤ) ∈ RingHom.ker (Int.castRingHom (ZMod 5)) := hker (by simp [h])
  have hz : (1 : ZMod 5) = 0 := h1
  exact (by decide : (1 : ZMod 5) ≠ 0) hz

theorem quotient_nontrivial :
    Nontrivial (ℤ ⧸ (idealFive • (⊤ : Submodule ℤ ℤ))) := by
  apply Submodule.Quotient.nontrivial_iff.mpr
  intro hp
  have hsub : idealFive • (⊤ : Submodule ℤ ℤ) ≤ idealFive := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    simpa only [smul_eq_mul, mul_comm a x] using idealFive.smul_mem x ha
  apply idealFive_ne_top
  exact top_unique (by simpa only [hp] using hsub)

example : Module.Projective ℤ ℤ := inferInstance

example : Function.Surjective (Module.End.reduceModIdeal (M := ℤ) idealFive) :=
  Module.End.reduceModIdeal_surjective idealFive

example (g : Module.End ℤ (ℤ ⧸ (idealFive • (⊤ : Submodule ℤ ℤ)))) :
    ∃ f : Module.End ℤ ℤ,
      (idealFive • (⊤ : Submodule ℤ ℤ)).mkQ.comp f =
        g.comp (idealFive • (⊤ : Submodule ℤ ℤ)).mkQ := by
  obtain ⟨f, hf⟩ := Module.End.reduceModIdeal_surjective idealFive g
  refine ⟨f, ?_⟩
  rw [← Module.End.reduceModIdeal_comp_mkQ, hf]

example :
    (5 : ℤ) • (1 : Module.End ℤ ℤ) ≠ 0 ∧
      Module.End.reduceModIdeal idealFive ((5 : ℤ) • (1 : Module.End ℤ ℤ)) = 0 ∧
      ¬ Function.Injective (Module.End.reduceModIdeal (M := ℤ) idealFive) ∧
      ¬ idealFive ≤ Module.annihilator ℤ ℤ := by
  have hne : (5 : ℤ) • (1 : Module.End ℤ ℤ) ≠ 0 := by
    intro h
    have hz : (5 : ℤ) = 0 := by simpa using DFunLike.congr_fun h 1
    exact (by decide : (5 : ℤ) ≠ 0) hz
  have hred : Module.End.reduceModIdeal idealFive ((5 : ℤ) • (1 : Module.End ℤ ℤ)) =
      Module.End.reduceModIdeal idealFive 0 := by
    apply (Module.End.reduceModIdeal_eq_iff idealFive _ _).mpr
    intro x
    simpa using
      (Submodule.smul_mem_smul five_mem_idealFive (show x ∈ (⊤ : Submodule ℤ ℤ) by trivial))
  have hni : ¬ Function.Injective (Module.End.reduceModIdeal (M := ℤ) idealFive) :=
    fun hi => hne (hi hred)
  refine ⟨hne, by simpa using hred, hni, ?_⟩
  intro hAnn
  exact hni ((Module.End.reduceModIdeal_injective_iff idealFive).mpr hAnn)

example : idealFive ≤ Module.annihilator ℤ (ZMod 5) ∧
    Function.Injective (Module.End.reduceModIdeal (R := ℤ) (M := ZMod 5) idealFive) := by
  have hI : idealFive ≤ Module.annihilator ℤ (ZMod 5) := by
    apply Ideal.span_le.mpr
    intro a ha
    have ha5 : a = (5 : ℤ) := Set.mem_singleton_iff.mp ha
    subst a
    apply Module.mem_annihilator.mpr
    exact (by decide : ∀ x : ZMod 5, (5 : ℤ) • x = 0)
  have hinj := Module.End.reduceModIdeal_injective_of_le_annihilator idealFive hI
  exact ⟨(Module.End.reduceModIdeal_injective_iff idealFive).mp hinj, hinj⟩

end Module.End.IntFive

universe u v

section InjectivityContracts

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M]

-- These applications ensure the API does not inherit finite/projective hypotheses.
example (I : Ideal R) (hI : I ≤ Module.annihilator R M) :
    Function.Injective (Module.End.reduceModIdeal (R := R) (M := M) I) :=
  Module.End.reduceModIdeal_injective_of_le_annihilator I hI

example : Function.Injective (Module.End.reduceModIdeal (M := M) (⊥ : Ideal R)) :=
  Module.End.reduceModIdeal_injective_bot

end InjectivityContracts

section CommutingScalarInjectivityContract

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M] [SMulCommClass R R M]

example (I : Ideal R) :
    Function.Injective (Module.End.reduceModIdeal (R := R) (M := M) I) ↔
      I ≤ Module.annihilator R M :=
  Module.End.reduceModIdeal_injective_iff I

end CommutingScalarInjectivityContract

section Boundaries

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Projective R M]

example : Function.Surjective (Module.End.reduceModIdeal (M := M) (⊥ : Ideal R)) :=
  Module.End.reduceModIdeal_surjective ⊥

example : Function.Surjective (Module.End.reduceModIdeal (M := M) (⊤ : Ideal R)) :=
  Module.End.reduceModIdeal_surjective ⊤

example (I : Ideal R) :
    Function.Surjective (Module.End.reduceModIdeal (M := Fin 0 → R) I) :=
  Module.End.reduceModIdeal_surjective I

end Boundaries

namespace Module.End.ZModNine

private abbrev R := ZMod 9

private def idealThree : Ideal R := Ideal.span ({(3 : R)} : Set R)

private theorem three_mem_idealThree : (3 : R) ∈ idealThree :=
  Ideal.subset_span (by simp)

private theorem idealThree_le_jacobson : idealThree ≤ Ideal.jacobson (⊥ : Ideal R) := by
  apply Ideal.span_le.mpr
  intro x hx
  have hx3 : x = (3 : R) := Set.mem_singleton_iff.mp hx
  subst x
  apply Ideal.mem_jacobson_bot.mpr
  intro y
  have hy : ((3 : R) * y + 1) * (1 - (3 : R) * y) = 1 := by
    calc
      _ = 1 - (9 : R) * (y * y) := by ring
      _ = 1 := by rw [show (9 : R) = 0 by decide]; simp
  exact ⟨⟨(3 : R) * y + 1, 1 - (3 : R) * y, hy, by rw [mul_comm]; exact hy⟩, rfl⟩

private theorem idealThree_ne_top : idealThree ≠ ⊤ := by
  intro h
  have h1 : (1 : R) ∈ Ideal.jacobson (⊥ : Ideal R) :=
    idealThree_le_jacobson (by simp [h])
  have hu := (Ideal.mem_jacobson_bot.mp h1) (-1)
  have hz : (0 : R) = 1 := by simpa using hu
  exact (by decide : (0 : R) ≠ 1) hz

private theorem idealThree_ne_bot : idealThree ≠ ⊥ := by
  intro h
  have hz : (3 : R) = 0 := by simpa [h] using three_mem_idealThree
  exact (by decide : (3 : R) ≠ 0) hz

private def multiply (a : R) : Module.End R R where
  toFun x := a * x
  map_add' x y := mul_add _ _ _
  map_smul' r x := by
    change a * (r * x) = r * (a * x)
    ring

private def doubleUnit : (Module.End R R)ˣ where
  val := multiply 2
  inv := multiply 5
  val_inv := by
    apply LinearMap.ext
    intro x
    change (2 : R) * ((5 : R) * x) = x
    rw [← mul_assoc, show (2 : R) * 5 = 1 by decide, one_mul]
  inv_val := by
    apply LinearMap.ext
    intro x
    change (5 : R) * ((2 : R) * x) = x
    rw [← mul_assoc, show (5 : R) * 2 = 1 by decide, one_mul]

private def quotientDouble :
    (Module.End R (R ⧸ (idealThree • (⊤ : Submodule R R))))ˣ :=
  Units.map (Module.End.reduceModIdeal idealThree).toMonoidHom doubleUnit

example (x : R) :
    (quotientDouble : Module.End R (R ⧸ (idealThree • (⊤ : Submodule R R))))
        (Submodule.Quotient.mk x) = Submodule.Quotient.mk ((2 : R) * x) :=
  Module.End.reduceModIdeal_apply_mk idealThree (multiply 2) x

private theorem quotientDouble_ne_one : quotientDouble ≠ 1 := by
  intro h
  have hred : Module.End.reduceModIdeal idealThree (multiply 2) = 1 :=
    congrArg Units.val h
  have hm := (Module.End.reduceModIdeal_eq_iff idealThree (multiply 2) 1).mp
    (by simpa using hred) 1
  have hdiff : (multiply 2) 1 - (1 : Module.End R R) 1 = (1 : R) := by decide
  have hmem : (1 : R) ∈ idealThree • (⊤ : Submodule R R) := hdiff ▸ hm
  have hsub : idealThree • (⊤ : Submodule R R) ≤ idealThree := by
    apply Submodule.smul_le.mpr
    intro a ha x _
    simpa only [smul_eq_mul, mul_comm a x] using idealThree.smul_mem x ha
  apply idealThree_ne_top
  apply top_unique
  intro a _
  simpa using idealThree.smul_mem a (hsub hmem)

example : idealThree ≠ ⊥ ∧ idealThree ≠ ⊤ ∧ quotientDouble ≠ 1 :=
  ⟨idealThree_ne_bot, idealThree_ne_top, quotientDouble_ne_one⟩

example : ∃ u : (Module.End R R)ˣ,
    Units.map (Module.End.reduceModIdeal idealThree).toMonoidHom u = quotientDouble :=
  Module.End.unitsMap_reduceModIdeal_surjective idealThree
    (idealThree_le_jacobson.trans (Ideal.jacobson_mono bot_le)) quotientDouble

end Module.End.ZModNine

section AutomorphismBoundaries

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable [Module.Finite R M] [Module.Projective R M]

example : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := M) (⊥ : Ideal R)).toMonoidHom) :=
  Module.End.unitsMap_reduceModIdeal_surjective ⊥ bot_le

example (I : Ideal R) : Function.Surjective
    (Units.map (Module.End.reduceModIdeal (M := Fin 0 → R) I).toMonoidHom) := by
  apply Module.End.unitsMap_reduceModIdeal_surjective I
  have hAnn : Module.annihilator R (Fin 0 → R) = ⊤ := by
    apply top_unique
    intro a _
    exact Module.mem_annihilator.mpr (fun m => Subsingleton.elim _ _)
  simp [hAnn]

end AutomorphismBoundaries
