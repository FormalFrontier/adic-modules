section KernelContracts

variable {R : Type u} [Ring R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable [SMulCommClass R R M] [Module.Projective R M]

example (I : Ideal R) (hI : I.FG) (f : Module.End R M) :
    Module.End.reduceModIdeal I f = 0 ↔
      f ∈ I • (⊤ : Submodule R (Module.End R M)) :=
