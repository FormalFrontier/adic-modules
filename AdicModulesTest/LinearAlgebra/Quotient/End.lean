example : Module.End.reduceModIdealQuotientEquiv idealThree (Ideal.Quotient.mk _ upper)
    (Submodule.Quotient.mk ((0, 1) : R × R)) = Submodule.Quotient.mk ((1, 0) : R × R) := by
