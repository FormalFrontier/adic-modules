module

import AdicModules.LinearAlgebra.Descent
import AdicModules.LinearAlgebra.Span.Basic
import Mathlib.LinearAlgebra.Prod
import Mathlib.Tactic.NormNum
import Lean.Elab.Tactic.Omega

/-!
# Kernel pullbacks of cones

The cone generated by `(2, 0)` in the natural-number module `ℤ × ℤ` has a
proper pullback under `(x, y) ↦ (3 * x, 0) : ℤ × ℤ → ℤ × ℕ`. The image of
this map lies in the first factor, although its ambient target is not a group.
The image/kernel formula computes this pullback directly, without requiring
inverses in the target. Its group-target specialization recovers Mathlib's
formula. The sum map on `ℕ × ℕ` gives a contrasting boundary where source
inverses are unavailable.

## References

The formula `Submodule.comap_map_eq_sup_ker` extends Mathlib's
`Submodule.comap_map_eq` from `Mathlib.LinearAlgebra.Span.Basic`. The named
group-target specialization below has exactly the latter formula's conclusion.
The group-target formula and its formalization are due to the Mathlib
contributors (see the authors credited in that module).
-/

namespace Submodule

universe uR uS uM uP

private def characteristicProp {R : Type uR} {S : Type uS}
    {M : Type uM} {P : Type uP} [Semiring R] [Semiring S]
    [AddCommGroup M] [AddCommMonoid P] [Module R M] [Module S P]
    {σ : R →+* S} [RingHomSurjective σ]
    (f : M →ₛₗ[σ] P) (N : Submodule R M) : Prop :=
  Submodule.comap f (Submodule.map f N) = N ⊔ LinearMap.ker f

section GroupTarget

variable {R : Type uR} {S : Type uS} {M : Type uM} {P : Type uP}
variable [Semiring R] [Semiring S] [AddCommGroup M] [AddCommGroup P]
variable [Module R M] [Module S P] {σ : R →+* S} [RingHomSurjective σ]

private theorem characteristic_of_group (f : M →ₛₗ[σ] P) (N : Submodule R M) :
    Submodule.comap f (Submodule.map f N) = N ⊔ LinearMap.ker f :=
  Submodule.comap_map_eq_sup_ker f N

end GroupTarget

private def tripleFirst : (ℤ × ℤ) →ₗ[ℕ] ℤ :=
  (3 : ℕ) • LinearMap.fst ℕ ℤ ℤ

private def leftInclusion : ℤ →ₗ[ℕ] ℤ × ℕ :=
  LinearMap.inl ℕ ℤ ℕ

private def coneMap : (ℤ × ℤ) →ₗ[ℕ] ℤ × ℕ :=
  leftInclusion.comp tripleFirst

private def evenRay : Submodule ℕ (ℤ × ℤ) :=
  Submodule.span ℕ {((2 : ℤ), (0 : ℤ))}

private theorem coneMap_apply (z : ℤ × ℤ) : coneMap z = (3 * z.1, 0) := by
  simp [coneMap, leftInclusion, tripleFirst, LinearMap.inl_apply, nsmul_eq_mul]

private theorem coneMap_characteristic : characteristicProp coneMap evenRay :=
  Submodule.comap_map_eq_sup_ker coneMap evenRay

private theorem mem_evenRay_iff (z : ℤ × ℤ) :
    z ∈ evenRay ↔ ∃ n : ℕ, ((n : ℤ) * 2, 0) = z := by
  change z ∈ Submodule.span ℕ {((2 : ℤ), (0 : ℤ))} ↔ _
  rw [Submodule.mem_span_singleton]
  change (∃ n : ℕ, (n • (2 : ℤ), n • (0 : ℤ)) = z) ↔ _
  simp only [nsmul_eq_mul, mul_zero]

private theorem coneMap_witnesses :
    (2, 0) ∈ evenRay ∧ (-2, 0) ∉ evenRay ∧
    ((0, 1) : ℤ × ℤ) ≠ 0 ∧ coneMap (0, 1) = 0 ∧
    (2, 1) ∈ Submodule.comap coneMap (Submodule.map coneMap evenRay) ∧
    (2, 1) ∉ evenRay ∧
    (1, 0) ∉ Submodule.comap coneMap (Submodule.map coneMap evenRay) ∧
    ¬ ∃ q : ℤ × ℕ, (0, 1) + q = 0 := by
  have hgen : (2, 0) ∈ evenRay := (mem_evenRay_iff _).2 ⟨1, by norm_num⟩
  have hnegative : (-2, 0) ∉ evenRay := by
    intro hx
    obtain ⟨n, hn⟩ := (mem_evenRay_iff _).1 hx
    have he := congrArg Prod.fst hn
    change (n : ℤ) * 2 = -2 at he
    omega
  have hnonzero : ((0, 1) : ℤ × ℤ) ≠ 0 := by
    intro h
    have he := congrArg Prod.snd h
    norm_num at he
  have hkilled : coneMap (0, 1) = 0 := by norm_num [coneMap_apply]
  have hshift : (2, 1) ∈ Submodule.comap coneMap (Submodule.map coneMap evenRay) := by
    exact Submodule.mem_map.mpr ⟨(2, 0), hgen, by norm_num [coneMap_apply]⟩
  have hshiftnot : (2, 1) ∉ evenRay := by
    intro hx
    obtain ⟨n, hn⟩ := (mem_evenRay_iff _).1 hx
    have he := congrArg Prod.snd hn
    norm_num at he
  have hunitout : (1, 0) ∉ Submodule.comap coneMap (Submodule.map coneMap evenRay) := by
    intro hx
    obtain ⟨z, hz, he⟩ := Submodule.mem_map.mp hx
    obtain ⟨n, hn⟩ := (mem_evenRay_iff _).1 hz
    have hz' := congrArg Prod.fst hn
    change (n : ℤ) * 2 = z.1 at hz'
    have he' : 3 * z.1 = 3 := by
      simpa only [coneMap_apply, mul_one] using congrArg Prod.fst he
    omega
  have hnoinverse : ¬ ∃ q : ℤ × ℕ, (0, 1) + q = 0 := by
    rintro ⟨q, hq⟩
    have he := congrArg Prod.snd hq
    change 1 + q.2 = 0 at he
    omega
  exact ⟨hgen, hnegative, hnonzero, hkilled, hshift, hshiftnot, hunitout, hnoinverse⟩

private theorem kernel_point_mem_pullback :
    (0, 1) ∈ Submodule.comap coneMap (Submodule.map coneMap evenRay) := by
  have hker : (0, 1) ∈ LinearMap.ker coneMap := coneMap_witnesses.2.2.2.1
  have heq : Submodule.comap coneMap (Submodule.map coneMap evenRay) =
      evenRay ⊔ LinearMap.ker coneMap := coneMap_characteristic
  rw [heq]
  exact Submodule.mem_sup.mpr ⟨0, evenRay.zero_mem, (0, 1), hker, by simp⟩

private def sumMap : (ℕ × ℕ) →ₗ[ℕ] ℕ :=
  LinearMap.fst ℕ ℕ ℕ + LinearMap.snd ℕ ℕ ℕ

private def firstAxis : Submodule ℕ (ℕ × ℕ) :=
  Submodule.span ℕ {((1 : ℕ), (0 : ℕ))}

private theorem sumMap_boundary :
    LinearMap.ker sumMap = ⊥ ∧ Submodule.map sumMap firstAxis = ⊤ ∧
    (0, 1) ∈ Submodule.comap sumMap (Submodule.map sumMap firstAxis) ∧
    (0, 1) ∉ firstAxis ⊔ LinearMap.ker sumMap ∧
    Submodule.comap sumMap (Submodule.map sumMap firstAxis) ≠
      firstAxis ⊔ LinearMap.ker sumMap := by
  have hker : LinearMap.ker sumMap = ⊥ := by
    apply le_antisymm ?_ bot_le
    intro x hx
    have hz : x.1 + x.2 = 0 := by simpa [LinearMap.mem_ker, sumMap] using hx
    obtain ⟨h1, h2⟩ := Nat.add_eq_zero_iff.mp hz
    change x = 0
    exact Prod.ext h1 h2
  have haxis (n : ℕ) : (n, 0) ∈ firstAxis := by
    exact Submodule.mem_span_singleton.mpr ⟨n, by simp⟩
  have hmap : Submodule.map sumMap firstAxis = ⊤ := by
    apply top_unique
    intro n _
    exact Submodule.mem_map.mpr ⟨(n, 0), haxis n, by simp [sumMap]⟩
  have hp : (0, 1) ∈ Submodule.comap sumMap (Submodule.map sumMap firstAxis) := by
    rw [hmap]
    exact Submodule.mem_top
  have hnot : (0, 1) ∉ firstAxis := by
    intro hx
    obtain ⟨n, hn⟩ := Submodule.mem_span_singleton.mp hx
    have he := congrArg Prod.snd hn
    norm_num at he
  have hn : (0, 1) ∉ firstAxis ⊔ LinearMap.ker sumMap := by simpa [hker] using hnot
  refine ⟨hker, hmap, hp, hn, ?_⟩
  intro heq
  rw [heq] at hp
  exact hn hp

/-- Descending the nonzero cone map through its proper range recovers the
range inclusion, with the expected unique factorization. -/
private theorem coneMap_range_factorization :
    coneMap.rangeRestrict.liftOfSurjective (τ := RingHom.id ℕ)
        coneMap.surjective_rangeRestrict coneMap coneMap.ker_rangeRestrict.le =
      coneMap.range.subtype ∧
    (∃! h : coneMap.range →ₗ[ℕ] ℤ × ℕ,
      h.comp coneMap.rangeRestrict = coneMap) ∧
    coneMap (1, 0) ≠ 0 ∧ ((0, 1) : ℤ × ℕ) ∉ coneMap.range := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact ((coneMap.rangeRestrict.eq_liftOfSurjective_iff
      (τ := RingHom.id ℕ) coneMap.surjective_rangeRestrict coneMap
      coneMap.ker_rangeRestrict.le coneMap.range.subtype).2
        coneMap.subtype_comp_rangeRestrict).symm
  · exact (coneMap.rangeRestrict.ker_le_ker_iff_existsUnique_comp_eq
      (τ := RingHom.id ℕ) coneMap.surjective_rangeRestrict coneMap).1
        coneMap.ker_rangeRestrict.le
  · intro h
    have hfst := congrArg Prod.fst h
    norm_num [coneMap_apply] at hfst
  · intro h
    obtain ⟨z, hz⟩ := LinearMap.mem_range.mp h
    have hsnd := congrArg Prod.snd hz
    norm_num [coneMap_apply] at hsnd

end Submodule
