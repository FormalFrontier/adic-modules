module

import AdicModules.Topology.Algebra.PrincipalUnits
import AdicModules.Polynomial.Hensel
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

/-!
# Principal units over Henselian rings

In the 3-adic integers, reduction modulo the maximal ideal sends the exponent 2
to a unit. The principal unit 4 is not one and has the principal square root
`-2`.

In `ZMod 9`, the ideal generated by 3 has square zero. Completeness for this
ideal supplies Henselianity, but the exponent 3 is not a unit in the quotient.
The principal unit 4 is not one and its cube is one, so cubing on the reduction
kernel is not injective.

The zero ideal in the integers has a trivial reduction kernel. In the zero ring
`ZMod 1`, the exponent zero is a unit in the quotient, and zeroth powering on
the reduction kernel is bijective. All kernels below are those of the units
maps induced by the ideal quotient maps.

## References

* Mathlib's Henselian rings, algebraic adic completeness, p-adic integers,
  modular integers and units.
-/

set_option linter.privateModule false

namespace PadicInt

local notation "J" => IsLocalRing.maximalIdeal ℤ_[3]
local notation "K" => MonoidHom.ker (Units.map (RingHom.toMonoidHom (Ideal.Quotient.mk J)))

private theorem three_principal_square :
    IsAdicComplete J ℤ_[3] ∧
      HenselianRing ℤ_[3] J ∧
      IsUnit (2 : ℤ_[3] ⧸ J) ∧
      ∃ u v : K,
        ((u : ℤ_[3]ˣ) : ℤ_[3]) = 4 ∧
        ((v : ℤ_[3]ˣ) : ℤ_[3]) = -2 ∧
        u ≠ 1 ∧ v ^ (2 : ℕ) = u := by
  have htwo : IsUnit (2 : ℤ_[3]) := by
    apply PadicInt.isUnit_iff.mpr
    simpa only [Nat.cast_ofNat] using
      (PadicInt.norm_natCast_eq_one_iff (p := 3) (n := 2)).mpr (by decide)
  have hfour : IsUnit (4 : ℤ_[3]) := by
    apply PadicInt.isUnit_iff.mpr
    simpa only [Nat.cast_ofNat] using
      (PadicInt.norm_natCast_eq_one_iff (p := 3) (n := 4)).mpr (by decide)
  have hminus : IsUnit (-2 : ℤ_[3]) := htwo.neg
  have hthree : (3 : ℤ_[3]) ∈ J := by
    rw [PadicInt.maximalIdeal_eq_span_p]
    exact Ideal.mem_span_singleton_self _
  let u : K := ⟨hfour.unit, by
    apply (Ideal.mem_ker_unitsMap_quotient_iff J _).mpr
    rw [hfour.unit_spec, show (4 : ℤ_[3]) - 1 = 3 by norm_num]
    exact hthree⟩
  let v : K := ⟨hminus.unit, by
    apply (Ideal.mem_ker_unitsMap_quotient_iff J _).mpr
    rw [hminus.unit_spec, show (-2 : ℤ_[3]) - 1 = -(3 : ℤ_[3]) by norm_num]
    exact (Ideal.neg_mem_iff J).2 hthree⟩
  have hu : ((u : ℤ_[3]ˣ) : ℤ_[3]) = 4 := hfour.unit_spec
  have hv : ((v : ℤ_[3]ˣ) : ℤ_[3]) = -2 := hminus.unit_spec
  have hsq : v ^ (2 : ℕ) = u := by
    apply Subtype.ext
    apply Units.ext
    change ((v : ℤ_[3]ˣ) : ℤ_[3]) ^ (2 : ℕ) = ((u : ℤ_[3]ˣ) : ℤ_[3])
    rw [hu, hv]
    norm_num
  have hne : u ≠ 1 := by
    have hvne : v ≠ 1 := by
      intro h
      have hval := congrArg (fun w : K => ((w : ℤ_[3]ˣ) : ℤ_[3])) h
      have hcast : ((-2 : ℤ) : ℤ_[3]) = ((1 : ℤ) : ℤ_[3]) := by
        simpa [hv] using hval
      exact (by decide : (-2 : ℤ) ≠ 1) ((PadicInt.intCast_eq _ _).mp hcast)
    have htwoq : IsUnit (2 : ℤ_[3] ⧸ J) := by
      simpa only [map_ofNat] using htwo.map (Ideal.Quotient.mk J)
    intro huone
    apply hvne
    apply (HenselianRing.bijective_pow_principal_units J 2 htwoq).1
    simp only [hsq, huone, one_pow]
  refine ⟨inferInstance, IsAdicComplete.henselianRing _ _, ?_, u, v, hu, hv, hne, hsq⟩
  simpa only [map_ofNat] using htwo.map (Ideal.Quotient.mk J)

end PadicInt

namespace ZMod

section Nine

local notation "J" => (Ideal.span {(3 : ZMod 9)} : Ideal (ZMod 9))
local notation "K" => MonoidHom.ker (Units.map (RingHom.toMonoidHom (Ideal.Quotient.mk J)))

private theorem nine_principal_cube :
    J ^ (2 : ℕ) = ⊥ ∧
      IsAdicComplete J (ZMod 9) ∧
      HenselianRing (ZMod 9) J ∧
      ¬ IsUnit (3 : (ZMod 9) ⧸ J) ∧
      (∃ u : K,
        ((u : (ZMod 9)ˣ) : ZMod 9) = 4 ∧ u ≠ 1 ∧ u ^ (3 : ℕ) = 1) ∧
      ¬ Function.Injective (fun u : K => u ^ (3 : ℕ)) := by
  have hsq : J ^ (2 : ℕ) = ⊥ := by
    rw [Ideal.span_singleton_pow,
      show (3 : ZMod 9) ^ (2 : ℕ) = 0 by decide, Ideal.span_singleton_zero]
  have hhaus : IsHausdorff J (ZMod 9) := IsHausdorff.mk (by
    intro x hx
    have hx2 := hx 2
    simpa only [Ideal.smul_eq_mul, Ideal.mul_top, hsq, SModEq.bot] using hx2)
  have hprec : IsPrecomplete J (ZMod 9) := IsPrecomplete.mk (by
    intro f hf
    refine ⟨f 2, ?_⟩
    intro n
    have htwo : f 2 = f (max n 2) := by
      have h := hf (m := 2) (n := max n 2) (le_max_right n 2)
      simpa only [Ideal.smul_eq_mul, Ideal.mul_top, hsq, SModEq.bot] using h
    have hn := hf (m := n) (n := max n 2) (le_max_left n 2)
    simpa only [← htwo] using hn)
  have hcomplete : IsAdicComplete J (ZMod 9) :=
    { toIsHausdorff := hhaus, toIsPrecomplete := hprec }
  have : IsAdicComplete J (ZMod 9) := hcomplete
  have hhens : HenselianRing (ZMod 9) J := IsAdicComplete.henselianRing _ _
  have hthree : ¬ IsUnit (3 : ZMod 9) := by
    intro h
    apply (by decide : ¬ Nat.Coprime 3 9)
    exact (ZMod.isUnit_iff_coprime 3 9).mp (by simpa only [Nat.cast_ofNat] using h)
  have hproper : J ≠ ⊤ := Ideal.span_singleton_ne_top hthree
  have hqthree : (3 : (ZMod 9) ⧸ J) = 0 := by
    calc
      (3 : (ZMod 9) ⧸ J) = Ideal.Quotient.mk J ((3 : ℕ) : ZMod 9) :=
        (map_natCast (Ideal.Quotient.mk J) 3).symm
      _ = 0 := Ideal.Quotient.mk_singleton_self (3 : ZMod 9)
  have hnunit : ¬ IsUnit (3 : (ZMod 9) ⧸ J) := by
    rw [hqthree, isUnit_zero_iff]
    exact Ideal.Quotient.zero_ne_one_iff.mpr hproper
  let u : K := ⟨ZMod.unitOfCoprime 4 (by decide : Nat.Coprime 4 9), by
    apply (Ideal.mem_ker_unitsMap_quotient_iff J _).mpr
    rw [ZMod.coe_unitOfCoprime, Nat.cast_ofNat, show (4 : ZMod 9) - 1 = 3 by decide]
    exact Ideal.mem_span_singleton_self _⟩
  have hu : ((u : (ZMod 9)ˣ) : ZMod 9) = 4 :=
    ZMod.coe_unitOfCoprime 4 (by decide : Nat.Coprime 4 9)
  have hne : u ≠ 1 := by
    intro h
    have hval := congrArg (fun w : K => ((w : (ZMod 9)ˣ) : ZMod 9)) h
    have h41 : (4 : ZMod 9) = 1 := by simpa only [hu, OneMemClass.coe_one,
      Units.val_one] using hval
    exact (by decide : (4 : ZMod 9) ≠ 1) h41
  have hcube : u ^ (3 : ℕ) = 1 := by
    apply Subtype.ext
    apply Units.ext
    change ((u : (ZMod 9)ˣ) : ZMod 9) ^ (3 : ℕ) = 1
    rw [hu]
    decide
  refine ⟨hsq, hcomplete, hhens, hnunit, ⟨u, hu, hne, hcube⟩, ?_⟩
  intro hinj
  exact hne (hinj (hcube.trans (one_pow 3).symm))

end Nine

end ZMod

namespace Ideal

local notation "K" =>
  MonoidHom.ker (Units.map (RingHom.toMonoidHom (Ideal.Quotient.mk (⊥ : Ideal ℤ))))

private theorem int_bot_principal_units :
    Nontrivial ℤ ∧
      IsAdicComplete (⊥ : Ideal ℤ) ℤ ∧
      HenselianRing ℤ (⊥ : Ideal ℤ) ∧
      (∀ u : K, u = 1) ∧
      ∀ n : ℕ, Function.Bijective (fun u : K => u ^ n) := by
  have htrivial : ∀ u : K, u = 1 := by
    intro u
    apply Subtype.ext
    apply Units.ext
    have hmem := (Ideal.mem_ker_unitsMap_quotient_iff (⊥ : Ideal ℤ) (u : ℤˣ)).mp
      u.property
    exact sub_eq_zero.mp (Ideal.mem_bot.mp hmem)
  refine ⟨inferInstance, inferInstance, IsAdicComplete.henselianRing _ _, htrivial, ?_⟩
  intro n
  constructor
  · intro u v _
    exact (htrivial u).trans (htrivial v).symm
  · intro u
    refine ⟨1, ?_⟩
    simpa only [one_pow] using (htrivial u).symm

end Ideal

namespace ZMod

section One

local notation "J" => (⊥ : Ideal (ZMod 1))
local notation "K" => MonoidHom.ker (Units.map (RingHom.toMonoidHom (Ideal.Quotient.mk J)))

private theorem one_principal_zeroth_power :
    IsAdicComplete J (ZMod 1) ∧
      HenselianRing (ZMod 1) J ∧
      IsUnit (0 : (ZMod 1) ⧸ J) ∧
      Function.Bijective (fun u : K => u ^ (0 : ℕ)) := by
  refine ⟨inferInstance, IsAdicComplete.henselianRing _ _,
    isUnit_of_subsingleton _, ?_⟩
  constructor
  · intro u v _
    exact Subsingleton.elim _ _
  · intro u
    exact ⟨1, Subsingleton.elim _ _⟩

end One

end ZMod
