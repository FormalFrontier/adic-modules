/-!
# Boundary examples for ideal-power neighborhood bases

In the discrete integer topology, the ideal generated by `3` is proper and
not dense, although its sum with the ideal generated by `2` is top. The powers
of `(2)` do not form a neighborhood basis for that discrete topology. In the
canonical `(2)`-adic topology on the original integers, `(2)` itself is proper,
closed, not dense, and not comaximal with the ideal defining the topology.

The zeroth power imposes no comaximality condition, whereas the first power
already does. The top ideal gives the indiscrete topology and every ideal is
dense there, because every ideal contains zero. The bottom ideal gives the
discrete topology, where an ideal is dense exactly when it is top. Without any
separation assumption, the bottom ideal is dense for an ideal-power basis
exactly when the defining ideal is top. The one-element ring supplies the
subsingleton boundary, with all ideals and their powers equal to top and bottom.

## Implementation notes

All powers are formed in the original ring. The integer model and the
commutative extreme-ideal models use Mathlib's `Ideal.adicTopology` and its
characteristic neighborhood basis. The bottom-density computation uses the
submodule closure formula after canonical restriction to integer scalars;
fixed-integer continuity comes from the topological additive group, not a
hypothesis about the full ring action. The indiscrete integer model is not T1,
and its empty set is not dense.

## References

* Mathlib's principal ideal, comaximality, ideal-power and adic topology APIs.
* Mathlib's discrete and indiscrete topology, open additive subgroup and
  one-element ring APIs.
* `Submodule.topologicalClosure_eq_iInf_sup` for closure from a submodule
  neighborhood basis.
-/

open Filter Topology

namespace Ideal

section Powers

variable {R : Type*} [Semiring R]

private theorem sup_pow_zero_eq_top (J I : Ideal R) : J ⊔ I ^ 0 = ⊤ := by
  simp only [Submodule.pow_zero, Ideal.one_eq_top, sup_top_eq]

private theorem sup_pow_one_eq_top_iff (J I : Ideal R) :
    J ⊔ I ^ 1 = ⊤ ↔ J ⊔ I = ⊤ := by
  rw [Submodule.pow_one]

end Powers

private theorem span_three_ne_top : Ideal.span {(3 : ℤ)} ≠ (⊤ : Ideal ℤ) := by
  apply (Ideal.ne_top_iff_one _).2
  rw [Ideal.mem_span_singleton]
  norm_num

private theorem one_notMem_span_two : (1 : ℤ) ∉ Ideal.span {(2 : ℤ)} := by
  rw [Ideal.mem_span_singleton]
  norm_num

private theorem span_two_ne_top : Ideal.span {(2 : ℤ)} ≠ (⊤ : Ideal ℤ) :=
  (Ideal.ne_top_iff_one _).2 one_notMem_span_two

private theorem span_two_sup_pow_zero_eq_top_and_sup_pow_one_ne_top :
    Ideal.span {(2 : ℤ)} ⊔ (Ideal.span {(2 : ℤ)}) ^ 0 = ⊤ ∧
      Ideal.span {(2 : ℤ)} ⊔ (Ideal.span {(2 : ℤ)}) ^ 1 ≠ ⊤ := by
  constructor
  · exact sup_pow_zero_eq_top _ _
  · simpa only [Submodule.pow_one, sup_idem] using span_two_ne_top

section DiscreteIntegers

local instance : TopologicalSpace ℤ := ⊥
local instance : DiscreteTopology ℤ := discreteTopology_bot _
local instance : IsTopologicalAddGroup ℤ := inferInstance

private theorem span_three_ne_top_and_not_dense_discrete :
    Ideal.span {(3 : ℤ)} ≠ (⊤ : Ideal ℤ) ∧
      ¬ Dense (Ideal.span {(3 : ℤ)} : Set ℤ) := by
  refine ⟨span_three_ne_top, ?_⟩
  intro hdense
  exact span_three_ne_top (Submodule.coe_eq_univ.mp (dense_discrete.mp hdense))

private theorem span_three_sup_span_two_eq_top_discrete :
    Ideal.span {(3 : ℤ)} ⊔ Ideal.span {(2 : ℤ)} = ⊤ :=
  (Ideal.sup_eq_top_iff_isCoprime (3 : ℤ) 2).2 ⟨1, -1, by norm_num⟩

private theorem span_two_pow_not_basis_discrete :
    ¬ (𝓝 (0 : ℤ)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((Ideal.span {(2 : ℤ)}) ^ n : Ideal ℤ) : Set ℤ)) := by
  intro hI
  have hzero : ({0} : Set ℤ) ∈ 𝓝 (0 : ℤ) := by
    rw [mem_nhds_discrete]
    exact Set.mem_singleton _
  obtain ⟨n, _hn, hsubset⟩ := hI.mem_iff.mp hzero
  have hpow : (2 : ℤ) ^ n ∈ (Ideal.span {(2 : ℤ)}) ^ n :=
    Ideal.pow_mem_pow (Ideal.mem_span_singleton_self (2 : ℤ)) n
  have hpowzero : (2 : ℤ) ^ n = 0 := Set.mem_singleton_iff.mp (hsubset hpow)
  exact (pow_ne_zero n (by norm_num : (2 : ℤ) ≠ 0)) hpowzero

end DiscreteIntegers

section AdicIntegers

local instance : TopologicalSpace ℤ := (Ideal.span {(2 : ℤ)}).adicTopology
local instance : IsTopologicalAddGroup ℤ :=
  (Ideal.span {(2 : ℤ)}).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup

private theorem span_two_pow_basis_two_adic :
    (𝓝 (0 : ℤ)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((Ideal.span {(2 : ℤ)}) ^ n : Ideal ℤ) : Set ℤ)) :=
  (Ideal.span {(2 : ℤ)}).hasBasis_nhds_zero_adic

private theorem span_two_isClosed_two_adic :
    IsClosed (Ideal.span {(2 : ℤ)} : Set ℤ) := by
  have hmem : (Ideal.span {(2 : ℤ)} : Set ℤ) ∈ 𝓝 (0 : ℤ) := by
    simpa only [Submodule.pow_one] using
      span_two_pow_basis_two_adic.mem_of_mem (i := 1) trivial
  have hopen : IsOpen ((Ideal.span {(2 : ℤ)}).toAddSubgroup : Set ℤ) :=
    (Ideal.span {(2 : ℤ)}).toAddSubgroup.isOpen_of_mem_nhds hmem
  simpa only [Submodule.coe_toAddSubgroup] using
    (Ideal.span {(2 : ℤ)}).toAddSubgroup.isClosed_of_isOpen hopen

private theorem span_two_ne_top_not_dense_and_not_comaximal_two_adic :
    Ideal.span {(2 : ℤ)} ≠ (⊤ : Ideal ℤ) ∧
      ¬ Dense (Ideal.span {(2 : ℤ)} : Set ℤ) ∧
      Ideal.span {(2 : ℤ)} ⊔ Ideal.span {(2 : ℤ)} ≠ ⊤ := by
  refine ⟨span_two_ne_top, ?_, ?_⟩
  · intro hdense
    have hone := hdense (1 : ℤ)
    rw [span_two_isClosed_two_adic.closure_eq] at hone
    exact one_notMem_span_two hone
  · simpa only [sup_idem] using span_two_ne_top

end AdicIntegers

section IndiscreteRing

variable {R : Type*} [Ring R]

local instance : TopologicalSpace R := ⊤
local instance : IsTopologicalAddGroup R := inferInstance

private theorem top_pow_basis_indiscrete :
    (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊤ : Ideal R) ^ n : Ideal R) : Set R)) := by
  refine ⟨fun U ↦ ?_⟩
  simp [nhds_top, Ideal.top_pow]

private theorem dense_ideal_indiscrete (J : Ideal R) : Dense (J : Set R) :=
  dense_indiscrete ⟨0, J.zero_mem⟩

end IndiscreteRing

section IndiscreteIntegers

local instance : TopologicalSpace ℤ := ⊤
local instance : IsTopologicalAddGroup ℤ := inferInstance

private theorem not_t1Space_indiscrete_integers : ¬ T1Space ℤ := by
  intro h
  let : T1Space ℤ := h
  have h01 : (0 : ℤ) = 1 := (Inseparable.all (0 : ℤ) 1).eq
  norm_num at h01

private theorem empty_not_dense_indiscrete_integers : ¬ Dense (∅ : Set ℤ) := by
  intro hdense
  have hzero := hdense (0 : ℤ)
  simp only [closure_empty, Set.mem_empty_iff_false] at hzero

private theorem span_three_ne_top_and_dense_indiscrete :
    Ideal.span {(3 : ℤ)} ≠ (⊤ : Ideal ℤ) ∧
      Dense (Ideal.span {(3 : ℤ)} : Set ℤ) :=
  ⟨span_three_ne_top, dense_ideal_indiscrete _⟩

end IndiscreteIntegers

section DiscreteRing

variable {R : Type*} [Ring R]

local instance : TopologicalSpace R := ⊥
local instance : DiscreteTopology R := discreteTopology_bot _
local instance : IsTopologicalAddGroup R := inferInstance

private theorem bot_pow_basis_discrete :
    (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊥ : Ideal R) ^ n : Ideal R) : Set R)) := by
  refine ⟨fun U ↦ ?_⟩
  rw [mem_nhds_discrete]
  constructor
  · intro hU
    refine ⟨1, trivial, ?_⟩
    simpa only [Submodule.pow_one, Submodule.bot_coe, Set.singleton_subset_iff] using hU
  · rintro ⟨n, _hn, hsubset⟩
    exact hsubset (((⊥ : Ideal R) ^ n).zero_mem)

private theorem dense_ideal_iff_eq_top_discrete (J : Ideal R) :
    Dense (J : Set R) ↔ J = ⊤ := by
  simpa only [Submodule.coe_eq_univ] using
    (dense_discrete : Dense (J : Set R) ↔ (J : Set R) = Set.univ)

end DiscreteRing

section ExtremeBases

variable {R : Type*} [Ring R] [TopologicalSpace R] [IsTopologicalAddGroup R]

private theorem indiscrete_of_top_pow_basis
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊤ : Ideal R) ^ n : Ideal R) : Set R))) : IndiscreteTopology R := by
  refine ⟨IsTopologicalAddGroup.ext (inferInstance : IsTopologicalAddGroup R)
    (show @IsTopologicalAddGroup R ⊤ _ from inferInstance) ?_⟩
  rw [nhds_top]
  ext U
  rw [hI.mem_iff]
  simp [Ideal.top_pow]

private theorem dense_ideal_of_top_pow_basis
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊤ : Ideal R) ^ n : Ideal R) : Set R))) (J : Ideal R) :
    Dense (J : Set R) := by
  let : IndiscreteTopology R := indiscrete_of_top_pow_basis hI
  exact dense_indiscrete ⟨0, J.zero_mem⟩

private theorem discrete_of_bot_pow_basis
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊥ : Ideal R) ^ n : Ideal R) : Set R))) : DiscreteTopology R := by
  have hzero : ({0} : Set R) ∈ 𝓝 (0 : R) := by
    simpa only [Submodule.pow_one, Submodule.bot_coe] using
      hI.mem_of_mem (i := 1) trivial
  have hopen : IsOpen (((⊥ : Ideal R).toAddSubgroup) : Set R) :=
    (⊥ : Ideal R).toAddSubgroup.isOpen_of_mem_nhds hzero
  apply discreteTopology_of_isOpen_singleton_zero
  simpa only [Submodule.coe_toAddSubgroup, Submodule.bot_coe] using hopen

private theorem dense_ideal_iff_eq_top_of_bot_pow_basis
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ (((⊥ : Ideal R) ^ n : Ideal R) : Set R))) (J : Ideal R) :
    Dense (J : Set R) ↔ J = ⊤ := by
  let : DiscreteTopology R := discrete_of_bot_pow_basis hI
  simpa only [Submodule.coe_eq_univ] using
    (dense_discrete : Dense (J : Set R) ↔ (J : Set R) = Set.univ)

private theorem dense_bot_iff_eq_top_of_pow_basis {I : Ideal R}
    (hI : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((I ^ n : Ideal R) : Set R))) :
    Dense ((⊥ : Ideal R) : Set R) ↔ I = ⊤ := by
  let : ContinuousConstSMul ℤ R := AddGroup.continuousConstSMul_int (A := R)
  have hℤ : (𝓝 (0 : R)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((I ^ n).restrictScalars ℤ : Set R)) := by
    simpa only [Submodule.coe_restrictScalars] using hI
  have hclosure := Submodule.topologicalClosure_eq_iInf_sup
    ((⊥ : Ideal R).restrictScalars ℤ)
    (U := fun n : ℕ ↦ (I ^ n).restrictScalars ℤ) hℤ
  constructor
  · intro hdense
    have htop : ((⊥ : Ideal R).restrictScalars ℤ).topologicalClosure = ⊤ := by
      apply Submodule.dense_iff_topologicalClosure_eq_top.mp
      simpa only [Submodule.coe_restrictScalars] using hdense
    have hle : ((⊥ : Ideal R).restrictScalars ℤ).topologicalClosure ≤
        I.restrictScalars ℤ := by
      rw [hclosure]
      exact iInf_le_of_le 1 (iInf_le_of_le trivial (by
        simp only [Submodule.restrictScalars_bot, bot_sup_eq, Submodule.pow_one]
        exact le_rfl))
    apply (Ideal.eq_top_iff_one I).2
    have hone : (1 : R) ∈ ((⊥ : Ideal R).restrictScalars ℤ).topologicalClosure := by
      rw [htop]
      exact Submodule.mem_top
    exact hle hone
  · intro htop
    subst I
    exact dense_ideal_of_top_pow_basis hI _

end ExtremeBases

section TopIdeal

variable {R : Type*} [Semiring R] [TopologicalSpace R]

private theorem dense_top_ideal : Dense ((⊤ : Ideal R) : Set R) := by
  simpa only [Submodule.top_coe] using (dense_univ : Dense (Set.univ : Set R))

omit [TopologicalSpace R] in
private theorem top_sup_pow_eq_top (I : Ideal R) (n : ℕ) :
    (⊤ : Ideal R) ⊔ I ^ n = ⊤ := by
  simp only [top_sup_eq]

end TopIdeal

section AdicExtremeIdeals

variable {R : Type*} [CommRing R]

private theorem top_adicTopology_eq_top : (⊤ : Ideal R).adicTopology = ⊤ := by
  let : TopologicalSpace R := (⊤ : Ideal R).adicTopology
  let : IsTopologicalAddGroup R :=
    (⊤ : Ideal R).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup
  let : IndiscreteTopology R :=
    indiscrete_of_top_pow_basis (⊤ : Ideal R).hasBasis_nhds_zero_adic
  exact IndiscreteTopology.eq_top R

private theorem bot_adicTopology_eq_bot : (⊥ : Ideal R).adicTopology = ⊥ := by
  let : TopologicalSpace R := (⊥ : Ideal R).adicTopology
  let : IsTopologicalAddGroup R :=
    (⊥ : Ideal R).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup
  let : DiscreteTopology R :=
    discrete_of_bot_pow_basis (⊥ : Ideal R).hasBasis_nhds_zero_adic
  exact DiscreteTopology.eq_bot

end AdicExtremeIdeals

section SubsingletonSemiring

variable {R : Type*} [Semiring R] [Subsingleton R]

private theorem ideal_eq_bot_and_top_subsingleton (I : Ideal R) : I = ⊥ ∧ I = ⊤ :=
  ⟨Subsingleton.elim _ _, Subsingleton.elim _ _⟩

private theorem ideal_pow_eq_bot_and_top_subsingleton (I : Ideal R) (n : ℕ) :
    I ^ n = ⊥ ∧ I ^ n = ⊤ :=
  ideal_eq_bot_and_top_subsingleton (I ^ n)

end SubsingletonSemiring

section OneElementRing

local instance : TopologicalSpace PUnit := (Ideal.span {(0 : PUnit)}).adicTopology
local instance : IsTopologicalAddGroup PUnit :=
  (Ideal.span {(0 : PUnit)}).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup

private theorem all_ideal_pow_bases_punit (I : Ideal PUnit) :
    (𝓝 (0 : PUnit)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((I ^ n : Ideal PUnit) : Set PUnit)) := by
  have hI : I = Ideal.span {(0 : PUnit)} := Subsingleton.elim _ _
  rw [hI]
  exact (Ideal.span {(0 : PUnit)}).hasBasis_nhds_zero_adic

private theorem all_ideals_dense_punit (J : Ideal PUnit) : Dense (J : Set PUnit) :=
  dense_indiscrete ⟨0, J.zero_mem⟩

private theorem all_ideal_powers_and_sums_punit (I J : Ideal PUnit) (n : ℕ) :
    I = ⊥ ∧ I = ⊤ ∧ I ^ n = ⊥ ∧ I ^ n = ⊤ ∧ J ⊔ I ^ n = ⊤ := by
  obtain ⟨hbot, htop⟩ := ideal_eq_bot_and_top_subsingleton I
  obtain ⟨hpowbot, hpowtop⟩ := ideal_pow_eq_bot_and_top_subsingleton I n
  exact ⟨hbot, htop, hpowbot, hpowtop, by rw [hpowtop, sup_top_eq]⟩

end OneElementRing

end Ideal
