module

import AdicModules.Topology.Algebra.Ideal
import AdicModules.Topology.Algebra.Submodule
import Mathlib.Algebra.Module.NatInt
import Mathlib.Algebra.Module.Submodule.RestrictScalars
import Mathlib.Data.Int.ModEq
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Topology.Algebra.Group.ZPow
import Mathlib.Topology.Algebra.Nonarchimedean.AdicTopology
import Mathlib.Tactic.NormNum

/-!
# The ideal generated by three in the two-adic integer topology

The whole ideal generated by `3` is nonzero and proper in `ℤ`, yet dense for
`(Ideal.span {(2 : ℤ)}).adicTopology`. Its sum with every power of the ideal
generated by `2` is top, and it represents every residue modulo `2 ^ n`.
The topology here is on the integers themselves, not on a completion.

The density computation uses the submodule closure formula after restriction
to the canonical integer action. The powers are formed as ideals before
restriction, which preserves their whole carriers.

## References

* Mathlib's principal ideal, comaximal powers and integer congruence APIs.
* Mathlib's adic ring and additive group filter bases, and its canonical
  integer scalar continuity and submodule density APIs.
* `Submodule.topologicalClosure_eq_iInf_sup` for closure from a submodule
  neighborhood basis.
-/

open Filter Topology

namespace Ideal

private theorem three_mem_and_one_notMem_span_three :
    (3 : ℤ) ∈ Ideal.span {(3 : ℤ)} ∧
      (1 : ℤ) ∉ Ideal.span {(3 : ℤ)} := by
  constructor
  · exact Ideal.mem_span_singleton_self (3 : ℤ)
  · rw [Ideal.mem_span_singleton]
    norm_num

private theorem span_three_sup_span_two_pow : ∀ n : ℕ,
    Ideal.span {(3 : ℤ)} ⊔ (Ideal.span {(2 : ℤ)}) ^ n = ⊤ := by
  intro n
  apply Ideal.sup_pow_eq_top
  exact (Ideal.sup_eq_top_iff_isCoprime (3 : ℤ) 2).2 ⟨1, -1, by norm_num⟩

private theorem exists_mem_span_three_modEq_two_pow (n : ℕ) (x : ℤ) :
    ∃ j : ℤ, j ∈ Ideal.span {(3 : ℤ)} ∧ j ≡ x [ZMOD ((2 : ℤ) ^ n)] := by
  have hx : x ∈ Ideal.span {(3 : ℤ)} ⊔ (Ideal.span {(2 : ℤ)}) ^ n := by
    rw [span_three_sup_span_two_pow n]
    exact Submodule.mem_top
  obtain ⟨j, hj, y, hy, hxy⟩ := Submodule.mem_sup.mp hx
  refine ⟨j, hj, Int.modEq_iff_dvd.mpr ?_⟩
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hy
  rw [← hxy, add_sub_cancel_left]
  exact hy

private theorem span_three_ne_top_and_dense_two_adic :
    Ideal.span {(3 : ℤ)} ≠ (⊤ : Ideal ℤ) ∧
      @Dense ℤ (Ideal.span {(2 : ℤ)}).adicTopology
        (Ideal.span {(3 : ℤ)} : Set ℤ) := by
  constructor
  · exact (Ideal.ne_top_iff_one _).2 three_mem_and_one_notMem_span_three.2
  · let : TopologicalSpace ℤ := (Ideal.span {(2 : ℤ)}).adicTopology
    let : IsTopologicalAddGroup ℤ :=
      (Ideal.span {(2 : ℤ)}).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup
    let : ContinuousConstSMul ℤ ℤ := AddGroup.continuousConstSMul_int (A := ℤ)
    have hI : (𝓝 (0 : ℤ)).HasBasis (fun _n : ℕ ↦ True)
        (fun n ↦ ((((Ideal.span {(2 : ℤ)}) ^ n).restrictScalars ℤ) : Set ℤ)) := by
      simpa only [Submodule.coe_restrictScalars] using
        (Ideal.span {(2 : ℤ)}).hasBasis_nhds_zero_adic
    have hclosure := Submodule.topologicalClosure_eq_iInf_sup
      ((Ideal.span {(3 : ℤ)}).restrictScalars ℤ)
      (U := fun n : ℕ ↦ ((Ideal.span {(2 : ℤ)}) ^ n).restrictScalars ℤ) hI
    have htop : ((Ideal.span {(3 : ℤ)}).restrictScalars ℤ).topologicalClosure = ⊤ := by
      rw [hclosure]
      apply top_unique
      refine le_iInf fun n ↦ le_iInf fun _hn ↦ ?_
      rw [← Submodule.restrictScalars_sup, span_three_sup_span_two_pow n,
        Submodule.restrictScalars_top]
    simpa only [Submodule.coe_restrictScalars] using
      (Submodule.dense_iff_topologicalClosure_eq_top
        (s := (Ideal.span {(3 : ℤ)}).restrictScalars ℤ)).2 htop

-- The ideal-power criterion gives density of the proper ideal generated by three.
private theorem span_three_dense_two_adic :
    @Dense ℤ (Ideal.span {(2 : ℤ)}).adicTopology
      (Ideal.span {(3 : ℤ)} : Set ℤ) := by
  let : TopologicalSpace ℤ := (Ideal.span {(2 : ℤ)}).adicTopology
  let : IsTopologicalAddGroup ℤ :=
    (Ideal.span {(2 : ℤ)}).ringFilterBasis.toAddGroupFilterBasis.isTopologicalAddGroup
  have hI : (𝓝 (0 : ℤ)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((Ideal.span {(2 : ℤ)} ^ n : Ideal ℤ) : Set ℤ)) :=
    (Ideal.span {(2 : ℤ)}).hasBasis_nhds_zero_adic
  have hsup : Ideal.span {(3 : ℤ)} ⊔ Ideal.span {(2 : ℤ)} = ⊤ :=
    (Ideal.sup_eq_top_iff_isCoprime (3 : ℤ) 2).2 ⟨1, -1, by norm_num⟩
  exact (Ideal.dense_iff_sup_eq_top_of_hasBasis
    (I := Ideal.span {(2 : ℤ)}) (J := Ideal.span {(3 : ℤ)}) hI).2 hsup

end Ideal
