module

import Mathlib.Data.Matrix.Basis
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Topology.Algebra.Ring.Basic
import Mathlib.Topology.Separation.Hausdorff
import Mathlib.Order.Filter.Bases.Basic
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-!
# Column ideals in a matrix ring

The left ideals generated by the two diagonal matrix units in `M₂(ℤ)` are
nonzero and proper, and neither is two-sided. The topology induced by the
second-column additive homomorphism into discrete `ℤ²` makes the powers of the
first ideal a neighborhood basis at zero. The second ideal is proper and dense.
Right multiplication by the column-swap matrix is not continuous in this topology.
The second ideal is not closed, and the induced topology is not Hausdorff.

## References

The constructions and proofs use Mathlib's matrix units and multiplication APIs,
canonical submodule spans, induced topological additive groups, and the
`closure_induced` formula. In particular the coefficient action is multiplication
by the whole matrix ring, not the integer action on a selected generator.
-/

open Filter Topology

namespace Matrix

section ColumnTopology

private abbrev MatrixRing := Matrix (Fin 2) (Fin 2) ℤ
private abbrev Column := Fin 2 → ℤ

private def e00 : MatrixRing := Matrix.single 0 0 1
private def e11 : MatrixRing := Matrix.single 1 1 1

private def leftColumnIdeal : Ideal MatrixRing := Submodule.span MatrixRing {e00}
private def rightColumnIdeal : Ideal MatrixRing := Submodule.span MatrixRing {e11}

private lemma mul_e00_apply (B : MatrixRing) (r c : Fin 2) :
    (B * e00) r c = if c = 0 then B r 0 else 0 := by
  by_cases hc : c = 0
  · subst c
    simp [e00]
  · simp [e00, hc, Matrix.mul_single_apply_of_ne]

private lemma mul_e11_apply (B : MatrixRing) (r c : Fin 2) :
    (B * e11) r c = if c = 1 then B r 1 else 0 := by
  by_cases hc : c = 1
  · subst c
    simp [e11]
  · simp [e11, hc, Matrix.mul_single_apply_of_ne]

private lemma mem_leftColumnIdeal_iff (B : MatrixRing) :
    B ∈ leftColumnIdeal ↔ ∀ r, B r 1 = 0 := by
  constructor
  · intro hB
    obtain ⟨C, hC⟩ := Submodule.mem_span_singleton.mp hB
    change C * e00 = B at hC
    intro r
    rw [← hC, mul_e00_apply]
    norm_num
  · intro hB
    apply Submodule.mem_span_singleton.mpr
    refine ⟨B, ?_⟩
    change B * e00 = B
    ext r c
    fin_cases c <;> simp [mul_e00_apply, hB]

private lemma mem_rightColumnIdeal_iff (B : MatrixRing) :
    B ∈ rightColumnIdeal ↔ ∀ r, B r 0 = 0 := by
  constructor
  · intro hB
    obtain ⟨C, hC⟩ := Submodule.mem_span_singleton.mp hB
    change C * e11 = B at hC
    intro r
    rw [← hC, mul_e11_apply]
    norm_num
  · intro hB
    apply Submodule.mem_span_singleton.mpr
    refine ⟨B, ?_⟩
    change B * e11 = B
    ext r c
    fin_cases c <;> simp [mul_e11_apply, hB]

private lemma e00_mem_leftColumnIdeal : e00 ∈ leftColumnIdeal :=
  Submodule.mem_span_singleton_self e00

private lemma e11_mem_rightColumnIdeal : e11 ∈ rightColumnIdeal :=
  Submodule.mem_span_singleton_self e11

private lemma e11_notMem_leftColumnIdeal : e11 ∉ leftColumnIdeal := by
  intro h
  have h11 := (mem_leftColumnIdeal_iff e11).mp h 1
  norm_num [e11, Matrix.single_apply] at h11

private lemma e00_notMem_rightColumnIdeal : e00 ∉ rightColumnIdeal := by
  intro h
  have h00 := (mem_rightColumnIdeal_iff e00).mp h 0
  norm_num [e00, Matrix.single_apply] at h00

private theorem leftColumnIdeal_nonzero_proper :
    leftColumnIdeal ≠ ⊥ ∧ leftColumnIdeal ≠ ⊤ := by
  constructor
  · intro h
    have hz : e00 = 0 := by
      simpa only [h, Submodule.mem_bot] using e00_mem_leftColumnIdeal
    have h00 := congrArg (fun B : MatrixRing ↦ B 0 0) hz
    norm_num [e00, Matrix.single_apply] at h00
  · intro h
    apply e11_notMem_leftColumnIdeal
    rw [h]
    trivial

private theorem rightColumnIdeal_nonzero_proper :
    rightColumnIdeal ≠ ⊥ ∧ rightColumnIdeal ≠ ⊤ := by
  constructor
  · intro h
    have hz : e11 = 0 := by
      simpa only [h, Submodule.mem_bot] using e11_mem_rightColumnIdeal
    have h11 := congrArg (fun B : MatrixRing ↦ B 1 1) hz
    norm_num [e11, Matrix.single_apply] at h11
  · intro h
    apply e00_notMem_rightColumnIdeal
    rw [h]
    trivial

private theorem leftColumnIdeal_not_twoSided : ¬ leftColumnIdeal.IsTwoSided := by
  intro h
  let := h
  have hm := leftColumnIdeal.mul_mem_right (Matrix.single 0 1 (1 : ℤ))
    e00_mem_leftColumnIdeal
  have h01 := (mem_leftColumnIdeal_iff _).mp hm 0
  norm_num [e00, Matrix.single_mul_single_same, Matrix.single_apply] at h01

private theorem rightColumnIdeal_not_twoSided : ¬ rightColumnIdeal.IsTwoSided := by
  intro h
  let := h
  have hm := rightColumnIdeal.mul_mem_right (Matrix.single 1 0 (1 : ℤ))
    e11_mem_rightColumnIdeal
  have h10 := (mem_rightColumnIdeal_iff _).mp hm 1
  norm_num [e11, Matrix.single_mul_single_same, Matrix.single_apply] at h10

private lemma mul_e00_eq_of_mem {B : MatrixRing} (hB : B ∈ leftColumnIdeal) :
    B * e00 = B := by
  have hcol := (mem_leftColumnIdeal_iff B).mp hB
  ext r c
  fin_cases c <;> simp [mul_e00_apply, hcol]

private lemma leftColumnIdeal_mul_self : leftColumnIdeal * leftColumnIdeal = leftColumnIdeal := by
  apply le_antisymm Ideal.mul_le_right
  intro B hB
  rw [← mul_e00_eq_of_mem hB]
  exact Ideal.mul_mem_mul hB e00_mem_leftColumnIdeal

-- Successor powers append the right factor; no right-unit law for ideals is used.
private lemma leftColumnIdeal_pow_succ (n : ℕ) : leftColumnIdeal ^ (n + 1) = leftColumnIdeal := by
  induction n with
  | zero => exact Submodule.pow_one _
  | succ n ih => rw [Submodule.pow_succ, ih, leftColumnIdeal_mul_self]

private lemma split_columns (B : MatrixRing) : B * e00 + B * e11 = B := by
  ext r c
  fin_cases c <;> simp [Matrix.add_apply, mul_e00_apply, mul_e11_apply]

private theorem rightColumnIdeal_sup_leftColumnIdeal :
    rightColumnIdeal ⊔ leftColumnIdeal = ⊤ := by
  apply top_unique
  intro B _
  refine Submodule.mem_sup.mpr ⟨B * e11, ?_, B * e00, ?_, ?_⟩
  · exact Submodule.mem_span_singleton.mpr ⟨B, rfl⟩
  · exact Submodule.mem_span_singleton.mpr ⟨B, rfl⟩
  · rw [add_comm, split_columns]

private def secondColumn : MatrixRing →+ Column :=
  (Pi.evalAddMonoidHom (fun _ : Fin 2 ↦ Column) 1).comp
    (Matrix.transposeAddEquiv (Fin 2) (Fin 2) ℤ).toAddMonoidHom

private lemma secondColumn_apply (B : MatrixRing) (r : Fin 2) : secondColumn B r = B r 1 := rfl

private lemma secondColumn_zero_preimage :
    secondColumn ⁻¹' {(0 : Column)} = (leftColumnIdeal : Set MatrixRing) := by
  ext B
  change secondColumn B = 0 ↔ B ∈ leftColumnIdeal
  rw [mem_leftColumnIdeal_iff]
  exact ⟨fun h r ↦ congrFun h r, fun h ↦ funext h⟩

local instance columnDiscreteSpace : TopologicalSpace Column := ⊥
local instance columnDiscreteTopology : DiscreteTopology Column := discreteTopology_bot _
local instance columnTopology : TopologicalSpace MatrixRing :=
  TopologicalSpace.induced secondColumn (⊥ : TopologicalSpace Column)
local instance columnTopology_isTopologicalAddGroup : IsTopologicalAddGroup MatrixRing :=
  isTopologicalAddGroup_induced secondColumn

private lemma nhds_zero_eq_principal_leftColumnIdeal :
    𝓝 (0 : MatrixRing) = 𝓟 (leftColumnIdeal : Set MatrixRing) := by
  change @nhds MatrixRing (TopologicalSpace.induced secondColumn
    (⊥ : TopologicalSpace Column)) 0 = _
  rw [nhds_induced]
  simp only [map_zero, nhds_discrete, ← principal_singleton, comap_principal,
    secondColumn_zero_preimage]

private theorem leftColumnIdeal_powers_basis :
    (𝓝 (0 : MatrixRing)).HasBasis (fun _n : ℕ ↦ True)
      (fun n ↦ ((leftColumnIdeal ^ n : Ideal MatrixRing) : Set MatrixRing)) := by
  rw [nhds_zero_eq_principal_leftColumnIdeal]
  refine (hasBasis_principal (leftColumnIdeal : Set MatrixRing)).to_hasBasis ?_ ?_
  · intro _ _
    exact ⟨1, trivial, by
      simpa only [Submodule.pow_one] using
        (Set.Subset.rfl : (leftColumnIdeal : Set MatrixRing) ⊆ leftColumnIdeal)⟩
  · intro n _
    refine ⟨(), trivial, ?_⟩
    cases n with
    | zero =>
      simpa only [Submodule.pow_zero, Ideal.one_eq_top, Submodule.top_coe] using
        (Set.subset_univ (leftColumnIdeal : Set MatrixRing))
    | succ n =>
      simpa only [leftColumnIdeal_pow_succ] using
        (Set.Subset.rfl : (leftColumnIdeal : Set MatrixRing) ⊆ leftColumnIdeal)

private theorem secondColumn_rightColumnIdeal_surjective (v : Column) :
    ∃ B : MatrixRing, B ∈ rightColumnIdeal ∧ secondColumn B = v := by
  refine ⟨Matrix.of (fun r c ↦ if c = 1 then v r else 0), ?_, ?_⟩
  · rw [mem_rightColumnIdeal_iff]
    intro r
    norm_num
  · ext r
    simp [secondColumn_apply]

private theorem rightColumnIdeal_meets_fiber (B : MatrixRing) :
    ∃ C : MatrixRing, C ∈ rightColumnIdeal ∧ secondColumn C = secondColumn B :=
  secondColumn_rightColumnIdeal_surjective (secondColumn B)

-- Every second-column fiber meets the whole ideal, independently of a density criterion.
private theorem rightColumnIdeal_dense : Dense (rightColumnIdeal : Set MatrixRing) := by
  intro B
  apply (closure_induced (f := secondColumn)).mpr
  apply subset_closure
  obtain ⟨C, hC, hcol⟩ := rightColumnIdeal_meets_fiber B
  exact ⟨C, hC, hcol⟩

-- Density adds a matrix outside the right-column ideal, so that ideal is not closed.
private theorem rightColumnIdeal_not_isClosed :
    ¬ IsClosed (rightColumnIdeal : Set MatrixRing) := by
  intro h
  exact e00_notMem_rightColumnIdeal (h.closure_subset (rightColumnIdeal_dense e00))

-- The nonzero first-column matrix and zero have the same second-column image.
private theorem columnTopology_not_t2Space : ¬ T2Space MatrixRing := by
  intro h
  let := h
  have he00 : e00 ∈ closure ({(0 : MatrixRing)} : Set MatrixRing) := by
    apply (closure_induced (f := secondColumn)).mpr
    apply subset_closure
    refine ⟨(0 : MatrixRing), rfl, ?_⟩
    ext r
    norm_num [secondColumn_apply, e00, Matrix.single_apply]
  have hz : e00 = 0 := by
    simpa only [isClosed_singleton.closure_eq, Set.mem_singleton_iff] using he00
  have h00 := congrArg (fun B : MatrixRing ↦ B 0 0) hz
  norm_num [e00, Matrix.single_apply] at h00

private lemma isOpen_leftColumnIdeal : IsOpen (leftColumnIdeal : Set MatrixRing) := by
  rw [← secondColumn_zero_preimage]
  exact isOpen_induced (isOpen_discrete _)

private lemma not_isOpen_rightColumnIdeal : ¬ IsOpen (rightColumnIdeal : Set MatrixRing) := by
  intro h
  have hN := h.mem_nhds rightColumnIdeal.zero_mem
  rw [nhds_zero_eq_principal_leftColumnIdeal, mem_principal] at hN
  exact e00_notMem_rightColumnIdeal (hN e00_mem_leftColumnIdeal)

private def columnSwap : MatrixRing := Matrix.single 0 1 1 + Matrix.single 1 0 1

private lemma mul_columnSwap_secondColumn (B : MatrixRing) (r : Fin 2) :
    (B * columnSwap) r 1 = B r 0 := by
  simp [columnSwap, Matrix.mul_add, Matrix.add_apply, Matrix.mul_single_apply_of_ne]

private lemma columnSwap_preimage_leftColumnIdeal :
    (fun B : MatrixRing ↦ B * columnSwap) ⁻¹' (leftColumnIdeal : Set MatrixRing) =
      (rightColumnIdeal : Set MatrixRing) := by
  ext B
  change B * columnSwap ∈ leftColumnIdeal ↔ B ∈ rightColumnIdeal
  rw [mem_leftColumnIdeal_iff, mem_rightColumnIdeal_iff]
  simp only [mul_columnSwap_secondColumn]

private theorem right_mul_columnSwap_not_continuous :
    ¬ Continuous (fun B : MatrixRing ↦ B * columnSwap) := by
  intro h
  apply not_isOpen_rightColumnIdeal
  rw [← columnSwap_preimage_leftColumnIdeal]
  exact isOpen_leftColumnIdeal.preimage h

private theorem columnTopology_not_isTopologicalRing : ¬ IsTopologicalRing MatrixRing := by
  intro h
  let := h
  exact right_mul_columnSwap_not_continuous (continuous_mul_const columnSwap)

end ColumnTopology

end Matrix
