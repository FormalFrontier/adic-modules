module

import AdicModules.Topology.Algebra.Module.AdicTopology
import Mathlib.LinearAlgebra.Prod
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.NormNum

/-!
# The integer-pair projection and adic module neighborhoods

The existing first projection `ℤ × ℤ →ₗ[ℤ] ℤ` is surjective and noninjective.
The source and target topologies are independently chosen as the module adic
topologies for the ideal generated by `2`. The precision-two source neighborhood
projects to the proper nonzero target neighborhood `4ℤ`; both neighborhoods
have explicit nonzero membership and nonmembership witnesses. The target
adic module topology is not discrete.

These model calculations use only stock algebra and filter-basis APIs, not the
four functoriality statements. No product-topology identification is used.
-/

open Filter Topology

private abbrev twoIdeal : Ideal ℤ := Ideal.span {(2 : ℤ)}

private abbrev sourceModFour : Submodule ℤ (ℤ × ℤ) := twoIdeal ^ 2 • ⊤

private abbrev targetModFour : Submodule ℤ ℤ := twoIdeal ^ 2 • ⊤

private theorem projection_hypotheses :
    twoIdeal.map (RingHom.id ℤ) = twoIdeal ∧
      Function.Surjective (LinearMap.fst ℤ ℤ ℤ) ∧
      ¬ Function.Injective (LinearMap.fst ℤ ℤ ℤ) := by
  refine ⟨Ideal.map_id _, LinearMap.fst_surjective, ?_⟩
  intro h
  have hp : ((0, 0) : ℤ × ℤ) = (0, 1) := h rfl
  have hs := congrArg Prod.snd hp
  norm_num at hs

private theorem targetModFour_mem_iff (z : ℤ) : z ∈ targetModFour ↔ (4 : ℤ) ∣ z := by
  simp [targetModFour, twoIdeal, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton]

private theorem projection_image_modFour :
    (LinearMap.fst ℤ ℤ ℤ) '' (sourceModFour : Set (ℤ × ℤ)) =
      (targetModFour : Set ℤ) := by
  have h : sourceModFour.map (LinearMap.fst ℤ ℤ ℤ) = targetModFour := by
    rw [sourceModFour, Submodule.map_smul'', Submodule.map_top,
      LinearMap.range_eq_top.mpr LinearMap.fst_surjective]
  exact congrArg (fun P : Submodule ℤ ℤ ↦ (P : Set ℤ)) h

private theorem modFour_witnesses :
    (4 : ℤ) ∈ targetModFour ∧ (1 : ℤ) ∉ targetModFour ∧
      ((4, 0) : ℤ × ℤ) ∈ sourceModFour ∧ ((1, 0) : ℤ × ℤ) ∉ sourceModFour := by
  have hfour : (4 : ℤ) ∈ twoIdeal ^ 2 := by
    norm_num [twoIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  have hone : (1 : ℤ) ∉ targetModFour := by
    rw [targetModFour_mem_iff]
    norm_num
  refine ⟨(targetModFour_mem_iff 4).mpr (dvd_refl 4), hone, ?_, ?_⟩
  · simpa using (Submodule.smul_mem_smul hfour
      (Submodule.mem_top : ((1, 0) : ℤ × ℤ) ∈ (⊤ : Submodule ℤ (ℤ × ℤ))))
  · intro h
    exact hone (Submodule.smul_top_le_comap_smul_top (twoIdeal ^ 2)
      (LinearMap.fst ℤ ℤ ℤ) h)

private theorem sourceModFour_mem_nhds_zero :
    (sourceModFour : Set (ℤ × ℤ)) ∈
      @nhds (ℤ × ℤ) (twoIdeal.adicModuleTopology (ℤ × ℤ)) 0 := by
  let : TopologicalSpace ℤ := twoIdeal.adicTopology
  exact (twoIdeal.ringFilterBasis.moduleFilterBasis
    (twoIdeal.adic_module_basis (ℤ × ℤ))).toAddGroupFilterBasis.mem_nhds_zero ⟨2, rfl⟩

private theorem targetModFour_mem_nhds_zero :
    (targetModFour : Set ℤ) ∈ @nhds ℤ (twoIdeal.adicModuleTopology ℤ) 0 := by
  let : TopologicalSpace ℤ := twoIdeal.adicTopology
  exact (twoIdeal.ringFilterBasis.moduleFilterBasis
    (twoIdeal.adic_module_basis ℤ)).toAddGroupFilterBasis.mem_nhds_zero ⟨2, rfl⟩

private theorem target_not_discrete : ¬ @DiscreteTopology ℤ (twoIdeal.adicModuleTopology ℤ) := by
  intro h
  let : TopologicalSpace ℤ := twoIdeal.adicModuleTopology ℤ
  let : DiscreteTopology ℤ := h
  have hz : ({0} : Set ℤ) ∈ 𝓝 (0 : ℤ) := by simp [nhds_discrete]
  obtain ⟨n, _, hn⟩ := twoIdeal.hasBasis_nhds_zero_adic.mem_iff.mp hz
  have hp : (2 : ℤ) ^ n ∈ twoIdeal ^ n :=
    Ideal.pow_mem_pow (Ideal.mem_span_singleton_self 2) n
  have hzero := hn hp
  exact (pow_ne_zero n (by decide : (2 : ℤ) ≠ 0)) hzero

-- Surjectivity is not dispensable for an open quotient map.
private theorem doubling_not_surjective : ¬ Function.Surjective (fun z : ℤ ↦ 2 * z) := by
  intro h
  obtain ⟨z, hz⟩ := h 1
  change 2 * z = 1 at hz
  omega

-- The same projection transports precision-two neighborhoods and detects descent of
-- continuity to any independently topologized codomain. Its preimage of 4ℤ is
-- 4ℤ × ℤ, whereas the source basis member is 4ℤ × 4ℤ; only their images agree.
private theorem projection_modFour_descent {X : Type*} [TopologicalSpace X] (g : ℤ → X) :
    (sourceModFour : Set (ℤ × ℤ)) ∈
        @nhds (ℤ × ℤ) (twoIdeal.adicModuleTopology (ℤ × ℤ)) 0 ∧
      (LinearMap.fst ℤ ℤ ℤ) ⁻¹' (targetModFour : Set ℤ) ∈
        @nhds (ℤ × ℤ) (twoIdeal.adicModuleTopology (ℤ × ℤ)) 0 ∧
      @IsOpen ℤ (twoIdeal.adicModuleTopology ℤ)
        ((LinearMap.fst ℤ ℤ ℤ) '' (sourceModFour : Set (ℤ × ℤ))) ∧
      (LinearMap.fst ℤ ℤ ℤ) '' (sourceModFour : Set (ℤ × ℤ)) ≠ Set.univ ∧
      (@Continuous (ℤ × ℤ) X (twoIdeal.adicModuleTopology (ℤ × ℤ)) _
          (g ∘ LinearMap.fst ℤ ℤ ℤ) ↔
        @Continuous ℤ X (twoIdeal.adicModuleTopology ℤ) _ g) := by
  let : TopologicalSpace (ℤ × ℤ) := twoIdeal.adicModuleTopology (ℤ × ℤ)
  let : TopologicalSpace ℤ := twoIdeal.adicModuleTopology ℤ
  have hU : (sourceModFour : Set (ℤ × ℤ)) ∈ 𝓝 0 :=
    (twoIdeal.hasBasis_nhds_zero_adicModuleTopology (ℤ × ℤ)).mem_iff.mpr
      ⟨2, trivial, Set.Subset.rfl⟩
  have hV : (targetModFour : Set ℤ) ∈ 𝓝 0 :=
    (twoIdeal.hasBasis_nhds_zero_adicModuleTopology ℤ).mem_iff.mpr
      ⟨2, trivial, Set.Subset.rfl⟩
  obtain ⟨hI, hf, _⟩ := projection_hypotheses
  have hc := (LinearMap.fst ℤ ℤ ℤ).continuous_adicModuleTopology_of_map_le hI.le
  have ho := (LinearMap.fst ℤ ℤ ℤ).isOpenMap_adicModuleTopology_of_le_map hI.ge hf
  have hq := (LinearMap.fst ℤ ℤ ℤ).isOpenQuotientMap_adicModuleTopology hI hf
  refine ⟨hU, ?_, ho _ (sourceModFour.toAddSubgroup.isOpen_of_mem_nhds hU), ?_,
    hq.continuous_comp_iff⟩
  · simpa only [map_zero] using hc.continuousAt.preimage_mem_nhds hV
  · rw [projection_image_modFour]
    intro h
    apply modFour_witnesses.2.1
    change (1 : ℤ) ∈ (targetModFour : Set ℤ)
    rw [h]
    trivial
