module

public import AdicModules.LinearAlgebra.Correspondence

/-!
# A semimodule kernel–range correspondence

The natural-number-linear projection `(x, y) ↦ (x, 0)` from `ℤ × ℤ` to `ℤ × ℕ`
has a nonzero proper range and a target without additive inverses. The submodule
generated by `(1, 0)` together with its kernel is a proper half-plane, not an
additive subgroup. The correspondence sends it to the nonnegative first-axis ray.
-/

@[expose] public section

namespace Submodule

/-- Projection to the integer coordinate, with zero natural-number coordinate. -/
private def intProdNatProjection : (ℤ × ℤ) →ₗ[ℕ] (ℤ × ℕ) where
  toFun x := (x.1, 0)
  map_add' := by intro x y; rfl
  map_smul' := by intro n x; exact Prod.ext rfl (smul_zero n).symm

/-- The nonnegative first-coordinate half-plane, containing the projection kernel. -/
private def upperHalfPlane : Set.Ici (LinearMap.ker intProdNatProjection) :=
  ⟨span ℕ {((1 : ℤ), (0 : ℤ))} ⊔ LinearMap.ker intProdNatProjection,
    (show LinearMap.ker intProdNatProjection ≤
      span ℕ {((1 : ℤ), (0 : ℤ))} ⊔ LinearMap.ker intProdNatProjection from le_sup_right)⟩

/-- The nonnegative first-axis ray inside the projection range. -/
private def nonnegativeAxis : Set.Iic (LinearMap.range intProdNatProjection) :=
  ⟨span ℕ {((1 : ℤ), (0 : ℕ))}, span_le.mpr <| Set.singleton_subset_iff.mpr <|
    LinearMap.mem_range.mpr ⟨((1 : ℤ), (0 : ℤ)), rfl⟩⟩

private theorem map_upperHalfPlane :
    map intProdNatProjection upperHalfPlane.1 = nonnegativeAxis.1 := by
  have hk : map intProdNatProjection (LinearMap.ker intProdNatProjection) = ⊥ :=
    le_antisymm (map_le_iff_le_comap.mpr le_rfl) bot_le
  change map intProdNatProjection
    (span ℕ {((1 : ℤ), (0 : ℤ))} ⊔ LinearMap.ker intProdNatProjection) =
    span ℕ {((1 : ℤ), (0 : ℕ))}
  rw [map_sup, hk, sup_bot_eq, map_span]
  simp [intProdNatProjection]

private theorem neg_one_not_mem_nonnegativeAxis :
    ((-1 : ℤ), (0 : ℕ)) ∉ nonnegativeAxis.1 := by
  intro hz
  obtain ⟨n, hn⟩ := mem_span_singleton.mp hz
  have h := congrArg Prod.fst hn
  change n • (1 : ℤ) = -1 at h
  simp only [nsmul_eq_mul, mul_one] at h
  exact (by decide : ¬ (0 : ℤ) ≤ -1) (h ▸ Int.natCast_nonneg n)

private theorem orderIsoMapComapKerRange_upperHalfPlane :
    orderIsoMapComapKerRange intProdNatProjection upperHalfPlane = nonnegativeAxis ∧
    (orderIsoMapComapKerRange intProdNatProjection).symm nonnegativeAxis = upperHalfPlane := by
  have h : orderIsoMapComapKerRange intProdNatProjection upperHalfPlane = nonnegativeAxis := by
    apply Subtype.ext
    simpa only [coe_orderIsoMapComapKerRange_apply] using map_upperHalfPlane
  refine ⟨h, ?_⟩
  rw [← h]
  exact (orderIsoMapComapKerRange intProdNatProjection).symm_apply_apply upperHalfPlane

private theorem upperHalfPlane_strict_bounds :
    LinearMap.ker intProdNatProjection < upperHalfPlane.1 ∧
    upperHalfPlane.1 < ⊤ ∧
    ((1 : ℤ), (0 : ℤ)) ∈ upperHalfPlane.1 ∧
    ((-1 : ℤ), (0 : ℤ)) ∉ upperHalfPlane.1 := by
  have hp : ((1 : ℤ), (0 : ℤ)) ∈ upperHalfPlane.1 :=
    mem_sup_left (mem_span_singleton_self _)
  have hn : ((-1 : ℤ), (0 : ℤ)) ∉ upperHalfPlane.1 := by
    intro h
    apply neg_one_not_mem_nonnegativeAxis
    rw [← map_upperHalfPlane]
    exact mem_map.mpr ⟨((-1 : ℤ), (0 : ℤ)), h, rfl⟩
  refine ⟨lt_of_le_not_ge upperHalfPlane.2 ?_, lt_of_le_not_ge le_top ?_, hp, hn⟩
  · intro h
    have hk := congrArg Prod.fst (LinearMap.mem_ker.mp (h hp))
    exact (by decide : (1 : ℤ) ≠ 0) hk
  · intro h
    exact hn (h mem_top)

private theorem intProdNatProjection_range :
    (∀ z : ℤ × ℕ, z ∈ LinearMap.range intProdNatProjection ↔ z.2 = 0) ∧
    ⊥ < nonnegativeAxis.1 ∧
    nonnegativeAxis.1 < LinearMap.range intProdNatProjection ∧
    ((0 : ℤ), (1 : ℕ)) ∉ LinearMap.range intProdNatProjection ∧
    (¬ ∃ q : ℤ × ℕ, ((0 : ℤ), (1 : ℕ)) + q = 0) := by
  have hp : ((1 : ℤ), (0 : ℕ)) ∈ nonnegativeAxis.1 := mem_span_singleton_self _
  have hn : ((-1 : ℤ), (0 : ℕ)) ∈ LinearMap.range intProdNatProjection :=
    LinearMap.mem_range.mpr ⟨((-1 : ℤ), (0 : ℤ)), rfl⟩
  refine ⟨?_, lt_of_le_not_ge bot_le ?_, lt_of_le_not_ge nonnegativeAxis.2 ?_, ?_, ?_⟩
  · intro z
    rw [LinearMap.mem_range]
    constructor
    · rintro ⟨w, rfl⟩
      rfl
    · intro hz
      exact ⟨(z.1, 0), Prod.ext rfl hz.symm⟩
  · intro h
    have hz : ((1 : ℤ), (0 : ℕ)) = 0 := (mem_bot ℕ).mp (h hp)
    exact (by decide : (1 : ℤ) ≠ 0) (congrArg Prod.fst hz)
  · intro h
    exact neg_one_not_mem_nonnegativeAxis (h hn)
  · intro h
    obtain ⟨w, hw⟩ := LinearMap.mem_range.mp h
    exact (by decide : (0 : ℕ) ≠ 1) (congrArg Prod.snd hw)
  · rintro ⟨q, hq⟩
    have he := congrArg Prod.snd hq
    change 1 + q.2 = 0 at he
    rw [Nat.add_comm] at he
    exact Nat.noConfusion he

end Submodule
