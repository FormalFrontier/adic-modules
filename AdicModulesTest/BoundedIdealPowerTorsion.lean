module

public import AdicModules
public import Mathlib.Data.ZMod.Basic
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Uniform ideal-power annihilation on finite modules

For a finite module whose primary component is the whole module, elementwise ideal-power
annihilation yields one uniform annihilating power, inherited by every submodule without a
finiteness assumption on that submodule. The other applications retain closure under
submodules, surjective images and extensions, including addition of specified exponents.

For `R = ℤ`, `M = ℤ/4ℤ` and `I = (2)`, the whole module is primary and is killed
by `I^2`. Its nonzero submodule `2M` illustrates that the submodule conclusion concerns
annihilation of a real module, not just the zero submodule. Tensoring the ambient module
with the integer unit module, in either order, preserves the exponent two and retains a
nonzero pure tensor.
The zero natural-number submodule supplies the exponent-zero boundary.
The ambient witness also gives radical containment, and the converse is applied
to the zero ideal over the natural numbers without additive inverses.

The proofs use the module-torsion and primary-component APIs of AdicModules and Mathlib,
together with Mathlib's integer action, finite-module instance and canonical reduction
homomorphism for `ZMod`. The product applications reuse the ambient `(2)^2`
annihilation witness for the original infinite family `ℕ → ZMod 4` and its
restriction to `Fin 2`. An empty product over `ℕ` also uses the uniform API with
exponent zero, without additive inverses or a nonempty index type.

## References

* Mathlib's `ZMod` development by Chris Hughes, integer-module development by Nathaniel Thomas
  and collaborators, finite-module development by Johan Commelin, and module-torsion development
  by Pierre-Alexandre Bazin and collaborators supply the formalization interfaces used here.
* Mathlib's tensor-product development by Kenny Lau, Mario Carneiro and collaborators supplies
  the canonical tensor product, commutor and unitors.
-/

set_option warningAsError true

universe u v w

open Module

section AddCommMonoid

variable (R : Type u) (M : Type v) [CommSemiring R] [AddCommMonoid M] [Module R M]

private theorem submoduleClient (I : Ideal R) (h : IsKilledByIdealPower R M I) (N : Submodule R M) :
    IsKilledByIdealPower R N I :=
  h.submodule N

variable {R M} {N : Type w} [AddCommMonoid N] [Module R N]

private theorem surjectiveClient (I : Ideal R) (h : IsKilledByIdealPower R M I) (f : M →ₗ[R] N)
    (hf : Function.Surjective f) : IsKilledByIdealPower R N I :=
  h.of_surjective f hf

end AddCommMonoid

section Finite

variable (R : Type u) (M : Type v) [CommRing R] [AddCommMonoid M] [Module R M]
  [Module.Finite R M]

private theorem finitePrimaryComponentClient (I : Ideal R) (h : Ideal.primaryComponent M I = ⊤) :
    IsKilledByIdealPower R M I :=
  (Module.isKilledByIdealPower_iff_primaryComponent_eq_top R M I).mpr h

private theorem primaryComponentTopClient (I : Ideal R) (h : IsKilledByIdealPower R M I) :
    Ideal.primaryComponent M I = ⊤ :=
  (Module.isKilledByIdealPower_iff_primaryComponent_eq_top R M I).mp h

end Finite

section AddCommGroup

variable (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]

private theorem specifiedExponentExtensionClient (I : Ideal R) (N : Submodule R M) {n m : ℕ}
    (hN : Module.IsTorsionBySet R N (↑(I ^ n) : Set R))
    (hQ : Module.IsTorsionBySet R (M ⧸ N) (↑(I ^ m) : Set R)) :
    Module.IsTorsionBySet R M (↑(I ^ (n + m)) : Set R) :=
  Module.isTorsionBySet_ideal_pow_extension I N hN hQ

private theorem boundedExtensionClient (I : Ideal R) (N : Submodule R M)
    (hN : IsKilledByIdealPower R N I)
    (hQ : IsKilledByIdealPower R (M ⧸ N) I) : IsKilledByIdealPower R M I :=
  IsKilledByIdealPower.extension I N hN hQ

end AddCommGroup

/-- The integer submodule generated by two in `ℤ/4ℤ` is nonzero and proper, and is
annihilated by a power of `(2)`. The ambient module is killed by `(2)^2` and is its entire
`(2)`-primary component; uniform annihilation of the submodule is obtained from that finite
ambient module, without a separate finiteness assumption on the submodule. -/
public theorem ZMod.span_two_isKilledByIdealPower :
    let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
    let N : Submodule ℤ (ZMod 4) := Submodule.span ℤ {(2 : ZMod 4)}
    Module.IsTorsionBySet ℤ (ZMod 4) (↑(I ^ 2) : Set ℤ) ∧
      Ideal.primaryComponent (ZMod 4) I = ⊤ ∧
      Module.IsKilledByIdealPower ℤ N I ∧
      (2 : ZMod 4) ∈ N ∧ (2 : ZMod 4) ≠ 0 ∧ N ≠ ⊤ := by
  dsimp only
  let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
  let N : Submodule ℤ (ZMod 4) := Submodule.span ℤ {(2 : ZMod 4)}
  have hKilled : Module.IsTorsionBySet ℤ (ZMod 4) (↑(I ^ 2) : Set ℤ) := by
    dsimp only [I]
    rw [Ideal.span_singleton_pow, show (2 : ℤ) ^ 2 = 4 from by decide,
      Module.isTorsionBySet_span_singleton_iff]
    intro x
    rw [zsmul_eq_mul, show ((4 : ℤ) : ZMod 4) = 0 from by decide, zero_mul]
  have hPrimary : Ideal.primaryComponent (ZMod 4) I = ⊤ :=
    (Module.isKilledByIdealPower_iff_primaryComponent_eq_top ℤ (ZMod 4) I).mp
      ⟨2, hKilled⟩
  have hSubmodule : Module.IsKilledByIdealPower ℤ N I :=
    Module.isKilledByIdealPower_submodule_of_primaryComponent_eq_top
      ℤ (ZMod 4) I hPrimary N
  refine ⟨hKilled, hPrimary, hSubmodule,
    Submodule.subset_span (Set.mem_singleton _), by decide, ?_⟩
  let f : ZMod 4 →+ ZMod 2 :=
    (ZMod.castHom (show 2 ∣ 4 from ⟨2, rfl⟩) (ZMod 2)).toAddMonoidHom
  have hfTwo : f (2 : ZMod 4) = 0 := by
    change ZMod.castHom (show 2 ∣ 4 from ⟨2, rfl⟩) (ZMod 2) (2 : ZMod 4) = 0
    simpa only [map_ofNat] using (show (2 : ZMod 2) = 0 from by decide)
  have hKernel : N ≤ f.toIntLinearMap.ker := by
    apply Submodule.span_le.mpr
    intro y hy
    have hyTwo : y = (2 : ZMod 4) := Set.mem_singleton_iff.mp hy
    subst y
    change f (2 : ZMod 4) = 0
    exact hfTwo
  intro hTop
  change N = ⊤ at hTop
  have hOne : (1 : ZMod 4) ∈ N := by
    rw [hTop]
    trivial
  have hfOne : f (1 : ZMod 4) = 0 := hKernel hOne
  change ZMod.castHom (show 2 ∣ 4 from ⟨2, rfl⟩) (ZMod 2) 1 = 0 at hfOne
  rw [map_one] at hfOne
  exact one_ne_zero hfOne

/-- Both nonzero ends are killed by `(2)`, but the middle requires exponent two. -/
private theorem ZMod.span_two_exactClient :
    let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
    let N : Submodule ℤ (ZMod 4) := Submodule.span ℤ {(2 : ZMod 4)}
    Module.IsTorsionBySet ℤ (ZMod 4) (↑(I ^ 2) : Set ℤ) ∧
      ¬ Module.IsTorsionBySet ℤ (ZMod 4) (↑I : Set ℤ) ∧
      Nontrivial N ∧ Nontrivial (ZMod 4 ⧸ N) := by
  dsimp only
  let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
  let N : Submodule ℤ (ZMod 4) := Submodule.span ℤ {(2 : ZMod 4)}
  have hTwoMem : (2 : ZMod 4) ∈ N := ZMod.span_two_isKilledByIdealPower.2.2.2.1
  have hTwo : (2 : ZMod 4) ≠ 0 := ZMod.span_two_isKilledByIdealPower.2.2.2.2.1
  have hProper : N ≠ ⊤ := ZMod.span_two_isKilledByIdealPower.2.2.2.2.2
  have hN : Module.IsTorsionBySet ℤ N (↑(I ^ 1) : Set ℤ) := by
    dsimp only [I]
    rw [pow_one, Module.isTorsionBySet_span_singleton_iff]
    intro x
    apply Subtype.ext
    change (2 : ℤ) • (x : ZMod 4) = 0
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp x.property
    rw [← ha, smul_comm (2 : ℤ) a (2 : ZMod 4),
      show (2 : ℤ) • (2 : ZMod 4) = 0 from by decide, smul_zero]
  have hQ : Module.IsTorsionBySet ℤ (ZMod 4 ⧸ N) (↑(I ^ 1) : Set ℤ) := by
    dsimp only [I]
    rw [pow_one, Module.isTorsionBySet_span_singleton_iff]
    intro x
    obtain ⟨y, rfl⟩ := N.mkQ_surjective x
    rw [← N.mkQ.map_smul (2 : ℤ) y, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    have hy : (2 : ℤ) • y = (y.val : ℤ) • (2 : ZMod 4) := by
      simp [zsmul_eq_mul, mul_comm]
    rw [hy]
    exact N.smul_mem (y.val : ℤ) hTwoMem
  refine ⟨Module.isTorsionBySet_ideal_pow_of_exact I N.subtype N.mkQ
    (LinearMap.exact_subtype_mkQ N) hN hQ, ?_,
    Submodule.nontrivial_span_singleton hTwo, Submodule.Quotient.nontrivial_iff.mpr hProper⟩
  intro hM
  apply hTwo
  simpa [zsmul_eq_mul] using
    (@hM (1 : ZMod 4) ⟨(2 : ℤ), Ideal.subset_span (Set.mem_singleton _)⟩)

example : Ideal.span {(2 : ℤ)} ≤ (Module.annihilator ℤ (ZMod 4)).radical := by
  have hKilled : Module.IsKilledByIdealPower ℤ (ZMod 4) (Ideal.span {(2 : ℤ)}) :=
    ⟨2, ZMod.span_two_isKilledByIdealPower.1⟩
  exact hKilled.le_radical_annihilator

example : Module.IsKilledByIdealPower ℕ ℕ (⊥ : Ideal ℕ) :=
  (Module.isKilledByIdealPower_iff_le_radical_annihilator
    ℕ ℕ ⊥ Submodule.fg_bot).mpr bot_le

/-- The original ambient exponent works uniformly over the infinite constant family. -/
private theorem ZMod.infinite_pi_isKilledByIdealPower :
    IsKilledByIdealPower ℤ (ℕ → ZMod 4) (Ideal.span {(2 : ℤ)}) :=
  (Module.isKilledByIdealPower_pi_iff ℤ (fun _ : ℕ ↦ ZMod 4) _).mpr
    ⟨2, fun _ ↦ ZMod.span_two_isKilledByIdealPower.1⟩

/-- The same family restricted to two coordinates uses the finite-product API. -/
private theorem ZMod.finite_pi_isKilledByIdealPower :
    IsKilledByIdealPower ℤ (Fin 2 → ZMod 4) (Ideal.span {(2 : ℤ)}) :=
  (Module.isKilledByIdealPower_pi_iff_of_finite ℤ (fun _ : Fin 2 ↦ ZMod 4) _).mpr
    (fun _ ↦ ⟨2, ZMod.span_two_isKilledByIdealPower.1⟩)

/-- Even the unit ideal to the zeroth power kills the empty product of `ℕ`-modules. -/
private theorem empty_pi_isKilledByIdealPower :
    IsKilledByIdealPower ℕ (Empty → ℕ) ⊤ :=
  (Module.isKilledByIdealPower_pi_iff ℕ (fun _ : Empty ↦ ℕ) ⊤).mpr
    ⟨0, fun i ↦ nomatch i⟩

section TensorProduct

open scoped TensorProduct

private theorem integerTensorProductClient :
    let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
    Module.IsTorsionBySet ℤ (ZMod 4 ⊗[ℤ] ℤ) (↑(I ^ 2) : Set ℤ) ∧
      Module.IsKilledByIdealPower ℤ (ZMod 4 ⊗[ℤ] ℤ) I ∧
      Module.IsTorsionBySet ℤ (ℤ ⊗[ℤ] ZMod 4) (↑(I ^ 2) : Set ℤ) ∧
      Module.IsKilledByIdealPower ℤ (ℤ ⊗[ℤ] ZMod 4) I ∧
      (2 : ZMod 4) ⊗ₜ[ℤ] (1 : ℤ) ≠ 0 := by
  dsimp only
  let I : Ideal ℤ := Ideal.span {(2 : ℤ)}
  have hM : Module.IsTorsionBySet ℤ (ZMod 4) (↑(I ^ 2) : Set ℤ) :=
    ZMod.span_two_isKilledByIdealPower.1
  have hBounded : Module.IsKilledByIdealPower ℤ (ZMod 4) I := ⟨2, hM⟩
  refine ⟨hM.tensorProduct_left, hBounded.tensorProduct_left,
    hM.tensorProduct_right, hBounded.tensorProduct_right, ?_⟩
  intro h
  have hTwo : (2 : ZMod 4) ≠ 0 := ZMod.span_two_isKilledByIdealPower.2.2.2.2.1
  apply hTwo
  simpa only [TensorProduct.rid_tmul, one_smul, map_zero] using
    congrArg (TensorProduct.rid ℤ (ZMod 4)) h

private theorem natBotTensorProductClient :
    let I : Ideal ℕ := ⊥
    Module.IsTorsionBySet ℕ ((⊥ : Submodule ℕ ℕ) ⊗[ℕ] ℕ) (↑(I ^ 0) : Set ℕ) ∧
      Module.IsKilledByIdealPower ℕ ((⊥ : Submodule ℕ ℕ) ⊗[ℕ] ℕ) I ∧
      Module.IsTorsionBySet ℕ (ℕ ⊗[ℕ] (⊥ : Submodule ℕ ℕ)) (↑(I ^ 0) : Set ℕ) ∧
      Module.IsKilledByIdealPower ℕ (ℕ ⊗[ℕ] (⊥ : Submodule ℕ ℕ)) I := by
  dsimp only
  have hZero : Module.IsTorsionBySet ℕ (⊥ : Submodule ℕ ℕ)
      (↑((⊥ : Ideal ℕ) ^ 0) : Set ℕ) := by
    intro x a
    exact Subsingleton.elim _ _
  have hM := Module.isTorsionBySet_ideal_pow_of_exact (⊥ : Ideal ℕ)
    (LinearMap.id : (⊥ : Submodule ℕ ℕ) →ₗ[ℕ] (⊥ : Submodule ℕ ℕ))
    (0 : (⊥ : Submodule ℕ ℕ) →ₗ[ℕ] (⊥ : Submodule ℕ ℕ))
    (LinearMap.exact_iff.mpr (by rw [LinearMap.ker_zero, LinearMap.range_id])) hZero hZero
  have hBounded : Module.IsKilledByIdealPower ℕ (⊥ : Submodule ℕ ℕ) ⊥ := ⟨0, hM⟩
  exact ⟨hM.tensorProduct_left, hBounded.tensorProduct_left,
    hM.tensorProduct_right, hBounded.tensorProduct_right⟩

end TensorProduct
