module

public import AdicModules.MvPolynomial.HenselDeterminant
import AdicModules.AdicCompletion.Completeness
import AdicModules.Polynomial.Hensel
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

/-!
# Ideal-power precision with a nonregular Jacobian determinant

A polynomial system over `ℕ`, evaluated in `ZMod 256`, has initial error `128`
and Jacobian determinant `4`. The ideal generated by `2` has eighth power zero.
Its adic completeness supplies Henselianity independently of the system.
Ideal-power lifting produces a root in the fourth-power correction box, even
though the determinant is not regular. Two explicit roots in that same box show
why regularity cannot be omitted from a uniform uniqueness statement.
-/

@[expose] public section

namespace HenselPrecision

open MvPolynomial

private abbrev R := ZMod 256

private def φ : ℕ →+* R := Nat.castRingHom R

private def evenIdeal : Ideal R := Ideal.span ({2} : Set R)

private noncomputable def q : MvPolynomial (Fin 2) ℕ := C 4 * X 0 + X 0 ^ 2

private noncomputable def system : Fin 2 → MvPolynomial (Fin 2) ℕ :=
  ![q + X 1 + C 128, q + C 2 * X 1 + C 128]

private noncomputable def jacobian : Matrix (Fin 2) (Fin 2) R :=
  fun i j => eval₂ φ (0 : Fin 2 → R) (pderiv j (system i))

private def solution (b : Fin 2 → R) : Prop :=
  (∀ i, eval₂ φ b (system i) = 0) ∧ ∀ i, b i ∈ evenIdeal ^ 4

private lemma ideal_power (n : ℕ) :
    evenIdeal ^ n = Ideal.span ({(2 : R) ^ n} : Set R) := by
  exact Ideal.span_singleton_pow (2 : R) n

private lemma eighth_power_zero : evenIdeal ^ 8 = ⊥ := by
  rw [ideal_power]
  have h : (2 : R) ^ 8 = 0 := by decide
  rw [h, Ideal.span_singleton_zero]

private instance : IsAdicComplete evenIdeal R :=
  IsAdicComplete.of_pow_smul_top_eq_bot (n := 8) (by simp [eighth_power_zero])

private instance : HenselianRing R evenIdeal := by
  refine HenselianRing.of_monic_factorization evenIdeal
    (IsAdicComplete.le_jacobson_bot evenIdeal) ?_
  intro F g₀ h₀ hF hg₀ hh₀ hcop hfac
  obtain ⟨g, h, hg, hh, _, hfactor, hgmod, hhmod⟩ :=
    Polynomial.exists_monic_factorization_of_isAdicComplete evenIdeal
      hF hg₀ hh₀ hcop hfac
  exact ⟨g, h, hg, hh, hfactor, hgmod, hhmod⟩

private lemma jacobian_eq : jacobian = !![4, 1; 4, 2] := by
  have h128 (j : Fin 2) : pderiv j (128 : MvPolynomial (Fin 2) ℕ) = 0 :=
    (pderiv j).map_natCast 128
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [jacobian, system, q, φ, pderiv_C, pderiv_mul, pderiv_pow, h128,
      eval₂_add, eval₂_mul, eval₂_pow]

private lemma determinant_eq : jacobian.det = (4 : R) := by
  rw [jacobian_eq, Matrix.det_fin_two]
  norm_num

private lemma initial_error (i : Fin 2) :
    eval₂ φ (0 : Fin 2 → R) (system i) = 128 := by
  fin_cases i <;>
    norm_num [system, q, φ, eval₂_add, eval₂_mul, eval₂_pow]

/-- A nonzero error can be lifted through a nonregular determinant, but the
resulting root need not be unique in the prescribed correction box. -/
example :
    (∃ b : Fin 2 → R, solution b) ∧
      ¬ IsRegular jacobian.det ∧
      (∀ i, eval₂ φ (0 : Fin 2 → R) (system i) = 128) ∧
      (128 : R) ≠ 0 ∧
      solution ![32, 0] ∧ solution ![96, 0] ∧
      (![32, 0] : Fin 2 → R) ≠ ![96, 0] ∧
      ¬ (∃! b : Fin 2 → R, solution b) := by
  have hspan : Ideal.span ({jacobian.det} : Set R) = evenIdeal ^ 2 := by
    rw [determinant_eq, ideal_power]
    norm_num
  have herr (i : Fin 2) :
      eval₂ φ (0 : Fin 2 → R) (system i) - (0 : Fin 2 → R) i ∈
        evenIdeal ^ (2 * 3 + 1) := by
    simp only [initial_error, Pi.zero_apply, sub_zero]
    rw [ideal_power]
    apply Ideal.mem_span_singleton.mpr
    exact ⟨1, by norm_num⟩
  have hexists : ∃ b : Fin 2 → R, solution b := by
    obtain ⟨b, hb, hbox⟩ := HenselianRing.exists_eval₂_eq_of_sub_mem_pow
      (M := evenIdeal) φ system (0 : Fin 2 → R) (0 : Fin 2 → R)
      3 2 (by norm_num) hspan herr
    exact ⟨b, hb, by simpa only [Pi.zero_apply, sub_zero] using hbox⟩
  have hnonregular : ¬ IsRegular jacobian.det := by
    rw [determinant_eq]
    intro h
    have hz : (4 : R) * 64 = (4 : R) * 0 := by decide
    have h64 : (64 : R) = 0 := h.left hz
    exact (by decide : (64 : R) ≠ 0) h64
  have h32 : solution ![32, 0] := by
    constructor
    · intro i
      fin_cases i <;>
        simpa [system, q, φ, eval₂_add, eval₂_mul, eval₂_pow] using
          (show (4 : R) * 32 + (32 : R) ^ 2 + 128 = 0 from by decide)
    · intro i
      fin_cases i
      · rw [ideal_power]
        apply Ideal.mem_span_singleton.mpr
        exact ⟨2, by norm_num⟩
      · simp
  have h96 : solution ![96, 0] := by
    constructor
    · intro i
      fin_cases i <;>
        simpa [system, q, φ, eval₂_add, eval₂_mul, eval₂_pow] using
          (show (4 : R) * 96 + (96 : R) ^ 2 + 128 = 0 from by decide)
    · intro i
      fin_cases i
      · rw [ideal_power]
        apply Ideal.mem_span_singleton.mpr
        exact ⟨6, by norm_num⟩
      · simp
  have hne : (![32, 0] : Fin 2 → R) ≠ ![96, 0] := by
    intro h
    have h0 := congrFun h 0
    exact (by decide : (32 : R) ≠ 96) (by simpa using h0)
  refine ⟨hexists, hnonregular, initial_error, (by decide : (128 : R) ≠ 0),
    h32, h96, hne, ?_⟩
  rintro ⟨b, _, huniq⟩
  exact hne ((huniq _ h32).trans (huniq _ h96).symm)

end HenselPrecision
